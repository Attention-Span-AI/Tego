# SPDX-License-Identifier: Apache-2.0
# The supply-chain demo's settings, read by demo.sh (plain sh). Every line is a default: set the same name in
# the environment to override it for one run, e.g.   DEMO_PORT_API=9803 ./demo.sh setup
# A port or unit prefix you change here must be the same for every subcommand (setup fills the contract's API
# address from DEMO_PORT_API, so run setup again after changing a port).

# The two fake "attacker" servers (sink.py) and the project's own API (api.py), all on 127.0.0.1.
DEMO_PORT_LEFT=${DEMO_PORT_LEFT:-8801}     # the attacker the watched (left) side reaches
DEMO_PORT_RIGHT=${DEMO_PORT_RIGHT:-8802}   # the attacker the enforced (right) side must not reach
DEMO_PORT_API=${DEMO_PORT_API:-8803}       # the project's own API: on the contract's net.allow

# The three servers run as systemd user units named <prefix>-sink-<port> and <prefix>-api-<port>. demo.sh
# starts and stops those exact names and nothing else.
DEMO_UNIT_PREFIX=${DEMO_UNIT_PREFIX:-tego-sc}

# The dashboard (tego-control serve). demo.sh check fails while another program listens here; the demo's own
# dashboard (TEGO_CONFIG=DEMO_CONFIG) is fine, and it can stay up across a reset.
DEMO_DASH_ADDR=${DEMO_DASH_ADDR:-127.0.0.1:8484}

# Tego's machine config for the demo and the ledger it names (ledger_root). Setup writes the config once, mode
# 0600, if it is missing. Both stay outside the demo folder: a contract or a stage inside the ledger root is
# not writable by the dashboard's rule edits.
DEMO_CONFIG=${DEMO_CONFIG:-$HOME/tego-demo.yaml}
DEMO_LEDGER=${DEMO_LEDGER:-$HOME/tego-demo-ledger}

# The agent both sides run: codex (signed in with ChatGPT) or claude (Claude Code, signed in with
# CLAUDE_CODE_OAUTH_TOKEN from `claude setup-token`, or ANTHROPIC_API_KEY, exported in the shell that runs left and right).
# Set it for every subcommand: DEMO_AGENT=claude ./demo.sh setup, check, left, right, ...
DEMO_AGENT=${DEMO_AGENT:-codex}

# Where setup copies your Codex login from (the file Codex wrote when you signed in with ChatGPT).
DEMO_CODEX_AUTH=${DEMO_CODEX_AUTH:-$HOME/.codex/auth.json}

# How many old ledgers (<ledger>.old-*) reset keeps of those it moved there; older ones are deleted. A folder of that
# name it did not move (one you made, or a copy of one it moved) is never deleted.
DEMO_KEEP_LEDGERS=${DEMO_KEEP_LEDGERS:-3}

# 1: tego treats a host it cannot resolve (chatgpt.com, api.anthropic.com) as a warning and check skips the DNS
# lookups, for rehearsing the script with no network. The agent itself needs the network: never set it for a real take.
DEMO_OFFLINE=${DEMO_OFFLINE:-0}

# 1: backup keeps the attacker logs it just filled (they are cleared by default so a take starts empty). For tests.
DEMO_BACKUP_KEEP_LOGS=${DEMO_BACKUP_KEEP_LOGS:-0}

# Where the generated state lives (without/, with/, api.log). Empty = this folder (gitignored).
DEMO_STAGE=${DEMO_STAGE:-}

# 1: left and right print their command without your desktop variables (user name, display, session bus) and
# with a short PATH. The command that runs is the same.
DEMO_QUIET=${DEMO_QUIET:-0}
