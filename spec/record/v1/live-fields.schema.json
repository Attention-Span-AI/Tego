              "live_fence"
            ],
            "properties": {
              "live_mode": {
                "const": "adjustable"
              },
              "live_fence": {
                "$ref": "#/$defs/live_fence"
              }
            }
          },
          "minor": {
            "minimum": 26
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "refused"
          },
          "rule": {
            "pattern": "^live\\.(fence|lift)\\["
          }
        },
        "required": [
          "kind",
          "rule"
        ]
      },
      "then": {
        "properties": {
          "minor": {
            "minimum": 26
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "refused"
          },
          "rule": {
            "pattern": "^live\\.block\\[(read|write):"
          }
        },
        "required": [
          "kind",
          "rule"
        ]
      },
      "then": {
        "properties": {
          "minor": {
            "minimum": 24
          }
        }
      }
    }
  ],
  "$defs": {
    "serial": {
      "type": "integer",
      "minimum": 1,
      "description": "The change's serial in the overlay, from 1; an overlay numbers its changes in one sequence."
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "live_block": {
      "type": "object",
      "required": [
        "op",
        "kind",
        "value",
        "rule",
        "by",
        "serial",
        "at"
      ],
      "properties": {
        "op": {
          "enum": [
            "add",
            "remove",
            "expire",
            "lift",
            "restore"
          ]
        },
        "kind": {
          "enum": [
            "exec",
            "net",
            "path",
            "read",
            "write"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "rule": {
          "type": "string",
          "pattern": "^live\\.(block|fence|lift)\\[(exec|net|path|read|write):.+\\]$"
        },
        "by": {
          "type": "string"
        },
        "serial": {
          "$ref": "#/$defs/serial"
        },
        "at": {
          "$ref": "#/$defs/time"
        },
        "until": {
          "$ref": "#/$defs/time"
        },
        "refused": {
          "enum": [
            "mac",
            "outside-fence",
            "locked",
            "until"
          ]
        },
        "addrs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 32
        },
        "addrs_more": {
          "type": "integer",
          "minimum": 0
        },
        "note": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[\\p{L}\\p{M}\\p{N}\\p{P}\\p{S} ]*$",
          "description": "The text the person who lifted the entry gave with the lift: at most 200 bytes (maxLength counts characters, so pkg/spec/record also holds the byte bound) of printable text, no control character, line break, tab or invisible format character. Only on a live-rule-lifted line, from revision 41. It is shown and never interpreted."
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "addrs_more"
            ],
            "properties": {
              "addrs_more": {
                "minimum": 1
              }
            }
          },
          "then": {
            "required": [
              "addrs"
            ],
            "properties": {
              "addrs": {
                "minItems": 32
              }
            }
          }
        }
      ]
    },
    "live_control": {
      "type": "object",
      "required": [
        "op",
        "by",
        "serial",
        "at"
      ],
      "properties": {
        "op": {
          "enum": [
            "pause",
            "resume"
          ]
        },
        "by": {
          "type": "string"
        },
        "serial": {
          "$ref": "#/$defs/serial"
        },
        "at": {
          "$ref": "#/$defs/time"
        }
      }
    },
    "live_fence": {
      "type": "object",
      "required": [
        "sha256",
        "entries"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "entries": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/live_fence_entry"
          }
        }
      }
    },
    "live_fence_entry": {
      "type": "object",
      "required": [
        "kind",
        "value",
        "source",
        "rule"
      ],
      "properties": {
        "kind": {
          "enum": [
            "read",
            "net",
            "exec"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "source": {
          "enum": [
            "deny",
            "new"
          ]
        },
        "rule": {
          "type": "string",
          "pattern": "^live\\.fence\\[(read|net|exec):.+\\]$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/]+$"
        }
      },
      "if": {
        "required": [
          "name"
        ]
      },
      "then": {
        "properties": {
          "kind": {
            "const": "exec"
          },
          "source": {
            "const": "deny"
          }
        }
      }
    }
  }
}
