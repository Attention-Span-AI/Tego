  "$id": "https://tego.dev/spec/receipt/receipt-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What `tego receipt --json` prints and the dashboard's Receipt tab shows: one run's receipt (receipt_v 1). Keys only grow within the version, so a reader ignores a key it does not know; this schema, which is for the writer, refuses one, and a test holds it to pkg/spec/receipt, which holds the same keys and is read by the receipt's builder. A field the ledger cannot support says so (recorded false and a note) and carries no number; coverage lists each field the ledger could not support in full, with a code, a level (partial or none: a field with no gap is complete) and words.",
  "properties": {
    "agent": {
      "type": "string"
    },
    "asks": {
      "$ref": "#/$defs/Asks"
    },
    "baseline": {
      "anyOf": [
        {
          "$ref": "#/$defs/BaselineSummary"
        },
        {
          "type": "null"
        }
      ]
    },
    "binding": {
      "anyOf": [
        {
          "$ref": "#/$defs/Binding"
        },
        {
          "type": "null"
        }
      ]
    },
    "capture": {
      "type": "string"
    },
    "command": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "connection_tries": {
      "type": "integer"
    },
    "connections": {
      "items": {
        "$ref": "#/$defs/Connection"
      },
      "type": "array"
    },
    "connections_more": {
      "type": "integer"
    },
    "connections_note": {
      "type": "string"
    },
    "connections_overflow_attempts": {
      "type": "integer"
    },
    "coverage": {
      "$ref": "#/$defs/Coverage"
    },
    "cwd": {
      "type": "string"
    },
    "datagram_sends": {
      "type": "integer"
    },
    "end_reason": {
      "type": "string"
    },
    "ended": {
      "type": "boolean"
    },
    "escalated": {
      "type": "boolean"
    },
    "execs_decision_lost": {
      "type": "integer"
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "files": {
      "$ref": "#/$defs/Files"
    },
    "finished": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "lines": {
      "type": "integer"
    },
    "local_approval_authority": {
      "anyOf": [
