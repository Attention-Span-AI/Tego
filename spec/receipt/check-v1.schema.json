{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tego.dev/spec/receipt/check-v1.schema.json",
  "title": "Receipt comparison result",
  "type": "object",
  "required": ["check_v", "binding_v", "result", "run", "lines", "head", "ended", "coverage_complete", "complete", "checks", "limits", "not_shown", "checked_by", "not_compared"],
  "properties": {
    "check_v": {"const": 1},
    "binding_v": {"type": "integer", "minimum": 0},
    "result": {"enum": ["match", "match-unended", "mismatch", "cannot-check", "incomplete"]},
    "run": {"type": "string"},
    "lines": {"type": "integer", "minimum": 0},
    "head": {"type": "string"},
    "ended": {"type": "boolean"},
    "coverage_complete": {"type": "boolean"},
    "complete": {"type": "boolean"},
    "checks": {"type": "array", "items": {"type": "object", "required": ["name", "result"], "properties": {"name": {"type": "string"}, "result": {"enum": ["pass", "fail", "not-checked"]}, "why": {"type": "string"}}, "additionalProperties": false}},
    "limits": {"type": "array", "items": {"type": "object", "required": ["code", "why"], "properties": {"code": {"type": "string"}, "why": {"type": "string"}}, "additionalProperties": false}},
    "not_shown": {"type": "array", "items": {"type": "string"}},
    "receipt_by": {"$ref": "#/$defs/made_by"},
    "checked_by": {"$ref": "#/$defs/made_by"},
    "not_compared": {"type": ["array", "null"], "items": {"type": "string"}}
  },
  "additionalProperties": false,
  "$defs": {"made_by": {"type": "object", "required": ["tego_version", "commit"], "properties": {"tego_version": {"type": "string"}, "commit": {"type": "string"}}, "additionalProperties": false}},
  "allOf": [{"if": {"properties": {"complete": {"const": true}}}, "then": {"properties": {"result": {"const": "match"}, "ended": {"const": true}, "coverage_complete": {"const": true}}}}]
}
