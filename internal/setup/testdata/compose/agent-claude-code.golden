# Generated by tego init --preset no-secrets,no-prod,repo-only-writes.
# Edit freely: `tego compile agent.yaml` shows what will be enforced, and `tego compile --merged agent.yaml`
# prints the one rule file with every preset laid in (docs/user/presets.md).
#
# What the presets promise:
#   tego/no-secrets@1: the agent cannot read your secret files, and your secret variables never reach it.
#   tego/no-prod@1: the agent reaches no network host except the ones your contract names.
#   tego/repo-only-writes@1: the agent writes only in the folders your contract names.
#
# Always on, preset or not: the host's local daemon sockets (docker, the D-Bus bus, ssh-agent) are refused,
# since host_sockets is not set (ADR 0070), and the agent cannot gain privilege: no_new_privs is set on every
# run and setuid binaries do not raise it.

version: 0
name: "demo"

# The presets this contract builds on, in a fixed order. Their lists and this file's add up; pin one to the
# revision you reviewed with tego/<preset>@<n> to keep later releases from changing it.
extends: [tego/no-secrets, tego/no-prod, tego/repo-only-writes]

# The program tego starts (--command).
command: ["claude", "-p", "--permission-mode", "acceptEdits", "--", "Explain 'a'; $(touch nope)\nand stop"]

# Where the agent may write; a folder covers everything beneath it. repo-only-writes refuses every
# write outside these entries.
fs:
  write:
    - "./src/"            # --write
    - "./.tego/tmp/"      # TMPDIR: the agent's temporary files stay in the project
    - "./.tego/claude/"   # Claude Code's own folder: its login, settings and sessions
    - "/dev/null"         # its Bash tool redirects into it
    - "/dev/tty"          # the full-screen interface draws there

# No direct hosts were granted. The model below is reached through the capture forwarder.

env:
  # Variables the agent gets from the shell that starts it, on top of the presets' list.
  pass:
    - "CLAUDE_CODE_OAUTH_TOKEN"   # Claude Code's login (claude setup-token)
    - "ANTHROPIC_API_KEY"         # or an API key
  # Variables tego sets for the agent, so its temporary files and caches land in folders it may write.
  set:
    # TMPDIR inside the writable ./.tego/tmp/
    TMPDIR: "${TEGO_PROJECT_DIR}/.tego/tmp"
    # Claude Code's own folder: its login, settings and sessions
    CLAUDE_CONFIG_DIR: "${TEGO_PROJECT_DIR}/.tego/claude"
    # private per-run session sockets; launch checks Claude's 103-byte path budget
    XDG_RUNTIME_DIR: "%R"
    # no self-update inside the run
    DISABLE_AUTOUPDATER: "1"
    # no optional network calls
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC: "1"

harness: claude-code
capture: forwarder
record: full
models:
  - {provider: anthropic, host: api.anthropic.com, port: 443}
