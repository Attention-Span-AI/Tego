; SPDX-License-Identifier: Apache-2.0
; Disposable guest policy: ordinary file creation succeeds; fscreate=restricted_t
; cannot create a regular file. Everything outside these three classes is allowed
; as unknown so this small fixture is independent of the guest kernel's classes.
(handleunknown allow)
(class file (read write open create getattr))
(class process (getattr setfscreate transition dyntransition))
(class filesystem (associate))
(classorder (file process filesystem))
(sid kernel)
(sid security)
(sid unlabeled)
(sidorder (kernel security unlabeled))
(type base_t)
(type restricted_t)
(role base_r)
(role object_r)
(roletype base_r base_t)
(roletype object_r base_t)
(roletype object_r restricted_t)
(user user_u)
(userrole user_u base_r)
(userrole user_u object_r)
(sensitivity s0)
(sensitivityorder (s0))
(level low (s0))
(userlevel user_u low)
(userrange user_u (low low))
(context process_context (user_u base_r base_t (low low)))
(context object_context (user_u object_r base_t (low low)))
(sidcontext kernel process_context)
(sidcontext security process_context)
(sidcontext unlabeled object_context)
(allow base_t base_t (file (read write open create getattr)))
(allow base_t base_t (process (getattr setfscreate transition dyntransition)))
(allow base_t base_t (filesystem (associate)))
(allow base_t restricted_t (file (read write open getattr)))
(allow restricted_t base_t (filesystem (associate)))
(fsuse trans tmpfs object_context)
(fsuse trans devtmpfs object_context)
(genfscon proc / object_context)
(genfscon sysfs / object_context)
(genfscon selinuxfs / object_context)
(genfscon cgroup2 / object_context)
