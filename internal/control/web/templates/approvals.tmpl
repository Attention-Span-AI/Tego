{{define "content"}}<link rel="stylesheet" href="/static/approvals.css">{{with .Data}}
<div class="head"><div>{{if $.Tour}}<h2>{{else}}<h1>{{end}}{{if .Detail}}Your decision{{else if .Pending}}{{template "quantity" (quantity "approvals.waiting" (len .Pending) $.Numbers)}} {{plural (len .Pending) "request" "requests"}} waiting{{else}}Who needs your answer?{{end}}{{if $.Tour}}</h2>{{else}}</h1>{{end}}{{if .Pending}}<p data-number-title="shared.policy" class="lede" title="Agents such as Codex give up after about 30 s" data-number-exclude="approvals.explicit-1">Answer fast</p>{{end}}</div></div>
<p data-number="approvals.waiting" class="soft desktop-only">{{.Waiting.Sentence}}</p>{{if and (eq .Tab "history") .AttentionSource.PendingReason}}<p class="soft phone-only" data-number="approvals.waiting">{{.Waiting.PhoneSentence}}</p>{{end}}
{{if not .Detail}}<nav class="tabs ap-tabs" aria-label="Approvals"><a href="/approvals"{{if ne .Tab "history"}} aria-current="page"{{end}}>Waiting {{with .Waiting}}<span class="n" data-number="approvals.waiting" title="{{.Sentence}}" aria-label="{{.Sentence}}" data-number-title="approvals.waiting" data-number-aria-label="approvals.waiting">{{.Short}}</span>{{end}}</a><a href="/approvals?tab=history"{{if eq .Tab "history"}} aria-current="page"{{end}}>History <span class="n">{{template "quantity" (quantity "approvals.history" .Answers $.Numbers)}}</span></a></nav>{{end}}
{{if eq .Tab "history"}}{{template "ap-history" (withNumbers . $.Numbers)}}{{else}}
{{if .Answered}}<section class="panel ap-answer" role="status"><div class="panel-body"><h2>Request answered</h2><p data-number-exclude="approvals.answered-outcome">{{.Answered.Word}}</p><p data-number-exclude="approvals.answered-agent">{{.Answered.Agent}} asked to {{askVerb .Answered.Op .Answered.Rule ""}}</p><p class="ut ut-box" data-number-exclude="approvals.answered-target">{{.Answered.Target}}</p><div class="ap-recovery-actions"><a class="btn" href="/runs/{{pathEsc .Answered.Run}}/lines/{{.Answered.Seq}}">Answer details</a><a class="btn desktop-only" href="/approvals">Next waiting request</a><details class="phone-only ap-recovery"><summary>More</summary><a class="btn" href="/approvals">Next waiting request</a></details></div></div></section>{{else if .Missing}}<section class="panel panel-body"><h2>{{if .AttentionSource.PendingReason}}This request is not in the retained list{{else}}This request is not waiting{{end}}</h2><p class="desktop-only" data-number="approvals.attention">{{if .AttentionSource.PendingReason}}Waiting requests are not fully known: {{.AttentionSource.PendingReason}}. {{end}}Check its recorded answer in History.</p><p class="phone-only">Check its recorded answer in History.</p><a class="btn" href="/approvals?tab=history">Answer history</a></section>{{end}}
{{if and .Selected (not .Detail)}}{{$a := .Selected}}{{$r := request $a (index $.AskMeta $a.Run)}}<section class="banner banner-ask ab-line ap-compact" id="ask-banner" role="region" data-approval-hold aria-label="Oldest waiting request"><div class="grow ab-row" data-k="{{$a.Run}}-{{$a.AskID}}">{{template "compact-request-sentence" $r}}{{if $r.Quick}}<form class="ab-act{{$r.QuickClass}}" method="post" action="/approvals/answer"><input type="hidden" name="csrf" value="{{$.CSRF}}"><input type="hidden" name="run" value="{{$a.Run}}"><input type="hidden" name="ask" value="{{$a.AskID}}"><button class="btn ask-btn" type="submit" name="decision" value="approve"><span data-number="shared.policy">Allow once</span></button><button class="btn ask-btn" type="submit" name="decision" value="deny">Deny</button><a class="btn btn-ghost" href="{{approvalURL $a.Run $a.AskID}}" aria-label="Details: {{$a.Agent}} wants to {{askVerb $a.Op $a.Rule $a.Hold}} {{$a.Target}}, {{quantityText "approvals.waiting" (len .Pending) $.Numbers}} waiting" data-number-aria-label="approvals.waiting">Details<span class="ab-count"> ({{template "quantity" (quantity "approvals.waiting" (len .Pending) $.Numbers)}})</span></a></form>{{end}}{{template "ask-review" $r}}</div></section>{{end}}
{{if .Selected}}<div class="ap-detail{{if not .Detail}} ap-default{{end}}" data-approval-hold>{{template "ap-card" (card .Selected $.CSRF true (index $.AskMeta .Selected.Run) .Now)}}</div>{{end}}
{{if .Detail}}<p class="ap-detail-count">{{template "quantity" (quantity "approvals.waiting" (len .Pending) $.Numbers)}} waiting · <a class="link" href="/approvals">All requests</a> <a class="link" href="/approvals?tab=history">Answer history</a></p>{{end}}
{{if and .Pending .AttentionSource.PendingReason}}{{$attention := .Attention}}<section class="panel panel-body" aria-label="Incomplete request list"><h2 class="desktop-only" data-number="approvals.attention">{{$attention.Headline}}</h2><p class="phone-only" data-number="approvals.attention">{{.Waiting.PhoneSentence}}</p>{{range $attention.Items}}<p class="desktop-only" data-number="approvals.attention" data-attention="{{.Kind}}">{{.Body}} <a class="link" href="{{.URL}}">{{.Link}}</a></p>{{end}}</section>{{end}}
{{if .Pending}}<section class="panel approval-queue" aria-labelledby="ap-queue-h"><div class="panel-head"><h2 id="ap-queue-h" data-say>{{template "quantity" (quantity "approvals.waiting" (len .Pending) $.Numbers)}} waiting · oldest first</h2></div><div class="phone-list">{{range .Pending}}{{$r := request . (index $.AskMeta .Run)}}<a class="phone-row" href="{{approvalURL .Run .AskID}}#{{.AskID}}"><span class="phone-who" data-number-exclude="approvals.identity-5">{{if $r.Phone.Long}}<span class="sr" data-number-exclude="approvals.queue-full">{{$r.Full}}</span><span class="phone-only" aria-hidden="true" data-number-exclude="approvals.queue-phone">{{$r.Phone.Agent}} wants to {{askVerb .Op .Rule .Hold}} <span class="ap-request-target">{{range requestParts $r.Phone.Target}}{{.}}<wbr>{{end}}</span></span><span class="desktop-only" aria-hidden="true" data-number-exclude="approvals.queue-wide">{{$r.Wide.Agent}} wants to {{askVerb .Op .Rule .Hold}} <span class="ap-request-target">{{range requestParts (or (and $r.Wide.Long $r.Wide.Target) .Target)}}{{.}}<wbr>{{end}}</span></span>{{else}}{{if .Agent}}{{.Agent}}{{else}}An agent{{end}} wants to {{askVerb .Op .Rule .Hold}} <span class="ap-request-target" data-number-exclude="approvals.queue-target">{{range requestParts $r.Phone.Target}}{{.}}<wbr>{{end}}</span>{{end}}</span><span class="b b-waiting">{{template "i" "i-hand"}}Waiting</span><time class="phone-when" datetime="{{iso .TS}}" data-started="{{iso .TS}}" data-number-exclude="approvals.clock-1" data-ck>{{rowAgo .TS $.Data.Now}}</time></a>{{end}}</div></section>{{else}}
<section class="panel"><div class="empty">
  <div class="glyph">{{template "i" "i-inbox"}}</div>
  {{ $attention := .Attention }}{{if $attention.Items}}<h3 class="desktop-only" data-number="approvals.attention">{{$attention.Headline}}</h3><p class="phone-only" data-number="approvals.attention">{{.Waiting.PhoneSentence}}</p>{{range $attention.Items}}<p class="desktop-only" data-number="approvals.attention" data-attention="{{.Kind}}">{{.Body}} <a class="link" href="{{.URL}}">{{.Link}}</a></p>{{end}}{{else}}<h3>{{template "quantity" (quantityZero "approvals.waiting" "Nothing waiting" $.Numbers)}}</h3>
  <p>A contract can ask you before a file change or a connection; those requests wait here for your answer.</p>{{end}}
</div></section>
{{end}}
{{if .Recent}}<section class="panel" aria-labelledby="h-recent-ans"><div class="panel-head"><h2 id="h-recent-ans">Answered recently</h2><span class="soft">Newest first, from every run</span></div>
<ul class="list ans-list">{{range .Recent}}<li>{{template "ap-answer-row" (answerSummary . $.Data.Now)}}<div class="ap-answer-facts">{{if and .Approved .Managed}}<span class="b b-neutral">Approval recorded</span>{{else if .Approved}}<span class="b b-allowed">{{template "i" "i-check"}}Allowed</span>{{else if .Withdrawn}}<span class="b b-neutral" title="Withdrawn: a live block now refuses this">{{template "i" "i-ban"}}Withdrawn</span>{{else if .TimedOut}}<span class="b b-neutral" title="Nobody answered in time, so Tego refused it">Timed out</span>{{else}}<span class="b b-refused">{{template "i" "i-ban"}}Denied</span>{{end}}<div class="grow"><span class="title"><b data-number-exclude="approvals.agent-field-2">{{if .Agent}}{{.Agent}}{{else}}An agent{{end}}</b> asked to <span class="op"{{with .Op}} title="{{.}}"{{end}} data-number-exclude="approvals.identity-6">{{askVerb .Op .Rule ""}}</span> <span class="ans-tgt">{{template "sptv" (sptIn (mask .Target) (index $.Data.Homes .Run) (index $.Data.Cwds .Run) 60)}}</span></span><span class="meta" data-number-exclude="approvals.detail-2">{{.Word}} · <time datetime="{{iso .TS}}" title="{{stamp .TS}}" data-number-exclude="approvals.clock-2">{{clock .TS}} {{tz}}</time> · <a class="link" href="/runs/{{pathEsc .Run}}" data-number-exclude="approvals.identity-8">run {{rid .Run}}</a></span></div></div></li>{{end}}</ul></section>{{end}}
{{if .Lost}}<section class="panel" aria-labelledby="h-lost"><div class="panel-head"><h2 id="h-lost">{{template "quantity" (quantityZero "approvals.history" "Never answered" $.Numbers)}}</h2><span class="soft">Run lost</span></div>
<ul class="list ans-list">{{range .Lost}}<li><a class="phone-row ap-phone-answer" href="/runs/{{pathEsc .Run}}/lines/{{.Seq}}"><span class="phone-who" data-number-exclude="approvals.lost-agent">{{.Agent}} asked to {{askVerb .Op .Rule .Hold}}</span><span class="b b-neutral">Not answered</span><time class="phone-when" datetime="{{iso .TS}}" data-started="{{iso .TS}}" data-number-exclude="approvals.lost-phone-clock" data-ck>{{rowAgo .TS $.Data.Now}}</time></a><div class="ap-answer-facts"><span class="b b-neutral">Not answered</span><div class="grow"><span class="title"><b data-number-exclude="approvals.lost-agent-detail">{{if .Agent}}{{.Agent}}{{else}}An agent{{end}}</b> asked to <span class="op"{{with .Op}} title="{{.}}"{{end}}>{{askVerb .Op .Rule .Hold}}</span> <span class="ans-tgt">{{template "sptv" (sptIn (mask .Target) (index $.Data.Homes .Run) (index $.Data.Cwds .Run) 60)}}</span></span><span class="meta">asked at <time datetime="{{iso .TS}}" title="{{stamp .TS}}" data-number-exclude="approvals.lost-clock">{{clock .TS}} {{tz}}</time> · <a class="link" href="/runs/{{pathEsc .Run}}">run {{rid .Run}}</a> (lost)</span></div></div></li>{{end}}</ul></section>{{end}}
{{end}}
{{end}}{{end}}
{{/* ap-history is Approvals' History tab: every answer, by run (answerSession), newest run first. */}}
{{define "ap-history"}}{{$numbers := numbersOf .}}{{$ := numberValue .}}{{with $}}{{if .Sessions}}{{range .Sessions}}{{$ses := .}}<section class="panel" aria-label="{{if .Agent}}{{.Agent}}{{else}}Run{{end}} {{rid .Run}}" data-number-exclude-aria-label="approvals.identity-1"><div class="panel-head"><h2><a class="link" href="/runs/{{pathEsc .Run}}" data-number-exclude="approvals.agent-field-5">{{if .Agent}}{{.Agent}}{{else}}Run{{end}}</a>{{with .Project}} <span class="soft">· {{.}}</span>{{end}}</h2><span class="soft">{{if not .Start.IsZero}}<time datetime="{{iso .Start}}" title="{{stamp .Start}}" data-number-exclude="approvals.clock-5">{{stamp .Start}}</time> · {{end}}<span title="Allowed">{{template "quantity" (quantity "approvals.session-allowed" .Allowed $numbers)}} {{if .Managed}}approvals recorded{{else}}allowed{{end}}</span> · <span title="Denied, timed out or withdrawn">{{template "quantity" (quantity "approvals.session-denied" .Denied $numbers)}} denied</span></span></div>
<ul class="list ans-list">{{range .Answers}}<li>{{template "ap-answer-row" (answerSummary . $.Now)}}<div class="ap-answer-facts">{{if and .Approved .Managed}}<span class="b b-neutral">Approval recorded</span>{{else if .Approved}}<span class="b b-allowed">{{template "i" "i-check"}}Allowed</span>{{else if .Withdrawn}}<span class="b b-neutral" title="A live block now refuses this">{{template "i" "i-ban"}}Withdrawn</span>{{else if .TimedOut}}<span class="b b-neutral" title="Nobody answered in time">Timed out</span>{{else}}<span class="b b-refused">{{template "i" "i-ban"}}Denied</span>{{end}}<div class="grow"><span class="title"><span class="op"{{with .Op}} title="{{.}}"{{end}} data-number-exclude="approvals.identity-13">{{askVerb .Op .Rule ""}}</span> <span class="ans-tgt">{{template "sptv" (sptIn (mask .Target) (index $.Homes .Run) (index $.Cwds .Run) 60)}}</span></span><span class="meta" data-number-exclude="approvals.detail-1">{{.Word}} · <time datetime="{{iso .TS}}" title="{{stamp .TS}}" data-number-exclude="approvals.clock-6">{{clock .TS}}</time></span></div></div></li>{{end}}</ul></section>{{end}}
{{else}}<section class="panel"><div class="empty"><div class="glyph">{{template "i" "i-inbox"}}</div><h3 data-number="approvals.history">{{if $unknown := unknownCount $numbers.History "Answer history"}}{{$unknown}}{{else}}{{template "quantity" (quantityZero "approvals.history" "No answers yet" $numbers)}}{{end}}</h3></div></section>{{end}}{{end}}{{end}}

{{define "ap-card"}}{{$a := .V}}<section class="ask" id="{{$a.AskID}}" aria-labelledby="q-{{$a.AskID}}">
<div class="ask-bar"><span class="who">{{template "i" "i-hand"}}Waiting for your answer</span></div>
<div class="ap-card-body"><h2 class="ask-q" id="q-{{$a.AskID}}">Let <span data-number-exclude="approvals.request-agent">{{if $a.Agent}}{{$a.Agent}}{{else}}the agent{{end}}</span> <span{{with $a.Op}} title="{{.}}"{{end}} data-number-exclude="approvals.identity-15">{{askVerb $a.Op $a.Rule $a.Hold}}</span> {{askObject $a.Op $a.Rule $a.Hold}}?</h2>
<div class="ap-target"><span class="soft">Exact target</span><p class="ut ut-box" tabindex="0" data-number-exclude="approvals.identity-16">{{if $a.Target}}{{$a.Target}}{{else}}No target was named; held {{$a.Hold}}{{end}}</p></div>
<div class="ap-why"><span class="soft">Why it asked</span><p data-number-exclude="approvals.identity-17">{{askWhy $a.Rule}}</p></div>
<p class="ap-wait"><time class="ask-ago" datetime="{{iso $a.TS}}" data-ago="{{iso $a.TS}}" data-number-exclude="approvals.clock-7" data-ck>asked {{ago $a.TS .Now}} ago</time> · {{template "waitnote" .Wait}}. Tego refuses this action when its time runs out.</p>
<p class="ap-effect"><span data-number="shared.policy">Allow once lets this request through. Deny refuses this request.</span></p>
{{template "askform" (askForm $a .CSRF)}}
<details class="ap-record"><summary>Request details</summary><dl class="kv"><dt>Run</dt><dd><a class="link" href="/runs/{{pathEsc $a.Run}}" data-number-exclude="approvals.identity-18">{{$a.Agent}} · {{$a.Run}}</a></dd><dt>Asked</dt><dd><time datetime="{{iso $a.TS}}" data-number-exclude="approvals.clock-8">{{stamp $a.TS}}</time></dd><dt>Display path</dt><dd><p class="ask-path">{{template "sptv" (sptIn $a.Target .Home .Cwd 72)}}</p></dd><dt>Rule</dt><dd data-number-exclude="approvals.identity-20">{{$a.Rule}}</dd><dt>Request</dt><dd><span class="mono" title="The id the terminal and the record show for this request" data-number-exclude="approvals.ask-id">{{$a.AskID}}</span> <span class="soft" data-number-exclude="approvals.fact-1">· line #{{$a.Seq}}</span></dd></dl></details>
</div></section>{{end}}
{{define "ap-answer-row"}}<a class="phone-row ap-phone-answer" href="/runs/{{pathEsc .Run}}/lines/{{.Seq}}"><span class="phone-who" data-number-exclude="approvals.agent-field-6">{{if .Agent}}{{.Agent}}{{else}}An agent{{end}}</span>{{if and .Approved .Managed}}<span class="b b-neutral">Approval recorded</span>{{else if .Approved}}<span class="b b-allowed">{{template "i" "i-check"}}Allowed</span>{{else if .Withdrawn}}<span class="b b-neutral">Withdrawn</span>{{else if .TimedOut}}<span class="b b-neutral">Timed out</span>{{else}}<span class="b b-refused">{{template "i" "i-ban"}}Denied</span>{{end}}<time class="phone-when" datetime="{{iso .TS}}" data-started="{{iso .TS}}" data-number-exclude="approvals.clock-9" data-ck>{{rowAgo .TS .Now}}</time></a>{{end}}
