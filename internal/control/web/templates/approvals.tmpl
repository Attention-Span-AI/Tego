{{define "content"}}{{with .Data}}
<div class="head"><div><h1>{{if .Pending}}{{len .Pending}} {{plural (len .Pending) "approval" "approvals"}} waiting{{else}}Approvals{{end}}</h1>{{if .Pending}}<p class="lede" title="Agents such as Codex give up after about 30 s">Answer fast</p>{{end}}</div></div>
<nav class="tabs ap-tabs" aria-label="Approvals"><a href="/approvals"{{if ne .Tab "history"}} aria-current="page"{{end}}>Waiting <span class="n">{{len .Pending}}</span></a><a href="/approvals?tab=history"{{if eq .Tab "history"}} aria-current="page"{{end}}>History <span class="n">{{.Answers}}</span></a></nav>
{{if eq .Tab "history"}}{{template "ap-history" .}}{{else}}
{{if .Pending}}<div class="stack-lg">{{range .Pending}}
{{template "askcard" (card . $.CSRF true (index $.AskMeta .Run) $.Data.Now)}}{{end}}</div>
{{else}}
<section class="panel"><div class="empty">
  <div class="glyph">{{template "i" "i-inbox"}}</div>
  <h3>Nothing waiting</h3>
  <p>Ask-first rules show up here.</p>
</div></section>
{{end}}
{{if .Recent}}<section class="panel" aria-labelledby="h-recent-ans"><div class="panel-head"><h2 id="h-recent-ans">Answered recently</h2><span class="soft">Newest first, from every run</span></div>
<ul class="list ans-list">{{range .Recent}}<li>{{if .Approved}}<span class="b b-allowed">{{template "i" "i-check"}}Allowed</span>{{else if .Withdrawn}}<span class="b b-neutral" title="Withdrawn: a live block now refuses this">{{template "i" "i-ban"}}Withdrawn</span>{{else if .TimedOut}}<span class="b b-neutral" title="Nobody answered in time, so Tego refused it">Timed out</span>{{else}}<span class="b b-refused">{{template "i" "i-ban"}}Denied</span>{{end}}<div class="grow"><span class="title"><b>{{if .Agent}}{{.Agent}}{{else}}An agent{{end}}</b> asked to <span class="op">{{askVerb .Op .Rule ""}}</span> <span class="ans-tgt">{{template "sptv" (sptIn (mask .Target) (index $.Data.Homes .Run) (index $.Data.Cwds .Run) 60)}}</span></span><span class="meta">{{.Word}} · <time datetime="{{iso .TS}}" title="{{stamp .TS}}">{{clock .TS}} {{tz}}</time> · <a class="link" href="/runs/{{pathEsc .Run}}">run {{rid .Run}}</a></span></div></li>{{end}}</ul></section>{{end}}
{{if .Lost}}<section class="panel" aria-labelledby="h-lost"><div class="panel-head"><h2 id="h-lost">Never answered</h2><span class="soft">Run lost</span></div>
<ul class="list ans-list">{{range .Lost}}<li><span class="b b-neutral">Not answered</span><div class="grow"><span class="title"><b>{{if .Agent}}{{.Agent}}{{else}}An agent{{end}}</b> asked to <span class="op">{{askVerb .Op .Rule .Hold}}</span> <span class="ans-tgt">{{template "sptv" (sptIn (mask .Target) (index $.Data.Homes .Run) (index $.Data.Cwds .Run) 60)}}</span></span><span class="meta">asked at <time datetime="{{iso .TS}}" title="{{stamp .TS}}">{{clock .TS}} {{tz}}</time> · <a class="link" href="/runs/{{pathEsc .Run}}">run {{rid .Run}}</a> (lost)</span></div></li>{{end}}</ul></section>{{end}}
{{end}}
{{end}}{{end}}
{{/* ap-history is Approvals' History tab: every answer, by run (answerSession), newest run first. */}}
{{define "ap-history"}}{{if .Sessions}}{{range .Sessions}}{{$ses := .}}<section class="panel" aria-label="{{if .Agent}}{{.Agent}}{{else}}Run{{end}} {{rid .Run}}"><div class="panel-head"><h2><a class="link" href="/runs/{{pathEsc .Run}}">{{if .Agent}}{{.Agent}}{{else}}Run{{end}}</a>{{with .Project}} <span class="soft">· {{.}}</span>{{end}}</h2><span class="soft">{{if not .Start.IsZero}}<time datetime="{{iso .Start}}" title="{{stamp .Start}}">{{stamp .Start}}</time> · {{end}}<span title="Allowed">{{.Allowed}} allowed</span> · <span title="Denied, timed out or withdrawn">{{.Denied}} denied</span></span></div>
<ul class="list ans-list">{{range .Answers}}<li>{{if .Approved}}<span class="b b-allowed">{{template "i" "i-check"}}Allowed</span>{{else if .Withdrawn}}<span class="b b-neutral" title="A live block now refuses this">{{template "i" "i-ban"}}Withdrawn</span>{{else if .TimedOut}}<span class="b b-neutral" title="Nobody answered in time">Timed out</span>{{else}}<span class="b b-refused">{{template "i" "i-ban"}}Denied</span>{{end}}<div class="grow"><span class="title"><span class="op">{{askVerb .Op .Rule ""}}</span> <span class="ans-tgt">{{template "sptv" (sptIn (mask .Target) (index $.Homes .Run) (index $.Cwds .Run) 60)}}</span></span><span class="meta">{{.Word}} · <time datetime="{{iso .TS}}" title="{{stamp .TS}}">{{clock .TS}}</time></span></div></li>{{end}}</ul></section>{{end}}
{{else}}<section class="panel"><div class="empty"><div class="glyph">{{template "i" "i-inbox"}}</div><h3>No answers yet</h3></div></section>{{end}}{{end}}
