{{/* rules-new: "New rules file" (rules_new.go): the form, its preview, and the contract written. Labels, not sentences. */}}
{{define "newhidden"}}<input type="hidden" name="draft" value="{{.Draft}}"><input type="hidden" name="to" value="{{.To}}"><input type="hidden" name="builder" value="1"><input type="hidden" name="step" value="save"><input type="hidden" name="view" value="{{.View}}"><textarea name="text" hidden data-number-exclude="editor.draft-yaml">{{template "buildertextarea" .Text}}</textarea><input type="hidden" name="mode" value="{{.Mode}}"><input type="hidden" name="dir" value="{{.Form.Dir}}"><input type="hidden" name="name" value="{{.Form.Name}}">{{if eq .Mode "run"}}<input type="hidden" name="from" value="{{.Form.FromRun}}">{{if .Reads}}<input type="hidden" name="reads" value="on">{{end}}{{else}}{{range .Presets}}{{if .On}}<input type="hidden" name="preset" value="{{.Name}}">{{end}}{{end}}<input type="hidden" name="writes" value="{{.Writes}}"><input type="hidden" name="hosts" value="{{.Hosts}}"><input type="hidden" name="pass" value="{{.Pass}}"><input type="hidden" name="askread" value="{{.AskRead}}">{{if .Reads}}<input type="hidden" name="reads" value="on">{{end}}{{end}}<input type="hidden" name="cmd" value="{{.Form.Command}}"><input type="hidden" name="live" value="{{.LiveMode}}">{{if eq .LiveMode "adjustable"}}<input type="hidden" name="fence_read" value="{{.FenceRead}}"><input type="hidden" name="fence_net" value="{{.FenceNet}}"><input type="hidden" name="fence_exec" value="{{.FenceExec}}">{{end}}{{end}}
{{/* readsswitch is "Show refused reads (slower)": its name is the strong text alone and its cost the description, so a screen reader says each once. */}}
{{define "readsswitch"}}<label class="nw-preset nw-reads"><input type="checkbox" aria-labelledby="nw-reads-name" name="reads" value="on" aria-describedby="nw-reads-cost"{{if .Reads}} checked{{end}}><span><strong id="nw-reads-name">Show refused reads (slower)</strong><span class="soft" id="nw-reads-cost" data-number-exclude="editor.reads-cost"><span data-number="shared.policy">Each read the contract refuses gets a line in the record, at Basic protection too. Every file open is slower: </span>{{.ReadsCost}}.</span></span></label>{{end}}
{{define "newrules"}}{{range .}}<section class="panel rules-g" aria-labelledby="ng-{{.ID}}"><div class="panel-head"><h3 id="ng-{{.ID}}">{{template "i" .Icon}}{{.Title}} <span class="soft">{{.Lede}}</span></h3></div>
{{if .Rows}}<ul class="nw-rules">{{range .Rows}}<li>{{template "effect" .Effect}}<span>{{.Sentence}}{{with .Note}}<span class="soft nw-note">{{template "i" "i-triangle-alert"}}{{.}}</span>{{end}}</span></li>{{end}}</ul>{{end}}
{{if .More}}<details class="nw-more"><summary>and {{len .More}} more</summary><ul class="nw-rules">{{range .More}}<li>{{template "effect" .Effect}}<span>{{.Sentence}}{{with .Note}}<span class="soft nw-note">{{template "i" "i-triangle-alert"}}{{.}}</span>{{end}}</span></li>{{end}}</ul></details>{{end}}
{{with .Default}}<div class="panel-foot rules-default"><span>{{.}}</span></div>{{end}}</section>{{end}}{{end}}
{{define "effect"}}{{if eq . "allow"}}<span class="b b-allowed">{{template "i" "i-check"}}Allowed</span>{{else if eq . "ask"}}<span class="b b-asked">{{template "i" "i-hand"}}Ask first</span>{{else if eq . "deny"}}<span class="b b-refused">{{template "i" "i-ban"}}Refused</span>{{else if eq . "limit"}}<span class="b b-neutral">{{template "i" "i-square"}}Limit</span>{{else}}<span class="b b-neutral">{{template "i" "i-eye"}}Note</span>{{end}}{{end}}
{{define "content"}}<link rel="stylesheet" href="/static/rules.css"><link rel="stylesheet" href="/static/builder.css"><script src="/static/builder.js" defer></script><script src="/static/lines.js" defer></script><div class="builder-page">{{$csrf := $.CSRF}}{{with .Data}}{{$d := .}}
{{if .Created}}
<div class="head"><div>{{if $.Tour}}<h2>{{else}}<h1>{{end}}{{.Created.Name}} · {{if .Created.Registry}}contract saved{{else}}contract written{{end}}{{if $.Tour}}</h2>{{else}}</h1>{{end}}<p class="lede">{{template "spv" (sp .Created.Path "")}}</p></div></div>
{{with .Err}}<section class="banner banner-danger" role="alert">{{.}}</section>{{end}}
<section class="panel"><div class="panel-body stack"><h2>Next: start the agent</h2><details><summary>Rules file details</summary><p>{{template "pwp" (pieces .Created.Path)}}</p></details><div class="cli"><code>{{cmd .Start}}</code></div><a class="btn" href="/rules">Rules files</a><a class="btn" href="/detections">Then watch Detections</a>{{if .Ref}}<a class="btn" href="/rules?c={{queryEsc .Ref}}">Open this rules file</a>{{end}}
{{with .Created.Made}}<p>Folders made: {{join . ", "}}</p>{{end}}{{with .Created.Ignore}}<p>Add to .gitignore: {{join . ", "}}</p>{{end}}</div></section>
{{else}}
<div class="head"><div>{{if $.Tour}}<h2>{{else}}<h1>{{end}}What may it do?{{if $.Tour}}</h2>{{else}}</h1>{{end}}<p class="lede" data-number="editor.new-written">New rules file. Preview first. No contract written yet.</p>{{if and .Plan .Plan.Text}}<a class="btn btn-primary" href="#builder-save">Review and save</a>{{end}}</div></div>
{{if .Off}}<section class="panel"><div class="empty"><h2>Not available here</h2><div class="cli"><code>tego rules create --preset no-secrets,no-prod</code></div></div></section>
{{else}}
<nav class="chips nw-mode" aria-label="Start from"><a class="chip" href="/rules/new{{if $.Tour}}?guide=review{{end}}"{{if eq .Mode "presets"}} aria-current="true"{{end}}>From presets</a><a class="chip" href="/rules/new?mode=run{{if $.Tour}}&amp;guide=review{{end}}"{{if eq .Mode "run"}} aria-current="true"{{end}}>From a run</a><a class="chip" href="/rules/new?mode=blank{{if $.Tour}}&amp;guide=review{{end}}"{{if eq .Mode "blank"}} aria-current="true"{{end}} data-number-exclude="rules-new.from-nothing">From nothing</a></nav>
<details class="panel builder-source"{{if or (not .Plan) (builderHasError .Errors "builder-dir") (builderHasError .Errors "builder-name") (builderHasError .Errors "builder-source") (builderHasError .Errors "builder-run") (builderHasError .Errors "builder-presets") (builderHasError .Errors "builder-hosts") (builderHasError .Errors "builder-writes") (builderHasError .Errors "builder-pass") (builderHasError .Errors "builder-command") (builderHasError .Errors "builder-askread")}} open{{end}}><summary class="panel-head">Name and source{{with .Plan}}{{with .Name}}: {{.}}{{end}}{{end}}</summary>
<form class="nw-form" action="/rules/new{{if $.Tour}}?guide=review&amp;preview=1{{end}}" method="post" aria-label="The new contract" id="builder-source"><input type="hidden" name="csrf" value="{{$csrf}}">{{if $.Tour}}<input type="hidden" name="guide" value="review">{{end}}<input type="hidden" name="builder" value="1"><input type="hidden" name="step" value="source"><input type="hidden" name="mode" value="{{.Mode}}"><input type="hidden" name="preview" value="1"><input type="hidden" name="view" value="{{.View}}">
<div class="panel-body stack">
<label class="field" for="builder-dir">Project folder<input class="input mono" id="builder-dir" name="dir" aria-invalid="{{if builderHasError .Errors "builder-dir"}}true{{else}}false{{end}}" value="{{.Form.Dir}}" required autocomplete="off" spellcheck="false" aria-describedby="builder-source-errors"></label>{{range .Errors}}{{if eq .Field "builder-dir"}}<p class="err">{{.Message}}</p>{{end}}{{end}}
<label class="field" for="builder-name">Name<input class="input mono" id="builder-name" name="name" aria-invalid="{{if builderHasError .Errors "builder-name"}}true{{else}}false{{end}}" value="{{.Form.Name}}" pattern="[a-z0-9\-]{1,40}" autocomplete="off" spellcheck="false" aria-describedby="builder-source-errors"></label>
{{range .Errors}}{{if eq .Field "builder-name"}}<p class="err">{{.Message}}</p>{{end}}{{end}}{{if eq .Mode "run"}}<label class="field" for="builder-run">Finished run<select class="select" id="builder-run" name="from" aria-invalid="{{if builderHasError .Errors "builder-run"}}true{{else}}false{{end}}" aria-describedby="builder-run-error" required><option value=""{{if not .Form.FromRun}} selected{{end}}>{{if .Runs}}Choose a finished run{{else}}{{template "quantity" (quantityZero "editor.finished-runs-zero" "No finished run" $.Numbers)}}{{end}}</option>{{range .Runs}}<option value="{{.ID}}"{{if eq .ID $d.Form.FromRun}} selected{{end}} data-number-exclude="editor.finished-run">{{.Agent}} · {{.ID}}</option>{{end}}</select></label><p class="err" id="builder-run-error"{{if not (builderHasError .Errors "builder-run")}} hidden{{end}}>{{builderErrorText .Errors "builder-run"}}</p>{{if and .Form.FromRun (not (builderHasError .Errors "builder-run"))}}<a class="btn" href="/runs/{{pathEsc .Form.FromRun}}">Open recorded run</a>{{end}}<p>A draft from what that run did, for you to review: the folders it wrote, the programs it started, the addresses it connected to (tego rules learn).</p>{{if not .Runs}}<p>To record a run: <span class="mono">tego watch -- &lt;the command that starts your agent&gt;</span></p>{{end}}{{else if eq .Mode "presets"}}
<fieldset class="nw-presets" id="builder-presets" aria-invalid="{{if builderHasError .Errors "builder-presets"}}true{{else}}false{{end}}" aria-describedby="builder-presets-error"{{if builderHasError .Errors "builder-presets"}} tabindex="-1"{{end}}><legend>Rules you set</legend>{{range .Presets}}<label class="nw-preset"><input type="checkbox" name="preset" value="{{.Name}}"{{if .On}} checked{{end}}><span><strong>{{presetLabel .Name}}</strong><span class="soft" data-number-exclude="editor.preset-promise">{{.Promise}}</span>{{with .Also}}<span class="soft ut" title="What the command’s agent needs to run">Also {{.}}</span>{{end}}</span></label>{{end}}<p class="err" id="builder-presets-error"{{if not (builderHasError .Errors "builder-presets")}} hidden{{end}}>{{builderErrorText .Errors "builder-presets"}}</p></fieldset>
<label class="field">Folders it may write<input class="input mono" id="builder-writes" name="writes" aria-invalid="{{if builderHasError .Errors "builder-writes"}}true{{else}}false{{end}}" aria-describedby="builder-writes-error" value="{{.Writes}}" autocomplete="off" spellcheck="false"></label><p class="err" id="builder-writes-error"{{if not (builderHasError .Errors "builder-writes")}} hidden{{end}}>{{builderErrorText .Errors "builder-writes"}}</p><label class="field">Hosts it may reach<input class="input mono" id="builder-hosts" name="hosts" aria-invalid="{{if builderHasError .Errors "builder-hosts"}}true{{else}}false{{end}}" aria-describedby="builder-hosts-error" value="{{.Hosts}}" autocomplete="off" spellcheck="false"></label><p class="err" id="builder-hosts-error"{{if not (builderHasError .Errors "builder-hosts")}} hidden{{end}}>{{builderErrorText .Errors "builder-hosts"}}</p>
<label class="field">Variables it needs (names)<input class="input mono" id="builder-pass" name="pass" aria-invalid="{{if builderHasError .Errors "builder-pass"}}true{{else}}false{{end}}" aria-describedby="builder-pass-error" value="{{.Pass}}" autocomplete="off" spellcheck="false"></label><p class="err" id="builder-pass-error"{{if not (builderHasError .Errors "builder-pass")}} hidden{{end}}>{{builderErrorText .Errors "builder-pass"}}</p><label class="field">Ask before reading<input class="input mono" id="builder-askread" name="askread" aria-invalid="{{if builderHasError .Errors "builder-askread"}}true{{else}}false{{end}}" aria-describedby="builder-askread-error" value="{{.AskRead}}" autocomplete="off" spellcheck="false"></label><p class="err" id="builder-askread-error"{{if not (builderHasError .Errors "builder-askread")}} hidden{{end}}>{{builderErrorText .Errors "builder-askread"}}</p><p class="soft">Ask before reading runs the whole contract at Basic.</p>
{{else}}<p>Start with no grants. Built-in secret refusals stay on. Add only what this agent needs.</p><label class="field">Folders it may write<input class="input mono" id="builder-writes" name="writes" aria-invalid="{{if builderHasError .Errors "builder-writes"}}true{{else}}false{{end}}" aria-describedby="builder-writes-error" value="{{.Writes}}" autocomplete="off" spellcheck="false"></label><p class="err" id="builder-writes-error"{{if not (builderHasError .Errors "builder-writes")}} hidden{{end}}>{{builderErrorText .Errors "builder-writes"}}</p><label class="field">Hosts it may reach<input class="input mono" id="builder-hosts" name="hosts" aria-invalid="{{if builderHasError .Errors "builder-hosts"}}true{{else}}false{{end}}" aria-describedby="builder-hosts-error" value="{{.Hosts}}" autocomplete="off" spellcheck="false"></label><p class="err" id="builder-hosts-error"{{if not (builderHasError .Errors "builder-hosts")}} hidden{{end}}>{{builderErrorText .Errors "builder-hosts"}}</p><label class="field">Variables it needs (names)<input class="input mono" id="builder-pass" name="pass" aria-invalid="{{if builderHasError .Errors "builder-pass"}}true{{else}}false{{end}}" aria-describedby="builder-pass-error" value="{{.Pass}}" autocomplete="off" spellcheck="false"></label><p class="err" id="builder-pass-error"{{if not (builderHasError .Errors "builder-pass")}} hidden{{end}}>{{builderErrorText .Errors "builder-pass"}}</p><p>These grants are optional. A command you type is admitted explicitly.</p>{{end}}
<label class="field">Command<input class="input mono" id="builder-command" name="cmd" aria-invalid="{{if builderHasError .Errors "builder-command"}}true{{else}}false{{end}}" aria-describedby="builder-command-error"{{if eq .Mode "blank"}} required{{end}} value="{{.Form.Command}}" autocomplete="off" spellcheck="false"></label><p class="err" id="builder-command-error"{{if not (builderHasError .Errors "builder-command")}} hidden{{end}}>{{builderErrorText .Errors "builder-command"}}</p>{{if eq .Mode "blank"}}<p class="soft">Use the full program path, such as /usr/bin/python3, or include PATH in Variables it needs.</p>{{end}}
<fieldset class="nw-presets nw-to"><legend>Save to</legend><label class="nw-preset"><input type="radio" name="to" value="registry"{{if eq .To "registry"}} checked{{end}}><span>Your agents (~/.config/tego/agents/)</span></label><label class="nw-preset"><input type="radio" name="to" value="project"{{if ne .To "registry"}} checked{{end}}><span>The project folder, as agent.yaml</span></label></fieldset>
{{template "readsswitch" .}}
<details class="builder-options"{{if or (builderHasError .Errors "builder-fence-read") (builderHasError .Errors "builder-fence-net") (builderHasError .Errors "builder-fence-exec")}} open{{end}}><summary>More choices</summary><fieldset class="nw-live"><legend>While it runs</legend><label class="nw-preset"><input type="radio" name="live" value="locked"{{if ne .LiveMode "adjustable"}} checked{{end}}><span>Locked (default)</span></label><label class="nw-preset"><input type="radio" name="live" value="adjustable"{{if eq .LiveMode "adjustable"}} checked{{end}}><span>Adjustable. Loosen while it runs; needs root.</span></label><p>The kernel holds the fence. Tego’s live layer holds the rules inside it.</p>{{template "livemodes" ""}}<label class="field">Readable later<textarea class="input mono" id="builder-fence-read" name="fence_read" aria-invalid="{{if builderHasError .Errors "builder-fence-read"}}true{{else}}false{{end}}" aria-describedby="builder-fence-read-error">{{.FenceRead}}</textarea></label><p class="err" id="builder-fence-read-error"{{if not (builderHasError .Errors "builder-fence-read")}} hidden{{end}}>{{builderErrorText .Errors "builder-fence-read"}}</p><label class="field">Hosts later<textarea class="input mono" id="builder-fence-net" name="fence_net" aria-invalid="{{if builderHasError .Errors "builder-fence-net"}}true{{else}}false{{end}}" aria-describedby="builder-fence-net-error">{{.FenceNet}}</textarea></label><p class="err" id="builder-fence-net-error"{{if not (builderHasError .Errors "builder-fence-net")}} hidden{{end}}>{{builderErrorText .Errors "builder-fence-net"}}</p><label class="field">Programs later<textarea class="input mono" id="builder-fence-exec" name="fence_exec" aria-invalid="{{if builderHasError .Errors "builder-fence-exec"}}true{{else}}false{{end}}" aria-describedby="builder-fence-exec-error">{{.FenceExec}}</textarea></label><p class="err" id="builder-fence-exec-error"{{if not (builderHasError .Errors "builder-fence-exec")}} hidden{{end}}>{{builderErrorText .Errors "builder-fence-exec"}}</p></fieldset></details>
<div id="builder-source-errors">{{range .Errors}}<p class="err">{{.Message}}</p>{{end}}</div><button class="btn" type="submit" data-page>Preview</button></div></form></details>
{{with .Err}}<section class="banner banner-danger" role="alert">{{.}}</section>{{end}}
{{template "builderproblems" .Errors}}
{{with .Plan}}{{$p := .}}
{{if .Text}}
{{with $d.Form.Withhold}}<section class="banner banner-danger" role="alert"><div class="grow"><strong>This run leaked to {{join . ", "}}</strong>. {{if $p.Withheld}}Left out: {{join $p.Withheld ", "}}.{{end}} Review every other choice.</div></section>{{end}}
<div class="builder-cols"><form class="builder-edit stack" method="post" action="/rules/new{{if $.Tour}}?guide=review&amp;preview=1{{end}}" data-page id="builder-edit"><input type="hidden" name="csrf" value="{{$csrf}}">{{if $.Tour}}<input type="hidden" name="guide" value="review">{{end}}<input type="hidden" name="builder" value="1"><input type="hidden" name="draft" value="{{$d.Draft}}"><input type="hidden" name="mode" value="{{$d.Mode}}"><input type="hidden" name="dir" value="{{$d.Form.Dir}}"><input type="hidden" name="name" value="{{$d.Form.Name}}">{{range $d.Presets}}{{if .On}}<input type="hidden" name="preset" value="{{.Name}}">{{end}}{{end}}<input type="hidden" name="from" value="{{$d.Form.FromRun}}"><input type="hidden" name="to" value="{{$d.To}}">{{if eq $d.View "full"}}<input type="hidden" name="reads" value="{{if $d.Reads}}on{{end}}">{{end}}
<nav class="seg" aria-label="Contract view"><button class="btn" data-page formnovalidate name="view" value="simple"{{if eq $d.View "simple"}} aria-current="true"{{end}}>Simple</button><button class="btn" data-page formnovalidate id="builder-full-view" name="view" value="full"{{if eq $d.View "full"}} aria-current="true"{{end}}>Full</button></nav>
{{if eq $d.View "full"}}<section class="panel"><div class="panel-body stack"><h2>Full rules file</h2><p class="builder-phone-note">This editor works best on a larger screen. Hidden environment values stay unchanged.</p><label class="field" for="builder-text">{{template "spv" (sp .File "")}}<textarea class="input mono builder-editor" wrap="off" id="builder-text" name="text" aria-invalid="{{if $d.Errors}}true{{else}}false{{end}}" rows="22" spellcheck="false" autocomplete="off" aria-describedby="builder-problems" data-lines data-number-exclude="editor.builder-yaml">{{template "buildertextarea" $d.Editor}}</textarea></label><p>Check compiles this file with the same compiler used when a run starts.</p></div></section>{{template "builderglossary" $d.Fields}}
{{else}}<textarea name="text" hidden data-number-exclude="editor.editor-yaml">{{template "buildertextarea" $d.Editor}}</textarea><section class="panel"><div class="panel-head"><h2>{{if eq $d.Mode "run"}}What should it do again?{{else}}Permissions you chose{{end}}</h2></div><div class="phone-list builder-decisions">{{range $d.Decisions}}<div class="builder-decision" data-rule="{{.ID}}" data-yaml-id="builder-rule-{{.ID}}"><p>{{.Sentence}}</p><fieldset class="kd"><legend class="sr">{{.Sentence}}</legend><label><input type="radio" name="choice-{{.ID}}" value="keep"{{if not .Drop}} checked{{end}}>Keep</label><label><input type="radio" name="choice-{{.ID}}" value="drop"{{if .Drop}} checked{{end}}>Drop</label></fieldset>{{if .Address}}<label class="field">Name it (a host name)<input class="input mono" name="host-{{.ID}}" id="builder-host-{{.ID}}" value="{{.Host}}" aria-invalid="{{if .Err}}true{{else}}false{{end}}" aria-describedby="builder-host-err-{{.ID}}" autocomplete="off" spellcheck="false"></label><p class="err" id="builder-host-err-{{.ID}}">{{.Err}}</p><p class="soft">Tego saw an address, not a name. The next run may reach another address.</p>{{end}}</div>{{else}}<p class="panel-body" data-number-exclude="editor.draft-empty">No extra permissions are listed. Open Name and source to add folders or hosts.</p>{{end}}</div></section>
<details class="panel"{{if or (builderHasError $d.Errors "builder-wall") (builderHasError $d.Errors "builder-ask-hosts")}} open{{end}}><summary class="panel-head">Rules you set</summary><div class="panel-body stack"><label class="nw-preset nw-reads"><input type="checkbox" name="reads" value="on" aria-labelledby="builder-reads-name" aria-describedby="builder-reads-cost"{{if $d.Reads}} checked{{end}}><span><strong id="builder-reads-name">Show refused reads (slower)</strong><span class="soft" id="builder-reads-cost">Every file open is slower: {{$d.ReadsCost}}.</span></span></label><input type="hidden" name="wall-choice" value="1"><label class="nw-preset"><input type="checkbox" name="limit-wall" value="on"{{if eq $d.Form.Wall "2h"}} checked{{end}}><span data-number-exclude="editor.fixed-limit">Stop it after 2 hours</span></label><label class="field">Custom time limit<input class="input" id="builder-wall" name="wall" aria-invalid="{{if builderHasError $d.Errors "builder-wall"}}true{{else}}false{{end}}" aria-describedby="builder-wall-error" value="{{if ne $d.Form.Wall "2h"}}{{$d.Form.Wall}}{{end}}" placeholder="45m…" data-number-exclude-placeholder="editor.limit-placeholder" autocomplete="off"></label><p class="err" id="builder-wall-error"{{if not (builderHasError $d.Errors "builder-wall")}} hidden{{end}}>{{builderErrorText $d.Errors "builder-wall"}}</p><input type="hidden" name="ask-choice" value="1"><label class="nw-preset"><input type="checkbox" name="ask-connections" value="on"{{if or $d.Form.AskHosts $d.Form.WantAsk}} checked{{end}}><span>Ask before connecting to hosts I name</span></label><label class="field">Hosts to ask about<input class="input mono" name="ask-hosts" id="builder-ask-hosts" aria-describedby="builder-ask-hosts-error" aria-invalid="{{if builderHasError $d.Errors "builder-ask-hosts"}}true{{else}}false{{end}}" value="{{join $d.Form.AskHosts ", "}}" placeholder="api.example.com:443…" data-number-exclude-placeholder="editor.host-placeholder" autocomplete="off" spellcheck="false"></label><p class="err" id="builder-ask-hosts-error"{{if not (builderHasError $d.Errors "builder-ask-hosts")}} hidden{{end}}>{{builderErrorText $d.Errors "builder-ask-hosts"}}</p><p class="soft">Unlisted destinations stay refused. Every request needs your answer; nobody answering means refusal.</p></div></details>
<details class="panel"><summary class="panel-head">All rules in sentences</summary>{{template "newrules" $d.Groups}}</details>{{end}}
<input type="hidden" name="current-view" value="{{$d.View}}"><button class="btn" data-page name="step" value="preview" type="submit">Check choices</button><p class="soft" id="builder-updates" aria-live="polite" data-number="editor.new-written">Nothing saved. Review the file before Save.</p>
</form>
<div class="stack" id="builder-result"><details class="panel builder-yaml"><summary class="panel-head">YAML and changed lines</summary><div class="panel-body"><p>{{template "spv" (sp .File "")}}</p><ul class="builder-dropped">{{range $d.Decisions}}{{if .Drop}}<li id="builder-rule-{{.ID}}">Dropped: {{.Entry}} (not written)</li>{{end}}{{end}}</ul><ol class="builder-lines">{{range $d.YAML}}<li id="builder-line-{{.N}}"{{if .Changed}} class="builder-changed"{{end}}>{{range .RuleIDs}}<span class="sr" id="builder-rule-{{.}}">Rule line</span>{{end}}<code>{{.Text}}</code>{{if .Changed}}<span class="sr"> Changed</span>{{end}}</li>{{end}}</ol></div></details>
<section class="panel" id="builder-save"><div class="panel-body stack"><h2>Preview: {{.Name}}</h2><p>Writes <span class="code-i">{{template "pwp" (pieces .File)}}</span></p><p>Save writes the checked draft, restoring any hidden environment values.</p>{{if $d.Form.PreviewOnly}}<p>Saving is not available from this connection. Open the dashboard from a terminal outside any governed run to save a change.</p>{{else if .OK}}<form method="post" action="/rules/new{{if $.Tour}}?guide=review&amp;preview=1{{end}}" data-page><input type="hidden" name="csrf" value="{{$csrf}}">{{if $.Tour}}<input type="hidden" name="guide" value="review">{{end}}<input type="hidden" name="base" value="{{.Base}}">{{template "newhidden" $d}}<button class="btn btn-primary" data-page type="submit">{{if .Registry}}Save {{.Name}}{{else}}Create agent.yaml{{end}}</button></form>{{else}}<p class="err">Fix the problems above, then check again. No contract was written.</p>{{end}}{{with .Protection}}<p>{{.}}</p>{{end}}{{if or .MakeDirs .Ignore}}<details><summary>Folders and ignore entries</summary>{{with .MakeDirs}}<p>Folders to make: {{join . ", "}}</p>{{else}}<p>Every folder it writes to is already there.</p>{{end}}{{with .Ignore}}<p>Add to .gitignore: {{join . ", "}}</p>{{else}}<p>Nothing it makes needs a .gitignore line.</p>{{end}}</details>{{end}}{{if .Diagnostics}}<details><summary>Compiler output</summary><pre class="term" data-number-exclude="editor.compiler-output">{{join .Diagnostics "\n"}}</pre></details>{{end}}{{with .Notes}}<ul>{{range .}}<li>{{.}}</li>{{end}}</ul>{{end}}<div class="cli"><code>{{cmd $d.Start}}</code></div></div></section>
</div></div>
{{end}}{{end}}{{end}}{{end}}{{end}}</div>{{end}}
