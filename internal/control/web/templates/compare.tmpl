{{/* SPDX-License-Identifier: Apache-2.0 */}}
{{define "cmpcell"}}{{if .Seen}}<span class="b b-{{cmpTone .}}" title="{{range $i, $w := .Where}}{{if $i}}&#10;{{end}}{{$w}}{{end}}">{{template "i" (cmpIcon .)}}{{.Word}}</span>{{if .Detail}} <span class="cmp-d">{{.Detail}}</span>{{end}}{{else}}<span class="muted">not seen</span>{{end}}{{end}}
{{/* cmpcellw is a merged row's cell: the verdict, then the address this run sent to. */}}
{{define "cmpcellw"}}{{template "cmpcell" .}}{{if .Seen}}{{range .Where}}<span class="cmp-where">{{.}}</span>{{end}}{{end}}{{end}}
{{define "cmphead"}}<section class="panel cmp-run" aria-labelledby="h-{{.Label}}">
<div class="panel-head"><h2 id="h-{{.Label}}"><span class="b b-outline">Run {{.Label}}</span> <a href="/runs/{{pathEsc .Run.ID}}">{{if .Run.Agent}}{{.Run.Agent}}{{else}}(no agent){{end}}</a></h2>{{template "state" .Run}}</div>
<dl class="kv cmp-kv">
<dt>Protection</dt><dd><span class="b {{if eq .Run.Tier "observe"}}b-observed{{else}}b-active{{end}}">{{if eq .Run.Tier "observe"}}{{template "i" "i-eye"}}{{else}}{{template "i" "i-shield"}}{{end}}{{enforcement .Run.Tier}}</span></dd>
<dt>Started by</dt><dd>{{if .Run.User}}{{.Run.User}}{{else}}<span class="muted">not recorded</span>{{end}}</dd>
<dt>Rules version</dt><dd>{{if .Run.ContractHash}}<span class="mono" title="sha256 of the contract: {{.Run.ContractHash}}">{{cut .Run.ContractHash 12}}</span>{{else}}<span class="muted">not recorded</span>{{end}}</dd>
<dt>Chain</dt><dd>{{template "chainpill" .Chain}}</dd>
<dt>Started</dt><dd><time datetime="{{iso .Run.Start}}" title="{{stamp .Run.Start}}">{{clock .Run.Start}} {{tz}}</time> · {{dur (.Run.Duration .Now)}}</dd>
<dt>Blocked</dt><dd>{{if .Run.Refusals}}<a class="n-link" href="/runs/{{pathEsc .Run.ID}}/refusals">{{.Run.Refusals}} {{plural .Run.Refusals "action" "actions"}}</a>{{with .Verdict.Stopped}} · <span title="Secret reads and sends next to a secret: the count the run's banner and its Runs chip give. The rest are routine lookups and retries.">{{.}} against secrets</span>{{end}}{{else}}None{{end}}</dd>
</dl></section>{{end}}
{{define "content"}}{{with .Data}}{{$d := .}}
<div class="head"><div><nav class="crumbs" aria-label="Breadcrumb"><a href="/runs">Runs</a></nav><h1>Compare two runs</h1><p class="lede">Two runs side by side</p></div></div>
<link rel="stylesheet" href="/static/compare.css">
{{if lt (len .Runs) 2}}<section class="panel" aria-labelledby="h-cmp-none"><div class="empty cmp-none"><div class="glyph">{{template "i" "i-activity"}}</div><h3 id="h-cmp-none">Compare needs two runs</h3><p>{{if .Runs}}There is one run so far. {{end}}Run the agent once with <span class="mono">tego watch</span> (records, blocks nothing) and once with <span class="mono">tego run</span> (enforces its policy), then compare here</p><div class="cli-pair"><div class="cli cli-wrap"><code>tego watch -- &lt;agent&gt;</code></div><div class="cli cli-wrap"><code>tego run &lt;policy.yaml&gt; -- &lt;agent&gt;</code></div></div></div></section>
{{else}}<section class="panel" aria-label="Choose the runs"><div class="panel-body">{{template "cmpform" (cmpForm .Runs .A .B)}}</div></section>
{{if .Err}}<section class="banner banner-warn" role="status">{{template "i" "i-triangle-alert"}}<div class="grow">{{.Err}}</div></section>{{end}}
{{with .Cmp}}{{$home := .Home}}
<div class="cmp-stats">{{range (cmpStats .A .B)}}<div class="cmp-stat cmp-stat-{{.Tone}}"><span class="cmp-stat-k">{{.Label}} · {{.Mode}}</span><strong class="cmp-stat-h">{{.Head}}</strong><span class="cmp-stat-d">{{.Detail}}</span></div>{{end}}</div>
<p class="cmp-sum cmp-sum-quiet" role="status">{{.Summary}}</p>
<section class="ch-cmp" aria-label="The two runs in bars">{{range (cmpCharts .)}}<figure class="panel ch-fig"><figcaption class="ch-cap"><span class="ch-h" title="{{.Hint}}">{{.Label}}</span></figcaption>{{range .Rows}}<div class="ch-mrow"><span class="ch-side"><span class="b b-outline">{{.Side}}</span> <span class="ch-agent" title="{{.Agent}}">{{.Agent}}</span></span>{{template "chart" .Bar}}<b>{{.N}}</b></div>{{end}}</figure>{{end}}</section>
<div class="cmp-heads">{{template "cmphead" (cmpSide .A "A" $d.ChainA $d.Now)}}{{template "cmphead" (cmpSide .B "B" $d.ChainB $d.Now)}}</div>
<section class="panel" aria-labelledby="h-cmp"><div class="panel-head"><h2 id="h-cmp">Sensitive actions</h2><span class="cmp-legend"><span title="Red: a secret or an off-list destination got through. Green: tego blocked it.">Attack first · red got through · green blocked</span></span></div>
{{if $d.Shown}}<div class="tw"><table class="t t-cmp" role="table"><caption class="sr">Secrets, hosts, programs, approvals</caption><thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader">What</th><th scope="col" role="columnheader">A · {{if .A.Run.Agent}}{{.A.Run.Agent}}{{else}}run A{{end}} · {{modeWord .A.Run.Tier}}</th><th scope="col" role="columnheader">B · {{if .B.Run.Agent}}{{.B.Run.Agent}}{{else}}run B{{end}} · {{modeWord .B.Run.Tier}}</th></tr></thead><tbody role="rowgroup">
{{range $d.Shown}}<tr role="row" class="{{if or (eq .A.Tone "bad") (eq .B.Tone "bad")}}cmp-bad{{end}}{{if .Differs}} cmp-diff{{end}}{{if .Danger}} cmp-danger{{end}}">{{if .Merged}}<td role="cell" class="lead"><span class="cmp-k">{{.Label}}</span> <strong>{{.Target}}</strong> <span class="muted cmp-n">{{.Note}}</span></td><td role="cell" data-label="Run A">{{template "cmpcellw" .A}}</td><td role="cell" data-label="Run B">{{template "cmpcellw" .B}}</td>{{else}}<td role="cell" class="lead"><span class="cmp-k">{{.Label}}</span> {{if eq .Class "secret" "ask"}}{{template "spv" (sp .Target $home)}}{{else}}<span class="ut" title="{{.Target}}">{{cut .Target 90}}</span>{{end}}{{if .Note}} <span class="muted cmp-n">{{.Note}}</span>{{end}}</td><td role="cell" data-label="Run A">{{template "cmpcell" .A}}</td><td role="cell" data-label="Run B">{{template "cmpcell" .B}}</td>{{end}}</tr>{{end}}
</tbody></table></div>
{{else}}<div class="empty"><div class="glyph">{{template "i" "i-check"}}</div><h3>Nothing sensitive in either run</h3><p>No secret, off-list host or approval</p></div>{{end}}
<div class="panel-foot"><span>{{if $d.Hidden}}Showing {{len $d.Shown}} of {{len .Rows}} rows. <a class="link" href="{{$d.AllURL}}">Show all</a>.{{else if $d.All}}All {{len .Rows}} rows shown.{{else}}{{len .Rows}} {{plural (len .Rows) "row" "rows"}}.{{end}}{{if and (or .Routine .Folded) (not $d.All)}}{{if .Routine}} {{.Routine}} routine {{plural .Routine "row" "rows"}} (allowed programs and destinations, the same in both){{end}}{{if .Folded}}{{if .Routine}} and{{end}} {{.Folded}} background {{plural .Folded "destination" "destinations"}} (each run's own retries and probes){{end}} left out. <a class="link" href="{{$d.AllURL}}">Show all</a>.{{end}}</span><span>Not listed: {{.A.Background}} lookups and probes in A, {{.B.Background}} in B (DNS, system sockets, route probes to port 65535).</span></div>
</section>
{{end}}{{end}}
{{end}}{{end}}
