{{/* SPDX-License-Identifier: Apache-2.0 */}}
{{/* cmpcell keeps the outcome word and count. A muted source cell is a refusal
     outside the headline count; its title explains why it is not Stopped. */}}
{{define "cmpcell"}}{{$numbers:=numbersOf .}}{{$:=numberValue .}}{{with $}}{{if .Seen}}<span data-number-title="shared.policy" class="b b-{{cmpTone .}}" title="{{if eq .Tone "muted"}}Tego refused it. It was no send next to a secret, so the attempts stopped above do not count it.{{if .Where}}&#10;{{end}}{{end}}{{range $i, $w := .Where}}{{if $i}}&#10;{{end}}{{$w}}{{end}}" data-number-exclude-title="compare.target-title">{{template "i" (cmpIcon .)}}{{.Word}}</span>{{if .Detail}} <span class="cmp-d">{{template "quantity" (quantityWords "compare.cell-detail" .Detail $numbers)}}</span>{{end}}{{else}}<span class="muted">{{template "quantity" (quantityZero "compare.cell-empty" "not seen" $numbers)}}</span>{{end}}{{end}}{{end}}
{{/* cmpcellw is a merged row's cell: the verdict, then the address this run sent to. */}}
{{define "cmpcellw"}}{{$numbers:=numbersOf .}}{{$:=numberValue .}}{{with $}}{{template "cmpcell" (withNumbers . $numbers)}}{{if .Seen}}{{range .Where}}<span class="cmp-where" data-number-exclude="compare.target">{{.}}</span>{{end}}{{end}}{{end}}{{end}}
{{define "cmphead"}}{{$numbers:=runNumbers .Run}}<section data-k="{{.Run.ID}}" class="panel cmp-run" aria-labelledby="h-{{.Label}}">
<div class="panel-head"><h2 id="h-{{.Label}}"><span class="b b-outline">Run {{.Label}}</span> <a href="/runs/{{pathEsc .Run.ID}}" data-number-exclude="compare.agent-1">{{if .Run.Agent}}{{.Run.Agent}}{{else}}(no agent){{end}}</a></h2>{{template "state" .Run}}</div>
<dl class="kv cmp-kv">
<dt>Protection</dt><dd><span class="b {{if eq .Run.Tier "observe"}}b-observed{{else}}b-active{{end}}">{{if eq .Run.Tier "observe"}}{{template "i" "i-eye"}}{{else}}{{template "i" "i-shield"}}{{end}}{{enforcement .Run.Tier}}</span></dd>
<dt>Started by</dt><dd>{{if .Run.User}}{{.Run.User}}{{else}}<span class="muted">not recorded</span>{{end}}</dd>
<dt>Rules version</dt><dd>{{if .Run.ContractHash}}<span class="mono" title="sha256 of the contract: {{.Run.ContractHash}}">{{.Run.ContractHash}}</span>{{else}}<span class="muted">not recorded</span>{{end}}</dd>
<dt>Chain</dt><dd>{{template "chainpill" .Chain}}</dd>
<dt>Started</dt><dd><time datetime="{{iso .Run.Start}}" title="{{stamp .Run.Start}}" data-number-exclude="compare.started">{{clock .Run.Start}} {{tz}}</time> · <span data-number-exclude="compare.duration">{{dur (.Run.Duration .Now)}}</span></dd>
<dt>Refused</dt><dd>{{if .Run.Refusals}}<a class="n-link" href="/runs/{{pathEsc .Run.ID}}/refusals">{{template "quantity" (quantity "compare.refusals" .Run.Refusals $numbers)}} {{plural .Run.Refusals "action" "actions"}}</a>{{with .Verdict.Stopped}} · <span title="Secret reads and sends next to a secret: the count the run's banner and its Runs chip give. The rest are routine lookups and retries.">{{template "quantity" (quantity "compare.stopped" . $numbers)}} against secrets</span>{{end}}{{else}}{{template "quantity" (quantityZero "compare.refusals" "None" $numbers)}}{{end}}</dd>
</dl></section>{{end}}
{{define "content"}}{{with .Data}}{{$d := .}}{{$numbers:=.Numbers}}
<div class="head"><div>{{if $.Tour}}<h2>{{else}}<h1>{{end}}What changed between runs?{{if $.Tour}}</h2>{{else}}</h1>{{end}}<p class="lede">Two runs side by side</p></div></div>
<link rel="stylesheet" href="/static/compare.css">
{{if lt (len .Runs) 2}}<section class="panel" aria-labelledby="h-cmp-none"><div class="empty cmp-none"><div class="glyph">{{template "i" "i-activity"}}</div><h3 id="h-cmp-none">{{template "quantity" (quantityWords "compare.required" "Compare needs two runs" exactNumbers)}}</h3><p>{{if .Runs}}{{template "quantity" (quantityWords "compare.available" "There is one run so far." $.Numbers)}} {{end}}Run the agent once with <span class="mono">tego watch</span> (records without enforcing refusals) and once with <span class="mono">tego run</span> (enforces its contract), then compare here</p><div class="cli-pair"><div class="cli cli-wrap"><code>tego watch -- &lt;agent&gt;</code></div><div class="cli cli-wrap"><code>tego run &lt;contract.yaml&gt; -- &lt;agent&gt;</code></div></div></div></section>
{{else}}{{if .Cmp}}<details class="panel cmp-picker"><summary>Change the runs</summary><div class="panel-body">{{template "cmpform" (cmpForm .Runs .A .B)}}</div></details>{{else}}<section class="panel" aria-label="Choose the runs"><div class="panel-body">{{template "cmpform" (cmpForm .Runs .A .B)}}</div></section>{{end}}
{{if .Err}}<section class="banner banner-warn" role="status">{{template "i" "i-triangle-alert"}}<div class="grow" data-number-exclude="compare.selection-error">{{.Err}}</div></section>{{end}}
{{with .Cmp}}{{$home := .Home}}{{$ra := .A.Run}}{{$rb := .B.Run}}
<div class="cmp-stats">{{range (cmpStats .A .B)}}<div data-k="{{.RunID}}" class="cmp-stat cmp-stat-{{.Tone}}"><strong class="cmp-stat-agent" data-number-exclude="compare.agent-2">{{if eq .Label "A"}}{{if $ra.Agent}}{{$ra.Agent}}{{else}}Run A{{end}}{{else}}{{if $rb.Agent}}{{$rb.Agent}}{{else}}Run B{{end}}{{end}}</strong><span class="cmp-stat-k">Run {{.Label}} · {{.Mode}}</span><strong class="cmp-stat-h">{{if eq .Head "No sensitive access recorded"}}{{template "quantity" (quantityZero "compare.head" .Head .Numbers)}}{{else}}{{template "quantity" (quantityWords "compare.head" .Head .Numbers)}}{{end}}</strong><span class="cmp-stat-d">{{template "quantity" (quantityWords "compare.detail" .Detail .Numbers)}}</span></div>{{end}}</div>
<p class="cmp-sum cmp-sum-quiet" role="status">{{template "quantity" (cmpSummary . $numbers)}}</p>
{{with readGap $ra}}<p class="cmp-sum soft">Run A: {{.}} {{template "readfix"}}</p>{{end}}{{with readGap $rb}}<p class="cmp-sum soft">Run B: {{.}} {{template "readfix"}}</p>{{end}}
<details class="cmp-details panel"><summary>Run details and charts</summary><a class="btn" href="/runs">All runs</a><section class="ch-cmp" aria-label="The two runs in bars">{{range (cmpCharts .)}}<figure class="panel ch-fig"><figcaption class="ch-cap"><span class="ch-h" title="{{.Hint}}">{{.Label}}</span></figcaption>{{range .Rows}}<div data-k="{{if eq .Side "A"}}{{$ra.ID}}{{else}}{{$rb.ID}}{{end}}" class="ch-mrow"><span class="ch-side"><span class="b b-outline">{{.Side}}</span> <span class="ch-agent" title="{{.Agent}}" data-number-exclude="compare.agent-field-1">{{.Agent}}</span></span>{{template "chart" .Bar}}<b>{{template "quantity" (quantity "compare.chart-count" .N .Numbers)}}</b></div>{{end}}</figure>{{end}}</section>
<div class="cmp-heads">{{template "cmphead" (cmpSide .A "A" $d.ChainA $d.Now)}}{{template "cmphead" (cmpSide .B "B" $d.ChainB $d.Now)}}</div>
</details><section class="panel" aria-labelledby="h-cmp"><div class="panel-head"><h2 id="h-cmp">Sensitive actions</h2><span class="cmp-legend"><span title="Read allowed and refused are explicit outcomes. The counts above include secret reads and sends next to secrets.">Recorded outcomes for each run</span></span></div>
{{if $d.Shown}}<div class="tw"><table class="t t-cmp" role="table"><caption class="sr">Secrets, hosts, programs, approvals</caption><thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader">What</th><th scope="col" role="columnheader" data-number-exclude="compare.agent-3">A · {{if .A.Run.Agent}}{{.A.Run.Agent}}{{else}}run A{{end}} · {{modeWord .A.Run.Tier}}</th><th scope="col" role="columnheader" data-number-exclude="compare.agent-4">B · {{if .B.Run.Agent}}{{.B.Run.Agent}}{{else}}run B{{end}} · {{modeWord .B.Run.Tier}}</th></tr></thead><tbody role="rowgroup">
{{range $d.Shown}}<tr role="row" class="{{if or (eq .A.Tone "bad") (eq .B.Tone "bad")}}cmp-bad{{end}}{{if .Differs}} cmp-diff{{end}}{{if .Danger}} cmp-danger{{end}}">{{if .Merged}}<td role="cell" class="lead"><span class="cmp-k">{{.Label}}</span> <strong>{{.Target}}</strong> <span class="muted cmp-n">{{.Note}}</span></td><td role="cell" data-k="{{$ra.ID}}" data-label="Run A">{{template "cmpcellw" (withNumbers .A (runNumbers $ra))}}</td><td role="cell" data-k="{{$rb.ID}}" data-label="Run B">{{template "cmpcellw" (withNumbers .B (runNumbers $rb))}}</td>{{else}}<td role="cell" class="lead"><span class="cmp-k">{{.Label}}</span> {{if eq .Class "secret" "ask"}}{{template "spv" (sp .Target $home)}}{{else}}<span class="ut" title="{{.Target}}" data-number-exclude="compare.row-target">{{.Target}}</span>{{end}}{{if .Note}} <span class="muted cmp-n">{{.Note}}</span>{{end}}</td><td role="cell" data-k="{{$ra.ID}}" data-label="Run A">{{with cmpUnrec .A .Class $ra}}<span class="muted" title="{{.}}">not recorded</span>{{else}}{{template "cmpcell" (withNumbers .A (runNumbers $ra))}}{{end}}</td><td role="cell" data-k="{{$rb.ID}}" data-label="Run B">{{with cmpUnrec .B .Class $rb}}<span class="muted" title="{{.}}">not recorded</span>{{else}}{{template "cmpcell" (withNumbers .B (runNumbers $rb))}}{{end}}</td>{{end}}</tr>{{end}}
</tbody></table></div>
{{else}}<div class="empty"><div class="glyph">{{template "i" "i-check"}}</div><h3>{{template "quantity" (quantityZero "compare.rows" "Nothing sensitive in either run" $numbers)}}</h3><p>{{template "quantity" (quantityZero "compare.rows" "No secret, off-list host or approval" $numbers)}}</p></div>{{end}}
<div class="panel-foot"><span>{{if $d.Hidden}}Showing {{template "quantity" (quantity "compare.shown" (len $d.Shown) $numbers)}} of {{template "quantity" (quantity "compare.rows" (len .Rows) $numbers)}} rows. <a class="link" href="{{$d.AllURL}}">Show all</a>.{{else if $d.All}}All {{template "quantity" (quantity "compare.rows" (len .Rows) $numbers)}} rows shown.{{else}}{{template "quantity" (quantity "compare.rows" (len .Rows) $numbers)}} {{plural (len .Rows) "row" "rows"}}.{{end}}{{if and (or .Routine .Folded) (not $d.All)}}{{if .Routine}} {{template "quantity" (quantity "compare.routine" (.Routine) $numbers)}} routine {{plural .Routine "row" "rows"}} (allowed programs and destinations, the same in both){{end}}{{if .Folded}}{{if .Routine}} and{{end}} {{template "quantity" (quantity "compare.folded" (.Folded) $numbers)}} background {{plural .Folded "destination" "destinations"}} (each run's own retries and probes){{end}} left out. <a class="link" href="{{$d.AllURL}}">Show all</a>.{{end}}</span><span>Not listed: {{template "quantity" (quantity "compare.background-a" (.A.Background) $numbers)}} lookups and probes in A, {{template "quantity" (quantity "compare.background-b" (.B.Background) $numbers)}} in B (DNS, system sockets, <span data-number-exclude="compare.probe-port"><span data-number="shared.policy">route probes to port 65535</span></span>).</span></div>
</section>
{{end}}{{end}}
{{end}}{{end}}
