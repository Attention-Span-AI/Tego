{{/* Logs: the search form (a literal text search q, a query in the query language where, and the form's fields), the facets beside the rows, the Lines / By process / By target / By rule switch, and the downloads. Everything is a GET form or a link, so the page works with JavaScript off; static/logs.js adds the live tail, older rows in place, rows opened in place, saved views and the j/k keys. */}}
{{define "content"}}<link rel="stylesheet" href="/static/logs.css"><script src="/static/logs.js" defer></script>{{template "lr" (index $.L "r-logs-head")}}{{template "r-logs-head" $}}</div>{{with .Data}}
{{if .FilterPage}}<section class="filter-fallback panel panel-body logs-filters" id="logs-filters" aria-labelledby="logs-filter-title"><h2 id="logs-filter-title">Filter events</h2>{{template "logs-filters" $}}</section>{{else}}<dialog class="filter-sheet logs-filters" id="logs-filters" aria-labelledby="logs-filter-title"><div class="filter-title"><h2 id="logs-filter-title">Filter events</h2><button class="btn" type="button" data-filter-close>Close</button></div>{{template "logs-filters" $}}</dialog>{{end}}{{end}}
<div class="lq-grid">
<div class="lq-main">{{template "lr" (index $.L "r-logs-rows")}}{{template "r-logs-rows" $}}</div></div>
</div>
{{end}}
{{/* r-logs-head is one sentence: how many lines, how they fold into rows and how many a page shows, then the refused and asked counts (each refusal counts once: a refused action and the line that mirrors it are one); and the downloads of every matching line. */}}
{{define "r-logs-head"}}{{with .Data}}<div class="head"><div>{{if $.Tour}}<h2>{{else}}<h1>{{end}}What did the agents do?{{if $.Tour}}</h2>{{else}}</h1>{{end}}<p class="lede">{{template "quantity" (quantity "logs.matched" .Page.Matched $.Numbers)}} {{plural .Page.Matched "line" "lines"}} · <span class="n-refused">{{template "quantity" (quantity "logs.refused" (index .Page.Counts "refused") $.Numbers)}} refused</span> · <span class="n-asked">{{template "quantity" (quantity "logs.asked" (index .Page.Counts "ask") $.Numbers)}} asked</span></p>{{with .Window}}<p class="lq-window soft" role="status"><span class="lq-window-t">{{.Words}}</span>{{if .NowURL}} <a class="link" href="{{.NowURL}}" title="Show the same length of time, ending now">Move to now</a>{{end}}</p>{{end}}</div>{{if or .ExportLines .ExportLedger}}<details class="head-more desktop-only"><summary>Actions</summary><div class="head-actions lq-dl">{{if .ExportLines}}<a class="btn" href="{{.ExportCSV}}" download title="The {{quantityText "logs.export-lines" .ExportLines $.Numbers}} matching {{plural .ExportLines "line" "lines"}}{{if .ExportMore}}, the {{quantityText "logs.export-system" .ExportMore $.Numbers}} hidden system {{plural .ExportMore "line" "lines"}} included,{{end}} as a spreadsheet, oldest first, in the page's words; secrets masked as on the page" data-number-title="logs.export-lines{{if .ExportMore}} logs.export-system{{end}}">{{template "i" "i-download"}}CSV</a>{{end}}<a class="btn" href="{{.ExportJSONL}}" download title="{{if .ExportLedger}}This run's whole ledger: all {{quantityText "logs.export-ledger" .ExportLedger $.Numbers}} {{plural .ExportLedger "line" "lines"}} of its events file, byte for byte, oldest first, the refusal notes included, so `tego events --verify` style tooling can check the chain.{{else}}The {{quantityText "logs.export-lines" .ExportLines $.Numbers}} matching ledger {{plural .ExportLines "line" "lines"}}{{if .ExportMore}}, the {{quantityText "logs.export-system" .ExportMore $.Numbers}} hidden system {{plural .ExportMore "line" "lines"}} included{{end}}, byte for byte, oldest first. Refusal notes (the kind refused line written beside each refused action) are left out unless the search asks for kind refused, so this is not a chain anything can check: pick one run and nothing else for the whole ledger.{{end}} Not masked: this is your own ledger, so it holds what the agent sent, secrets included." data-number-title="{{if .ExportLedger}}logs.export-ledger{{else}}logs.export-lines{{if .ExportMore}} logs.export-system{{end}}{{end}}">{{template "i" "i-download"}}Record (JSONL)</a></div></details>{{end}}</div><div class="phone-filter-control summary-controls"><span class="soft" data-say>{{if .Group}}{{template "quantity" (quantity "logs.groups" .GroupInfo.Total $.Numbers)}} groups{{else}}{{template "quantity" (quantity "logs.matched" .Page.Matched $.Numbers)}} events{{end}} · {{.PeriodLabel}}<span class="sr">. {{if .Group}}{{template "quantity" (quantity "logs.shown-groups" (len .Grouped) $.Numbers)}} of {{template "quantity" (quantity "logs.groups" .GroupInfo.Total $.Numbers)}} groups shown, of {{template "quantity" (quantity "logs.group-matched" .GroupInfo.Matched $.Numbers)}} events{{else}}{{template "quantity" (quantity "logs.shown-rows" (len .Rows) $.Numbers)}} of {{template "quantity" (quantity "logs.folded-rows" .Page.Groups $.Numbers)}} rows shown{{end}}{{if .Page.SysHidden}}. {{template "quantity" (quantity "logs.system-hidden" .Page.SysHidden $.Numbers)}} system lines hidden; show them in Filter{{end}}</span></span><a class="btn" data-filter-open href="{{.FilterURL}}">Filter</a></div>{{end}}{{end}}
{{/* r-logs-facets is the matched lines counted six ways: a value adds itself to the query (or, already in it, removes itself) and its − leaves it out. */}}
{{define "r-logs-facets"}}{{with .Data}}<nav class="lq-facets" aria-label="Narrow the search">{{range .Facets}}<section class="lq-fg"><h2 class="lq-fh">{{.Name}}</h2><ul>{{range .Items}}<li class="lq-fi{{if .Active}} on{{end}}"><a class="lq-add" href="{{.AddURL}}" title="{{if .Active}}Remove {{.Title}} from the query{{else}}Only lines with {{.Title}}{{end}}"{{if .Active}} aria-current="true"{{end}} data-number-exclude-title="logs.detail-7"><span class="lq-l" title="{{.Label}} · {{.Title}}" data-number-exclude="logs.explicit-6">{{.Label}}</span><span class="lq-n">{{template "quantity" (quantity "logs.facet" .Count $.Numbers)}}</span></a>{{if not .Active}}<a class="lq-not" href="{{.NotURL}}" title="Leave out lines with {{.Title}}" aria-label="Leave out {{.Label}}" data-number-exclude="logs.explicit-7">−</a>{{end}}</li>{{end}}</ul>{{if .More}}<p class="lq-more">and {{template "quantity" (quantity "logs.facet-more" .More $.Numbers)}} more</p>{{end}}</section>{{else}}<p class="soft lq-none">{{template "quantity" (quantityZero "logs.matched" "No lines to narrow." $.Numbers)}}</p>{{end}}</nav>{{end}}{{end}}
{{/* r-logs-rows is the rows of the search, or its groups, with the rule changes among the first render's rows (rclog, changefeed.go). In lines mode the tbody names where logs.js asks for newer rows (data-rows with data-tail, the append cursor, and data-after, the newest row's cursor, which only an overflowed tail falls back on) and older ones (data-next): with JavaScript the page follows new lines itself, at the top, and the live region is left to it. */}}
{{define "r-logs-rows"}}{{with .Data}}<section class="panel" id="log-results" data-crev="{{.Crev}}" aria-labelledby="h-res">
  {{if .QueryErr}}<p class="lq-err" role="alert">{{template "i" "i-triangle-alert"}}<span>This query could not be read in full, so no lines are shown. {{.QueryErr}}</span></p>{{end}}
  <div class="panel-head lq-ph"><h2 id="h-res" class="soft">{{if .Group}}{{template "quantity" (quantity "logs.groups" .GroupInfo.Total $.Numbers)}} {{plural .GroupInfo.Total "group" "groups"}} of {{template "quantity" (quantity "logs.group-matched" .GroupInfo.Matched $.Numbers)}} {{plural .GroupInfo.Matched "line" "lines"}}{{if gt .GroupInfo.Total (len .Grouped)}} · the {{template "quantity" (quantity "logs.shown-groups" (len .Grouped) $.Numbers)}} with the most lines{{end}}{{template "lsys" (withNumbers . $.Numbers)}}{{else}}<span><span class="lq-shown" data-number="logs.shown-rows">{{quantityText "logs.shown-rows" (len .Rows) $.Numbers}}</span> of {{$total := quantity "logs.folded-rows" .Page.Groups $.Numbers}}<span class="lq-total" data-number="{{$total.ID}}"{{with $total.Reason}} title="{{.}}"{{end}}>{{$total.Text}}</span> <span class="lq-rows-w">{{plural .Page.Groups "row" "rows"}}</span> shown{{template "lsys" (withNumbers . $.Numbers)}}</span>{{end}}</h2><nav class="lq-by" aria-label="Show the lines as">{{range .GroupTabs}}<a href="{{.URL}}" title="{{.Title}}"{{if .Current}} aria-current="page"{{end}} data-number-exclude="logs.explicit-3">{{.Label}}</a>{{end}}</nav></div>
<p class="soft lq-live-note">{{if .Older}}This is an older page: it stays as it was loaded. The newest lines are on the first page.{{else if .Group}}With scripts on, groups follow the record while you are at the top of this page. Lower down they stay as they are, and catch up when you scroll back to the top.{{else}}With scripts on, new lines arrive at the top while you are there; lower down a button counts them and brings them in. A row you opened stays open and follows its line.{{end}}</p>
{{if .Group}}{{if .GroupDetail}}{{template "log-group-detail" (withNumbers .GroupDetail $.Numbers)}}{{else}}{{template "lgroups" (withNumbers . $.Numbers)}}{{end}}{{else if or .Rows .Changes.Tail}}
  <div class="lq-pill-wrap"><button class="lq-pill" type="button" hidden><span aria-hidden="true">↑</span> <span class="lq-pill-t">New lines</span></button></div>
  {{if not .Rows}}<p class="soft lq-nolines">No lines match in this time frame. The rule changes made in it are below.</p>{{end}}
  <form id="lq-narrow" class="lq-narrow" action="/logs" method="get" hidden>{{range .NarrowFields}}<input type="hidden" name="{{.Name}}" value="{{.Value}}">{{end}}</form>
  <div class="tw phone-list"><table class="t t-log summary-table" role="table"><caption class="sr">Matching record lines, newest first. Text in monospace is what the agent did, shown escaped. Open a row to see every field of its line.</caption><thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader" class="c-time">Time ({{tz}})</th><th scope="col" role="columnheader" class="c-verdict">Verdict</th><th scope="col" role="columnheader" class="c-what">What, and why</th><th scope="col" role="columnheader" class="c-proc">Process</th><th scope="col" role="columnheader" class="c-rule">Rule</th><th scope="col" role="columnheader" class="c-line">Agent and line</th></tr></thead><tbody role="rowgroup" id="lq-rows" data-rows="{{.RowsURL}}" data-after="{{.After}}" data-next="{{.Next}}" data-tail="{{.Tail}}">
{{$ch := .Changes}}{{range .Rows}}{{range index $ch.Before .Cursor}}{{template "rclog" .}}
{{end}}{{template "logrow" .}}
{{end}}{{range $ch.Tail}}{{template "rclog" .}}
{{end}}</tbody></table></div>
  <div class="panel-foot"><span class="lq-keys-hint soft">Keys: <kbd>j</kbd> <kbd>k</kbd> move, <kbd>Enter</kbd> opens a row here, <kbd>o</kbd> opens its line, <kbd>/</kbd> searches</span>{{if .NextURL}}<a class="btn" id="lq-older" href="{{.NextURL}}">Older lines</a>{{end}}</div>
{{else}}
  <div class="empty"><div class="glyph">{{template "i" "i-search"}}</div><h3 data-number="logs.matched">{{if $unknown := unknownCount $.Numbers.Window "Matching lines"}}{{$unknown}}{{else}}{{template "quantity" (quantityZero "logs.matched" "No matching lines" $.Numbers)}}{{end}}</h3>{{if .Filtered}}<a class="btn" href="/logs">Clear filters</a>{{else}}<p data-number="shared.policy">Every line a run records shows here; <span class="mono">tego watch -- &lt;command&gt;</span> starts one.</p>{{end}}</div>
{{end}}
</section>
{{end}}{{end}}
{{/* lsys says how many system lines the search hides and shows them, in the lines view and the group views alike. */}}
{{define "lsys"}}{{$numbers := numbersOf .}}{{$ := numberValue .}}{{with $}}{{if .Page.SysHidden}} · <span title="Still counted in each run">{{template "quantity" (quantity "logs.system-hidden" .Page.SysHidden $numbers)}} system lines hidden</span> · <a class="link" href="{{.ShowNoiseURL}}">Show</a>{{end}}{{end}}{{end}}
{{/* logrows is rows of the Logs table (rowView): the page's, and the fragments GET /logs/rows answers. */}}
{{define "logrows"}}{{range .}}{{template "logrow" .}}
{{end}}{{end}}
{{/* logchanges is the rule-change rows of a search (rclog), as GET /logs/changes answers. */}}
{{define "logchanges"}}{{range .}}{{template "rclog" .}}
{{end}}{{end}}
{{/* logrow is one row: its open button (with JavaScript; the line link opens the line page without it), the time, verdict, what and why, the process (its program and pid narrow the search), the rule and the line. */}}
{{define "logrow"}}<tr role="row" data-k="{{.Key}}"{{with foldKey .Event}} data-f="{{$.Run}}-{{.}}"{{end}} data-c="{{.Cursor}}" class="lq-r v-{{pageVerdictClass .Event .Reads}}{{if .SystemLookup}} sys{{end}}"><td role="cell" class="c-time mono lead"><button class="lx-tog" type="button" aria-expanded="false" aria-label="Open line {{.Seq}} here" title="Every field of this line, here" data-number-exclude-aria-label="logs.fact-1"><span class="lx-chev" aria-hidden="true"></span></button><time datetime="{{iso .TS}}" title="{{stamp .TS}}" data-number-exclude="logs.clock-1">{{clock .TS}}</time></td><td role="cell" data-label="Verdict" class="c-verdict">{{with .Severity}}<span class="sev sev-{{.}}">{{.}}</span> {{end}}{{template "logchip" (withNumbers . $.Numbers)}}</td><td role="cell" data-label="What" class="c-what">{{$code := .Reason}}{{$full := ""}}{{if eq .Kind "exec"}}{{$full = mask .Target}}{{end}}<div class="lw"><span class="op" data-number-exclude="logs.element-1">{{.Words.Action}}</span>{{with shown .Event}}{{template "pw" (pathWordsIn . $.Home $.Cwd $full)}}{{end}}{{if .SystemLookup}}<span class="tag-sys">system lookup</span>{{end}}</div>{{with .Words.Why}}<div class="lw-why" title="Reason code: {{$code}}">{{.}}</div>{{end}}</td><td role="cell" data-label="Process" class="c-proc">{{if .Program}}<button class="lq-prog" type="submit" form="lq-narrow" name="narrow" value="{{.ProgTerm}}" title="Only lines of {{.Program}}">{{.Program}}</button>{{end}}{{if .PIDTerm}}<button class="lq-pid mono" type="submit" form="lq-narrow" name="narrow" value="{{.PIDTerm}}" title="Only lines of process {{.PID}}" data-number-exclude="logs.fact-3">{{if not .Program}}pid {{end}}{{.PID}}</button>{{else if not .Program}}<span class="soft">—</span>{{end}}</td><td role="cell" data-label="Rule" class="c-rule"><span class="clamp" title="{{if .Label}}{{homeIn .Label $.Home}}{{else if .Rule}}{{homeIn (ruleName .Rule) $.Home}}{{else}}—{{end}}{{with .Rule}} · {{.}}{{end}}" data-number-exclude-title="logs.fact-4"><span data-number-exclude="logs.fact-5">{{if .Label}}{{homeIn .Label $.Home}}{{else if .Rule}}{{homeIn (ruleName .Rule) $.Home}}{{else}}—{{end}}</span></span></td><td role="cell" data-label="Line" class="c-line"><div class="lw-end"><span class="row-acts">{{template "rulelink" (acts .Event .Live .Contract)}}</span><a class="link lw-line" href="/runs/{{pathEsc .Run}}/lines/{{.Seq}}" title="Run {{.Run}}, line {{.Seq}}" aria-label="Details of {{.Run}} line {{.Seq}}" data-number-exclude="logs.fact-6"><span class="lw-agent" title="{{if .Agent}}{{.Agent}}{{else}}{{.Run}}{{end}}" data-number-exclude-title="logs.identity-2" data-number-exclude="logs.identity-5">{{if .Agent}}{{.Agent}}{{else}}{{rid .Run}}{{end}}</span><span class="mono lw-seq" data-number-exclude="logs.fact-7">#{{.Seq}}</span></a></div></td><td role="cell" class="phone-cell"><a class="phone-row" href="/runs/{{pathEsc .Run}}/lines/{{.Seq}}"><span class="phone-who" data-number-exclude="logs.agent-field-1">{{if .Agent}}{{.Agent}}{{else}}An agent{{end}}</span>{{template "logchip" (withNumbers . $.Numbers)}}<time class="phone-when" datetime="{{iso .TS}}" data-started="{{iso .TS}}" data-number-exclude="logs.clock-2" data-ck>{{rowAgo .TS .Now}}</time></a></td></tr>{{end}}
{{/* lgroups is the matched lines gathered: each group with its lines and refusals, its first and last time, and links to its lines and its newest line. */}}
{{define "lgroups"}}{{$numbers := numbersOf .}}{{$ := numberValue .}}{{with $}}{{if .Grouped}}<div class="tw"><table class="t t-grp summary-table" role="table"><caption class="sr">The matching lines gathered {{if eq .Group "process"}}by process{{else if eq .Group "target"}}by target{{else if eq .Group "severity"}}by severity{{else}}by rule{{end}}, {{if eq .Group "severity"}}most serious first{{else}}most lines first{{end}}.</caption><thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader" class="g-what">{{if eq .Group "process"}}Process{{else if eq .Group "target"}}Target{{else if eq .Group "severity"}}Severity{{else}}Rule{{end}}</th><th scope="col" role="columnheader" class="g-n">Lines</th><th scope="col" role="columnheader" class="g-n">Refused</th><th scope="col" role="columnheader" class="g-when">First – last ({{tz}})</th><th scope="col" role="columnheader" class="g-line">Newest</th></tr></thead><tbody role="rowgroup">
{{range .Grouped}}<tr role="row" class="{{if .Refused}}v-refused{{end}}"><td role="cell" class="g-what lead">{{if .PID}}<span class="g-main" data-number-exclude="logs.fact-8">{{if .Program}}{{.Program}}{{else}}A process with no program recorded{{end}}</span> <span class="mono soft" data-number-exclude="logs.fact-9">pid {{.PID}}</span><span class="g-sub" data-number-exclude="logs.identity-6">{{if .Agent}}{{.Agent}} · {{end}}{{rid .Run}}</span>{{else if .Target}}<span class="g-main">{{template "pw" (pathWords (mask .Target) .Home "")}}</span>{{with .KindWords}}<span class="g-sub">{{.}}</span>{{end}}{{else if .Severity}}<span class="g-main">{{if or (eq .Severity "High") (eq .Severity "Medium") (eq .Severity "Low")}}<span class="sev sev-{{.Severity}}">{{.Severity}}</span>{{else}}{{.Severity}}{{end}}</span>{{if eq .Severity "Recorded"}}<span class="g-sub">notes, run start and end, and lines recorded without a decision</span>{{end}}{{else if .Rule}}<span class="g-main"{{with .RuleTitle}} title="{{.}}"{{end}}>{{.RuleWords}}</span><span class="g-sub mono" data-number-exclude="logs.fact-10">{{.Rule}}</span>{{else}}<span class="g-main" data-number-exclude="logs.static-2">No rule decided these lines</span><span class="g-sub">notes, run start and end, and lines recorded without a decision</span>{{end}}</td><td role="cell" data-label="Lines" class="g-n">{{if .LinesURL}}<a class="link" href="{{.LinesURL}}" title="Show these lines">{{template "quantity" (quantity "logs.group-lines" .Lines $numbers)}}</a>{{else}}{{template "quantity" (quantity "logs.group-lines" .Lines $numbers)}}{{end}}</td><td role="cell" data-label="Refused" class="g-n">{{if .Refused}}<span class="n-refused">{{template "quantity" (quantity "logs.group-refused" .Refused $numbers)}}</span>{{else}}<span class="soft">{{template "quantity" (quantity "logs.group-refused" 0 $numbers)}}</span>{{end}}</td><td role="cell" data-label="First – last" class="g-when"><time datetime="{{iso .First}}" title="{{stamp .First}}" data-number-exclude="logs.clock-3">{{clock .First}}</time>{{if not (.First.Equal .Last)}} – <time datetime="{{iso .Last}}" title="{{stamp .Last}}" data-number-exclude="logs.clock-4">{{clock .Last}}</time>{{end}}</td><td role="cell" data-label="Newest" class="g-line">{{if .NewestURL}}<a class="link mono" href="{{.NewestURL}}" title="Run {{.NewestRun}}, line {{.NewestSeq}}" data-number-exclude="logs.fact-11">#{{.NewestSeq}}</a>{{end}}</td><td role="cell" class="phone-cell"><a class="phone-row" href="{{.DetailURL}}"><span class="phone-who" data-number-exclude="logs.element-2">{{if .Program}}{{baseName .Program}}{{else if .Target}}Target group{{else if .Severity}}{{.Severity}} events{{else if .Rule}}Rule group{{else}}No deciding rule{{end}}</span>{{if .Refused}}<span class="b b-refused">Includes refusal</span>{{else}}<span class="b b-neutral">Recorded</span>{{end}}<time class="phone-when" datetime="{{iso .Last}}" data-started="{{iso .Last}}" data-number-exclude="logs.clock-5" data-ck>{{rowAgo .Last $.Now}}</time></a></td></tr>
{{end}}</tbody></table></div>{{if .GroupInfo.Keyless}}<div class="panel-foot"><span class="soft" data-number-exclude-text="logs.detail-10">{{template "quantity" (quantity "logs.keyless" .GroupInfo.Keyless $numbers)}} matching {{plural .GroupInfo.Keyless "line names" "lines name"}} no target and {{plural .GroupInfo.Keyless "is" "are"}}<span data-number="logs.keyless"> in no group.</span></span></div>{{end}}{{else}}<div class="empty"><div class="glyph">{{template "i" "i-search"}}</div><h3 data-number="logs.matched">{{if $unknown := unknownCount $numbers.Window "Matching lines"}}{{$unknown}}{{else}}{{template "quantity" (quantityZero "logs.matched" "No matching lines" $numbers)}}{{end}}</h3><p>{{template "quantity" (quantityZero "logs.matched" "Nothing in the runs read matches these filters." $numbers)}}</p></div>{{end}}{{end}}{{end}}
{{/* logline is one row opened in place: the line in a sentence, then when, the process and its parents, the decision, the question it belongs to, every other field in words, and links to the line and the raw JSON. Values are masked as on the row; the exact line is on the line page and in the copy. */}}
{{define "logline"}}{{$lv := .LV}}{{$e := .Ev}}<div class="lx" role="region" aria-label="Line {{$lv.Seq}} of {{$lv.Run}}" data-number-exclude-aria-label="logs.detail-8">
  <p class="lx-sent" data-number-exclude="logs.fact-12">{{mask $lv.Sentence}}</p>
  <dl class="lx-kv">
    <dt>When</dt><dd data-number-exclude-text="logs.specific-1"><time datetime="{{iso $e.TS}}" data-number-exclude="logs.clock-6">{{stamp $e.TS}}</time>{{with .Into}} · {{.}} into the run{{end}}</dd>
    <dt>Process</dt><dd data-number-exclude-text="logs.specific-2">{{with $lv.Proc}}{{if .Name}}<b>{{.Name}}</b> {{end}}<span class="mono">pid {{.PID}}</span>{{if .Refused}} (its start was refused; it still ran its parent's program){{end}}{{else}}<span class="mono" data-number-exclude="logs.specific-3">pid {{$lv.Envelope.PID}}</span>{{with $lv.ProcNote}} · {{.}}{{end}}{{end}}{{with .Parents}}<span class="lx-sub">Started by {{.}}</span>{{end}}{{with $lv.ChainNote}}<span class="lx-sub">{{.}}</span>{{end}}</dd>
    {{if or $e.Verdict $e.Refused}}<dt>Verdict</dt><dd>{{verdictWord $e}}{{with reasonWords $e}} · {{.}}{{end}}{{with $e.Reason}} <span class="mono soft" title="Reason code">{{.}}</span>{{end}}</dd>{{end}}
    {{if $e.Rule}}<dt>Rule</dt><dd data-number-exclude="logs.fact-14">{{if .Label}}{{.Label}}{{else}}{{ruleName $e.Rule}}{{end}} <span class="mono soft" data-number-exclude="logs.identity-9">{{$e.Rule}}</span></dd>{{end}}
    {{with $lv.Ask}}<dt>Question</dt><dd>{{mask .Sentence}}{{if .HasAsk}} · <a class="link" href="/runs/{{pathEsc $lv.Run}}/lines/{{.AskSeq}}">the ask, line {{.AskSeq}}</a>{{end}}{{if .Answered}} · <a class="link" href="/runs/{{pathEsc $lv.Run}}/lines/{{.AnswerSeq}}">the answer, line {{.AnswerSeq}}</a>{{end}}</dd>{{end}}
    {{with $lv.MirrorOf}}<dt>Same refusal as</dt><dd><a class="link" href="/runs/{{pathEsc $lv.Run}}/lines/{{.}}">line {{.}}</a> (this line repeats it for the refusal list)</dd>{{end}}
    {{with $lv.MirroredBy}}<dt>Repeated by</dt><dd><a class="link" href="/runs/{{pathEsc $lv.Run}}/lines/{{.}}" data-number-exclude="logs.mirrored-line">line {{.}}</a><span data-number="shared.policy"> (counted once)</span></dd>{{end}}
    <dt>In the record</dt><dd data-number-exclude="logs.detail-9">line {{$lv.Envelope.Position}} of {{$lv.Envelope.Total}} · <span class="mono" data-number-exclude="logs.line-hash" title="This line's hash: {{$lv.Envelope.ID}}" data-number-exclude-title="logs.explicit-8">{{cut $lv.Envelope.ID 16}}</span>{{if $lv.Envelope.PrevOK}} · links to the line before{{else}} · <b>does not link to the line before</b>{{end}}</dd>
  </dl>
  {{if .Fields}}<details class="lx-all" open><summary>Every field ({{template "quantity" (quantity "logs.query-fields" (len .Fields) exactNumbers)}})</summary><dl class="lx-fields">{{range .Fields}}<dt title="{{.Key}}" data-number-exclude-title="logs.identity-3">{{.Label}}{{if .Unknown}} <span class="soft">(a field this dashboard does not know)</span>{{end}}</dt><dd>{{if .Value}}<span class="ut lx-v" data-number-exclude="logs.record-field">{{.Value}}</span>{{else}}<span class="soft">empty</span>{{end}}</dd>{{end}}</dl></details>{{end}}
  <div class="lx-acts"><a class="btn btn-sm" href="/runs/{{pathEsc $lv.Run}}/lines/{{$lv.Seq}}" data-number-exclude="logs.fact-16">Open line {{$lv.Seq}}</a><button class="btn btn-sm lx-copy" type="button" title="Copies the line exactly as written, secrets included">Copy the line (JSON)</button><template data-exact class="lx-raw" data-number-exclude="logs.literal-11">{{$lv.Raw}}</template></div>
</div>{{end}}
{{/* pw is a row's text from pathWords (shown.go): a <wbr> between pieces cut after each / and : and at spaces, each short hyphenated word in a no-wrap span (pwp, layout.tmpl), so it wraps only between names; a path's folder muted and its file name bold, the full path in the title. */}}
{{define "pw"}}{{if .Parts}}{{range $i, $p := .Parts}}{{if $i}} → {{end}}<span class="ut pw" title="{{$p.Full}}" data-number-exclude-title="logs.explicit-1"><span class="sp-d">{{template "pwp" $p.Dir}}</span>{{if $p.Dir}}<wbr>{{end}}<b class="sp-b">{{template "pwp" $p.Base}}</b></span>{{end}}{{else}}<span class="ut pw"{{with .Title}} title="{{.}}"{{end}} data-number-exclude-title="logs.explicit-2">{{template "pwp" .Text}}</span>{{end}}{{end}}

{{define "logs-filters"}}{{with .Data}}<form class="filters lq-form" action="/logs" method="get" role="search" aria-label="Search the ledgers">
  <div class="frow lq-top">
    <label class="field search lq-text"><span class="lq-field-label">Search</span>{{template "i" "i-search"}}<input class="input" type="search" name="q" value="{{.F.Text}}" placeholder="Path, host or command…" autocomplete="off" title="Text anywhere in the line, exactly as typed" data-number-exclude-value="logs.search-query"></label>

    <button class="btn btn-primary" type="submit">{{template "i" "i-search"}}Show events</button>
  </div>
  {{if .Chips}}<div class="chips lq-chips" role="group" aria-label="Query terms: each one narrows the lines">{{range .Chips}}<span class="chip lq-chip{{if .Neg}} lq-neg{{end}}"><span class="mono" data-number-exclude="logs.fact-17">{{.Text}}</span><a class="x" href="{{.RemoveURL}}" aria-label="Remove {{.Text}} from the query" title="Remove" data-number-exclude="logs.fact-18">×</a></span>{{end}}</div>{{end}}
  {{$adv := or .F.Run .F.Agent .F.Kind .Verdicts .HideSys}}<details class="lq-adv"{{if $adv}} open{{end}}><summary class="lq-adv-s">Filters{{if $adv}} <span class="lq-adv-on">on</span>{{end}}<span class="lq-adv-c" aria-hidden="true"></span></summary>
  <div class="lq-adv-in">
    <label class="field search lq-where"><span class="lq-field-label">Query</span>{{template "i" "i-search"}}<input class="input mono" type="search" name="where" value="{{.Where}}" placeholder="verdict:refused host:example.com…" title="Query: key:value terms (How to write a query, under Filters)" autocomplete="off" spellcheck="false" aria-describedby="lq-help-s"></label>
  <div class="frow">
    <label class="field">Run<select class="select" name="run"><option value="">All runs</option>{{$run := .F.Run}}{{range .Runs}}<option value="{{.ID}}"{{if eq .ID $run}} selected{{end}} data-number-exclude="logs.identity-10">{{rid .ID}} {{.Agent}}</option>{{end}}</select>{{if .RunsMore}}<span class="lq-note" title="Older runs: the Run facet and Runs">Newest <span data-number="logs.run-options-limit">50</span></span>{{end}}</label>
    <label class="field">Agent<select class="select" name="agent"><option value="">All agents</option>{{$ag := .F.Agent}}{{range .Agents}}<option{{if eq . $ag}} selected{{end}} data-number-exclude="logs.agent-filter">{{.}}</option>{{end}}</select></label>
    <label class="field">Kind<select class="select" name="kind">{{$k := .F.Kind}}<option value="">All actions</option><option value="fs"{{if eq $k "fs"}} selected{{end}}>Files (fs)</option><option value="net"{{if eq $k "net"}} selected{{end}}>Network (net)</option><option value="exec"{{if eq $k "exec"}} selected{{end}}>Commands (exec)</option><option value="refused"{{if eq $k "refused"}} selected{{end}}>Refused</option><option value="ask"{{if eq $k "ask"}} selected{{end}}>Asks and answers</option><option value="run"{{if eq $k "run"}} selected{{end}}>Run start and end</option></select></label>
  </div>
  <div class="frow">
    <fieldset class="checks"><legend>Verdict</legend>
      <label class="check"><input type="checkbox" name="verdict" value="refused"{{if index .Verdicts "refused"}} checked{{end}}>Refused</label>
      <label class="check"><input type="checkbox" name="verdict" value="ask"{{if index .Verdicts "ask"}} checked{{end}}>Asked</label>
      <label class="check"><input type="checkbox" name="verdict" value="allow"{{if index .Verdicts "allow"}} checked{{end}}>Allowed</label>
      <label class="check"><input type="checkbox" name="verdict" value="observed"{{if index .Verdicts "observed"}} checked{{end}}>Observed</label>
      <label class="check" data-number-exclude="logs.detail-2"><input type="checkbox" name="verdict" value="none"{{if index .Verdicts "none"}} checked{{end}}>Recorded (no verdict)</label>
    </fieldset>
    <fieldset class="checks"><legend>Noise</legend>
      <label class="check"><input type="checkbox" name="sys" value="hide"{{if .HideSys}} checked{{end}}>Hide system lookups</label>
      <label class="check" title="Reads of /proc, /sys, /dev and system libraries"><input type="checkbox" name="noise" value="show"{{if .ShowNoise}} checked{{end}}>Show system reads</label>
    </fieldset>
  </div>
  <label class="field">Group events<select class="select" name="group">{{range .GroupTabs}}<option value="{{if eq .Label "Lines"}}{{else if eq .Label "By process"}}process{{else if eq .Label "By target"}}target{{else if eq .Label "By severity"}}severity{{else}}rule{{end}}"{{if .Current}} selected{{end}}>{{.Label}}</option>{{end}}</select></label><div class="frow lq-quick">
    <nav class="chips" aria-label="Time range"><span class="lq-lbl">Time</span>{{range .Times}}<a class="chip" href="{{.URL}}" title="{{.Title}}"{{if .Current}} aria-current="true"{{end}} data-number-exclude="logs.explicit-4">{{.Label}}</a>{{end}}</nav>
    <nav class="chips" aria-label="Built-in views"><span class="lq-lbl">Views</span>{{range .Presets}}<a class="chip preset" href="{{.URL}}" title="{{.Title}}"{{if .Current}} aria-current="true"{{end}} data-number-exclude="logs.explicit-5">{{.Label}}</a>{{end}}{{if .Filtered}}<a class="chip" href="/logs">Clear filters</a>{{end}}</nav>
  </div>
  <section class="lq-side" aria-labelledby="lq-side-h"><h2 class="lq-lbl" id="lq-side-h">Narrow</h2>{{template "lr" (index $.L "r-logs-facets")}}{{template "r-logs-facets" $}}</div></section>
  <div class="frow lq-saved-row" id="lq-saved" hidden><nav class="chips" aria-label="Your saved views"><span class="lq-lbl">Saved</span><span class="lq-saved-list"></span><button class="chip lq-save" type="button" title="Keep this view (its search and grouping) under a name, in this browser only">+ Save this view</button></nav></div>
  <div class="row"><a class="btn" href="{{.ExportCSV}}" download>Export CSV</a><a class="btn" href="{{.ExportJSONL}}" download title="Original unmasked record; may include secrets. A filtered download is not a complete chain.">Record (JSONL)</a><a class="btn" href="/compare">Compare runs</a><a class="btn" href="/logs">Clear filters</a></div>
  <p class="lq-note">Record downloads keep original values and may include secrets. Choose a whole run to download a complete chain.</p>
  <details class="lq-help"><summary id="lq-help-s">How to write a query</summary>
    <p class="soft">Space = and · <span class="mono">-</span> = not · same key twice, or OR between them = either · <span class="mono">"quotes"</span> search the text as written</p>
    <dl class="lq-keys">
      <dt class="mono" data-number-exclude="logs.literal-9">verdict:refused</dt><dd data-number-exclude="logs.static-1">refused, allow, ask, observed or none</dd>
      <dt class="mono" data-number-exclude="logs.literal-8">kind:exec</dt><dd>fs (files), net, exec (commands), ask, run, refused, gap</dd>
      <dt class="mono">kind:change</dt><dd>the rule changes: a change, an undo or a new rules file</dd>
      <dt class="mono" data-number-exclude="logs.literal-7">host:chatgpt.com</dt><dd>the host a connection named</dd>
      <dt class="mono" data-number-exclude="logs.literal-6">path:~/.ssh</dt><dd>this file or folder and everything in it; ~ is the run's home</dd>
      <dt class="mono" data-number-exclude="logs.literal-5">rule:fs.deny_read*</dt><dd>a rule, exactly or by the start of its name with *</dd>
      <dt class="mono" data-number-exclude="logs.literal-4">since:15m until:01:00</dt><dd data-number-exclude="logs.literal-10">15m, 2h, 7d back from now (the page writes it as the time it means, so it stays), or a time such as 2026-10-27T01:00</dd>
      <dt class="mono">target:/etc/hosts</dt><dd>the one file, address or command a group by target is named by, in every spelling of it</dd>
      <dt class="mono" data-number-exclude="logs.literal-3">prog:curl prog:/usr/bin</dt><dd>the program the line's process was running, by name or by where it is; a folder holds the programs in it</dd>
      <dt class="mono" data-number-exclude="logs.literal-12">step:3 step:none</dt><dd data-number-exclude="logs.literal-13">the lines the record ties to that model step, or to none; the same lines as <span class="mono">tego events --step</span> prints, except that Logs shows a refusal once (the line that mirrors a refused action sits with its action)</dd>
      <dt class="mono" data-number-exclude="logs.literal-2">pid:4242 run:r-… agent:codex source:kernel</dt><dd>one process, run, agent or recorder</dd>
      <dt class="mono" data-number-exclude="logs.literal-1">-kind:run -"system lookup"</dt><dd>leave these lines out</dd>
    </dl>
  </details>
  </div></details>
<details class="lq-shortcuts"><summary>Keyboard shortcuts</summary><p>Tab follows links and controls. With scripts on, j and k move through events. Enter opens a row on desktop and its Event page on smaller screens; o opens the Event page; / opens search.</p></details></form>{{end}}{{end}}

{{define "logchip"}}{{$numbers := numbersOf .}}{{$ := numberValue .}}{{with $}}{{$asked := and (eq .Kind "ask") (eq .Verdict "")}}{{$ans := answerChip .Event}}<span class="b b-{{pageVerdictClass .Event .Reads}}"{{if $asked}} title="Tego asked a person; the answer is the next line of this ask"{{else if $ans.Word}} title="A person's answer to the ask before it"{{else if gt .Count 1}} title="{{quantityText "logs.repeat" .Count $numbers}} identical lines folded, {{stamp .First}} to {{stamp .TS}}"{{end}} data-number-title="logs.repeat">{{template "i" (pageVerdictIcon .Event .Reads)}}{{.Words.Verdict}}{{if gt .Count 1}} ×{{template "quantity" (quantity "logs.repeat" .Count $numbers)}}{{end}}</span>{{end}}{{end}}

{{define "log-group-detail"}}{{$numbers := numbersOf .}}{{$ := numberValue .}}{{with $}}<section class="panel-body lq-group-detail"><h2>Group details</h2><dl class="lq-group-kv"><dt>What</dt><dd>{{if .Program}}{{.Program}}{{else if .Target}}<span class="ut">{{mask .Target}}</span>{{else if .Severity}}{{.Severity}}{{else}}{{.RuleWords}}{{end}}</dd>{{if .PID}}<dt>Process</dt><dd>{{.PID}}</dd>{{end}}{{if .Rule}}<dt>Rule</dt><dd>{{.Rule}}</dd>{{end}}<dt>Lines</dt><dd>{{template "quantity" (quantity "logs.group-lines" .Lines $numbers)}}</dd><dt>Refused</dt><dd>{{template "quantity" (quantity "logs.group-refused" .Refused $numbers)}}</dd><dt>First</dt><dd><time datetime="{{iso .First}}">{{stamp .First}}</time></dd><dt>Last</dt><dd><time datetime="{{iso .Last}}">{{stamp .Last}}</time></dd></dl><div class="row">{{if .LinesURL}}<a class="btn" href="{{.LinesURL}}">Show these events</a>{{end}}<a class="btn" href="{{.NewestURL}}">Newest event</a></div></section>{{end}}{{end}}
