{{/* SPDX-License-Identifier: Apache-2.0 */}}
{{/* Logs: the search form (a literal text search q, a query in the query language where, and the form's fields), the facets beside the rows, the Lines / By process / By target / By rule switch, and the downloads. Everything is a GET form or a link, so the page works with JavaScript off; static/logs.js adds the live tail, older rows in place, rows opened in place, saved views and the j/k keys. */}}
{{define "content"}}<link rel="stylesheet" href="/static/logs.css"><script src="/static/logs.js" defer></script>{{template "lr" (index $.L "r-logs-head")}}{{template "r-logs-head" $}}</div>{{with .Data}}
<details class="fsheet"><summary>Search and filters{{if .Filtered}} <span class="soft">filtered</span>{{end}}</summary>
{{/* One row: the text search, the query and Search; the run, agent, kind, verdict, time and view filters fold under "Filters", open while one of them narrows the lines, so the rows start near the top. Folded fields still go with the form. */}}
<form class="filters lq-form" action="/logs" method="get" role="search" aria-label="Search the ledgers">
  <div class="frow lq-top">
    <label class="field search lq-text"><span class="sr">Text</span>{{template "i" "i-search"}}<input class="input" type="search" name="q" value="{{.F.Text}}" placeholder=".ssh, 127.0.0.1, curl" title="Text anywhere in the line, exactly as typed"></label>
    <label class="field search lq-where"><span class="sr">Query</span>{{template "i" "i-search"}}<input class="input mono" type="search" name="where" value="{{.Where}}" placeholder="Query: verdict:refused host:chatgpt.com since:15m" title="Query: key:value terms (How to write a query, under Filters)" autocomplete="off" spellcheck="false" aria-describedby="lq-help-s"></label>
    <button class="btn btn-primary" type="submit">{{template "i" "i-search"}}Search</button>
  </div>
  {{if .QueryErr}}<p class="lq-err" role="alert">{{template "i" "i-triangle-alert"}}<span>Part of the query was left out: {{.QueryErr}}</span></p>{{end}}
  {{if .Chips}}<div class="chips lq-chips" role="group" aria-label="Query terms: each one narrows the lines">{{range .Chips}}<span class="chip lq-chip{{if .Neg}} lq-neg{{end}}"><span class="mono">{{.Text}}</span><a class="x" href="{{.RemoveURL}}" aria-label="Remove {{.Text}} from the query" title="Remove">×</a></span>{{end}}</div>{{end}}
  {{$adv := or .F.Run .F.Agent .F.Kind .Verdicts .HideSys}}<details class="lq-adv"{{if $adv}} open{{end}}><summary class="lq-adv-s">Filters{{if $adv}} <span class="lq-adv-on">on</span>{{end}}<span class="lq-adv-c" aria-hidden="true"></span></summary>
  <div class="lq-adv-in">
  <div class="frow">
    <label class="field">Run<select class="select" name="run"><option value="">All runs</option>{{$run := .F.Run}}{{range .Runs}}<option value="{{.ID}}"{{if eq .ID $run}} selected{{end}}>{{rid .ID}} {{.Agent}}</option>{{end}}</select>{{if .RunsMore}}<span class="lq-note" title="Older runs: the Run facet and Runs">Newest 50</span>{{end}}</label>
    <label class="field">Agent<select class="select" name="agent"><option value="">All agents</option>{{$ag := .F.Agent}}{{range .Agents}}<option{{if eq . $ag}} selected{{end}}>{{.}}</option>{{end}}</select></label>
    <label class="field">Kind<select class="select" name="kind">{{$k := .F.Kind}}<option value="">All actions</option><option value="fs"{{if eq $k "fs"}} selected{{end}}>Files (fs)</option><option value="net"{{if eq $k "net"}} selected{{end}}>Network (net)</option><option value="exec"{{if eq $k "exec"}} selected{{end}}>Commands (exec)</option><option value="refused"{{if eq $k "refused"}} selected{{end}}>Blocked</option><option value="ask"{{if eq $k "ask"}} selected{{end}}>Asks and answers</option><option value="run"{{if eq $k "run"}} selected{{end}}>Run start and end</option></select></label>
  </div>
  <div class="frow">
    <fieldset class="checks"><legend>Verdict</legend>
      <label class="check"><input type="checkbox" name="verdict" value="refused"{{if index .Verdicts "refused"}} checked{{end}}>Refused</label>
      <label class="check"><input type="checkbox" name="verdict" value="ask"{{if index .Verdicts "ask"}} checked{{end}}>Asked</label>
      <label class="check"><input type="checkbox" name="verdict" value="allow"{{if index .Verdicts "allow"}} checked{{end}}>Allowed</label>
      <label class="check"><input type="checkbox" name="verdict" value="observed"{{if index .Verdicts "observed"}} checked{{end}}>Observed</label>
      <label class="check"><input type="checkbox" name="verdict" value="none"{{if index .Verdicts "none"}} checked{{end}}>Recorded (no verdict)</label>
    </fieldset>
    <fieldset class="checks"><legend>Noise</legend>
      <label class="check"><input type="checkbox" name="sys" value="hide"{{if .HideSys}} checked{{end}}>Hide system lookups</label>
      <label class="check" title="Reads of /proc, /sys, /dev and system libraries"><input type="checkbox" name="noise" value="show"{{if .ShowNoise}} checked{{end}}>Show system reads</label>
    </fieldset>
  </div>
  <div class="frow lq-quick">
    <nav class="chips" aria-label="Time range"><span class="lq-lbl">Time</span>{{range .Times}}<a class="chip" href="{{.URL}}" title="{{.Title}}"{{if .Current}} aria-current="true"{{end}}>{{.Label}}</a>{{end}}</nav>
    <nav class="chips" aria-label="Built-in views"><span class="lq-lbl">Views</span>{{range .Presets}}<a class="chip preset" href="{{.URL}}" title="{{.Title}}"{{if .Current}} aria-current="true"{{end}}>{{.Label}}</a>{{end}}{{if .Filtered}}<a class="chip" href="/logs">Clear filters</a>{{end}}</nav>
  </div>
  <section class="lq-side" aria-labelledby="lq-side-h"><h2 class="lq-lbl" id="lq-side-h">Narrow</h2>{{template "lr" (index $.L "r-logs-facets")}}{{template "r-logs-facets" $}}</div></section>
  <div class="frow lq-saved-row" id="lq-saved" hidden><nav class="chips" aria-label="Your saved views"><span class="lq-lbl">Saved</span><span class="lq-saved-list"></span><button class="chip lq-save" type="button" title="Keep this view (its search and grouping) under a name, in this browser only">+ Save this view</button></nav></div>
  <details class="lq-help"><summary id="lq-help-s">How to write a query</summary>
    <p class="soft">Space = and · <span class="mono">-</span> = not · same key twice = or</p>
    <dl class="lq-keys">
      <dt class="mono">verdict:refused</dt><dd>refused, allow, ask, observed or none</dd>
      <dt class="mono">kind:exec</dt><dd>fs (files), net, exec (commands), ask, run, refused, gap</dd>
      <dt class="mono">host:chatgpt.com</dt><dd>the host a connection named</dd>
      <dt class="mono">path:~/.ssh</dt><dd>this file or folder and everything in it; ~ is the run's home</dd>
      <dt class="mono">rule:fs.deny_read*</dt><dd>a rule, exactly or by the start of its name with *</dd>
      <dt class="mono">since:15m until:01:00</dt><dd>15m, 2h, 7d back from now, or a time such as 2026-10-27T01:00</dd>
      <dt class="mono">prog:curl</dt><dd>the program the line's process was running</dd>
      <dt class="mono">pid:4242 run:r-… agent:codex source:kernel</dt><dd>one process, run, agent or recorder</dd>
      <dt class="mono">-kind:run -"system lookup"</dt><dd>leave these lines out</dd>
    </dl>
  </details>
  </div></details>
</form></details>{{end}}
<div class="lq-grid">
<div class="lq-main">{{template "lr" (index $.L "r-logs-rows")}}{{template "r-logs-rows" $}}</div></div>
</div>
{{end}}
{{/* r-logs-head is one sentence: how many lines, how they fold into rows and how many a page shows, then the refused and asked counts (each refusal counts once: a refused action and the line that mirrors it are one); and the downloads of every matching line. */}}
{{define "r-logs-head"}}{{with .Data}}<div class="head"><div><h1>Logs</h1><p class="lede">{{countWord .Page.Matched}} {{plural .Page.Matched "line" "lines"}} · <span class="n-refused">{{countWord (index .Page.Counts "refused")}} blocked</span> · <span class="n-asked">{{countWord (index .Page.Counts "ask")}} asked</span></p></div>{{if .ExportLines}}<div class="head-actions lq-dl"><a class="btn" href="{{.ExportCSV}}" download title="The {{countWord .ExportLines}} matching {{plural .ExportLines "line" "lines"}}{{if .ExportMore}}, the {{countWord .ExportMore}} hidden system {{plural .ExportMore "line" "lines"}} included,{{end}} as a spreadsheet, oldest first, in the page's words; secrets masked as on the page">{{template "i" "i-download"}}CSV</a><a class="btn" href="{{.ExportJSONL}}" download title="{{if .ExportLedger}}This run's whole ledger: all {{countWord .ExportLedger}} {{plural .ExportLedger "line" "lines"}} of its events file, byte for byte, oldest first, the refusal notes included, so `tego events --verify` style tooling can check the chain.{{else}}The {{countWord .ExportLines}} matching ledger {{plural .ExportLines "line" "lines"}}{{if .ExportMore}}, the {{countWord .ExportMore}} hidden system {{plural .ExportMore "line" "lines"}} included{{end}}, byte for byte, oldest first. Refusal notes (the kind refused line written beside each refused action) are left out unless the search asks for kind refused, so this is not a chain anything can check: pick one run and nothing else for the whole ledger.{{end}} Not masked: this is your own ledger, so it holds what the agent sent, secrets included.">{{template "i" "i-download"}}Record (JSONL)</a></div>{{end}}</div>{{end}}{{end}}
{{/* r-logs-facets is the matched lines counted six ways: a value adds itself to the query (or, already in it, removes itself) and its − leaves it out. */}}
{{define "r-logs-facets"}}{{with .Data}}<nav class="lq-facets" aria-label="Narrow the search">{{range .Facets}}<section class="lq-fg"><h2 class="lq-fh">{{.Name}}</h2><ul>{{range .Items}}<li class="lq-fi{{if .Active}} on{{end}}"><a class="lq-add" href="{{.AddURL}}" title="{{if .Active}}Remove {{.Title}} from the query{{else}}Only lines with {{.Title}}{{end}}"{{if .Active}} aria-current="true"{{end}}><span class="lq-l">{{.Label}}</span><span class="lq-n">{{countWord .Count}}</span></a>{{if not .Active}}<a class="lq-not" href="{{.NotURL}}" title="Leave out lines with {{.Title}}" aria-label="Leave out {{.Label}}">−</a>{{end}}</li>{{end}}</ul>{{if .More}}<p class="lq-more">and {{.More}} more</p>{{end}}</section>{{else}}<p class="soft lq-none">No lines to narrow.</p>{{end}}</nav>{{end}}{{end}}
{{/* r-logs-rows is the rows of the search, or its groups, with the rule changes among the first render's rows (rclog, changefeed.go). In lines mode the tbody names where logs.js asks for newer rows (data-rows with data-after, the newest row's cursor) and older ones (data-next): with JavaScript the page follows new lines itself, at the top, and the live region is left to it. */}}
{{define "r-logs-rows"}}{{with .Data}}<section class="panel" id="log-results" aria-labelledby="h-res">
  <div class="panel-head lq-ph"><h2 id="h-res" class="soft">{{if .Group}}{{.GroupInfo.Total}} {{plural .GroupInfo.Total "group" "groups"}} of {{countWord .GroupInfo.Matched}} {{plural .GroupInfo.Matched "line" "lines"}}{{if gt .GroupInfo.Total (len .Grouped)}} · the {{len .Grouped}} with the most lines{{end}}{{template "lsys" .}}{{else}}<span><span class="lq-shown">{{countWord (len .Rows)}}</span> of <span class="lq-total">{{countWord .Page.Groups}}</span> <span class="lq-rows-w">{{plural .Page.Groups "row" "rows"}}</span> shown{{template "lsys" .}}</span>{{end}}</h2><nav class="lq-by" aria-label="Show the lines as">{{range .GroupTabs}}<a href="{{.URL}}" title="{{.Title}}"{{if .Current}} aria-current="page"{{end}}>{{.Label}}</a>{{end}}</nav></div>
{{if .Group}}{{template "lgroups" .}}{{else if .Rows}}
  <div class="lq-pill-wrap"><button class="lq-pill" type="button" hidden><span aria-hidden="true">↑</span> <span class="lq-pill-t">New lines</span></button></div>
  <div class="tw"><table class="t t-log" role="table"><caption class="sr">Matching record lines, newest first. Text in monospace is what the agent did, shown escaped. Open a row to see every field of its line.</caption><thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader" class="c-time">Time ({{tz}})</th><th scope="col" role="columnheader" class="c-verdict">Verdict</th><th scope="col" role="columnheader" class="c-what">What, and why</th><th scope="col" role="columnheader" class="c-proc">Process</th><th scope="col" role="columnheader" class="c-rule">Rule</th><th scope="col" role="columnheader" class="c-line">Agent and line</th></tr></thead><tbody role="rowgroup" id="lq-rows" data-rows="{{.RowsURL}}" data-after="{{.After}}" data-next="{{.Next}}">
{{$ch := .Changes}}{{range .Rows}}{{range index $ch.Before .Cursor}}{{template "rclog" .}}
{{end}}{{template "logrow" .}}
{{end}}{{range $ch.Tail}}{{template "rclog" .}}
{{end}}</tbody></table></div>
  <div class="panel-foot"><span class="lq-keys-hint soft">Keys: <kbd>j</kbd> <kbd>k</kbd> move, <kbd>Enter</kbd> opens a row here, <kbd>o</kbd> opens its line, <kbd>/</kbd> searches</span>{{if .NextURL}}<a class="btn" id="lq-older" href="{{.NextURL}}">Older lines</a>{{end}}</div>
{{else}}
  <div class="empty"><div class="glyph">{{template "i" "i-search"}}</div><h3>No matching lines</h3>{{if .Filtered}}<a class="btn" href="/logs">Clear filters</a>{{end}}</div>
{{end}}
</section>
{{end}}{{end}}
{{/* lsys says how many system lines the search hides and shows them, in the lines view and the group views alike. */}}
{{define "lsys"}}{{if .Page.SysHidden}} · <span title="Still counted in each run">{{countWord .Page.SysHidden}} system lines hidden</span> · <a class="link" href="{{.ShowNoiseURL}}">Show</a>{{end}}{{end}}
{{/* logrows is rows of the Logs table (rowView): the page's, and the fragments GET /logs/rows answers. */}}
{{define "logrows"}}{{range .}}{{template "logrow" .}}
{{end}}{{end}}
{{/* logrow is one row: its open button (with JavaScript; the line link opens the line page without it), the time, verdict, what and why, the process (its program and pid narrow the search), the rule and the line. */}}
{{define "logrow"}}{{$asked := and (eq .Kind "ask") (eq .Verdict "")}}{{$ans := answerChip .Event}}<tr role="row" data-k="{{.Key}}"{{with foldKey .Event}} data-f="{{$.Run}}-{{.}}"{{end}} data-c="{{.Cursor}}" class="lq-r v-{{if $asked}}asked{{else if $ans.Word}}{{$ans.Class}}{{else}}{{verdictClass .Event}}{{end}}{{if .SystemLookup}} sys{{end}}"><td role="cell" class="c-time mono lead"><button class="lx-tog" type="button" aria-expanded="false" aria-label="Open line {{.Seq}} here" title="Every field of this line, here"><span class="lx-chev" aria-hidden="true"></span></button><time datetime="{{iso .TS}}" title="{{stamp .TS}}">{{clockms .TS}}</time></td><td role="cell" data-label="Verdict" class="c-verdict">{{with .Severity}}<span class="sev sev-{{.}}">{{.}}</span> {{end}}{{if $asked}}<span class="b b-asked" title="Tego asked a person; the answer is the next line of this ask">{{template "i" "i-hand"}}Asked</span>{{else if $ans.Word}}<span class="b b-{{$ans.Class}}" title="A person's answer to the ask before it">{{template "i" $ans.Icon}}{{$ans.Word}}</span>{{else}}<span class="b b-{{verdictClass .Event}}">{{template "i" (verdictIcon .Event)}}{{verdictWord .Event}}</span>{{end}}</td><td role="cell" data-label="What" class="c-what">{{$code := .Reason}}{{$full := ""}}{{if eq .Kind "exec"}}{{$full = mask .Target}}{{end}}<div class="lw"><span class="op">{{shownOp .Event}}</span>{{with shown .Event}}{{template "pw" (pathWordsIn . $.Home $.Cwd $full)}}{{end}}{{if gt .Count 1}}<span class="xn" title="{{.Count}} identical lines folded, {{clock .First}} to {{clock .TS}}">×{{.Count}}</span>{{end}}{{if .SystemLookup}}<span class="tag-sys">system lookup</span>{{end}}</div>{{with reasonWords .Event}}<div class="lw-why" title="Reason code: {{$code}}">{{.}}</div>{{end}}</td><td role="cell" data-label="Process" class="c-proc">{{if .Program}}<a class="lq-prog" href="{{.ProgURL}}" title="Only lines of {{.Program}}">{{.Program}}</a>{{end}}{{if .PIDURL}}<a class="lq-pid mono" href="{{.PIDURL}}" title="Only lines of process {{.PID}}">{{if not .Program}}pid {{end}}{{.PID}}</a>{{else if not .Program}}<span class="soft">—</span>{{end}}</td><td role="cell" data-label="Rule" class="c-rule"><span class="clamp" title="{{.Rule}}"><span>{{if .Label}}{{homeIn .Label $.Home}}{{else if .Rule}}{{homeIn (ruleName .Rule) $.Home}}{{else}}—{{end}}</span></span></td><td role="cell" data-label="Line" class="c-line"><div class="lw-end"><span class="row-acts">{{template "rulelink" (acts .Event .Live .Contract)}}</span><a class="link lw-line" href="/runs/{{pathEsc .Run}}/lines/{{.Seq}}" title="Run {{.Run}}, line {{.Seq}}" aria-label="Details of {{.Run}} line {{.Seq}}"><span class="lw-agent">{{if .Agent}}{{.Agent}}{{else}}{{rid .Run}}{{end}}</span><span class="mono lw-seq">#{{.Seq}}</span></a></div></td></tr>{{end}}
{{/* lgroups is the matched lines gathered: each group with its lines and refusals, its first and last time, and links to its lines and its newest line. */}}
{{define "lgroups"}}{{if .Grouped}}<div class="tw"><table class="t t-grp" role="table"><caption class="sr">The matching lines gathered {{if eq .Group "process"}}by process{{else if eq .Group "target"}}by target{{else if eq .Group "severity"}}by severity{{else}}by rule{{end}}, {{if eq .Group "severity"}}most serious first{{else}}most lines first{{end}}.</caption><thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader" class="g-what">{{if eq .Group "process"}}Process{{else if eq .Group "target"}}Target{{else if eq .Group "severity"}}Severity{{else}}Rule{{end}}</th><th scope="col" role="columnheader" class="g-n">Lines</th><th scope="col" role="columnheader" class="g-n">Blocked</th><th scope="col" role="columnheader" class="g-when">First – last ({{tz}})</th><th scope="col" role="columnheader" class="g-line">Newest</th></tr></thead><tbody role="rowgroup">
{{range .Grouped}}<tr role="row" class="{{if .Refused}}v-refused{{end}}"><td role="cell" class="g-what lead">{{if .PID}}<span class="g-main">{{if .Program}}{{.Program}}{{else}}A process with no program recorded{{end}}</span> <span class="mono soft">pid {{.PID}}</span><span class="g-sub">{{if .Agent}}{{.Agent}} · {{end}}{{rid .Run}}</span>{{else if .Target}}<span class="g-main">{{template "pw" (pathWords (mask .Target) .Home "")}}</span>{{with .KindWords}}<span class="g-sub">{{.}}</span>{{end}}{{else if .Severity}}<span class="g-main">{{if or (eq .Severity "High") (eq .Severity "Medium") (eq .Severity "Low")}}<span class="sev sev-{{.Severity}}">{{.Severity}}</span>{{else}}{{.Severity}}{{end}}</span>{{if eq .Severity "Recorded"}}<span class="g-sub">notes, run start and end, and lines recorded without a decision</span>{{end}}{{else if .Rule}}<span class="g-main"{{with .RuleTitle}} title="{{.}}"{{end}}>{{.RuleWords}}</span><span class="g-sub mono">{{.Rule}}</span>{{else}}<span class="g-main">No rule decided these lines</span><span class="g-sub">notes, run start and end, and lines recorded without a decision</span>{{end}}</td><td role="cell" data-label="Lines" class="g-n">{{if .LinesURL}}<a class="link" href="{{.LinesURL}}" title="Show these lines">{{countWord .Lines}}</a>{{else}}{{countWord .Lines}}{{end}}</td><td role="cell" data-label="Blocked" class="g-n">{{if .Refused}}<span class="n-refused">{{countWord .Refused}}</span>{{else}}<span class="soft">0</span>{{end}}</td><td role="cell" data-label="First – last" class="g-when"><time datetime="{{iso .First}}" title="{{stamp .First}}">{{clock .First}}</time>{{if not (.First.Equal .Last)}} – <time datetime="{{iso .Last}}" title="{{stamp .Last}}">{{clock .Last}}</time>{{end}}</td><td role="cell" data-label="Newest" class="g-line">{{if .NewestURL}}<a class="link mono" href="{{.NewestURL}}" title="Run {{.NewestRun}}, line {{.NewestSeq}}">#{{.NewestSeq}}</a>{{end}}</td></tr>
{{end}}</tbody></table></div>{{if .GroupInfo.Keyless}}<div class="panel-foot"><span class="soft">{{countWord .GroupInfo.Keyless}} matching {{plural .GroupInfo.Keyless "line names" "lines name"}} no target and {{plural .GroupInfo.Keyless "is" "are"}} in no group.</span></div>{{end}}{{else}}<div class="empty"><div class="glyph">{{template "i" "i-search"}}</div><h3>No matching lines</h3><p>Nothing in the runs read matches these filters.</p></div>{{end}}{{end}}
{{/* logline is one row opened in place: the line in a sentence, then when, the process and its parents, the decision, the question it belongs to, every other field in words, and links to the line and the raw JSON. Values are masked as on the row; the exact line is on the line page and in the copy. */}}
{{define "logline"}}{{$lv := .LV}}{{$e := .Ev}}<div class="lx" role="region" aria-label="Line {{$lv.Seq}} of {{$lv.Run}}">
  <p class="lx-sent">{{mask $lv.Sentence}}</p>
  <dl class="lx-kv">
    <dt>When</dt><dd><time datetime="{{iso $e.TS}}">{{stamp $e.TS}}</time>{{with .Into}} · {{.}} into the run{{end}}</dd>
    <dt>Process</dt><dd>{{with $lv.Proc}}{{if .Name}}<b>{{.Name}}</b> {{end}}<span class="mono">pid {{.PID}}</span>{{if .Refused}} (its start was refused; it still ran its parent's program){{end}}{{else}}<span class="mono">pid {{$lv.Envelope.PID}}</span>{{with $lv.ProcNote}} · {{.}}{{end}}{{end}}{{with .Parents}}<span class="lx-sub">Started by {{.}}</span>{{end}}{{with $lv.ChainNote}}<span class="lx-sub">{{.}}</span>{{end}}</dd>
    {{if or $e.Verdict $e.Refused}}<dt>Verdict</dt><dd>{{verdictWord $e}}{{with reasonWords $e}} · {{.}}{{end}}{{with $e.Reason}} <span class="mono soft" title="Reason code">{{.}}</span>{{end}}</dd>{{end}}
    {{if $e.Rule}}<dt>Rule</dt><dd>{{if .Label}}{{.Label}}{{else}}{{ruleName $e.Rule}}{{end}} <span class="mono soft">{{$e.Rule}}</span></dd>{{end}}
    {{with $lv.Ask}}<dt>Question</dt><dd>{{mask .Sentence}}{{if .HasAsk}} · <a class="link" href="/runs/{{pathEsc $lv.Run}}/lines/{{.AskSeq}}">the ask, line {{.AskSeq}}</a>{{end}}{{if .Answered}} · <a class="link" href="/runs/{{pathEsc $lv.Run}}/lines/{{.AnswerSeq}}">the answer, line {{.AnswerSeq}}</a>{{end}}</dd>{{end}}
    {{with $lv.MirrorOf}}<dt>Same refusal as</dt><dd><a class="link" href="/runs/{{pathEsc $lv.Run}}/lines/{{.}}">line {{.}}</a> (this line repeats it for the refusal list)</dd>{{end}}
    {{with $lv.MirroredBy}}<dt>Repeated by</dt><dd><a class="link" href="/runs/{{pathEsc $lv.Run}}/lines/{{.}}">line {{.}}</a> (counted once)</dd>{{end}}
    <dt>In the record</dt><dd>line {{$lv.Envelope.Position}} of {{$lv.Envelope.Total}} · <span class="mono" title="This line's hash: {{$lv.Envelope.ID}}">{{cut $lv.Envelope.ID 16}}</span>{{if $lv.Envelope.PrevOK}} · links to the line before{{else}} · <b>does not link to the line before</b>{{end}}</dd>
  </dl>
  {{if .Fields}}<details class="lx-all" open><summary>Every field ({{len .Fields}})</summary><dl class="lx-fields">{{range .Fields}}<dt title="{{.Key}}">{{.Label}}{{if .Unknown}} <span class="soft">(a field this dashboard does not know)</span>{{end}}</dt><dd>{{if .Value}}<span class="ut lx-v">{{.Value}}</span>{{else}}<span class="soft">empty</span>{{end}}</dd>{{end}}</dl></details>{{end}}
  <div class="lx-acts"><a class="btn btn-sm" href="/runs/{{pathEsc $lv.Run}}/lines/{{$lv.Seq}}">Open line {{$lv.Seq}}</a><button class="btn btn-sm lx-copy" type="button" title="Copies the line exactly as written, secrets included">Copy the line (JSON)</button><template data-exact class="lx-raw">{{$lv.Raw}}</template></div>
</div>{{end}}
{{/* pw is a row's text from pathWords (shown.go): a <wbr> between pieces cut after each / and : and at spaces, each short hyphenated word in a no-wrap span (pwp, layout.tmpl), so it wraps only between names; a path's folder muted and its file name bold, the full path in the title. */}}
{{define "pw"}}{{if .Parts}}{{range $i, $p := .Parts}}{{if $i}} → {{end}}<span class="ut pw" title="{{$p.Full}}"><span class="sp-d">{{template "pwp" $p.Dir}}</span>{{if $p.Dir}}<wbr>{{end}}<b class="sp-b">{{template "pwp" $p.Base}}</b></span>{{end}}{{else}}<span class="ut pw"{{with .Title}} title="{{.}}"{{end}}>{{template "pwp" .Text}}</span>{{end}}{{end}}
