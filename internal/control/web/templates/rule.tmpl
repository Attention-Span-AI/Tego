{{/* rule: the 410 page of POST /rule, the retired Confirm form of the old Rule page (rule.go). It writes nothing. */}}
{{define "content"}}<link rel="stylesheet" href="/static/support.css">{{with .Data}}<div class="page-interior recovery-page">
<section class="panel"><div class="empty" role="alert">
  <div class="glyph">{{template "i" "i-scroll-text"}}</div>
  <h1>This form is retired</h1>
  <p>{{template "quantity" (quantityZero "editor.retired-written" "Nothing written. Open the event and use its “What to do about this” panel to preview a new change." exactNumbers)}}</p>
  {{if .Line}}<a class="btn btn-primary" href="{{.Line}}">Open the line's page</a>{{else}}<a class="btn" href="/runs">Open Runs</a>{{end}}
</div></section>
</div>{{end}}{{end}}
