{{/* SPDX-License-Identifier: Apache-2.0 */}}
{{define "evrow"}}{{$v := ctxRow . (verdictClass .) (verdictIcon .) (verdictWord .)}}<li class="ev-ctx-row v-{{$v.Class}}"><a class="link mono ev-seq" href="/runs/{{pathEsc .Run}}/lines/{{.Seq}}">#{{.Seq}}</a><span class="mono soft ev-t">{{clockms .TS}}</span><span class="op">{{$v.Op}}</span><span class="ut ev-cut" title="{{$v.Title}}">{{$v.Text}}</span><span class="b b-{{$v.Class}}">{{template "i" $v.Icon}}{{$v.Word}}</span></li>{{end}}
{{define "evdir"}}{{if eq . "narrows"}} <span class="b b-narrows ev-dir" title="The next run may do less">Narrows</span>{{else if eq . "widens"}} <span class="b b-widens ev-dir" title="The next run may do more">Widens</span>{{else if .}} <span class="b b-widens ev-dir" title="Some of it lets the next run do more">Mixed</span>{{end}}{{end}}
{{/* evsays is the change in sentences, each path breaking only between its folders (pieces), the full words in the title when the panel shortened them. */}}
{{define "evsays"}}{{if .Sentences}}<ul class="ev-says">{{range .Sentences}}<li>{{if .Before}}<span class="ev-was"{{with .BeforeTitle}} title="{{.}}"{{end}}>{{template "pwp" (pathPieces .Before)}}</span>{{end}}<span class="ev-now-is">{{if .Before}}<span class="ev-to" aria-label="becomes">→ </span>{{end}}<strong{{with .AfterTitle}} title="{{.}}"{{end}}>{{template "pwp" (pathPieces .After)}}</strong></span></li>{{end}}</ul>{{else if .Effect}}<p class="ev-says-one"{{with .EffectTitle}} title="It will {{.}}"{{end}}>It will <strong>{{template "pwp" (pathPieces .Effect)}}</strong>.</p>{{end}}{{end}}
{{/* evscope is one scope chip of step 1 (scopeView): its link, its words, the full path in its title. */}}
{{define "evscope"}}<a class="chip{{if .Mono}} mono{{end}}" href="{{.URL}}"{{if .Title}} title="{{.Title}}"{{end}}{{if .Current}} aria-current="true"{{end}}>{{.Text}}</a>{{end}}
{{define "content"}}{{with .Data}}{{$d := .}}{{$e := .Ev}}{{$r := .Run}}
<link rel="stylesheet" href="/static/event.css"><script src="/static/copy.js" defer></script>
<div class="head"><div class="ev-headline"><nav class="crumbs" aria-label="Breadcrumb"><a class="link" href="/runs">Runs</a><span aria-hidden="true">/</span><a class="link" href="/runs/{{pathEsc $r.ID}}#l{{$e.Seq}}">{{if $r.Agent}}{{$r.Agent}}{{else}}{{rid $r.ID}}{{end}} · {{rid $r.ID}}</a><span aria-hidden="true">/</span><span>line #{{$e.Seq}}</span></nav>
<h1>{{with .Head}}{{.Lead}}{{with .Target}} <span class="ev-h-target" title="{{$d.Head.Title}}">{{.}}</span>{{end}}{{else}}Line #{{$e.Seq}}: {{kindWords $e.Kind}}{{end}}</h1>
<p class="ev-lede"><span class="b b-{{verdictClass $e}}">{{template "i" (verdictIcon $e)}}{{verdictWord $e}}</span> <span class="ev-sentence">{{if .F.LV}}{{.F.LV.Sentence}}{{else}}{{$e.Op}} {{cut (mask $e.Target) 600}}{{end}}</span></p></div>
<nav class="ev-nav" aria-label="Neighbouring lines">{{with .Prev}}<a class="btn" href="/runs/{{pathEsc $r.ID}}/lines/{{.Seq}}" rel="prev">← #{{.Seq}}</a>{{end}}{{with .Next}}<a class="btn" href="/runs/{{pathEsc $r.ID}}/lines/{{.Seq}}" rel="next">#{{.Seq}} →</a>{{end}}</nav></div>
<div class="ev-grid{{if .NoAct}} ev-noact{{end}}">
{{template "evwhat" $d}}
{{if not .NoAct}}<aside class="ev-side" aria-labelledby="h-act">{{template "lr" (index $.L "r-act")}}{{template "r-act" $}}</div></aside>{{end}}
{{template "evfacts" $d}}

<section class="panel" aria-labelledby="h-raw"><div class="panel-head"><h2 id="h-raw">The line as written</h2><span class="soft">{{with .F.LV}}{{len .Raw}} bytes{{end}}</span></div>
<div class="panel-body stack-sm">{{with .F.LV}}<details class="ev-asis"><summary>Show exactly as written <span class="soft">(not masked)</span></summary><div class="ev-rawbar"><span class="soft">One line of the events file, byte for byte{{if hasHidden .Raw}}, but for its invisible characters, shown as ⟦U+…⟧; Copy gives them as written{{end}}.</span><button class="btn copy-btn" type="button" data-copy="ev-rawline">{{template "i" "i-copy"}}<span class="copy-lbl">Copy</span></button></div><pre class="raw ev-raw ev-rawline" id="ev-rawline" tabindex="0" aria-label="The ledger line as written">{{.Raw}}</pre><template data-exact id="ev-rawline-exact">{{.Raw}}</template></details>{{else}}<p class="soft">Line unreadable</p>{{end}}
<p class="soft">In a terminal:</p><div class="cli"><code id="ev-cli">{{.CLI}}</code><button class="btn copy-btn" type="button" data-copy="ev-cli" aria-label="Copy the command">{{template "i" "i-copy"}}<span class="copy-lbl">Copy</span></button></div></div></section>

<section class="panel" aria-labelledby="h-ctx"><div class="panel-head"><h2 id="h-ctx">Around it</h2><span class="soft">{{len .Before}} before, {{len .After}} after</span></div>
<ul class="ev-ctx">{{range .Before}}{{template "evrow" .}}{{end}}{{$v := ctxRow $e (verdictClass $e) (verdictIcon $e) (verdictWord $e)}}<li class="ev-ctx-row ev-self v-{{$v.Class}}" aria-current="true"><span class="mono ev-seq">#{{$e.Seq}}</span><span class="mono soft ev-t">{{clockms $e.TS}}</span><span class="op">{{$v.Op}}</span><span class="ut ev-cut" title="{{$v.Title}}">{{$v.Text}}</span><span class="b b-{{$v.Class}}">{{template "i" $v.Icon}}{{$v.Word}}</span></li>{{range .After}}{{template "evrow" .}}{{end}}</ul></section>

<section class="panel" aria-labelledby="h-sim"><div class="panel-head"><h2 id="h-sim">Similar</h2><span class="soft">{{with .Similar.Subject}}{{if .Class}}the same {{.Class}}{{end}}{{end}}</span></div>
{{with .Similar}}{{if .Subject.Class}}<div class="panel-body stack-sm"><p><span class="mono ev-subj">{{.Subject.Value}}</span>: <strong>{{.Lines}}</strong> {{plural .Lines "line" "lines"}} in {{len .Runs}} {{plural (len .Runs) "run" "runs"}}{{if .Refused}}, {{.Refused}} refused{{end}}. <a class="link" href="/logs?q={{queryEsc .Subject.Value}}">All in Logs</a></p>
<div class="tw"><table class="t" role="table"><caption class="sr">Runs with lines that name {{.Subject.Value}}</caption><thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader">Run</th><th scope="col" role="columnheader">Agent</th><th scope="col" role="columnheader" class="num">Lines</th><th scope="col" role="columnheader" class="num">Refused</th></tr></thead><tbody role="rowgroup">{{$v := .Subject.Value}}{{range .Runs}}<tr role="row"><td role="cell"><a class="link mono" href="/runs/{{pathEsc .Run}}" title="{{.Run}}">{{rid .Run}}</a>{{if .This}} <span class="soft">this run</span>{{end}}</td><td role="cell" data-label="Agent">{{.Agent}}</td><td role="cell" data-label="Lines" class="num"><a class="n-link" href="/logs?run={{queryEsc .Run}}&amp;q={{queryEsc $v}}" aria-label="{{.Lines}} {{plural .Lines "line" "lines"}} in run {{rid .Run}}, open in Logs">{{.Lines}}</a></td><td role="cell" data-label="Refused" class="num">{{if .Refused}}<a class="n-link" href="/logs?run={{queryEsc .Run}}&amp;q={{queryEsc $v}}&amp;verdict=refused" aria-label="{{.Refused}} refused in run {{rid .Run}}, open in Logs">{{.Refused}}</a>{{else}}<span class="zero">0</span>{{end}}</td></tr>{{end}}</tbody></table></div></div>
{{else}}<div class="panel-body"><p class="soft">Nothing to compare</p></div>{{end}}{{end}}
<form class="panel-foot ev-search" role="search" action="/logs" method="get"><label class="sr" for="ev-q">Search the logs</label><input class="input" id="ev-q" type="search" name="q" value="{{.Similar.Subject.Value}}" placeholder="Search the logs: path, host, command or rule"><label class="ev-only"><input type="checkbox" name="run" value="{{$r.ID}}"> only this run</label><button class="btn" type="submit">{{template "i" "i-search"}}Search</button></form></section>

</div>
{{end}}{{end}}
{{/* r-act is the Act on this panel, a live region: its options, preview, Saved panel (?saved=<id>) and Block now change in place. */}}
{{define "r-act"}}{{with .Data}}{{$d := .}}{{$e := .Ev}}{{$r := .Run}}<section class="panel ev-act" id="act"><div class="panel-head"><h2 id="h-act">Act on this</h2></div>
{{if and .Guard (not (and .Act .Act.Plan.Saved))}}<div class="panel-body stack-sm ev-guard"><p class="ev-guard-lead">{{template "i" "i-shield"}}<span>Already refused by: <strong>{{.Guard}}</strong></span></p><p class="soft ev-note">Already refused next run</p></div>{{end}}
{{if .ActErr}}<div class="panel-body"><p class="soft">{{.ActErr}}</p></div>{{else}}{{with .Act}}{{$a := .}}{{$p := .Plan}}
{{if $p.Err}}<div class="panel-body"{{if $p.Action}} id="act-check"{{end}}><p class="soft">No rule can be made from this line: {{$p.Err}}</p></div>{{else if $p.Saved}}
<div class="panel-body stack-sm ev-saved" role="status"><h3 class="ev-step">{{template "i" "i-check"}}Saved{{template "evdir" $p.Direction}}</h3>
<p>From the next run of <span class="mono" title="{{$p.Contract}}">{{baseName $p.Contract}}</span>:</p>
{{template "evsays" $a}}
{{range $a.Live}}<p class="ev-live-out"{{with .State}} data-state="{{.}}"{{end}}{{with .Title}} title="{{.}}"{{end}}>{{if and .OK .Chip}}<span class="b {{.Chip}} ev-live-chip">{{template "i" "i-ban"}}{{.Before}}{{if .This}}this run{{else}}run <a class="link mono" href="/runs/{{pathEsc .Run}}">{{rid .Run}}</a>{{end}}</span><span class="ev-live-st">{{.Rest}} <span class="mono ev-live-blk" title="{{.Block}}">{{template "pwp" (pathPieces .Shown)}}</span></span>{{else if .OK}}{{if eq .State "waiting"}}{{template "i" "i-activity"}}{{else if eq .State "recorded_only"}}{{template "i" "i-eye"}}{{else}}{{template "i" "i-ban"}}{{end}}<span class="ev-live-st">{{.Before}}{{if .This}}this run{{else}}run <a class="link mono" href="/runs/{{pathEsc .Run}}">{{rid .Run}}</a>{{end}}{{.After}} <span class="mono ev-live-blk" title="{{.Block}}">{{template "pwp" (pathPieces .Shown)}}</span></span>{{else}}{{template "i" "i-triangle-alert"}}<span>Not placed on run <span class="mono">{{rid .Run}}</span>{{with .Shown}} (<span class="mono">{{.}}</span>){{end}}: {{.Err}}</span>{{end}}</p>{{end}}
{{with $p.PickErr}}<p class="soft">{{.}}</p>{{end}}
<details class="ev-file"><summary>The change to the file</summary><pre class="raw ev-diff" tabindex="0" aria-label="The contract change">{{$p.Diff}}</pre></details>
{{if and $p.ID $p.NewBase}}<form class="ev-undo" id="act-undo" method="post" action="/runs/{{pathEsc $r.ID}}/lines/{{$e.Seq}}#act"><input type="hidden" name="csrf" value="{{$d.CSRF}}"><input type="hidden" name="undo" value="{{$p.ID}}"><input type="hidden" name="base" value="{{$p.NewBase}}">{{if ne $p.Direction "widens"}}<label class="ev-ack"><input type="checkbox" name="ack" value="{{$p.UndoAck}}" required><span>Undo lets the next run do more again{{range $i, $s := $a.Sentences}}{{if $s.Before}}{{if $i}};{{else}}:{{end}} <strong{{with $s.BeforeTitle}} title="{{.}}"{{end}}>{{template "pwp" (pathPieces $s.Before)}}</strong>{{end}}{{end}}</span></label>{{with $a.Liftable}}<label class="ev-ack ev-lift"><input type="checkbox" name="lift" value="1" checked><span>Also lift {{if eq (len .) 1}}the live block{{else}}the {{len .}} live blocks{{end}} it placed{{range $i, $l := .}}{{if $i}},{{else}}:{{end}} <span class="mono" title="{{$l.Block}}">{{template "pwp" (pathPieces $l.Shown)}}</span> on {{if $l.This}}this run{{else}}run {{rid $l.Run}}{{end}}{{end}}. The run may do that again at once.</span></label>{{end}}{{end}}{{if eq $p.Direction "widens"}}{{range $i, $s := $a.Sentences}}{{if not $i}}{{if $s.Before}}<p class="soft ev-note ev-undo-what">Undo brings back: <strong>{{$s.Before}}</strong></p>{{end}}{{end}}{{end}}{{end}}<button class="btn ev-undo-btn" type="submit">{{template "i" "i-rotate-cw"}}Undo this change</button></form>{{end}}
<p class="soft ev-note">The old file is kept as <span class="mono">{{baseName $p.Bak}}</span>.{{if $p.ID}} The change is in the contract's history.{{else}} The change history missed this one, so the page offers no Undo; the old file holds the text from before.{{end}}</p>
<p class="ev-note"><a class="link" href="/runs/{{pathEsc $r.ID}}/lines/{{$e.Seq}}#act">Another rule from this line</a></p>
</div>
{{else}}
{{if $p.Nothing}}<div class="banner" role="status"{{if not $p.Diff}} id="act-check"{{end}}>{{template "i" "i-check"}}<div class="grow">{{template "pwp" (pathPieces $a.PickErr)}}</div></div>{{else if $p.PickErr}}<div class="banner banner-danger" role="alert"{{if not $p.Diff}} id="act-check"{{end}}>{{template "i" "i-triangle-alert"}}<div class="grow">{{template "pwp" (pathPieces $a.PickErr)}}</div></div>{{end}}
{{if $d.Guard}}<details class="ev-change"{{if $p.Action}} open{{end}}><summary><span class="ev-change-lbl">Change this rule</span> <span class="b b-widens ev-dir" title="Every option here lets the next run do more">Widens</span></summary>{{end}}<div class="panel-body stack-sm"><h3 class="ev-step"><span class="ev-n">1</span>{{if or (eq $p.Kind "read") (eq $p.Kind "write")}}Pick how much of the path{{else}}Pick what it names{{end}}</h3>
<nav class="ev-scopes{{if or (eq $p.Kind "read") (eq $p.Kind "write")}} ev-crumb{{end}}" aria-label="Scope">{{if .Wider}}<details class="ev-wider"{{if .WiderOpen}} open{{end}}><summary class="chip mono" title="{{.Wider}} wider folders, up to {{(index .Scopes 0).Title}}">…/</summary><div class="ev-wider-in">{{range .Scopes}}{{if .Wider}}{{template "evscope" .}}{{end}}{{end}}</div></details>{{end}}{{range .Scopes}}{{if not .Wider}}{{template "evscope" .}}{{end}}{{end}}</nav>
{{range .Scopes}}{{if .Current}}<p class="soft ev-scope-says"{{with .Title}} title="{{.}}"{{end}}>{{template "pwp" (pathPieces .Says)}}</p>{{end}}{{end}}
<h3 class="ev-step"><span class="ev-n">2</span>Next time</h3>
<ul class="ev-acts">{{range .Actions}}<li><a class="btn{{if eq .Action $p.Action}} ev-picked{{else if and (eq .Action $a.Lead) (not $p.Action)}} btn-primary{{end}}" href="/runs/{{pathEsc $r.ID}}/lines/{{$e.Seq}}?a={{.Action}}&amp;{{scopeKey .Scope}}={{scopeVal .Scope}}#act-check"{{if eq .Action $p.Action}} aria-current="true"{{end}}>{{if eq .Action "block"}}{{template "i" "i-ban"}}{{if $a.Never}}Never allow{{else}}Block next time{{end}}{{else if eq .Action "ask"}}{{template "i" "i-hand"}}Ask me next time{{else}}{{template "i" "i-check"}}Allow next time{{end}}</a><span class="soft ev-eff"{{with .EffectTitle}} title="Will {{.}}"{{end}}>Will {{template "pwp" (pathPieces .Effect)}}</span></li>{{else}}<li class="soft ev-eff">Nothing at this scope</li>{{end}}</ul>
{{if .Others}}<details class="ev-why"><summary>Why not the others</summary><ul class="ev-acts">{{range .Others}}<li class="ev-no"><span class="ev-off">{{if eq .Action "block"}}{{if $a.Never}}Never allow{{else}}Block{{end}}{{else if eq .Action "ask"}}Ask me{{else}}Allow{{end}}</span><span class="muted ev-eff"{{with .WhyTitle}} title="{{.}}"{{end}}>{{template "pwp" (pathPieces .Why)}}</span></li>{{end}}</ul>
</details>{{end}}
{{if eq $p.Kind "exec"}}<p class="soft ev-note"><span title="exec.ask is reserved and blocks every match">Programs cannot ask yet</span></p>{{end}}
{{if eq $p.Kind "net"}}<p class="soft ev-note"><span title="There is no network deny list: blocking removes the net.allow entry, so the connection is refused by default">Removes the allow entry</span></p>{{end}}
</div>{{if $d.Guard}}</details>{{end}}
{{if $p.Diff}}<div class="panel-body stack-sm ev-confirm" id="act-check"><h3 class="ev-step"><span class="ev-n">3</span>Check the change{{template "evdir" $p.Direction}}</h3>
{{template "evsays" $a}}
<p class="soft ev-applies">Applies from the next run of <span class="mono" title="{{$p.Contract}}">{{baseName $p.Contract}}</span><span class="ev-applies-now"> · this run within a second</span><span title="Compiled first; the old file is kept as .bak"> · undoable</span></p>
{{template "hostwarn" $p.Unresolved}}
<form id="act-confirm" method="post" action="/runs/{{pathEsc $r.ID}}/lines/{{$e.Seq}}#act"><input type="hidden" name="csrf" value="{{$d.CSRF}}"><input type="hidden" name="a" value="{{$p.Action}}"><input type="hidden" name="base" value="{{$p.Base}}">{{if $a.Scope.Command}}<input type="hidden" name="cmd" value="1">{{else if $a.Scope.Host}}<input type="hidden" name="host" value="1">{{else}}<input type="hidden" name="level" value="{{$a.Scope.Level}}">{{end}}
{{if ne $p.Direction "narrows"}}<div class="banner banner-warn ev-widen" role="note">{{template "i" "i-triangle-alert"}}<div class="grow stack-sm"><p>Next run may do more · confirm:</p><label class="ev-ack"><input type="checkbox" name="ack" value="{{$p.Ack}}" required><span>{{range $a.Sentences}}{{if ne .Direction "narrows"}}<strong{{with .AfterTitle}} title="{{.}}"{{end}}>{{template "pwp" (pathPieces .After)}}</strong>. {{end}}{{else}}It will <strong{{with $a.EffectTitle}} title="{{.}}"{{end}}>{{template "pwp" (pathPieces $a.Effect)}}</strong>.{{end}}</span></label></div></div>{{end}}
{{if $a.Now}}<fieldset class="ev-now"><legend>Also apply now</legend>{{range $a.Now}}<label class="ev-now-row{{if not .OK}} ev-no{{end}}"><input type="checkbox"{{if and .This (not .Observe)}} class="ev-now-this"{{end}} name="now" value="{{.Run}}"{{if .OK}} checked{{else}} disabled{{end}}><span>{{if .This}}This run{{else}}Run <span class="mono">{{rid .Run}}</span>{{end}}{{if .OK}}{{if .Observe}}: recorded only (watched run), nothing is refused{{else}}: refused from its next action on{{end}} (<span class="mono" title="{{.Title}}">{{template "pwp" (pathPieces .Shown)}}</span>){{else}}: <span class="muted">{{.Why}}</span>{{end}}</span></label>{{if and (not .OK) .FenceLift}}<a class="link ev-now-fence" href="/rules?run={{queryEsc .Run}}#live-fence">Lift it on the Rules page</a>{{end}}{{end}}</fieldset>{{end}}
<div class="ev-go"><button class="btn{{if eq $p.Direction "narrows"}} btn-primary{{end}}" type="submit">{{if and $a.Never (eq $p.Action "block")}}Confirm: never allow{{else}}Confirm: write the contract{{end}}</button> <a class="link" href="/runs/{{pathEsc $r.ID}}/lines/{{$e.Seq}}?{{scopeKey $a.Scope}}={{scopeVal $a.Scope}}#act">Cancel</a></div></form>
<details class="ev-file"><summary>The change to the file</summary><pre class="raw ev-diff" tabindex="0" aria-label="The contract change">{{$p.Diff}}</pre></details>
<div class="cli ev-cli"><code id="act-cli">{{$a.CLI}}</code><button class="btn copy-btn" type="button" data-copy="act-cli" aria-label="Copy the command">{{template "i" "i-copy"}}<span class="copy-lbl">Copy</span></button></div></div>{{end}}
{{end}}
{{with $a.Held}}<div class="panel-body stack-sm ev-live ev-held" data-state="{{.State}}"><h3 class="ev-step">{{if eq .State "recorded_only"}}{{template "i" "i-eye"}}Marked live on this run{{else if eq .State "waiting"}}{{template "i" "i-activity"}}Blocked live on this run, being put in force{{else}}{{template "i" "i-ban"}}Blocked live on this run{{if .Since}} since <a class="link" href="/runs/{{pathEsc $r.ID}}/lines/{{.Since}}">line #{{.Since}}</a>{{end}}{{end}}</h3><p class="soft"><span class="mono" title="{{.Block}}">{{template "pwp" (pathPieces .Shown)}}</span> {{if eq .State "recorded_only"}}is recorded on each matching line until the run ends{{else}}is refused on top of the contract until the run ends{{end}}. <a class="link" href="/runs/{{pathEsc $r.ID}}#block">Remove it on the run page</a></p></div>{{end}}
{{if $a.LiveKind}}<div class="panel-body stack-sm ev-live">{{if $a.Observe}}<h3 class="ev-step">{{template "i" "i-eye"}}Mark now, in this watched run</h3><p class="soft">This run is only watched: a mark is recorded on each matching line from the next action on, and nothing is refused.{{with $a.LiveNote}} {{.}}{{end}}</p>{{else}}<h3 class="ev-step">{{template "i" "i-ban"}}Block now, in this live run</h3><p class="soft"><span title="On top of the contract, until the run ends or you remove it on the run page">From the next action</span>{{with $a.LiveNote}} {{.}}{{end}}</p>{{end}}
<form id="act-block" method="post" action="/runs/{{pathEsc $r.ID}}/block"><input type="hidden" name="csrf" value="{{$d.CSRF}}"><input type="hidden" name="kind" value="{{$a.LiveKind}}"><input type="hidden" name="value" value="{{$a.LiveValue}}">{{if $a.Observe}}<button class="btn" type="submit">{{template "i" "i-eye"}}<span class="ev-btn-lbl">Mark <span class="mono ev-btn-path" title="{{$a.LiveValue}}">{{cut $a.LiveShown 40}}</span>&nbsp;<span class="ev-nowrap">(recorded only)</span></span></button>{{else}}<button class="btn btn-danger" type="submit">{{template "i" "i-ban"}}<span class="ev-btn-lbl">Block {{$a.LiveKind}} <span class="mono ev-btn-path" title="{{$a.LiveValue}}">{{cut $a.LiveShown 40}}</span>&nbsp;now</span></button>{{end}}</form></div>{{end}}
{{end}}{{end}}</section>{{end}}{{end}}
