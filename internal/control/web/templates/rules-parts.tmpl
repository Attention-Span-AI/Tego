{{/* rules-parts: the pieces the Change rules pages share (rules_change.go): the direction badge and the history list with Undo. */}}
{{define "dir"}}{{if eq . "narrows"}}<span class="b b-narrows rc-dir">{{template "i" "i-shield"}}Narrows</span>{{else if eq . "widens"}}<span class="b b-widens rc-dir">{{template "i" "i-triangle-alert"}}Widens</span>{{else if .}}<span class="b b-widens rc-dir">{{template "i" "i-triangle-alert"}}Mixed</span>{{end}}{{end}}
{{define "history"}}{{$csrf := .CSRF}}{{$ref := .Ref}}{{$base := .Base}}{{if .Rows}}<ol class="rc-hist">{{range .Rows}}<li class="rc-hrow">
<div class="rc-hmain"><span class="soft rc-when"><time datetime="{{iso .At}}" title="{{stamp .At}}">{{day .At}} {{clock .At}}</time>{{if .Via}} · {{.Via}}{{end}}</span>
<span class="rc-hwhat">{{.What}}</span>
{{template "dir" .Direction}}{{if .UndoneBy}} <span class="soft">Undone</span>{{end}}
{{range .Live}}<span class="soft rc-hlive">{{if .Lift}}{{if .OK}}lifted on {{rid .Run}}: {{.Block}}{{else}}not lifted on {{rid .Run}}{{with .Err}}: {{.}}{{end}}{{end}}{{else if .OK}}live on {{rid .Run}}: {{.Block}}{{else}}not live on {{rid .Run}}{{with .Err}}: {{.}}{{end}}{{end}}</span>{{end}}</div>
{{if .CanUndo}}<form class="rc-undo" method="post" action="/rules/revert"><input type="hidden" name="csrf" value="{{$csrf}}"><input type="hidden" name="c" value="{{$ref}}"><input type="hidden" name="id" value="{{.ID}}"><input type="hidden" name="base" value="{{$base}}">{{if .UndoAck}}<label class="rc-ack-sm"><input type="checkbox" name="ack" value="{{.Ack}}" required> Next run may do more</label>{{end}}{{with .Lift}}<label class="rc-ack-sm" title="{{range $i, $l := .}}{{if $i}}; {{end}}{{$l.Words}} on {{rid $l.Run}}{{end}}"><input type="checkbox" name="lift" value="1" checked> also lift {{if eq (len .) 1}}its live block{{else}}its {{len .}} live blocks{{end}} now</label>{{end}}<button class="btn" type="submit" data-page>{{template "i" "i-rotate-cw"}}Undo</button></form>{{end}}
</li>{{end}}</ol>{{else}}<p class="soft">{{template "quantity" (quantityZero "editor.history-zero" "No changes yet" exactNumbers)}}</p>{{end}}{{end}}
{{/* nowrows: "Also apply now" for a planned change ([]nowRun, rules_change.go nowRuns): a checkbox per running run that can get a live block now, then each change on that run with its live block, "Live now" for a widening inside a running Adjustable run's fence (ADR 0125), or "Next run" and why it has none. */}}
{{define "nowrows"}}{{if .}}<fieldset class="rc-now"><legend>Running now</legend>
{{range .}}{{$fl := false}}{{range .Blocks}}{{if .FenceLift}}{{$fl = true}}{{end}}{{end}}<div class="rc-nowrun">{{if .OK}}<label class="rc-nowl"><input type="checkbox" name="now" value="{{.Run}}" checked> Apply now to <span class="mono" title="{{.Run}}" data-number-exclude="editor.now-run">{{rid .Run}}</span>{{if .Observe}} <span class="soft">(watched)</span>{{end}}</label>{{else if $fl}}<span class="rc-nowl soft">Run <span class="mono" title="{{.Run}}">{{rid .Run}}</span> (running, Adjustable) can lift it on the Rules files page</span>{{else}}<span class="rc-nowl soft">Run <span class="mono" title="{{.Run}}">{{rid .Run}}</span> (running) cannot get it now</span>{{end}}
<ul class="rc-blocks">{{range .Blocks}}<li>{{if .OK}}{{if .Observe}}<span class="b b-observed rc-chip">Recorded only (watched run)</span> <span title="{{.Block}}">{{.Words}}</span>{{else}}<span class="b b-active rc-chip">Applies now</span> <span title="{{.Block}}">{{.Words}}</span> · until the run ends{{end}}{{else if .FenceLift}}<span class="b b-active rc-chip">Live now</span> {{with .Change}}<span class="mono">{{.}}</span>: {{end}}<span class="soft">(Tego's live layer): this lies inside the run's fence.</span> <a class="link" href="/rules?run={{queryEsc .Run}}#live-fence">Lift it on the Rules page</a>{{else}}<span class="b b-neutral rc-chip">Next run</span> {{with .Change}}<span class="mono">{{.}}</span>: {{end}}<span class="soft">{{.Why}}</span>{{end}}</li>{{end}}</ul>{{if .Waits}}<p class="soft rc-restart">{{nextRunWords}}{{with .Restart}}: <span class="cli"><code>{{cmd .}}</code></span>{{else}}.{{end}}</p>{{end}}</div>{{end}}
</fieldset>{{end}}{{end}}
{{/* forselect: a live change's time limit (ADR 0125 decision 4), with . the choice picked: the Block now form's "run", the lift forms' "1h". untilOf (livefence.go) reads for, span and until; each fixed span's value is a key of forSpans, and "for" reads the typed span as --for does. */}}
{{define "forselect"}}{{$d := .}}<label class="field lf-for">Time limit<select class="select" name="for"><option value="2m"{{if eq $d "2m"}} selected="selected"{{end}} data-number="shared.configuration">2 minutes</option><option value="4m"{{if eq $d "4m"}} selected="selected"{{end}} data-number="shared.configuration">4 minutes</option><option value="15m"{{if eq $d "15m"}} selected="selected"{{end}} data-number="shared.configuration">15 minutes</option><option value="30m"{{if eq $d "30m"}} selected="selected"{{end}} data-number="shared.configuration">30 minutes</option><option value="1h"{{if eq $d "1h"}} selected="selected"{{end}} data-number="shared.configuration">1 hour</option><option value="1d"{{if eq $d "1d"}} selected="selected"{{end}} data-number="shared.configuration">1 day</option><option value="3d"{{if eq $d "3d"}} selected="selected"{{end}} data-number="shared.configuration">3 days</option><option value="1w"{{if eq $d "1w"}} selected="selected"{{end}} data-number="shared.configuration">1 week</option><option value="run"{{if eq $d "run"}} selected="selected"{{end}}>for the rest of this run</option><option value="for"{{if eq $d "for"}} selected="selected"{{end}}>for…</option><option value="until"{{if eq $d "until"}} selected="selected"{{end}}>until…</option><option value="perm"{{if eq $d "perm"}} selected="selected"{{end}}>permanently (then Edit rules file)</option></select></label><label class="field lf-span">For<input data-number-placeholder="shared.configuration" class="input" type="text" name="span" maxlength="32" autocomplete="off" spellcheck="false" placeholder="45m, 4m, 72h, 3d, 1d12h, 7w"></label><label class="field lf-until">Until<input class="input" type="datetime-local" name="until"></label><input type="hidden" name="tz" value="" data-zone>{{end}}
{{/* livetable: ADR 0125's comparison of the two modes, shown wherever the mode is chosen or named. */}}
{{define "livetable"}}<div class="tw"><table class="t lm-table"><caption class="sr">Locked and Adjustable compared</caption><thead><tr><th scope="col"><span class="sr">Question</span></th><th scope="col">Locked (default)</th><th scope="col">Adjustable (live both ways)</th></tr></thead><tbody>
<tr><th scope="row">What holds the fixed rules</th><td><span data-number="shared.policy">The whole contract: Landlock and Tego's supervisor at every level, plus fanotify and BPF at Plus and Max</span></td><td><span data-number="shared.policy">The fence: the contract plus every fence entry. Inside the fence, Tego's live layer blocks each entry until you lift or grant it</span></td></tr>
<tr><th scope="row">Loosen while it runs</th><td>No: from the next run. MCP tool switches and model routes are the exception</td><td><span data-number="shared.policy">Yes, fence entries only, each one previewed, confirmed and recorded, optionally for a time. MCP tool switches and model routes are the same exception</span></td></tr>
<tr><th scope="row">Tighten while it runs</th><td>Yes: live blocks and pause</td><td>Yes: the same, plus Restore</td></tr>
<tr><th scope="row">Time limits</th><td>Blocks and unblocks</td><td>Blocks, unblocks, lifts and grants</td></tr>
<tr><th scope="row">What a compromised agent can do</th><td>What the contract allows. A live block on a file or a program can be raced with a symlink; reads that Tego holds cannot be</td><td><span data-number="shared.policy">The same, plus: it can dodge an exec fence entry not yet granted by copying the program to a place where it can write and run. Net and read fence entries cannot be raced. It can never lift its own rules</span></td></tr>
<tr><th scope="row">If Tego's supervisor stops</th><td data-number-exclude="rules-parts.element-12">Notified calls fail and the run ends; the kernel still holds the contract</td><td><span data-number="shared.policy">Notified calls fail and the run ends. Every open, connect and exec is notified, so none reaches a fence entry in between. Descriptors already open work until the run is killed</span></td></tr>
<tr><th scope="row">Protection</th><td>All</td><td>Plus and Max; not Basic</td></tr>
<tr><th scope="row">Performance</th><td>Baseline</td><td><span data-number="shared.policy">With read entries, each read open costs about 0.1 ms more. The plane modes run the full seccomp filter</span></td></tr>
<tr><th scope="row">What the record proves</th><td data-number="shared.policy">Every block, under contract rules or <span class="mono">live.block[...]</span>, and every block change</td><td><span data-number="shared.policy">The mode and the fence's digest at the start; every lift, restore, expiry and refused lift as the launcher applied it; every action under </span><span class="mono">live.fence[...]</span>. It does not prove that the kernel enforced the live contract: the live layer did</td></tr>
<tr><th scope="row">Who can loosen it while it runs</th><td><span data-number="shared.policy">Nobody for file, program and network rules. MCP tool switches and model routes: the operator, from outside every run, with confirmation</span></td><td><span data-number="shared.policy">The operator, from outside every run, with confirmation; never the agent. A same-user process outside every run that reads the run's key can too</span></td></tr>
</tbody></table></div>{{end}}
{{/* livemodes: the run's mode in one line with the comparison behind "What this means" (. is "locked" or "adjustable"), or, with . empty, the comparison alone (Set up a new agent). */}}
{{define "livemodes"}}{{if .}}<section class="lmode" aria-label="How this run's rules change while it runs"><p class="lmode-line">{{if eq . "adjustable"}}<span data-number-title="shared.policy" class="b b-neutral" title="The kernel holds this run to its fence; inside it, Tego's live layer blocks each fence entry until you lift or grant it">{{template "i" "i-shield"}}Adjustable</span>{{else}}<span class="b b-neutral" title="File, program and network rules are fixed when the run starts. Tighten while it runs; loosening applies from the next run">Locked</span>{{end}}</p><details class="lmode-more"><summary>Compare modes</summary>{{template "livetable"}}<p class="soft" title="Set in the contract file (live.mode); changes from the next run">live.mode</p></details></section>{{else}}<details class="lmode-more"><summary>Compare modes</summary>{{template "livetable"}}</details>{{end}}{{end}}

{{define "newlyallows"}}{{if .}}<section class="banner banner-warn" id="builder-newlyallows" role="alert" aria-labelledby="builder-newlyallows-heading"><div class="grow"><h2 id="builder-newlyallows-heading">This will newly allow</h2><ul>{{range .}}<li>{{.}}</li>{{end}}</ul><p>Compared using the compiled rules. Review each change before Save.</p></div></section>{{end}}{{end}}

{{define "comparisonreview"}}{{if .}}<section class="banner banner-warn" role="alert"><div class="grow"><h2>Also review these effective rules</h2><ul>{{range .}}<li>{{.}}</li>{{end}}</ul><p>The comparison cannot prove a direction for these changes. Check the full file before confirming.</p></div></section>{{end}}{{end}}

{{define "families"}}{{if .}}<div class="rc-fam stack-sm"><h3 class="rp-h">What the compiled contract changes</h3><ul class="rc-fam-list">{{range .}}<li>{{.Words}} {{template "dir" .Direction}}</li>{{end}}</ul></div>{{end}}{{end}}
{{define "sourcecmp"}}{{with .}}{{if .Err}}<p class="soft">The file could not be compared with the rules this run ran: {{.Err}}.</p>{{else if .Families}}<div class="rc-fam stack-sm"><h3 class="rp-h">What the file says now, compared with what this run ran {{template "dir" .Direction}}</h3><ul class="rc-fam-list">{{range .Families}}<li>{{.Words}} {{template "dir" .Direction}}</li>{{end}}</ul></div>{{else}}<p class="soft">Compared family by family, the file now compiles to the same rules this run ran.</p>{{end}}{{end}}{{end}}
