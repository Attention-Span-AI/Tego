{{define "effect"}}{{if eq . "allow"}}<span class="b b-neutral b-allow">{{template "i" "i-check"}}Allowed</span>{{else if eq . "ask"}}<span class="b b-asked">{{template "i" "i-hand"}}Asks you</span>{{else if eq . "deny"}}<span class="b b-refused">{{template "i" "i-ban"}}Refused</span>{{else if eq . "limit"}}<span class="b b-neutral">{{template "i" "i-square"}}Limit</span>{{else}}<span class="b b-neutral">{{template "i" "i-eye"}}Note</span>{{end}}{{end}}
{{define "enforced"}}{{if not .Enforced}}<span class="zero">—</span>{{else if eq .State "best_effort"}}<span class="enf-be">{{template "i" "i-triangle-alert"}}{{.Enforced}}</span>{{else if eq .State "not_enforced"}}<span class="enf-no">{{template "i" "i-triangle-alert"}}{{.Enforced}}</span>{{else}}{{.Enforced}}{{end}}{{end}}
{{define "hits"}}{{$numbers := numbersOf .}}{{$ := numberValue .}}{{with $}}{{if not .Hits}}<span class="zero">{{template "quantity" (quantityZero "contracts.hits" "No hits" $numbers)}}</span>{{else if .HitsURL}}<a class="n-link" href="{{.HitsURL}}" aria-label="{{quantityText "contracts.hits" .Hits $numbers}} {{plural .Hits "line" "lines"}} of this run under: {{.Sentence}}" data-number-aria-label="contracts.hits">{{template "quantity" (quantity "contracts.hits" .Hits $numbers)}} {{plural .Hits "hit" "hits"}}</a>{{else}}{{template "quantity" (quantity "contracts.hits" .Hits $numbers)}} {{plural .Hits "hit" "hits"}}{{end}}{{end}}{{end}}
{{define "rulespick"}}{{$d := .}}<form class="frow rules-pick" action="/rules" method="get" aria-label="Choose the rules to show">
  {{if .Contracts}}<label class="field rp-file">Contract file<select class="select" name="c">{{range .Contracts}}<option value="{{.Ref}}"{{if eq .Ref $d.Ref}} selected{{end}} data-number-exclude="rules.identity-10">{{if .Agent}}{{.Agent}} · {{end}}{{tail .Path 48}}{{if .Why}} · {{.Why}}{{else if .Gone}} · file gone{{end}}{{if .Live}} · running{{else if not .Runs}} · not run yet{{end}}</option>{{end}}{{if not .Ref}}<option value="" selected>{{if .SelectionErr}}Choose a contract file{{else}}a run with no contract file{{end}}</option>{{end}}</select></label>{{end}}
  {{if .Runs}}<label class="field rp-run">Run<select class="select" name="run">{{range .Runs}}<option value="{{.ID}}"{{if and $d.Run (eq .ID $d.Run.ID)}} selected{{end}} data-number-exclude="rules.fact-3">{{rid .ID}} · {{day .Start}} {{clock .Start}}{{if eq .State "running"}} · running{{end}}</option>{{end}}</select></label>{{end}}
  <button class="btn" type="submit">Show</button>
</form>{{range .Contracts}}{{if and .Aliases (eq .Ref $d.Ref)}}<p class="soft rp-alias">This file is also recorded as {{join .Aliases ", "}}. Runs of every spelling are listed here together.</p>{{end}}{{end}}{{if or .RunPage.OlderURL .RunPage.NewerURL}}<p class="soft rp-pages">The run list holds one page of this file's runs, newest first.{{with .RunPage.NewerURL}} <a class="link" href="{{.}}">Newer runs</a>{{end}}{{with .RunPage.OlderURL}} <a class="link" href="{{.}}">Older runs</a>{{end}}</p>{{end}}{{end}}
{{define "content"}}<link rel="stylesheet" href="/static/rules.css">{{$csrf := $.CSRF}}{{with .Data}}{{$d := .}}<div class="page-interior contracts-page">
{{with .General}}
<div class="head"><div>{{if $.Tour}}<h2>{{else}}<h1>{{end}}Rules files{{if $.Tour}}</h2>{{else}}</h1>{{end}}</div></div>
<section class="panel general-contract" aria-labelledby="h-general"><div class="panel-head"><h2 id="h-general">General contract</h2></div>
<div class="panel-body stack-sm"><p data-number-exclude="rules.general-note">{{.Note}}</p>{{with .Scope}}<p data-number-exclude="rules.general-scope">{{.}}</p>{{end}}
{{with .Name}}<p>Contract name: <span class="code-i" data-number-exclude="rules.general-name">{{.}}</span></p>{{end}}
{{with .Hash}}<p>Canonical general hash: <span class="code-i" data-number-exclude="rules.general-hash">{{.}}</span></p>{{end}}
<details><summary>Source and profile digests</summary><div class="stack-sm">{{range .Sources}}<div><p>{{.Layer}} source: <span class="code-i" data-number-exclude="rules.general-source">{{.Path}}</span> ({{.State}})</p>{{with .Reason}}<p data-number-exclude="rules.general-reason">{{.}}</p>{{end}}{{with .SHA256}}<p data-number-exclude="rules.general-sha-label">Source SHA-256: <span class="code-i" data-number-exclude="rules.general-sha">{{.}}</span></p>{{end}}{{if .Owner}}<p data-number-exclude="rules.general-owner">Owner uid {{.Owner}}, mode {{.Mode}}; resolved <span class="code-i" data-number-exclude="rules.general-resolved">{{.Resolved}}</span></p>{{end}}{{range .Walk}}<p class="code-i" data-number-exclude="rules.general-walk">{{.}}</p>{{end}}</div>{{end}}
{{range .Profiles}}<p>Profile <span class="code-i" data-number-exclude="rules.general-profile">{{.Name}}</span> ({{.Kind}}): <span class="code-i" data-number-exclude="rules.general-profile-sha">{{.SHA256}}</span></p>{{end}}</div></details>
{{range .Diagnostics}}<p class="code-i" data-number-exclude="rules.general-diag">{{.}}</p>{{end}}
<p>Agents outside a Tego run are not held to these rules. Existing own contracts keep their rules until you choose to migrate them.</p>
</div></section>
<section class="panel" aria-labelledby="h-general-baseline"><div class="panel-head"><h2 id="h-general-baseline">Machine baseline · Locked</h2></div><div class="panel-body"><p data-number-exclude="rules.baseline-state">{{$d.BaselineState}}</p><p>Neither the general contract nor an agent customisation may loosen the baseline.</p></div></section>
{{end}}{{if .List}}
<div class="head"><div>{{if .General}}<h2>Own contracts</h2>{{else}}{{if $.Tour}}<h2>{{else}}<h1>{{end}}Rules files{{if $.Tour}}</h2>{{else}}</h1>{{end}}{{end}}<p class="lede">Which rules hold each agent?</p></div>{{if .CanSetUp}}<details class="head-more"><summary>Actions</summary><div class="head-actions"><a class="btn btn-primary" href="/rules/new">New rules file</a></div></details>{{end}}</div>
<div class="contract-filter"><span class="soft" data-say>{{template "quantity" (quantity "contracts.contracts" (len .Contracts) $.Numbers)}} {{plural (len .Contracts) "contract" "contracts"}} · recorded here</span><a class="btn" data-filter-open href="{{contractFilterURL .Query .State}}">Filter</a></div>
{{if .FilterPage}}<section class="filter-fallback panel panel-body" aria-labelledby="contracts-filter-title"><h2 id="contracts-filter-title">Filter contracts</h2>{{template "contract-filters" .}}</section>{{else}}<dialog class="filter-sheet" aria-labelledby="contracts-filter-title"><div class="filter-title"><h2 id="contracts-filter-title">Filter contracts</h2><button class="btn" data-filter-close type="button">Close</button></div>{{template "contract-filters" .}}</dialog>{{end}}
{{if .Contracts}}<p class="page-intro desktop-only">{{template "quantity" (quantity "contracts.contracts" (len .Contracts) $.Numbers)}} {{plural (len .Contracts) "contract" "contracts"}}. Open one to see its rules and where they applied.</p>
<section class="panel contract-list" aria-label="Rules files"><div class="phone-list">
{{range .Contracts}}<a class="phone-row contract-row" href="/rules?c={{queryEsc .Ref}}" aria-label="Contract for {{if .Agent}}{{.Agent}}{{else}}{{.Path}}{{end}}; {{if .Gone}}file gone{{else if .Live}}in use{{else if .Runs}}used before{{else}}not run yet{{end}}{{if not .Last.IsZero}}; latest run {{when .Last $d.Now}}{{end}}" data-number-exclude-aria-label="rules.identity-1">
<span class="phone-who" data-number-exclude="rules.fact-4">{{if .Agent}}{{.Agent}}{{else}}{{.Path}}{{end}}</span>
<span class="b {{if .Gone}}b-outside{{else}}b-neutral{{end}}">{{if .Gone}}File gone{{else if .Live}}In use{{else if .Runs}}Used before{{else}}Not run yet{{end}}</span>
{{if .Last.IsZero}}<span class="phone-when">Not run yet</span>{{else}}<time class="phone-when" datetime="{{iso .Last}}" data-started="{{iso .Last}}" data-number-exclude="rules.clock-1" data-ck>{{rowAgo .Last $d.Now}}</time>{{end}}
<span class="desktop-facts contract-file" data-number-exclude-text="rules.list-contract-path">{{.Path}}<span class="soft">{{template "quantity" (quantity "contracts.runs" .Runs $.Numbers)}} {{plural .Runs "run" "runs"}}, {{template "quantity" (quantity "contracts.running" .Live $.Numbers)}} running</span></span>
</a>{{end}}</div></section>
{{else}}<section class="panel"><div class="empty"><h2>{{if or .Query .State}}{{template "quantity" (quantityZero "contracts.contracts" "No contracts match these filters" $.Numbers)}}{{else}}{{template "quantity" (quantityZero "contracts.contracts" "No contracts yet" $.Numbers)}}{{end}}</h2>{{if or .Query .State}}<a class="btn" href="/rules">Clear filters</a>{{else}}<p>Make one from presets or from a finished run.</p>{{end}}{{if .CanSetUp}}<a class="btn btn-primary" href="/rules/new">New rules file</a>{{else}}<div class="cli"><code>mkdir -p ~/contracts &amp;&amp; tego rules learn &lt;run&gt; --out ~/contracts/&lt;name&gt;.yaml</code></div>{{end}}</div></section>{{end}}
{{else if .Selected}}{{$rl := .Selected}}{{$r := .Run}}
<div class="head"><div><h1 class="h1-obj">What does this rule do?</h1></div></div>
<section class="panel rule-detail"><div class="panel-body stack">
<h2>{{$rl.Summary}}</h2><div>{{template "effect" $rl.Effect}}</div>
<p>{{if eq $rl.Effect "deny"}}Tego refuses this access when this rule is enforced. A refusal takes priority over an allowance.{{else if eq $rl.Effect "ask"}}This access waits for a person to allow or deny it when this rule is enforced.{{else if eq $rl.Effect "allow"}}This rule permits this access, subject to the contract's refusals and the protection level.{{else}}This rule sets a limit or records a fact for this run.{{end}}</p>
{{if .Watch}}<p>{{template "quantity" (quantityZero "shared.watch-refusals" "Watched only: nothing was refused by this run." exactNumbers)}}</p>{{end}}
<dl class="kv"><dt>Exact target</dt><dd class="detail-value mono">{{if $rl.Target}}{{$rl.Target}}{{else if $rl.Value}}{{$rl.Value}}{{else}}No single target; see the rule text below.{{end}}</dd><dt>{{if $rl.Devices}}Rule group{{else}}Rule key{{end}}</dt><dd class="detail-value mono">{{$rl.Key}}</dd><dt>Enforcement</dt><dd>{{if $rl.Enforced}}{{$rl.Enforced}}{{else}}Not recorded{{end}}</dd>{{with $rl.Ends}}<dt>Time limit</dt><dd class="detail-value">{{.}}</dd>{{end}}<dt>Contract for</dt><dd class="detail-value">{{.Agent}}</dd><dt>Agent in this run</dt><dd class="detail-value" data-number-exclude="rules.selected-agent">{{$r.Agent}}</dd><dt>Source</dt><dd class="detail-value mono" data-number-exclude="rules.selected-source">{{$rl.SourceTitle}}</dd><dt>Applied in</dt><dd><a class="text-link" href="/runs/{{pathEsc $r.ID}}" data-number-exclude="rules.selected-run">{{$r.ID}}</a></dd></dl>
{{if $rl.Devices}}<h2>Each terminal device</h2><dl class="kv">{{range $rl.Devices}}<dt>{{.Sentence}}</dt><dd class="detail-value"><span class="mono">{{.Target}}</span><p class="detail-value mono">{{.Key}}</p><p>{{.Enforced}}</p><p class="mono">{{.SourceTitle}}</p>{{template "hits" (withNumbers . $.Numbers)}}</dd>{{end}}</dl>{{end}}
{{if not $rl.Hits}}<p class="soft">{{template "quantity" (quantityZero "contracts.hits" "No matching event" $.Numbers)}}</p>{{else if $rl.HitsURL}}<a class="text-link" href="{{$rl.HitsURL}}">{{template "quantity" (quantity "contracts.hits" $rl.Hits $.Numbers)}} matching {{plural $rl.Hits "event" "events"}}</a>{{else}}<p class="soft">{{template "quantity" (quantity "contracts.hits" $rl.Hits $.Numbers)}} matching events. See the individual rules above.</p>{{end}}
{{if and .Running $rl.Kind (not $rl.Ended)}}<form method="post" action="/runs/{{pathEsc $r.ID}}/unblock"><input type="hidden" name="csrf" value="{{$csrf}}"><input type="hidden" name="kind" value="{{$rl.Kind}}"><input type="hidden" name="value" value="{{$rl.Value}}"><input type="hidden" name="back" value="/rules?run={{queryEsc $r.ID}}"><button class="btn" type="submit" data-page>Remove this live block</button></form>{{end}}
<a class="btn" href="/rules?run={{queryEsc $r.ID}}">Back to the contract</a>
</div></section>
<details class="detail-disclosure"><summary>Exact contract text and compiled rules</summary><div class="panel-body stack"><p class="detail-value">{{$rl.Sentence}}</p><p class="soft">Secret values stay hidden.</p><pre class="detail-value" data-number="contracts.compiled-facts">{{.Text}}</pre><pre class="detail-value" data-number="contracts.compiled-facts">{{.Table}}</pre></div></details>
{{else if .NotRun}}{{$n := .NotRun}}{{$p := $n.Plan}}
<div class="head"><div>{{if $.Tour}}<h2>{{else}}<h1 class="h1-obj">{{end}}<span class="desktop-only" data-number-exclude="rules.agent-field-3">{{.Agent}}</span><span class="phone-only">Contract</span>{{if $.Tour}}</h2>{{else}}</h1>{{end}}<p class="lede rules-ctx"><span class="detail-value mono" title="{{$p.File}}">{{tail $p.File 60}}</span> · not run yet</p></div>
<details class="head-more"><summary>Actions</summary><div class="head-actions">{{if .CanChange}}<a class="btn" href="/rules/change?c={{queryEsc .Ref}}">{{template "i" "i-scroll-text"}}Edit contract</a>{{end}}<a class="btn" href="/rules/new">{{template "i" "i-shield"}}New rules file</a></div></details></div>
{{with .Agent}}<p class="page-intro phone-only">Rules for <strong class="detail-value">{{.}}</strong>.</p>{{end}}<details class="detail-disclosure contract-details"><summary>Contract details and other runs</summary><div class="panel-body">{{template "rulespick" .}}{{if .Run}}{{template "livemodes" .Mode}}{{end}}{{with .CopyNote}}<p class="note">{{template "i" "i-scroll-text"}}<span>{{.}}</span></p>{{end}}{{with .V}}{{range .View.Notes}}<p class="note">{{template "i" "i-shield"}}<span>{{.}}</span></p>{{end}}{{end}}<p data-number-exclude="rules.fact-11">{{.Tier}}{{if .Watch}}. {{template "quantity" (quantityZero "shared.watch-refusals" "Watched only: nothing refused." exactNumbers)}}{{end}}</p>{{with .Run}}<p>Agent recorded by this run: <strong class="detail-value">{{.Agent}}</strong>.</p><p>Run <a class="text-link" href="/runs/{{pathEsc .ID}}">{{.ID}}</a>, started <time datetime="{{iso .Start}}">{{stamp .Start}}</time>.</p>{{end}}{{with .NotRun}}<p class="detail-value mono">{{.Plan.File}}</p>{{end}}{{with .Source}}<p class="detail-value mono">{{.}}</p>{{end}}<a class="text-link" href="/rules">All contracts</a></div></details>
<section class="panel"><div class="panel-body stack"><h2 class="rp-h">Start it</h2><div class="cli"><code data-number-exclude="rules.fact-12">{{cmd $n.Start}}</code></div><p class="soft">Add <span class="mono">-- &lt;command&gt;</span> to run another program than the file's <span class="mono">command:</span> · then each run's contract shows here</p></div></section>
{{if $p.Problems}}<section class="banner banner-warn" role="status">{{template "i" "i-triangle-alert"}}<div class="grow">{{range $p.Problems}}<p>{{.}}</p>{{end}}</div></section>{{end}}
{{if $p.Diagnostics}}<section class="panel"><div class="panel-head"><h2>What compile says</h2></div><div class="panel-body"><pre class="term detail-value" data-number-exclude="rules.compile-says">{{range $p.Diagnostics}}{{.}}
{{end}}</pre></div></section>{{end}}
{{with $p.ViewNote}}<p class="note">{{template "i" "i-shield"}}<span>{{.}}</span></p>{{end}}
{{range $n.Groups}}<section class="panel rules-g phone-table" aria-labelledby="g-{{.ID}}"><div class="panel-head"><h2 id="g-{{.ID}}">{{template "i" .Icon}}{{.Title}} <span class="soft" data-number-exclude="rules.detail-4">{{.Lede}}</span></h2></div>
{{if .Rows}}<ul class="nw-rules">{{range .Rows}}<li>{{template "effect" .Effect}}<span data-number-exclude="rules.identity-21">{{.Sentence}}</span></li>{{end}}</ul>{{end}}
{{if .More}}<details class="nw-more"><summary>and {{template "quantity" (quantity "contracts.more-rules" (len .More) $.Numbers)}} more</summary><ul class="nw-rules">{{range .More}}<li>{{template "effect" .Effect}}<span data-number-exclude="rules.identity-22">{{.Sentence}}</span></li>{{end}}</ul></details>{{end}}
{{with .Default}}<div class="panel-foot rules-default"><span>{{.}}</span></div>{{end}}</section>{{end}}
<details class="panel rules-raw"><summary class="panel-head"><h2>The rules file as written</h2><span class="soft">YAML</span></summary><div class="panel-body"><pre class="term detail-value" data-number-exclude="rules.fact-14">{{$n.Text}}</pre><p class="soft">Values hidden</p></div></details>
{{else if not .Run}}
<div class="head"><div>{{if .General}}<h2>Own contracts</h2>{{else}}{{if $.Tour}}<h2>{{else}}<h1>{{end}}Rules files{{if $.Tour}}</h2>{{else}}</h1>{{end}}{{end}}</div>{{if .CanSetUp}}<details class="head-more"><summary>Actions</summary><div class="head-actions"><a class="btn btn-primary" href="/rules/new">{{template "i" "i-shield"}}New rules file</a></div></details>{{end}}</div>
{{if .Contracts}}{{with .Agent}}<p class="page-intro phone-only">Rules for <strong class="detail-value">{{.}}</strong>.</p>{{end}}<details class="detail-disclosure contract-details"><summary>Contract details and other runs</summary><div class="panel-body">{{template "rulespick" .}}{{if .Run}}{{template "livemodes" .Mode}}{{end}}{{with .CopyNote}}<p class="note">{{template "i" "i-scroll-text"}}<span>{{.}}</span></p>{{end}}{{with .V}}{{range .View.Notes}}<p class="note">{{template "i" "i-shield"}}<span>{{.}}</span></p>{{end}}{{end}}<p>{{.Tier}}{{if .Watch}}. {{template "quantity" (quantityZero "shared.watch-refusals" "Watched only: nothing refused." exactNumbers)}}{{end}}</p>{{with .Run}}<p>Agent recorded by this run: <strong class="detail-value">{{.Agent}}</strong>.</p><p>Run <a class="text-link" href="/runs/{{pathEsc .ID}}">{{.ID}}</a>, started <time datetime="{{iso .Start}}">{{stamp .Start}}</time>.</p>{{end}}{{with .NotRun}}<p class="detail-value mono">{{.Plan.File}}</p>{{end}}{{with .Source}}<p class="detail-value mono">{{.}}</p>{{end}}<a class="text-link" href="/rules">All contracts</a></div></details>{{end}}
{{if .SelectionErr}}<section class="banner banner-warn" role="status">{{template "i" "i-triangle-alert"}}<div class="grow"><strong>Contract location unavailable</strong> {{.SelectionErr}}</div></section>
{{else}}<section class="panel"><div class="empty">
  <div class="glyph">{{template "i" "i-shield"}}</div>
  <h3>{{template "quantity" (quantityZero "contracts.contracts" "No contracts yet" $.Numbers)}}</h3>
  {{if .CanSetUp}}<a class="btn btn-primary" href="/rules/new">{{template "i" "i-shield"}}New rules file</a>{{end}}
  <p>Make one from presets or from a finished run{{if .CanSetUp}} with New rules file{{end}}.</p>
  <details class="cli-more"><summary>In a terminal</summary><div class="cli"><code>mkdir -p ~/contracts &amp;&amp; tego rules learn &lt;run&gt; --out ~/contracts/&lt;name&gt;.yaml</code></div></details>
</div></section>{{end}}
{{else}}{{$r := .Run}}{{$v := .V}}
<div class="head"><div>{{if .General}}<h2>Own contract{{if .Agent}} · {{.Agent}}{{end}}</h2>{{else}}{{if $.Tour}}<h2>{{else}}<h1 class="h1-obj">{{end}}<span class="desktop-only" data-number-exclude="rules.agent-field-6">Contract{{if .Agent}} · {{.Agent}}{{end}}</span><span class="phone-only">Contract</span>{{if $.Tour}}</h2>{{else}}</h1>{{end}}{{end}}
<p class="lede rules-ctx" data-number-exclude="rules.fact-17">{{if .Watch}}Watched only{{else}}{{.Tier}}{{end}} · run <a class="mono link" href="/runs/{{pathEsc $r.ID}}" title="{{$r.ID}}" data-number-exclude-title="rules.identity-2" data-number-exclude="rules.identity-24">{{rid $r.ID}}</a>{{if .Running}} · running{{else}} · ended{{end}}{{if .Source}} · <span class="detail-value mono" title="{{if $v.Source}}{{$v.Source}}{{else}}{{$v.CopyPath}} (the run's own copy){{end}}" data-number-exclude-title="rules.copy-location">{{template "pwp" (pieces .Source)}}</span>{{end}}</p></div>
<details class="head-more"><summary>Actions</summary><div class="head-actions">{{if .CanSetUp}}<a class="btn" href="/rules/new">{{template "i" "i-shield"}}New rules file</a>{{end}}{{if .Ref}}{{if .CanChange}}<a class="btn btn-primary" href="/rules/change?c={{queryEsc .Ref}}">{{template "i" "i-scroll-text"}}Edit contract</a>{{else}}<button class="btn btn-primary" type="button" disabled aria-describedby="rules-soon">{{template "i" "i-scroll-text"}}Change rules</button><p class="rules-soon" id="rules-soon">{{if .CannotChange}}{{.CannotChange}}{{else}}A rule changes from a log line (What to do about this) or with <span class="mono">tego rule</span>.{{end}}</p>{{end}}{{end}}</div></details></div>

{{with .Agent}}<p class="page-intro phone-only">Rules for <strong class="detail-value">{{.}}</strong>.</p>{{end}}<details class="detail-disclosure contract-details"><summary>Contract details and other runs</summary><div class="panel-body">{{template "rulespick" .}}{{if .Run}}{{template "livemodes" .Mode}}{{end}}{{with .CopyNote}}<p class="note">{{template "i" "i-scroll-text"}}<span>{{.}}</span></p>{{end}}{{with .V}}{{range .View.Notes}}<p class="note">{{template "i" "i-shield"}}<span data-number-exclude="rules.compile-note">{{.}}</span></p>{{end}}{{end}}<p data-number-exclude="rules.fact-18">{{.Tier}}{{if .Watch}}. {{template "quantity" (quantityZero "shared.watch-refusals" "Watched only: nothing refused." exactNumbers)}}{{end}}</p>{{with .Run}}<p>Agent recorded by this run: <strong class="detail-value" data-number-exclude="rules.agent-field-7">{{.Agent}}</strong>.</p><p>Run <a class="text-link" href="/runs/{{pathEsc .ID}}" data-number-exclude="rules.identity-25">{{.ID}}</a>, started <time datetime="{{iso .Start}}" data-number-exclude="rules.clock-4">{{stamp .Start}}</time>.</p>{{end}}{{with .NotRun}}<p class="detail-value mono">{{.Plan.File}}</p>{{end}}{{with .Source}}<p class="detail-value mono" data-number-exclude="rules.source-identity">{{.}}</p>{{end}}<a class="text-link" href="/rules">All contracts</a></div></details>{{with .Fence}}<section class="panel rules-fence" id="live-fence" aria-labelledby="h-fence"><div class="panel-head"><h2 id="h-fence">{{template "i" "i-shield"}}Live contract inside the fence <span class="soft">(Tego's live layer)</span></h2></div>
<div class="panel-body stack-sm"><p class="lf-lede"><span data-number-title="shared.policy" title="The kernel lets this run reach these; Tego's live layer blocks each until you lift it">Fence (kernel)</span></p>
{{if .Rows}}<ul class="list lf-list">{{range .Rows}}<li class="lf-row" data-k="{{.Kind}}:{{.Value}}" data-state="{{.State}}"><details class="row-details lf-entry"><summary><span class="lf-entry-what">{{.What}}</span><span class="b {{.ChipClass}} lf-chip">{{if eq .State "lifted"}}{{template "i" "i-check"}}{{else}}{{template "i" "i-ban"}}{{end}}{{.Chip}}</span></summary><div class="grow stack-sm"><span class="lf-what" title="{{.Rule}}">{{.What}} <span class="soft">· {{if eq .Verb "Grant"}}new access{{else}}one of the contract's refusals{{end}}{{if eq .Kind "exec"}} · best effort: a copy of the program under another name is not covered{{end}}</span></span>
<span class="lf-st"><span class="b {{.ChipClass}} lf-chip">{{if eq .State "lifted"}}{{template "i" "i-check"}}{{else}}{{template "i" "i-ban"}}{{end}}{{.Chip}}</span>{{with .Note}} <span class="soft">{{.}}</span>{{end}}{{with .LiftNote}} <span class="lf-note" data-number-exclude="rules.lift-note">Note: {{.}}</span>{{end}}{{if and (not .At.IsZero) .By}} <span class="soft">· {{if eq .State "lifted"}}{{if eq .Verb "Grant"}}granted{{else}}lifted{{end}}{{else}}last changed{{end}} by {{who .By}} at <time datetime="{{iso .At}}" title="{{stamp .At}}">{{clock .At}}</time></span>{{end}}</span></div>
{{if $d.Fence.Running}}{{if eq .State "lifted"}}<form class="lf-form" method="post" action="/runs/{{pathEsc $r.ID}}/restore"><input type="hidden" name="csrf" value="{{$csrf}}"><input type="hidden" name="kind" value="{{.Kind}}"><input type="hidden" name="value" value="{{.Value}}"><button class="btn" type="submit" aria-label="Restore: refuse again: {{.What}}">{{template "i" "i-ban"}}Restore</button></form>{{else}}<form class="lf-form" method="get" action="/runs/{{pathEsc $r.ID}}/lift" aria-label="{{.Verb}}: {{.What}}"><input type="hidden" name="kind" value="{{.Kind}}"><input type="hidden" name="value" value="{{.Value}}">{{template "forselect" "1h"}}<button class="btn" type="submit">{{.Verb}}…</button></form>{{end}}{{end}}<p class="detail-value mono lf-exact">{{.Value}}</p><p class="detail-value mono">{{.Rule}}</p></details></li>{{end}}</ul>
{{else}}<p class="soft" data-number="contracts.fence-entries">This run's fence is empty, so nothing can be lifted while it runs. Entries added under <span class="mono">live.fence</span> in its contract apply from the next run</p>{{end}}
<p class="soft">{{if .Running}}Lift and Grant preview first · {{end}}<span data-number-title="shared.policy" title="A time limit stops new access only: anything already read or copied, files still open and live connections stay"><span data-number="shared.policy">Time limits stop new access only</span></span></p>
<details class="cli-more"><summary>In a terminal</summary><div class="cli cli-wrap"><code data-number-exclude="rules.fence-cli">tego lift|grant|restore {{$r.ID}} &lt;read|net|exec&gt; &lt;value&gt;</code></div></details></div></section>{{end}}

{{if $v.Err}}<section class="banner banner-danger" role="alert">{{template "i" "i-triangle-alert"}}<div class="grow"><strong>Contract unreadable</strong> {{$v.Err}}</div></section>{{end}}
{{with .Pending}}{{if .Live}}<section class="panel rules-pending rp-live" aria-labelledby="h-pending"><div class="panel-head"><h2 id="h-pending">{{template "i" "i-scroll-text"}}{{if .Differs}}Rules file differs from this run{{else}}Changed since this run started{{end}}</h2></div><div class="panel-body stack-sm">
  <details class="row-details pending-details"><summary>Contract file</summary><p class="soft">The next run of <span class="detail-value mono">{{$d.Source}}</span> gets {{if .Differs}}the file's rules as they are now · this run keeps its own{{else}}every change below · this run keeps its own, except changes live on it{{end}}</p></details>
  {{if .Changes}}<ul class="rp-list rp-now">{{range .Changes}}{{$c := .}}<li class="rp-row"><div class="rp-what">{{if .Sentences}}{{range $i, $s := .Sentences}}{{if $i}}; {{end}}{{$s}}{{end}}{{else if .Summary}}{{.Summary}}{{else}}a change{{end}} <span class="soft">· {{if .Via}}from the {{.Via}}, {{end}}<time datetime="{{iso .At}}" title="{{stamp .At}}">{{clock .At}} {{tz}}</time></span></div>
  {{with .Now}}<div class="rp-state" data-state="{{.State}}"><span class="b {{.Class}}">{{.Label}}</span>{{with .Note}} <span class="soft">{{.}}</span>{{end}}{{if .Blocks}} <span class="rp-blocks">{{range $i, $b := .Blocks}}{{if $i}}; {{end}}<span title="{{$b.Key}}">{{$b.Words}}</span>{{end}}</span>{{end}}</div>
  {{if .CanApply}}<form class="rp-apply" method="post" action="/rules/change"><input type="hidden" name="csrf" value="{{$csrf}}"><input type="hidden" name="do" value="applynow"><input type="hidden" name="id" value="{{$c.ID}}"><input type="hidden" name="run" value="{{$r.ID}}"><button class="btn" type="submit">{{if .Observe}}{{template "i" "i-eye"}}Mark now (recorded only){{else}}{{template "i" "i-ban"}}Apply now{{end}}</button></form>{{end}}{{end}}</li>{{end}}</ul>{{end}}
  {{if not .Edited.IsZero}}<p>The file was also edited outside Tego at <time datetime="{{iso .Edited}}" title="{{stamp .Edited}}">{{clock .Edited}} {{tz}}</time> · not live on this run</p>{{end}}{{if .Differs}}<p><span data-number="shared.record-fields">The file's rules differ from what this run ran, and nothing dates the change: a profile it extends changed, or this run started from another version of the file · not live on this run</span></p>{{end}}{{if .Unchecked}}<p class="soft"><span title="The file could not be compared with what this run ran; this rests on the change record and the file's time">Not compared</span></p>{{end}}{{template "sourcecmp" .Compare}}
  <p class="soft">To apply all: stop it (<a class="link" href="/runs/{{pathEsc $r.ID}}/stop">Stop this run</a>); its next run gets these rules{{if .Restart}}:{{else}}.{{end}}</p>
  {{with .Restart}}<div class="cli"><code>{{cmd .}}</code></div><p class="soft"><span title="Same contract file and command; add options the run was started with, such as --tier or --record">Restart with</span></p>{{end}}
</div></section>{{else}}<section class="banner banner-warn rules-pending" role="status" aria-labelledby="h-pending">{{template "i" "i-triangle-alert"}}<div class="grow stack-sm">
  <h2 class="rp-h" id="h-pending">{{if .Differs}}Rules file differs{{else}}Saved{{end}} · from the next run</h2>
  <p>This run {{if $d.Running}}keeps{{else}}kept{{end}} its original rules. Changes to the file apply from the next run.</p><details class="row-details pending-details"><summary>Change details</summary><p>This run {{if $d.Running}}keeps{{else}}kept{{end}} the rules it started with. The next run of <span class="detail-value mono">{{$d.Source}}</span> gets {{if .Differs}}the file's rules as they are now.{{else}}the rules below changed:{{end}}</p>
  {{if .Changes}}<ul class="rp-list">{{range .Changes}}<li>{{if .Sentences}}{{range $i, $s := .Sentences}}{{if $i}}; {{end}}{{$s}}{{end}}{{else if .Summary}}{{.Summary}}{{else}}a change{{end}} <span class="soft">· {{if .Via}}from the {{.Via}}, {{end}}<time datetime="{{iso .At}}" title="{{stamp .At}}">{{clock .At}} {{tz}}</time></span></li>{{end}}</ul>{{end}}
  {{if not .Edited.IsZero}}<p>The file was also edited outside Tego at <time datetime="{{iso .Edited}}" title="{{stamp .Edited}}">{{clock .Edited}} {{tz}}</time> · tables show what this run enforces</p>{{end}}
  {{if .Differs}}<p><span data-number="shared.record-fields">The file's rules differ from what this run ran, and nothing dates the change: a profile it extends changed, or this run started from another version of the file · tables show what this run enforces</span></p>{{end}}
  {{if .Unchecked}}<p class="soft"><span title="The file could not be compared with what this run ran; this rests on the change record and the file's time">Not compared</span></p>{{end}}{{template "sourcecmp" .Compare}}
</details></div></section>{{end}}{{end}}
{{if .Watch}}<p class="note" title="Below: what an enforced run of this contract would refuse">{{template "i" "i-eye"}}<span>{{template "quantity" (quantityZero "shared.watch-refusals" "Watched only \u00b7 nothing refused" exactNumbers)}}</span></p>{{end}}

{{with $v.LiveErr}}<p class="note">{{template "i" "i-triangle-alert"}}<span>The run's live blocks could not be read: {{.}}.</span></p>{{end}}{{with .EndedLive}}<details class="r-fold rules-ended"><summary>This run's live {{if $d.Watch}}marks{{else}}blocks{{end}} <span class="soft">({{template "quantity" (quantity "contracts.ended-blocks" (len .) exactNumbers)}})</span></summary><ul class="r-devs">{{range .}}<li><span data-number-exclude="rules.identity-28">{{.Sentence}}</span><span class="soft"><span title="{{.SourceTitle}}" data-number-exclude="rules.fact-23">{{.Source}}</span> · {{template "hits" (withNumbers . $.Numbers)}}</span></li>{{end}}</ul></details>{{end}}

{{with .Live}}<section class="panel rules-live phone-table{{if .Calm}} is-calm{{end}}" aria-labelledby="g-live"><div class="panel-head"><h2 id="g-live">{{template "i" .Icon}}{{.Title}} <span class="soft">{{.Lede}}</span></h2></div><div class="tw"><table class="t t-rules summary-table" role="table"><caption class="sr">{{.Title}}: {{.Lede}}</caption><thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader">Rule</th><th scope="col" role="columnheader" class="c-enf">Enforced by</th><th scope="col" role="columnheader" class="c-hits num">In this run</th><th scope="col" role="columnheader" class="c-src">Added</th><th scope="col" role="columnheader" class="c-act"><span class="sr">Remove</span></th></tr></thead><tbody role="rowgroup">{{range .Rows}}
<tr role="row"><td role="cell" class="phone-cell"><a class="phone-row" href="{{.URL}}" aria-label="{{.Sentence}}; {{.Enforced}}{{with .Ends}}; {{.}}{{end}}"><span class="phone-who">{{phoneRuleName .}}</span><span class="b {{if eq .State "best_effort"}}b-refused{{else}}b-neutral{{end}}">{{if $d.Watch}}Recorded only{{else if .Ended}}Ended{{else if eq .State "best_effort"}}Refusing{{else}}Not in force{{end}}</span><span class="phone-when">{{if .Ends}}Time limit{{else}}This run{{end}}</span></a></td><td role="cell" class="lead">{{.Sentence}}{{with .Ends}} <span class="soft lf-ends">{{.}}</span>{{end}}</td><td role="cell" data-label="Enforced by" class="c-enf">{{template "enforced" .}}</td><td role="cell" data-label="In this run" class="c-hits num">{{template "hits" (withNumbers . $.Numbers)}}</td><td role="cell" data-label="Added" class="c-src"><span title="{{.SourceTitle}}">{{.Source}}</span></td><td role="cell" class="act">{{if not .Ended}}<form method="post" action="/runs/{{pathEsc $r.ID}}/unblock"><input type="hidden" name="csrf" value="{{$csrf}}"><input type="hidden" name="kind" value="{{.Kind}}"><input type="hidden" name="value" value="{{.Value}}"><button class="btn" type="submit" aria-label="Remove the live block: {{.Sentence}}">{{template "i" "i-rotate-cw"}}Remove</button></form>{{end}}</td></tr>{{end}}
</tbody></table></div>{{with .Default}}<div class="panel-foot"><span>{{.}}</span></div>{{end}}</section>{{end}}

{{range .Groups}}<section class="panel rules-g phone-table" aria-labelledby="g-{{.ID}}"><div class="panel-head"><h2 id="g-{{.ID}}">{{template "i" .Icon}}{{.Title}} <span class="soft" data-number-exclude="rules.detail-2">{{.Lede}}</span></h2></div>
{{if .Rows}}<div class="tw"><table class="t t-rules summary-table" role="table"><caption class="sr" data-number-exclude="rules.group-description">{{.Title}}: {{.Lede}}</caption><thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader">Rule</th><th scope="col" role="columnheader" class="c-effect">Effect</th><th scope="col" role="columnheader" class="c-enf">Enforced by <span class="th-sub">exceptions named below</span></th><th scope="col" role="columnheader" class="c-hits num">In this run</th><th scope="col" role="columnheader" class="c-src">Source</th></tr></thead><tbody role="rowgroup">{{range .Rows}}
<tr role="row"{{if .Devices}} class="r-fold-row"{{end}}><td role="cell" class="phone-cell"><a class="phone-row" href="{{.URL}}" aria-label="{{.Sentence}}; {{if eq .Effect "deny"}}Refuses{{else if eq .Effect "ask"}}Asks you{{else if eq .Effect "allow"}}Allows{{else}}Rule{{end}}; run started {{when $r.Start $d.Now}}" data-number-exclude-aria-label="rules.identity-8"><span class="phone-who">{{phoneRuleName .}}</span>{{template "effect" .Effect}}<time class="phone-when" datetime="{{iso $r.Start}}" data-started="{{iso $r.Start}}" data-number-exclude="rules.clock-10" data-ck>{{rowAgo $r.Start $d.Now}}</time></a></td><td role="cell" class="lead">{{if .Devices}}<details class="r-fold"><summary>{{.Sentence}} <span class="soft">{{range $i, $x := .Devices}}{{if $i}}, {{end}}{{$x.Target}}{{end}}</span></summary><ul class="r-devs">{{range .Devices}}<li><span>{{.Sentence}}</span><span class="soft"><span class="mono" title="{{.SourceTitle}}">{{.Source}}</span> · {{template "hits" (withNumbers . $.Numbers)}}</span></li>{{end}}</ul></details>{{else}}<a class="text-link" href="{{.URL}}" data-number-exclude="rules.identity-31">{{.Sentence}}</a>{{end}}</td><td role="cell" data-label="Effect" class="c-effect">{{template "effect" .Effect}}</td><td role="cell" data-label="Enforced by" class="c-enf{{if .ByOS}} is-os{{end}}">{{template "enforced" .}}</td><td role="cell" data-label="In this run" class="c-hits num">{{template "hits" (withNumbers . $.Numbers)}}</td><td role="cell" data-label="Source" class="c-src"><span class="mono" title="{{.SourceTitle}}" data-number-exclude="rules.fact-27">{{.Source}}</span></td></tr>{{end}}
</tbody></table></div>{{end}}
{{if .Default}}<div class="panel-foot rules-default{{if .Open}} is-open{{end}}">{{if .Open}}<span class="b b-neutral" title="Wide open: a contract usually narrows this">{{template "i" "i-triangle-alert"}}Open</span>{{end}}<span data-number-exclude="rules.detail-1">{{.Default}}</span>{{if .DefaultHits}}<a class="n-link r-dhits" href="{{.DefaultURL}}" aria-label="{{quantityText "contracts.default-hits" .DefaultHits $.Numbers}} {{plural .DefaultHits "line" "lines"}} of this run decided by: {{.Default}}" data-number-aria-label="contracts.default-hits">{{template "quantity" (quantity "contracts.default-hits" .DefaultHits $.Numbers)}} {{plural .DefaultHits "hit" "hits"}}</a>{{end}}{{if .Narrow}}<a class="link r-narrow" href="{{.Narrow}}">Narrow this</a>{{end}}</div>{{end}}</section>{{end}}
{{if $v.View.Unmatched}}<p class="note">{{template "i" "i-eye"}}<span><a class="n-link" href="{{logsURL $r.ID "unmatched"}}">{{template "quantity" (quantity "contracts.unmatched" $v.View.Unmatched $.Numbers)}} {{plural $v.View.Unmatched "line" "lines"}}</a> decided by defaults</span></p>{{end}}

<details class="cli-more"><summary>In a terminal</summary>{{if .Hint}}<div class="cli"><code data-number-exclude="rules.fact-28">{{cmd .Hint}}</code></div>{{end}}<div class="cli"><code data-number-exclude="rules.fact-29">tego block --list {{$r.ID}}</code></div>{{if not .Hint}}<span class="soft" title="The recorded contract source is not available to compile; its copy is below" data-number-exclude="rules.detail-5">Contract source unavailable</span>{{end}}</details>

<details class="panel rules-raw"><summary class="panel-head"><h2>Contract file and compiled form</h2><span class="soft">YAML</span></summary>
<div class="panel-body stack-lg">
<dl class="kv">
  <dt>Run copy</dt><dd>{{if $v.Contract.Missing}}<span class="muted">Copy unavailable</span>{{else}}<span class="mono" data-number-exclude="rules.run-copy-path">{{$v.CopyPath}}</span>{{end}}</dd>
  {{if not $v.Contract.Missing}}<dt>Hash</dt><dd>{{if $v.Contract.HashMatches}}<span class="b b-verified">{{template "i" "i-check"}}Same contract the run recorded</span>{{else if $v.Contract.Hash}}<span class="b b-broken">{{template "i" "i-triangle-alert"}}Not the contract_hash the run recorded</span>{{else}}<span class="muted" data-number-exclude="rules.static-1">Hash not available</span>{{end}}</dd>{{end}}
  {{if $v.Source}}<dt>Contract file</dt><dd class="mono" data-number-exclude="rules.contract-identity">{{$v.Source}}</dd>{{end}}
  {{with $v.Contract.Cwd}}<dt>Directory</dt><dd class="mono" data-number-exclude="rules.directory-identity">{{.}}</dd>{{end}}
  {{with .Hint}}<dt>In a terminal</dt><dd class="mono" data-number-exclude="rules.compile-command">{{.}}</dd>{{end}}
</dl>
{{if .Text}}<div><h3>The run's copy</h3><pre class="term detail-value" data-number="contracts.compiled-facts">{{.Text}}</pre></div>{{end}}
{{if .Table}}<div><h3>What it compiles to</h3><pre class="term detail-value" data-number="contracts.compiled-facts">{{.Table}}</pre></div>{{end}}
{{with $v.Contract.Err}}<section class="banner banner-warn" role="status">{{template "i" "i-triangle-alert"}}<div class="grow" data-number-exclude="rules.contract-error">{{.}}</div></section>{{end}}
{{with $v.Contract.Diagnostics}}<div><h3>Diagnostics</h3><pre class="term detail-value" data-number-exclude="rules.compile-diagnostics">{{.}}</pre></div>{{end}}
<p class="soft">Values hidden</p>
</div></details>
{{end}}</div>{{end}}{{end}}

{{define "contract-filters"}}<form class="filter-fields" action="/rules" method="get"><label class="field">Agent or contract file<input class="input" name="q" type="search" value="{{.Query}}" placeholder="Agent name…" autocomplete="off" spellcheck="false"></label><label class="field">State<select class="select" name="state"><option value="">All contracts</option><option value="running"{{if eq .State "running"}} selected{{end}}>In use</option><option value="not-run"{{if eq .State "not-run"}} selected{{end}}>Not run yet</option><option value="gone"{{if eq .State "gone"}} selected{{end}}>File gone</option></select></label><button class="btn btn-primary" type="submit">Show contracts</button><a class="btn" href="/rules">Clear filters</a></form>{{end}}
