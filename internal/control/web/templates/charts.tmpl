{{/* chart writes one svgChart (charts.go): its words as screen-reader text, then the svg, hidden from the
     accessibility tree like every svg on the page, with the same words as its title and desc for the hover. A
     sparkline's newest point is a zero-length round-capped line, so the dot stays round in a stretched viewBox. */}}
{{define "chart"}}{{if .}}<span class="sr">{{.Label}}. {{.Desc}}</span><svg class="{{.Class}}" viewBox="0 0 {{.W}} {{.H}}" preserveAspectRatio="none" aria-hidden="true" focusable="false"><title>{{.Label}}</title><desc>{{.Desc}}</desc>{{with .Area}}<polygon class="ch-area" points="{{.}}"/>{{end}}{{with .Line}}<polyline class="ch-line" points="{{.}}" vector-effect="non-scaling-stroke"/>{{end}}{{with .DotX}}<line class="ch-dot" x1="{{.}}" y1="{{$.DotY}}" x2="{{.}}" y2="{{$.DotY}}" vector-effect="non-scaling-stroke"/>{{end}}{{with .Axis}}<line class="ch-axis" x1="0" y1="{{.}}" x2="{{$.W}}" y2="{{.}}" vector-effect="non-scaling-stroke"/>{{end}}{{range .Parts}}{{if .Href}}<a href="{{.Href}}" tabindex="-1"><rect class="{{.Class}}" x="{{.X}}" y="{{.Y}}" width="{{.W}}" height="{{.H}}"><title>{{.Title}}</title></rect></a>{{else}}<rect class="{{.Class}}" x="{{.X}}" y="{{.Y}}" width="{{.W}}" height="{{.H}}">{{with .Title}}<title>{{.}}</title>{{end}}</rect>{{end}}{{end}}</svg>{{end}}{{end}}
{{/* spark writes a sparkline with its oldest value at the left end and its newest, stronger, at the right (the
     line has no axis; the screen-reader text already says every value, so the end numbers are hidden from it), or,
     with fewer than two values, its Note in words in the same fixed-height row. */}}
{{define "spark"}}{{if .}}{{if .Line}}<span class="ch-spk"><span class="ch-sv" aria-hidden="true">{{.First}}</span>{{template "chart" .}}<span class="ch-sv ch-sv-last" aria-hidden="true">{{.Last}}</span></span>{{else}}<span class="ch-spk ch-spk-note">{{.Note}}</span>{{end}}{{end}}{{end}}
