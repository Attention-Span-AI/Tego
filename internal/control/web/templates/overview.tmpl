{{/* SPDX-License-Identifier: Apache-2.0 */}}
{{/* The Overview is six live regions (regions.go), so a live run's new line resends the parts it changed (the Running
     now table, a count), not the page: the headline, the tiles (or, with no run yet, the empty state), Running now,
     Waiting on you, Recent runs (the newest runs that are not running: a running run is under Running now) and Recent
     refusals. A panel renders nothing while the ledger has no run, and a grid with no panel in it is hidden (mvp.css, .ov-grid). */}}
{{define "content"}}<link rel="stylesheet" href="/static/overview.css"><div class="overview-page">{{template "lr" (index $.L "r-ov-head")}}{{template "r-ov-head" $}}</div>
{{template "lr" (index $.L "r-ov-guide")}}{{template "r-ov-guide" $}}</div>
{{template "lr" (index $.L "r-ov-tiles")}}{{template "r-ov-tiles" $}}</div>
<div class="grid ov-grid ov-now">{{template "lr" (index $.L "r-ov-live")}}{{template "r-ov-live" $}}</div>{{template "lr" (index $.L "r-ov-refusals")}}{{template "r-ov-refusals" $}}</div></div>
<div class="grid ov-grid">{{template "lr" (index $.L "r-ov-recent")}}{{template "r-ov-recent" $}}</div>{{template "lr" (index $.L "r-ov-asks")}}{{template "r-ov-asks" $}}</div></div>
</div>{{end}}
{{define "r-ov-head"}}{{with .Data}}<div class="head"><div>
{{$a := .Attention}}{{if $.Tour}}<h2>{{else}}<h1>{{end}}<span data-number="overview.attention">{{$a.Headline}}</span>{{if $.Tour}}</h2>{{else}}</h1>{{end}}{{if .AttentionSource.PendingReason}}<p class="ov-risk phone-only" data-number="overview.attention">{{$.PhoneWaiting.PhoneReason}}</p>{{end}}
{{range $a.Items}}<p class="{{.Class}}{{if and $.Data.AttentionSource.PendingReason (or (eq .Kind "waiting") (eq .Kind "unreadable") (eq .Kind "incomplete"))}} desktop-only{{end}}" data-attention="{{.Kind}}"{{if eq .Kind "leak"}} role="alert"{{end}}><span><span data-number="overview.attention">{{.Body}}</span></span> <a class="link" href="{{.URL}}">{{.Link}}</a></p>{{end}}</div></div>{{end}}{{end}}
{{/* r-ov-guide is the guide once the ledger has a run (setupguide.go): the steps open until every one is done, then
     folded to one line; with no run, the empty state below shows it whole, and under it, the recoverable first step for
     any agent (firstrun-step) unless the guide's next step is already that one. */}}
{{define "r-ov-guide"}}{{with .Data}}{{if and .Total .Guide}}{{$open := .GuideOpen}}{{with .Guide}}{{if .Done}}<details class="panel gd gd-fold" id="h-gd"{{if $open}} open{{end}}>
<summary class="gd-sum"><h2 class="gd-sum-h"><span class="b b-verified">{{template "i" "i-check"}}Done</span><span data-number="overview.setup-step"> Set up: every step is done</span></h2></summary><div class="panel-body">{{template "guide" .}}</div></details>
{{else}}<details class="panel gd ov-setup" id="h-gd"{{if $open}} open{{end}}><summary>Set up, step by step</summary><div class="panel-body">{{template "guide" .}}</div></details>{{end}}{{end}}{{end}}{{end}}{{end}}
{{/* guide is the object internal/guide computed, in tego setup's words (guide.State.Words): each step's state in
     words beside its badge and the fact that decided it, as text; the next step's command as a command to copy only
     when the guide built it (guide.Next.Built); and what it could not know. */}}
{{define "guide"}}<details class="gd-history"><summary>All setup steps</summary><ol class="gd-steps">{{range .Words.Steps}}{{$b := stepBadge .State}}<li class="gd-step" data-step="{{.ID}}" data-state="{{.State}}"><span class="gd-n" aria-hidden="true">{{template "quantity" (quantity "overview.setup-step" .N exactNumbers)}}</span><div class="gd-body"><p class="gd-line"><span class="gd-t" data-number="overview.attention">{{.Title}}</span> <span class="b {{index $b 0}}">{{template "i" (index $b 1)}}{{stepWord .State}}</span></p><p class="gd-f">{{template "quantity" (quantityWords "overview.guide-fact" .Fact exactNumbers)}}</p></div></li>{{end}}</ol>
{{with .Words.NotKnown}}<h3 class="gd-h">Not known</h3><ul class="gd-nk">{{range .}}<li data-number-exclude="overview.specific-2">{{.}}</li>{{end}}</ul>{{end}}
<p class="soft gd-note"><span data-number="shared.policy">The page never checks this machine itself: the check step is the one</span> <span class="mono">tego setup</span> stored for this boot and this build.</p></details><h3 class="gd-h">Next step</h3>
<p class="gd-next" data-rule="{{.Next.Rule}}">{{template "quantity" (quantityWords "overview.guide-fact" .Next.Text exactNumbers)}}</p>
{{if .CanCopy}}<div class="cli cli-wrap gd-cmd"><code data-number-exclude="overview.fact-1">{{cmd .Next.Command}}</code></div>{{if .Next.NeedsRoot}}<p class="soft">This command runs as root.</p>{{end}}{{if .Next.Placeholder}}<p class="soft">The words in angle brackets are yours to fill in: Tego cannot know them.</p>{{end}}{{end}}
{{end}}
{{define "r-ov-tiles"}}{{with .Data}}{{template "overview-summary" (withNumbers . $.Numbers)}}{{if not .Total}}
{{with .Guide}}<section class="panel gd" aria-labelledby="h-gd"><div class="panel-head"><h2 id="h-gd">Set up, step by step</h2><span class="soft">{{template "quantity" (quantityZero "overview.runs" "No runs yet" $.Numbers)}} · same as <span class="mono">tego setup</span></span></div>
<div class="panel-body">{{template "guide" .}}</div></section>
{{if .AnyAgent}}<section class="panel" aria-labelledby="h-any"><details class="ov-extra-step"><summary><h2 id="h-any">The first step for any agent</h2></summary>
<div class="panel-body"><p>Start your agent under Tego, in a terminal, from your project:</p>
{{template "firstrun-step"}}</div></details></section>{{end}}
{{else}}<section class="panel"><div class="empty">
  <div class="glyph">{{template "i" "i-activity"}}</div>
  <h2>{{template "quantity" (quantityZero "overview.runs" "No runs yet" $.Numbers)}}</h2>
  {{template "firstrun"}}
</div></section>{{end}}
{{else}}
<section class="desktop-only" aria-labelledby="h-glance"><h2 id="h-glance" class="sr">At a glance</h2>
<div class="tiles">
  <div class="tile{{if .Pending}} attn{{end}}"><span class="label">{{template "i" "i-hand"}}Needs you</span><span class="value"><a href="/approvals" aria-label="{{$.Waiting.Sentence}}, open Approvals" data-number-aria-label="overview.waiting"><span data-number="overview.waiting" title="{{$.Waiting.Sentence}}" data-number-title="overview.waiting">{{$.Waiting.Short}}</span></a></span><span class="meta">{{if .Pending}}Waiting{{else if $.Data.AttentionSource.PendingReason}}<span data-number="overview.waiting" title="{{$.Waiting.Sentence}}">{{$.Waiting.Count}}</span>{{else}}{{template "quantity" (quantityZero "overview.waiting" "None waiting" $.Numbers)}}{{end}}</span></div>
  <div class="tile"><span class="label">{{template "i" "i-activity"}}Running now</span><span class="value"><a href="/runs?state=running" aria-label="{{quantityText "overview.running" (len .Live) $.Numbers}} running now, list them" data-number-aria-label="overview.running">{{template "quantity" (quantity "overview.running" (len .Live) $.Numbers)}}</a></span><span class="meta">of {{template "quantity" (quantity "overview.runs" .Total $.Numbers)}} {{plural .Total "run" "runs"}}</span></div>
  <div class="tile"><span class="label">{{template "i" "i-ban"}}Refused</span><span class="value"><a href="/logs?verdict=refused" aria-label="{{quantityText "overview.refused" .Refused $.Numbers}} refused, open Logs" data-number-aria-label="overview.refused">{{template "quantity" (quantity "overview.refused" .Refused $.Numbers)}}</a></span><span class="meta" title="Routine: system lookups and probes">{{template "quantity" (quantity "overview.routine" .BgTotal $.Numbers)}} routine</span><span class="tile-spark" title="Refused per run, last {{quantityText "overview.chart-runs" .Charts.SparkRuns $.Numbers}} runs" data-number-title="overview.chart-runs">{{template "spark" .Charts.RefSpark}}{{$runs := .Charts.SparkRuns}}{{with .Charts.RefSpark}}{{if .Line}}<span class="ch-spcap" aria-hidden="true">Each of the last {{template "quantity" (quantity "overview.chart-runs" $runs $.Numbers)}} runs</span>{{end}}{{end}}</span></div>
  {{with .Chain}}{{if .Broken}}<div class="tile chain-bad" role="alert"><span class="label">{{template "i" "i-triangle-alert"}}Record</span><span class="value chain-v"><a href="/runs/{{pathEsc .Broken.Run}}">Broken · <span class="mono" data-number-exclude="overview.broken-run-id">{{rid .Broken.Run}}</span></a></span><span class="meta" title="{{.Broken.Reason}}">{{if .Broken.AtLine}}Broken at #{{.Broken.Line}}{{else if .Broken.Lines}}Broken after #{{.Broken.Line}}{{else}}{{template "quantity" (quantityZero "overview.chain-lines-zero" "No lines read" exactNumbers)}}{{end}}</span></div>
  {{else if .Verifying}}<div class="tile" aria-busy="true"><span class="label">{{template "i" "i-link"}}Record</span><span class="value chain-v"><a href="/runs?state=ended">Verifying…</a></span><span class="meta" title="Newest {{quantityText "overview.check-limit" $.Data.MaxChain $.Numbers}} ended runs" data-number-title="overview.check-limit overview.skipped-checks">{{template "quantity" (quantity "overview.checking" .Verifying $.Numbers)}} checking{{if .Checked}} · {{template "quantity" (quantity "overview.checked" .Checked $.Numbers)}} verified{{end}}</span></div>
  {{else if .Checked}}<div class="tile"><span class="label">{{template "i" "i-link"}}Record</span><span class="value chain-v"><a href="/runs?state=ended">Verified · {{template "quantity" (quantity "overview.checked" .Checked $.Numbers)}} {{plural .Checked "run" "runs"}}</a></span><span class="meta" title="Each ended run's hash chain and its chain.log anchor, for the newest {{quantityText "overview.check-limit" $.Data.MaxChain $.Numbers}} ended runs at most{{if .Skipped}}; {{quantityText "overview.skipped-checks" .Skipped $.Numbers}} not checked (running, lost or older){{end}}" data-number-title="overview.check-limit overview.skipped-checks">{{with len $.Data.Live}}{{template "quantity" (quantity "overview.running" . $.Numbers)}} running, checked at end{{else}}Hash chain checked{{end}}</span></div>
  {{else}}<div class="tile"><span class="label">{{template "i" "i-link"}}Record</span><span class="value chain-v"><a href="/runs">Not checked</a></span><span class="meta" title="{{.Reason}}" data-number-exclude-title="overview.specific-1">{{if .Reason}}<span data-number="shared.check-reason">{{.Reason}}</span>{{else}}{{template "quantity" (quantityZero "overview.ended" "No ended run" $.Numbers)}}{{end}}</span></div>{{end}}{{end}}
</div></section>
{{with .Charts}}{{template "overview-bars" (withNumbers . $.Numbers)}}<section class="ch-row desktop-only" aria-label="Refused and secrets">
<figure class="panel ch-fig"><figcaption class="ch-cap"><span class="ch-h">Detections</span><a class="link" href="/detections">All</a></figcaption>
<table class="t sev-grid"><caption class="sr">Refused actions by severity and channel</caption><thead><tr><th scope="col"><span class="sr">Severity</span></th>{{range $.Data.Grid.Channels}}<th scope="col" class="num">{{.}}</th>{{end}}<th scope="col" class="num">All</th></tr></thead>
<tbody>{{range $.Data.Grid.Rows}}{{$sev := .Sev}}<tr><th scope="row"><span class="sev sev-{{.Sev}}">{{.Sev}}</span></th>{{range $i, $n := .Cells}}<td class="num" data-label="{{index $.Data.Grid.Channels $i}}">{{if $n}}<a href="/detections?sev={{lower $sev}}&amp;ch={{lower (index $.Data.Grid.Channels $i)}}" aria-label="{{quantityText "overview.severity-channel" $n $.Numbers}} {{$sev}}, {{index $.Data.Grid.Channels $i}}" data-number-aria-label="overview.severity-channel">{{template "quantity" (quantity "overview.severity-channel" $n $.Numbers)}}</a>{{else}}<span class="sev-0">{{template "quantity" (quantity "overview.severity-channel" 0 $.Numbers)}}</span>{{end}}</td>{{end}}<td class="num" data-label="All">{{if .Sum}}<a href="/detections?sev={{lower .Sev}}" aria-label="{{quantityText "overview.severity-total" .Sum $.Numbers}} {{.Sev}}, all channels" data-number-aria-label="overview.severity-total"><b>{{template "quantity" (quantity "overview.severity-total" .Sum $.Numbers)}}</b></a>{{else}}<span class="sev-0">{{template "quantity" (quantity "overview.severity-total" 0 $.Numbers)}}</span>{{end}}</td></tr>{{end}}</tbody></table></figure>
<figure class="panel ch-fig"><figcaption class="ch-cap"><span class="ch-h">Secrets</span>{{$runs := .SparkRuns}}{{with .SecretSpark}}{{if .Line}}<span class="ch-n ch-sp" title="Protected per run, last {{quantityText "overview.chart-runs" $runs $.Numbers}} runs" data-number-title="overview.chart-runs"><span aria-hidden="true">Protected, last {{template "quantity" (quantity "overview.chart-runs" $runs $.Numbers)}} runs</span>{{template "spark" .}}</span>{{end}}{{end}}</figcaption>{{template "chart" .SecretsBar}}
<ul class="ch-legend"><li><span class="sw ch-refused"></span>Protected <b>{{template "quantity" (quantity "overview.protected" .Protected $.Numbers)}}</b></li><li><span class="sw ch-leak"></span>Exposed <b>{{template "quantity" (quantity "overview.exposed" .Exposed $.Numbers)}}</b></li></ul>
{{with .Unrecorded}}<p class="soft">{{template "quantity" (quantity "overview.unrecorded" . $.Numbers)}} {{plural . "run" "runs"}}<span data-number="overview.unrecorded"> did not record every file read, so a secret read there may be missing from these counts. </span>{{template "readfix"}}</p>{{end}}</figure>
</section>{{end}}
{{end}}{{end}}{{end}}
{{define "r-ov-live"}}{{with .Data}}{{if .Total}}<section class="panel s8 ov-running{{if and (not .Live) $.Numbers.Live.Error}} desktop-only{{end}}" aria-labelledby="h-running"><div class="panel-head"><h2 id="h-running">Running now</h2><a class="link" href="/runs">All runs</a></div>
{{if .Live}}<div class="ov-desktop-table">{{template "runtable" (runtab .Live .Now .V)}}</div>{{template "overview-runs" (runtab .Live .Now .V)}}{{else}}<div class="panel-body"><p class="soft" data-number="overview.running">{{if $unknown := unknownCount $.Numbers.Live "Running runs"}}{{$unknown}}{{else}}{{template "quantity" (quantityZero "overview.running" "Nothing running" $.Numbers)}}{{end}}</p></div>{{end}}
</section>{{end}}{{end}}{{end}}
{{define "r-ov-asks"}}{{with .Data}}{{if .Total}}<section class="panel s4 desktop-only" aria-labelledby="h-asks"><div class="panel-head"><h2 id="h-asks">Waiting on you</h2><a class="link" href="/approvals">All approvals</a></div>
{{if .Pending}}<ul class="list">{{range .Pending}}<li class="wait-row" data-k="{{.Run}}-{{.AskID}}"><div class="grow"><span class="title ellip" data-number-exclude="overview.identity-4">{{.Agent}} wants to {{askVerb .Op .Rule .Hold}}</span><span class="meta ellip" title="{{rid .Run}} · {{clock .TS}} · Run {{.Run}} · {{stamp .TS}}" data-number-exclude="overview.fact-2">{{rid .Run}} · {{clock .TS}}</span></div><div class="tgt">{{template "sptv" (spt .Target (index $.AskMeta .Run).Home 44)}}</div><a class="btn btn-primary" href="{{approvalURL .Run .AskID}}" aria-label="Review: {{.Agent}} wants to {{askVerb .Op .Rule .Hold}}" data-number-exclude-aria-label="overview.identity-1">Review</a></li>{{end}}</ul>
{{else}}<div class="panel-body"><p class="soft">{{if .AttentionSource.PendingReason}}<span data-number="overview.waiting" title="{{$.Waiting.Sentence}}">{{$.Waiting.Sentence}}</span>{{else}}{{template "quantity" (quantityZero "overview.waiting" "None waiting" $.Numbers)}}{{end}}</p></div>{{end}}
</section>{{end}}{{end}}{{end}}
{{define "r-ov-recent"}}{{with .Data}}{{if .Total}}<section class="panel s8 desktop-only" aria-labelledby="h-recent"><div class="panel-head"><h2 id="h-recent">Recent runs</h2><span class="row">{{if .CmpURL}}<a class="link" href="{{.CmpURL}}">Compare</a>{{end}}<a class="link" href="/runs">All runs</a></span></div>
{{if .Recent}}{{template "overview-runs" (runtab .Recent .Now .V)}}{{else}}<div class="panel-body"><p class="soft" data-number="overview.ended">{{if $unknown := unknownCount $.Numbers.Aggregate "Ended runs"}}{{$unknown}}{{else}}{{template "quantity" (quantityZero "overview.ended" "None ended" $.Numbers)}}{{end}}</p></div>{{end}}
</section>{{end}}{{end}}{{end}}
{{define "r-ov-refusals"}}{{with .Data}}{{if .Total}}<section class="panel s4{{if .Pending}} desktop-only{{end}}" aria-labelledby="h-ref"><div class="panel-head"><h2 id="h-ref">Latest High and Medium</h2><a class="link" href="/detections">Detections</a></div>
{{if .Top}}<div class="ov-phone-refusals phone-list">{{range $i, $v := .Top}}{{if eq $i 0}}<a class="phone-row" href="/runs/{{pathEsc .Run}}/lines/{{.FirstSeq}}"><span class="phone-who" data-number-exclude="overview.agent-field-1">{{if .Agent}}{{.Agent}}{{else}}{{.Verb}}{{end}}</span><span class="b b-refused">{{template "i" "i-ban"}}Refused</span><time class="phone-when" datetime="{{iso .Last}}" data-started="{{iso .Last}}" data-number-exclude="overview.clock-1" data-ck>{{rowAgo .Last $.Data.Now}}</time></a>{{end}}{{end}}</div><ul class="list iv-linked desktop-only">{{range .Top}}<li><span class="sev sev-{{.Severity}}">{{.Severity}}</span><a class="dt-what" href="/runs/{{pathEsc .Run}}/investigate/{{.FirstSeq}}"><span class="dt-verb">{{.Verb}}</span> {{template "sptv" (spt (mask (tilde .Subject)) .Home 60)}}</a>{{template "porttag" (withNumbers . $.Numbers)}}<time class="soft" datetime="{{iso .Last}}" title="{{stamp .Last}}" data-number-exclude="overview.clock-2">{{when .Last $.Data.Now}}</time></li>{{end}}</ul>
{{else}}<div class="panel-body"><p class="soft" data-number="overview.severity-total">{{if $unknown := unknownCount $.Numbers.Window "High and Medium detections"}}{{$unknown}}{{else}}{{template "quantity" (quantityZero "overview.severity-total" "Nothing High or Medium" $.Numbers)}}{{end}}</p></div>{{end}}
</section>{{end}}{{end}}{{end}}
{{/* refrow is one refusal row (refRow): the row's run home, for the path shortener, the row, and its program fold:
one program refused under several paths reads as its name, the paths in the title. */}}
{{define "refrow"}}{{$numbers := numbersOf .}}{{$ := numberValue .}}{{with $}}{{$home := .Run}}{{$f := .Fold}}{{with .V}}<li class="{{if .SystemLookup}}sys{{end}}" data-k="{{.Run}}-{{.Seq}}">{{template "i" "i-ban"}}<div class="grow"><span class="title rf-t"><span class="op">{{.Op}}</span>{{if $f.Name}}<span class="ut rf-prog" title="{{join $f.Paths ", "}}">{{$f.Name}}</span>{{else}}{{template "sptv" (spt (shown .Event) $home 44)}}{{end}}{{if gt .Count 1}}<span class="xn" title="{{quantityText "overview.refusal-repeat" .Count $numbers}} times" data-number-title="overview.refusal-repeat">×{{template "quantity" (quantity "overview.refusal-repeat" .Count $numbers)}}</span>{{end}}</span><span class="meta"><span class="clamp"><span>{{.Agent}} · <span title="{{.Rule}}" data-number-exclude="overview.fact-3">{{if .Label}}{{.Label}}{{else}}{{ruleName .Rule}}{{end}}</span>{{if .SystemLookup}} · <span class="tag-sys">system lookup</span>{{end}}</span></span></span></div><a class="link nowrap" href="/runs/{{pathEsc .Run}}/refusals" aria-label="Open the refusals of run {{rid .Run}}" data-number-exclude-aria-label="overview.identity-2">Run</a></li>{{end}}{{end}}{{end}}

{{define "overview-summary"}}{{$numbers := numbersOf .}}{{$ := numberValue .}}{{with $}}<section class="overview-summary" aria-label="Record state"><div class="record-seal">
{{if not .Total}}<div class="record-copy"><strong>{{template "quantity" (quantityZero "overview.runs" "No record yet" $numbers)}}</strong><p>{{template "quantity" (quantityZero "overview.runs" "Your first run will appear here." $numbers)}}</p><a class="link" href="/runs">View runs</a></div>{{else}}{{with .Chain}}{{if .Broken}}<div class="record-copy" role="alert"><span class="b b-broken">{{template "i" "i-triangle-alert"}}Broken record</span><p>The saved record does not verify.</p><details class="record-failure-details"><summary>What failed</summary><p class="detail-value">{{.Broken.Reason}}</p></details><a class="link" href="/runs/{{pathEsc .Broken.Run}}/receipt">View record</a></div>
{{else if .Verifying}}<div class="record-copy" aria-busy="true"><strong>Checking the record…</strong><p>{{template "quantity" (quantity "overview.checking" .Verifying $numbers)}} checking{{if .Checked}}, {{template "quantity" (quantity "overview.checked" .Checked $numbers)}} verified{{end}}.</p><a class="link" href="/runs?state=ended">View runs</a></div>
{{else if .Checked}}<div class="record-copy"><strong>{{template "i" "i-link"}}Record verified</strong><p>{{template "quantity" (quantity "overview.checked" .Checked $numbers)}} {{plural .Checked "ended run checked" "ended runs checked"}}. Newest {{template "quantity" (quantity "overview.check-limit" $.MaxChain $numbers)}} at most.</p><a class="link" href="/runs?state=ended">View record</a></div>
{{else}}<div class="record-copy"><strong>Record not checked</strong>{{if .Reason}}<details class="record-failure-details"><summary>Why not checked</summary><p class="detail-value" data-number-exclude="overview.element-1">{{.Reason}}</p></details>{{else}}<p>{{template "quantity" (quantityZero "overview.ended" "No ended run to check." $numbers)}}</p>{{end}}<a class="link" href="/runs">View runs</a></div>{{end}}{{end}}
{{end}}</div>{{if .Total}}<div class="summary-counts"><a href="/runs?state=running">{{template "quantity" (quantity "overview.running" (len .Live) $numbers)}} running now</a><a href="/logs?verdict=refused&amp;where=since:{{dayStart .Now}}">{{template "quantity" (quantity "overview.refused-today" .RefusedToday $numbers)}} refused today</a></div>{{if .RefusedTodayLower}}<p class="soft">{{if .RefusalUnreadable}}Some record lines could not be read.{{else if .RefusalRecords}}Retained event windows omit part of today.{{else}}Some runs are omitted from this snapshot.{{end}} Open complete records:{{range .RefusalRecords}} <a class="link" href="{{if .Bad}}/logs.jsonl?run={{.ID}}{{else}}/runs/{{pathEsc .ID}}/receipt{{end}}" data-number-exclude="overview.agent-field-2">{{if .Agent}}{{.Agent}}{{else}}Run{{end}}</a>{{end}}{{if not .RefusalRecords}} <a class="link" href="/runs">All runs</a>{{end}}.</p>{{end}}{{end}}</section>{{end}}{{end}}
{{define "overview-runs"}}<div class="ov-phone-runs phone-list">{{range .Runs}}<a class="phone-row" data-k="{{.ID}}"{{if eq .Origin "background"}} title="Started without a terminal"{{end}} href="/runs/{{pathEsc .ID}}"><span class="phone-who" data-number-exclude="overview.agent-field-3">{{if .Agent}}{{.Agent}}{{else}}(no agent){{end}}</span>{{template "state" .}}<time class="phone-when" datetime="{{iso .Start}}" data-started="{{iso .Start}}" data-number-exclude="overview.clock-3" data-ck>{{rowAgo .Start $.Now}}</time>{{if or (eq .Origin "interactive") (eq .Origin "deployed")}}<span class="desktop-only">{{template "origin" .}}</span>{{end}}{{with scopedChip (chip (index $.V .ID)) (runNumbers .)}}{{if .Text}}<span class="desktop-only">{{template "secchip" .}}</span>{{end}}{{end}}</a>{{end}}</div>{{end}}
{{define "overview-bars"}}{{$numbers := numbersOf .}}{{$ := numberValue .}}{{with $}}<section class="panel ov-bars desktop-only" aria-labelledby="h-last-runs"><div class="panel-head"><h2 id="h-last-runs">Refused actions in the last {{template "quantity" (quantity "overview.bar-runs" (len .Last) $numbers)}} {{plural (len .Last) "run" "runs"}}</h2></div><ul class="ov-bar-list">{{range .Last}}<li><a class="link" href="/runs/{{pathEsc .Run}}/refusals" data-number-exclude="overview.bar-agent">{{.Name}}</a><svg viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true" focusable="false"><rect width="{{.Width}}" height="8"/></svg><span>{{template "quantity" (quantity "overview.bar-refusals" .Count $numbers)}} {{plural .Count "action" "actions"}}</span></li>{{end}}</ul></section>{{end}}{{end}}
