{{/* procs is the run page's Processes tab (procs.go): the run's process tree from ledgerview.ProcessTree, each process with what it ran, what it did and what was refused. A branch with a refusal opens; like leaves fold into one group. */}}
{{define "procs"}}<link rel="stylesheet" href="/static/procs.css">{{$t := .Tree}}
<section class="panel" aria-labelledby="h-pr"><div class="panel-head"><h2 id="h-pr">Processes</h2><span class="soft">{{$t.Procs}} {{plural $t.Procs "process" "processes"}} · {{.Actions}} {{plural .Actions "action" "actions"}}{{if .Notes}} · <span title="A refused action writes a second line beside it, of kind refused. Each refusal counts once, by its action; the two add up to the run's lines.">{{.Notes}} {{plural .Notes "refusal note" "refusal notes"}}</span>{{end}} · {{$t.Refused}} refused</span></div>
<p class="panel-body soft pt-sum">Each process this run started, under the process that started it, with what it ran, what it did and what was refused. A branch with a refusal in it is open; a process with refusals of its own is marked red.{{if $t.Unrecorded}} {{$t.Unrecorded}} {{plural $t.Unrecorded "process" "processes"}} started no program the record shows (a subshell that forks and never runs a program writes no exec line), so no line says which process started {{if eq $t.Unrecorded 1}}it: it hangs{{else}}them: they hang{{end}} from the launcher, marked “forked, no exec recorded”.{{end}}{{if $t.NoPID}} {{$t.NoPID}} {{plural $t.NoPID "line names" "lines name"}} no process and {{if eq $t.NoPID 1}}is{{else}}are{{end}} on none.{{end}}</p>
<div class="panel-body pt-wrap"><ul class="pt pt-top">{{template "pnode" .Root}}</ul>
{{if .Cut}}<p class="soft pt-cut">{{.Cut}} more {{plural .Cut "process is" "processes are"}} not shown here, so the page stays quick; every one is counted above and its lines are in <a class="link" href="/logs?run={{queryEsc $t.Run}}">Logs</a>.</p>{{end}}</div>
<div class="panel-body"><div class="cli"><code>tego events {{$t.Run}} --json | jq -c 'select(.kind=="exec") | {pid, exec_id, parent_exec_id, argv}'</code></div></div>
</section>{{end}}
{{/* pnode is one process and, under it, its children. */}}
{{define "pnode"}}{{$n := .N}}<li class="pt-n{{if $n.Counts.Refused}} pt-bad{{end}}" id="p-{{$n.Key}}">{{if or .Kids .More}}<details{{if .Open}} open{{end}}><summary>{{template "prow" .}}</summary><ul class="pt{{if ge $n.Depth 12}} pt-flat{{end}}">{{range .Kids}}{{if .Group}}{{template "pgroup" .Group}}{{else}}{{template "pnode" .Item}}{{end}}{{end}}{{if .More}}<li class="pt-more soft">{{.More}} more {{plural .More "child" "children"}} not shown: <a class="link" href="{{.Logs}}">this process in Logs</a></li>{{end}}</ul></details>{{else}}<div class="pt-leaf">{{template "prow" .}}</div>{{end}}</li>{{end}}
{{/* prow is a process's own row: its name and command, what it did, and each exec when there were several or one was refused. */}}
{{define "prow"}}{{$n := .N}}<div class="pt-row"><span class="pt-name">{{if $n.Launcher}}<b>tego launcher</b>{{else if $n.Unrecorded}}<b class="pt-unrec">pid {{$n.PID}}</b><span class="tag-sys" title="This process forked and started no program the record shows, so no line names its parent">forked, no exec recorded</span>{{else}}<b>{{$n.Name}}</b>{{if $n.Refused}}<span class="b b-refused">{{template "i" "i-ban"}}Not allowed to run</span>{{end}}{{end}}</span>{{if .Cmd}}<span class="pt-cmd mono" title="{{.Full}}">{{.Cmd}}</span>{{end}}
<span class="pt-meta">{{if $n.PID}}<span>pid {{$n.PID}}</span>{{end}}{{if not $n.Start.IsZero}}<time datetime="{{iso $n.Start}}" title="{{stamp $n.Start}}">{{clock $n.Start}}</time>{{end}}{{with $n.Counts}}<span>{{.Lines}} {{plural .Lines "line" "lines"}}{{if .Reads}} · {{.Reads}} {{plural .Reads "read" "reads"}}{{end}}{{if .Writes}} · {{.Writes}} {{plural .Writes "write" "writes"}}{{end}}{{if .Connects}} · {{.Connects}} {{plural .Connects "connect" "connects"}}{{end}}</span>{{end}}{{if .Hosts}}<span class="pt-hosts" title="Hosts it connected to or tried to, most first">to {{.Hosts}}</span>{{end}}{{if $n.Counts.Refused}}<span class="b b-refused">{{$n.Counts.Refused}} refused</span>{{end}}{{if $n.Below.Procs}}<span>{{$n.Below.Procs}} below{{if $n.Below.Refused}}, <span class="pt-red">{{$n.Below.Refused}} refused</span>{{end}}</span>{{end}}{{if .Tried}}<span class="pt-red">tried at {{.Tried}}{{if gt .Tries 1}} ({{.Tries}} times){{end}}</span>{{end}}{{if $n.HasExec}}<a class="link" href="/runs/{{pathEsc $n.Run}}/lines/{{$n.ExecSeq}}" title="The exec line of {{$n.Name}}">line #{{$n.ExecSeq}}</a>{{end}}{{if .Logs}}<a class="link" href="{{.Logs}}">Logs</a>{{end}}</span>
{{if .Execs}}<ol class="pt-execs" aria-label="What {{$n.Name}} ran, in order">{{range .Execs}}<li{{if .Refused}} class="pt-x-bad"{{end}}><span class="pt-x-w">{{if .Refused}}tried{{else}}ran{{end}}</span><span class="mono pt-x-c" title="{{.Full}}">{{.Cmd}}</span>{{if .Refused}}<span class="b b-refused">refused{{if .Others}} ×{{.Count}}{{end}}</span>{{end}}{{if .Paths}}<span class="soft">at {{.Paths}}</span>{{end}}<a class="link" href="/runs/{{pathEsc $n.Run}}/lines/{{.Seq}}">line #{{.Seq}}</a></li>{{end}}</ol>{{end}}</div>{{end}}
{{/* pgroup is like processes of one parent folded into one line. */}}
{{define "pgroup"}}<li class="pt-n pt-g{{if .Refuse}} pt-bad{{end}}" id="p-{{.Key}}"><details{{if .Open}} open{{end}}><summary><div class="pt-row"><span class="pt-name"><b>{{if .Name}}{{.Name}}{{else}}forked, no exec recorded{{end}}</b><span class="xn">×{{len .Items}}</span>{{if .NotRun}}<span class="b b-refused">{{template "i" "i-ban"}}Not allowed to run</span>{{end}}</span><span class="pt-meta"><span>{{len .Items}} processes · {{.Lines}} {{plural .Lines "line" "lines"}}</span>{{if .Refuse}}<span class="b b-refused">{{.Refuse}} refused</span>{{end}}</span></div></summary><ul class="pt">{{range .Items}}{{template "pnode" .}}{{end}}</ul></details></li>{{end}}
