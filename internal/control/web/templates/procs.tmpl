{{/* procs is the run page's Processes tab (procs.go): the run's process tree from ledgerview.ProcessTree, each process with what it ran, what it did and what was refused. A branch with a refusal opens; like leaves fold into one group. */}}
{{define "procs"}}{{$numbers := .Numbers}}<link rel="stylesheet" href="/static/procs.css">{{$t := .Tree}}
<section class="panel" aria-labelledby="h-pr"><div class="panel-head"><h2 id="h-pr">Processes</h2><span class="soft">{{template "quantity" (quantity "run.processes" $t.Procs $numbers)}} {{plural $t.Procs "process" "processes"}} · {{template "quantity" (quantity "run.process-actions" .Actions $numbers)}} {{plural .Actions "action" "actions"}}{{if .Notes}} · <span data-number-title="shared.policy" title="A refused action writes a second line beside it, of kind refused. Each refusal counts once, by its action; the two add up to the run's lines.">{{template "quantity" (quantity "run.process-notes" .Notes $numbers)}} {{plural .Notes "refusal note" "refusal notes"}}</span>{{end}} · {{template "quantity" (quantity "run.process-refused" $t.Refused $numbers)}} refused</span></div>

<div class="phone-procs phone-list">{{range .Phone}}<a class="phone-row" href="/runs/{{pathEsc .Run}}/lines/{{if .HasExec}}{{.ExecSeq}}{{else}}{{.FirstSeq}}{{end}}"><span class="phone-who" data-number-exclude="procs.phone-process">{{if .Launcher}}Tego launcher{{else if .Name}}{{.Name}}{{else}}Unrecorded program{{end}}</span><span class="b {{if .Refused}}b-refused{{else}}b-neutral{{end}}">{{if .Refused}}{{template "i" "i-ban"}}Refused{{else}}{{template "i" "i-eye"}}Recorded{{end}}</span><time class="phone-when" datetime="{{iso .Start}}" data-number-exclude="procs.fact-1">{{clock .Start}}</time></a>{{end}}</div><details class="process-details"><summary>Process details and ancestry</summary><p class="panel-body soft pt-sum">{{template "quantity" (quantityRecordWords "run.tree-coverage" "Each process this run started, under the process that started it, with what it ran, what it did and what was refused. A branch with a refusal in it is open; a process with refusals of its own is marked red." $numbers)}}{{if $t.Unrecorded}} {{template "quantity" (quantityWords "run.process-unrecorded" (printf "%d %s started no program the retained record shows (a subshell that forks and never runs a program writes no exec line), so no line says which process started %s from the launcher, marked “forked, no exec recorded”." $t.Unrecorded (plural $t.Unrecorded "process" "processes") (plural $t.Unrecorded "it: it hangs" "them: they hang")) $numbers)}}{{end}}{{if $t.NoPID}} {{template "quantity" (quantityWords "run.process-no-pid" (printf "%d %s no process and %s on none." $t.NoPID (plural $t.NoPID "line names" "lines name") (plural $t.NoPID "is" "are")) $numbers)}}{{end}}</p><div class="panel-body pt-wrap"><ul class="pt pt-top">{{template "pnode" (withNumbers .Root $numbers)}}</ul>
{{if .Cut}}<p class="soft pt-cut">{{template "quantity" (quantity "run.process-hidden" .Cut $numbers)}} more {{plural .Cut "process is" "processes are"}}<span data-number="run.process-hidden"> not shown here, so the page stays quick; every one is counted above and its lines are in </span><a class="link" href="/logs?run={{queryEsc $t.Run}}">Logs</a>.</p>{{end}}</div>
<div class="panel-body"><div class="cli"><code data-number-exclude="procs.fact-2">tego events {{$t.Run}} --json | jq -c 'select(.kind=="exec") | {pid, exec_id, parent_exec_id, argv}'</code></div></div>
</details></section>{{end}}
{{/* pnode is one process and, under it, its children. */}}
{{define "pnode"}}{{$numbers := numbersOf .}}{{$ := numberValue .}}{{with $}}{{$n := .N}}<li class="pt-n{{if $n.Counts.Refused}} pt-bad{{end}}" id="p-{{$n.Key}}">{{if or .Kids .More}}<details{{if .Open}} open{{end}}><summary>{{template "prow" (withNumbers . $numbers)}}</summary><ul class="pt{{if ge $n.Depth 12}} pt-flat{{end}}">{{range .Kids}}{{if .Group}}{{template "pgroup" (withNumbers .Group $numbers)}}{{else}}{{template "pnode" (withNumbers .Item $numbers)}}{{end}}{{end}}{{if .More}}<li class="pt-more soft">{{template "quantity" (quantity "run.process-children-hidden" .More $numbers)}} more {{plural .More "child" "children"}} not shown: <a class="link" href="{{.Logs}}">this process in Logs</a></li>{{end}}</ul></details>{{else}}<div class="pt-leaf">{{template "prow" (withNumbers . $numbers)}}</div>{{end}}</li>{{end}}{{end}}
{{/* prow is a process's own row: its name and command, what it did, and each exec when there were several or one was refused. */}}
{{define "prow"}}{{$numbers := numbersOf .}}{{$ := numberValue .}}{{with $}}{{$n := .N}}<div class="pt-row"><span class="pt-name">{{if $n.Launcher}}<b data-number-exclude="procs.explicit-2">tego launcher</b>{{else if $n.Unrecorded}}<b class="pt-unrec" data-number-exclude="procs.fact-3">pid {{$n.PID}}</b><span class="tag-sys" title="An exec line is needed to identify this process and its parent">{{template "quantity" (quantityZero "run.process-execs-zero" "No exec recorded" $numbers)}}</span>{{else}}<b data-number-exclude="procs.explicit-3">{{$n.Name}}</b>{{if $n.Refused}}<span class="b b-refused">{{template "i" "i-ban"}}Not allowed to run</span>{{end}}{{end}}</span>{{if .Cmd}}<details class="pt-command"><summary>Command details</summary><code>{{.Full}}</code></details>{{end}}
<span class="pt-meta">{{if $n.PID}}<span data-number-exclude="procs.fact-5">pid {{$n.PID}}</span>{{end}}{{if not $n.Start.IsZero}}<time datetime="{{iso $n.Start}}" title="{{stamp $n.Start}}" data-number-exclude="procs.fact-6">{{clock $n.Start}}</time>{{end}}{{with $n.Counts}}<span>{{template "quantity" (quantity "run.process-lines" .Lines $numbers)}} {{plural .Lines "line" "lines"}}{{if .Reads}} · {{template "quantity" (quantity "run.process-reads" .Reads $numbers)}} {{plural .Reads "read" "reads"}}{{end}}{{if .Writes}} · {{template "quantity" (quantity "run.process-writes" .Writes $numbers)}} {{plural .Writes "write" "writes"}}{{end}}{{if .Connects}} · {{template "quantity" (quantity "run.process-connects" .Connects $numbers)}} {{plural .Connects "connect" "connects"}}{{end}}</span>{{end}}{{if .Hosts}}<span class="pt-hosts" title="Hosts it connected to or tried to, most first">to <span data-number-exclude="procs.explicit-8">{{.Hosts}}</span>{{if .HostsMore}} and {{template "quantity" (quantity "run.process-hosts-more" .HostsMore $numbers)}} more{{end}}</span>{{end}}{{if $n.Counts.Refused}}<span class="b b-refused">{{template "quantity" (quantity "run.process-own-refused" $n.Counts.Refused $numbers)}} refused</span>{{end}}{{if $n.Below.Procs}}<span>{{template "quantity" (quantity "run.process-below" $n.Below.Procs $numbers)}} below{{if $n.Below.Refused}}, <span class="pt-red">{{template "quantity" (quantity "run.process-below-refused" $n.Below.Refused $numbers)}} refused</span>{{end}}</span>{{end}}{{if .Tried}}<span class="pt-red">tried at {{.Tried}}{{if gt .Tries 1}} ({{template "quantity" (quantity "run.process-tries" .Tries $numbers)}} times){{end}}</span>{{end}}{{if $n.HasExec}}<a class="link" href="/runs/{{pathEsc $n.Run}}/lines/{{$n.ExecSeq}}" title="The exec line of {{$n.Name}}">line #{{$n.ExecSeq}}</a>{{end}}{{if .Logs}}<a class="link" href="{{.Logs}}">Logs</a>{{end}}</span>
{{if .Execs}}<ol class="pt-execs" aria-label="What {{$n.Name}} ran, in order">{{range .Execs}}<li{{if .Refused}} class="pt-x-bad"{{end}}><span class="pt-x-w">{{if .Refused}}tried{{else}}ran{{end}}</span><span class="mono pt-x-c" data-number-exclude="procs.fact-8">{{.Full}}</span>{{if .Refused}}<span class="b b-refused">refused{{if .Others}} ×{{template "quantity" (quantity "run.process-exec-tries" .Count $numbers)}}{{end}}</span>{{end}}{{if .Paths}}<span class="soft">at {{.Paths}}</span>{{end}}<a class="link" href="/runs/{{pathEsc $n.Run}}/lines/{{.Seq}}" data-number-exclude="procs.fact-9">line #{{.Seq}}</a></li>{{end}}</ol>{{end}}</div>{{end}}{{end}}
{{/* pgroup is like processes of one parent folded into one line. */}}
{{define "pgroup"}}{{$numbers := numbersOf .}}{{$ := numberValue .}}{{with $}}<li class="pt-n pt-g{{if .Refuse}} pt-bad{{end}}" id="p-{{.Key}}"><details{{if .Open}} open{{end}}><summary><div class="pt-row"><span class="pt-name"><b>{{if .Name}}{{.Name}}{{else}}{{template "quantity" (quantityZero "run.process-execs-zero" "No exec recorded" $numbers)}}{{end}}</b><span class="xn">×{{template "quantity" (quantity "run.process-group-size" (len .Items) $numbers)}}</span>{{if .NotRun}}<span class="b b-refused">{{template "i" "i-ban"}}Not allowed to run</span>{{end}}</span><span class="pt-meta"><span>{{template "quantity" (quantity "run.process-group-size" (len .Items) $numbers)}} processes · {{template "quantity" (quantity "run.process-lines" .Lines $numbers)}} {{plural .Lines "line" "lines"}}</span>{{if .Refuse}}<span class="b b-refused">{{template "quantity" (quantity "run.process-group-refused" .Refuse $numbers)}} refused</span>{{end}}</span></div></summary><ul class="pt">{{range .Items}}{{template "pnode" (withNumbers . $numbers)}}{{end}}</ul></details></li>{{end}}{{end}}
