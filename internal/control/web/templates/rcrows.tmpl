{{/* rcrows: a rule-change journal entry as a row (changefeed.go): "rclog" in the Logs table, "rctl" in a run's timeline. Each says the change in words, its direction, the line it was made from, the live blocks it placed or lifted and whether it was undone, and links to the rules file's History, where Undo is. */}}
{{define "rcdir"}}{{if .Direction}}{{template "dir" .Direction}}{{else}}<span class="b b-neutral">{{template "i" "i-scroll-text"}}New file</span>{{end}}{{end}}
{{define "rcwhy"}}{{if eq .Via "cli"}}In the terminal{{else if .Via}}In the {{.Via}}{{else}}Saved{{end}}{{if .From}}, from <a class="link" href="{{.From}}">{{.FromWords}}</a>{{end}}{{range .Live}} · {{.}}{{end}}{{if .UndoneBy}} · undone later{{end}}{{end}}
{{define "rclog"}}<tr role="row" class="rc-row" data-k="{{.Key}}"><td role="cell" class="c-time mono lead"><time datetime="{{iso .At}}" title="{{stamp .At}}">{{clockms .At}}</time></td><td role="cell" data-label="Verdict" class="c-verdict"><span class="b b-neutral" title="A change of a rules file, from the rule-change journal: it applies from the file's next run">{{template "i" "i-scroll-text"}}Rule change</span></td><td role="cell" data-label="What" class="c-what"><div class="lw" title="{{.Words}}"><span class="op">{{.Words}}</span></div><div class="lw-why">{{template "rcwhy" .}}</div></td><td role="cell" data-label="Process" class="c-proc"><span class="soft">—</span></td><td role="cell" data-label="Rule" class="c-rule"><span class="clamp" title="{{.Contract}}"><span>{{template "rcdir" .}}</span></span></td><td role="cell" data-label="Line" class="c-line"><div class="lw-end"><a class="link lw-line" href="{{.Href}}" title="The History of {{.Contract}}, with Undo" aria-label="History of {{.Agent}}'s rules file"><span class="lw-agent">{{.Agent}}</span><span class="lw-seq">History</span></a></div></td></tr>{{end}}
{{define "rctl"}}<div class="tl rc-tl" data-k="{{.Key}}"><span class="time"><time datetime="{{iso .At}}" title="{{stamp .At}}">{{clock .At}}</time><a class="seq link" href="{{.Href}}" title="The History of {{.Contract}}, with Undo">History</a></span><span class="kind">{{template "i" "i-scroll-text"}}</span><span class="what"><span>{{if eq .Op "change"}}<span class="op">Rule change:</span> {{end}}<span class="ut">{{.Words}}</span></span><span class="rule"><span class="clamp">{{template "rcwhy" .}}{{with .Note}} · {{.}}{{end}}</span></span></span><span class="tl-end">{{template "rcdir" .}}</span></div>{{end}}
