{{/* The run page's Highlights card and its grouped refusals: ledgerview.Signal read for a person. */}}
{{define "vcounts"}}{{if .Refused}}<span class="b b-refused">{{template "i" "i-ban"}}Blocked {{.Refused}}</span>{{end}}{{if .Asked}}<span class="b b-asked">{{template "i" "i-hand"}}Asked {{.Asked}}</span>{{end}}{{if .Allowed}}<span class="b b-allowed">{{template "i" "i-check"}}Allowed {{.Allowed}}</span>{{end}}{{if .Observed}}<span class="b b-observed">{{template "i" "i-eye"}}Observed {{.Observed}}</span>{{end}}{{end}}
{{/* gotthrough: on a watched run, what was only observed next to a secret got through: red, as Compare says it. */}}
{{define "gotthrough"}}<span class="b b-bad" title="Watched only: nothing stopped it">{{template "i" "i-triangle-alert"}}Got through {{.}}</span>{{end}}
{{/* hl-dest: one destination. On a watched run read against an enforced run's contract (.Ref), what that contract
allows is marked so; with no contract to check against, only the destination the verdict names (.Lead) is red and
the others next to a secret are only "Not on a list". */}}
{{define "hl-dest"}}{{$soft := and .Obs .V.NearSecret (not .Ref) .Lead (ne .V.Key .Lead)}}<li><a class="hl-what" href="{{logsURL .Run .V.Query}}" title="Every line for {{.V.Key}}"><span class="ut">{{cut .V.Key 48}}</span></a><span class="hl-v">{{if and .Obs .V.NearSecret (not $soft)}}{{template "gotthrough" .V.Observed}}{{else}}{{template "vcounts" .V}}{{end}}</span>{{if $soft}}<span class="hl-tag" title="A watched run has no contract, so Tego cannot tell whether the job needs this destination. Its first contact was within 16 ledger lines and 5 s of a secret touch.">Not on a list</span>{{else if .V.NearSecret}}<span class="hl-tag hl-tag-near" title="First contact within 16 ledger lines and 5 s of a secret touch">{{template "i" "i-key-round"}}After a secret read</span>{{end}}{{if .V.InContract}}{{if not .Obs}}<span class="hl-tag">In policy</span>{{else if .Ref}}<span class="hl-tag" title="The contract of run {{.Ref}} allows it">Allowed in the enforced run</span>{{end}}{{end}}</li>{{end}}
{{define "hl-prog"}}<li><a class="hl-what" href="{{logsURL .Run .V.Program}}" title="Every line naming {{.V.Program}}"><span class="ut">{{.V.Program}}</span></a><span class="xn">×{{.V.N}}</span><span class="hl-why" title="{{.V.Rule}}">{{ruleName .V.Rule}}</span>{{if .V.Background}}<span class="hl-tag" title="Every refusal of it is routine: the agent's own retries">routine</span>{{end}}</li>{{end}}
{{/* verdict is the run's verdict banner (storyOf): red when secrets left, green when Tego stopped an attempt. The run
page places it right under its header (r-run-top), above the pause banner, the waiting asks and the Block now panel,
so the run's outcome is the first thing under its name, live or ended. */}}
{{define "verdict"}}{{with story .Story (eq .Run.State "running")}}<section class="banner verdict verdict-{{.Tone}}" role="status" aria-label="What happened in this run">{{template "i" .Icon}}<div class="grow"><p class="vt">{{.Title}}</p>{{if .Sub}}<p class="vs">{{.Sub}}</p>{{end}}</div></section>{{end}}{{end}}
{{define "highlights"}}{{$r := .Run}}{{$id := $r.ID}}{{$home := .Home}}{{$obs := eq $r.Tier "observe"}}
{{with .Signal}}
<section class="panel hl" aria-labelledby="h-hl">
<div class="panel-head"><h2 id="h-hl">Highlights</h2>{{if not $obs}}<span class="sev-counts">{{template "sevcounts" .}}{{if .BackgroundLines}} · <a class="link" href="/runs/{{pathEsc $id}}/refusals?bg=open#bg">{{.BackgroundLines}} routine</a>{{end}}</span>{{end}}</div>
<div class="hl-grid">
<section class="hl-sec hl-half" aria-labelledby="h-hl-s"><h3 id="h-hl-s">{{template "i" "i-key-round"}}Secrets <span class="n">{{len .Secrets}}</span></h3>
{{if .Secrets}}<ul class="hl-list">{{range .Secrets}}<li><a class="hl-what" href="{{logsURL $id .Path}}">{{template "spv" (spIn .Path $home $r.Cwd)}}</a><span class="hl-v">{{if and $obs .NearSend .Observed}}{{template "gotthrough" .Observed}}{{else}}{{template "vcounts" .}}{{end}}</span>{{if .NearSend}}<span class="hl-tag hl-tag-near" title="Touched within 16 ledger lines and 5 s of a connection outside the contract">{{template "i" "i-activity"}}Followed by a connection</span>{{end}}<span class="hl-why"{{if .Rule}} title="{{.Rule}}"{{end}}>{{secretWhy .}}</span></li>{{end}}</ul>
{{else}}<p class="hl-none" title="Allowed reads are recorded only under record: full">No secrets touched</p>{{end}}
</section>
<section class="hl-sec hl-half" aria-labelledby="h-hl-o"><h3 id="h-hl-o">{{template "i" "i-activity"}}Outbound <span class="n">{{len .Outbound}}</span></h3>
{{$head := .OutHead 6}}{{$tail := .OutTail 6}}{{$ref := .AllowedFrom}}{{$lead := $.Story.Dest}}
{{if $head}}<ul class="hl-list">{{range $head}}{{template "hl-dest" (hl $id . $obs $ref $lead)}}{{end}}</ul>
{{if $tail}}<details class="hl-more"><summary>{{len $tail}} more {{plural (len $tail) "destination" "destinations"}}</summary><ul class="hl-list">{{range $tail}}{{template "hl-dest" (hl $id . $obs $ref $lead)}}{{end}}</ul></details>{{end}}{{end}}
{{if .BackgroundDests}}<p class="hl-bg" title="System lookups, DNS and the agent's own probes: never next to a secret, never counted as a send">{{if .BackgroundDestLines}}<a class="link" href="/runs/{{pathEsc $id}}/refusals?bg=open#bg">Routine · {{.BackgroundDests}} {{plural .BackgroundDests "host" "hosts"}}</a>{{else}}Routine · {{.BackgroundDests}} {{plural .BackgroundDests "host" "hosts"}}{{end}}</p>{{end}}
{{if not .Outbound}}<p class="hl-none">No connections</p>{{else if and $obs $ref}}<p class="hl-bg">Checked against <a class="link mono" href="/runs/{{pathEsc $ref}}" title="The enforced run's policy">{{rid $ref}}</a></p>{{else if $obs}}<p class="hl-bg" title="Only the host nearest the secrets is marked red">No policy to check against</p>{{end}}
</section>
<section class="hl-sec hl-third" aria-labelledby="h-hl-a"><h3 id="h-hl-a">{{template "i" "i-hand"}}Approvals <span class="n">{{len .Approvals}}</span></h3>
{{if .Approvals}}<p class="hl-sum">{{if .PendingN}}<a class="b b-waiting" href="#{{(index $r.Pending 0).AskID}}">{{template "i" "i-hand"}}{{.PendingN}} waiting on you</a> {{end}}{{if .Approved}}{{.Approved}} allowed{{end}}{{if and .Approved .Denied}} · {{end}}{{if .Denied}}{{.Denied}} denied{{end}}{{if and (or .Approved .Denied) .Unanswered}} · {{end}}{{if .Unanswered}}{{.Unanswered}} not answered{{end}}</p>
{{$as := splitAsks .Approvals 6}}{{if $as.Head}}<ul class="hl-list">{{range $as.Head}}{{template "hl-ask" (askRow $r $home .)}}{{end}}</ul>{{end}}
{{if $as.More}}<details class="hl-more"><summary>{{len $as.More}} more {{plural (len $as.More) "request" "requests"}}</summary><ul class="hl-list">{{range $as.More}}{{template "hl-ask" (askRow $r $home .)}}{{end}}</ul></details>{{end}}
{{if $as.Repeats}}<details class="hl-more"><summary>{{len $as.Repeats}} answered earlier</summary><ul class="hl-list">{{range $as.Repeats}}{{template "hl-ask" (askRow $r $home .)}}{{end}}</ul></details>{{end}}
{{else}}<p class="hl-none">None</p>{{end}}
</section>
<section class="hl-sec hl-third" aria-labelledby="h-hl-b"><h3 id="h-hl-b">{{template "i" "i-ban"}}Live blocks <span class="n">{{len .Blocks}}</span></h3>
{{if .Blocks}}<ul class="hl-list">{{range .Blocks}}{{$kv := blockKV .Value}}<li><a class="hl-what" href="{{logsURL $id .Rule}}" title="{{.Rule}}">{{if $kv.Kind}}<span class="op">{{$kv.Kind}}</span> {{end}}{{if $kv.Path}}{{template "spv" (spIn $kv.Path $home $r.Cwd)}}{{else}}<span class="ut">{{$kv.Value}}</span>{{end}}</a><span class="b b-refused">{{template "i" "i-ban"}}Blocked {{.N}}</span></li>{{end}}</ul>
{{else}}<p class="hl-none">None</p>{{end}}
{{$nb := activeBlocks $.Blocks $.Now}}{{if and $nb (eq $r.State "running")}}<p class="hl-sum"><a class="link" href="#block">{{$nb}} {{plural $nb "block" "blocks"}} active now</a></p>{{end}}
</section>
<section class="hl-sec hl-third" aria-labelledby="h-hl-p"><h3 id="h-hl-p">{{template "i" "i-terminal"}}Programs blocked <span class="n">{{len .Programs}}</span></h3>
{{if .Programs}}{{$ph := .ProgHead 6}}{{$pt := .ProgTail 6}}<ul class="hl-list">{{range $ph}}{{template "hl-prog" (bind $id .)}}{{end}}</ul>
{{if $pt}}<details class="hl-more"><summary>{{len $pt}} more</summary><ul class="hl-list">{{range $pt}}{{template "hl-prog" (bind $id .)}}{{end}}</ul></details>{{end}}
{{else}}<p class="hl-none">None</p>{{end}}
</section>
</div>
</section>{{end}}{{end}}
{{define "rgroup"}}<li class="{{if .Background}}bg-row{{end}}{{if .SystemLookup}} sys{{end}}">{{if not .Background}}<span class="sev sev-{{.Severity}}">{{.Severity}}</span>{{end}}{{template "i" (kindIcon .Class)}}<div class="grow stack-sm"><span class="title"><span class="op">{{.Op}}</span> {{template "sptv" (spt (mask .Subject) "" 96)}}<span class="xn" title="{{.Count}} refused {{plural .Count "line" "lines"}}, {{clock .First}} to {{clock .Last}}">×{{.Count}}</span>{{if .Secret}}<span class="hl-tag hl-tag-near">{{template "i" "i-key-round"}}Secret</span>{{end}}{{if and .NearSecret (not .SystemLookup)}}<span class="hl-tag hl-tag-near" title="First refused within 16 ledger lines and 5 s of a secret touch">{{template "i" "i-key-round"}}After a secret read</span>{{end}}{{if .SystemLookup}}<span class="tag-sys">system lookup</span>{{end}}{{if .Hosts}}<span class="rg-ports" title="{{mask (someOf .Targets 24)}}">{{.Hosts}} addresses</span>{{end}}{{if .Ports}}<span class="rg-ports">{{if gt (len .Ports) 1}}{{len .Ports}} ports{{else}}port{{end}} <span class="mono">{{portSpans .Ports 12}}</span></span>{{else if gt (len .Targets) 1}}<span class="rg-ports" title="{{mask (someOf .Targets 24)}}">{{len .Targets}} targets</span>{{end}}</span>
<span class="meta"><span class="mono" title="{{if .Label}}{{.Label}}{{else}}{{.Rule}}{{end}}">{{if .Label}}{{firstPart .Label}}{{else if .Rule}}{{ruleName .Rule}}{{else}}—{{end}}</span>{{if .Why}} · <span title="Routine: {{.Why}}">Routine</span>{{end}}</span>
<span class="meta"><time datetime="{{iso .First}}" title="{{stamp .First}}">{{clock .First}}</time>{{if gt .Count 1}} to <time datetime="{{iso .Last}}" title="{{stamp .Last}}">{{clock .Last}}</time>{{end}} {{tz}} · first line #{{.FirstSeq}} · <a class="link" href="{{logsURL .Run .LogsText "refused"}}" title="Every refused line for this">Logs</a></span></div></li>{{end}}
{{/* porttag says a row holds many ports: Detections' Times column counts the attempts, and its title says both. */}}
{{define "porttag"}}{{if gt (len .Ports) 1}}<span class="dt-tag" title="{{len .Ports}} ports, {{.Count}} {{plural .Count "attempt" "attempts"}}: {{portSpans .Ports 12}}">{{len .Ports}} ports</span>{{end}}{{end}}
{{/* hl-ask is one approval (askRow: the run, its home, the approval): people named as the run recorded them, the
target through the path shortener, masked. */}}
{{define "hl-ask"}}{{$id := .Run}}{{$r := .R}}{{$home := .Home}}{{with .V}}<li><a class="hl-what" href="{{if eq .State "pending"}}#{{.AskID}}{{else}}{{logsURL $id .AskID}}{{end}}"><span class="op">{{if .Op}}{{.Op}}{{else}}ask{{end}}</span> {{if .Target}}{{template "sptv" (sptIn (mask .Target) $home $r.Cwd 48)}}{{end}}</a>{{if eq .State "pending"}}<span class="b b-waiting">{{template "i" "i-hand"}}Waiting</span>{{else if eq .State "approved"}}<span class="b b-allowed">{{template "i" "i-check"}}Allowed</span>{{else if and (eq .State "denied") (eq .By "cancelled")}}<span class="b b-neutral" title="Withdrawn: a live block now refuses this">{{template "i" "i-ban"}}Withdrawn</span>{{else if eq .State "denied"}}<span class="b b-refused">{{template "i" "i-ban"}}Denied</span>{{else if eq .State "lost"}}<span class="b b-neutral" title="The run was lost before anyone answered; nobody can answer it now">Never answered (run lost)</span>{{else}}<span class="b b-neutral">No answer</span>{{end}}<span class="hl-why">{{if and (eq .State "denied") (eq .By "cancelled")}}a live block now refuses this{{else if .By}}by {{whoIn .By $r}}{{end}}{{if .After}} after {{dur .After}}{{end}}{{if and (not .By) (not .After)}}asked at {{clock .TS}}{{end}}</span></li>{{end}}{{end}}
{{/* sevcounts is a run's High, Medium and Low counts as pills (RunSignal.High, Medium, Low). */}}
{{define "sevcounts"}}<span class="sev sev-High">{{.High}} High</span> <span class="sev sev-Medium">{{.Medium}} Medium</span> <span class="sev sev-Low">{{.Low}} Low</span>{{end}}
