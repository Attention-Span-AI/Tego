{{/* SPDX-License-Identifier: Apache-2.0 */}}
{{/* The run page's Highlights card and its grouped refusals: ledgerview.Signal read for a person. */}}
{{define "vcounts"}}{{$numbers := numbersOf .}}{{$ := numberValue .}}{{with $}}{{if .Refused}}<span class="b b-refused">{{template "i" "i-ban"}}Refused {{template "quantity" (quantity "run.dest-refused" .Refused $numbers)}}</span>{{end}}{{if .Asked}}<span class="b b-asked">{{template "i" "i-hand"}}Asked {{template "quantity" (quantity "run.dest-asked" .Asked $numbers)}}</span>{{end}}{{if .Allowed}}<span class="b b-allowed">{{template "i" "i-check"}}Allowed {{template "quantity" (quantity "run.dest-allowed" .Allowed $numbers)}}</span>{{end}}{{if .Observed}}<span class="b b-observed">{{template "i" "i-eye"}}Observed {{template "quantity" (quantity "run.dest-observed" .Observed $numbers)}}</span>{{end}}{{end}}{{end}}
{{/* gotthrough: on a watched run, what was only observed next to a secret got through: red, as Compare says it. */}}
{{define "gotthrough"}}{{$numbers := numbersOf .}}{{$ := numberValue .}}{{with $}}<span class="b b-bad" title="Watched only: all recorded attempts went through" data-number-title="shared.watch-refusals">{{template "i" "i-triangle-alert"}}Got through {{template "quantity" (quantity "run.dest-through" . $numbers)}}</span>{{end}}{{end}}
{{/* hl-dest: one destination. On a watched run read against an enforced run's contract (.Ref), what that contract
allows is marked so; with no contract to check against, only the destination the verdict names (.Lead) is red and
the others next to a secret are only "Not on a list". */}}
{{define "hl-dest"}}{{$numbers := numbersOf .}}{{$ := numberValue .}}{{with $}}{{$soft := and .Obs .V.NearSecret (not .Ref) .Lead (ne .V.Key .Lead)}}<li><a class="hl-what" href="{{logsURL .Run .V.Query}}" title="Every line for {{.V.Key}}" data-number-exclude-title="highlights.identity-1"><span class="ut" data-number-exclude="highlights.identity-3">{{cut .V.Key 48}}</span></a><span class="hl-v">{{if and .Obs .V.NearSecret (not $soft)}}{{template "gotthrough" (withNumbers .V.Observed $numbers)}}{{else}}{{template "vcounts" (withNumbers .V $numbers)}}{{end}}</span>{{if $soft}}<span data-number-title="shared.policy" class="hl-tag" title="A watched run has no contract, so Tego cannot tell whether the job needs this destination. Its first contact was within 16 ledger lines and 5 s of a secret touch.">Not on a list</span>{{else if .V.NearSecret}}<span data-number-title="shared.policy" class="hl-tag hl-tag-near" title="First contact within 16 ledger lines and 5 s of a secret touch">{{template "i" "i-key-round"}}After a secret read</span>{{end}}{{if .V.InContract}}{{if not .Obs}}<span class="hl-tag">In contract</span>{{else if .Ref}}<span class="hl-tag" title="The contract of run {{.Ref}} allows it">Allowed in the enforced run</span>{{end}}{{end}}</li>{{end}}{{end}}
{{define "hl-prog"}}{{$numbers := numbersOf .}}{{$ := numberValue .}}{{with $}}<li><a class="hl-what" href="{{logsURL .Run .V.Program}}" title="Every line naming {{.V.Program}}" data-number-exclude-title="highlights.identity-2"><span class="ut" data-number-exclude="highlights.identity-4">{{.V.Program}}</span></a><span class="xn">×{{template "quantity" (quantity "run.program-refusals" .V.N $numbers)}}</span><span class="hl-why" title="{{.V.Rule}}" data-number-exclude="highlights.fact-1">{{ruleName .V.Rule}}</span>{{if .V.Background}}<span class="hl-tag" title="Its refusals in this retained window are routine: the agent's own retries">routine</span>{{end}}</li>{{end}}{{end}}
{{/* readfix names the contract setting that keeps every file read (readGap says what a run without it cannot list)
and its cost: about 60 µs an open against 1 under record: summary (docs/OPERATIONS.md, "What the ledger costs"). */}}
{{define "readfix"}}<span data-number-exclude="highlights.specific-1">To record every read, add <code data-number-exclude="highlights.fact-2">record: full</code><span data-number="shared.policy"> to the contract; each file open then costs about 60 µs more.</span></span>{{end}}
{{/* verdict is the run's verdict banner (storyOf): red when secrets left, green when Tego stopped an attempt. The run
page places it right under its header (r-run-top), above the pause banner, the waiting asks and the Block now panel,
so the run's outcome is the first thing under its name, live or ended. */}}
{{define "verdict"}}{{with story .Story .Run}}<section class="banner verdict verdict-{{.Tone}}" role="status" aria-label="What happened in this run">{{template "i" .Icon}}<div class="grow"><p class="vt" data-number="run.attention">{{.Title}}</p>{{if .Sub}}<p class="vs" data-number="run.attention">{{.Sub}}</p>{{end}}</div></section>{{end}}{{end}}
{{define "highlights"}}{{$numbers := numbersOf .}}{{$ := numberValue .}}{{with $}}{{$r := .Run}}{{$id := $r.ID}}{{$home := .Home}}{{$obs := eq $r.Tier "observe"}}
{{with .Signal}}
<section class="panel hl" aria-labelledby="h-hl">
<div class="panel-head"><h2 id="h-hl">Highlights</h2>{{if not $obs}}<span class="sev-counts">{{template "sevcounts" (withNumbers . $numbers)}}{{if .BackgroundLines}} · <a class="link" href="/runs/{{pathEsc $id}}/refusals?bg=open#bg">{{template "quantity" (quantity "run.routine-lines" .BackgroundLines $numbers)}} routine</a>{{end}}</span>{{end}}</div>
<div class="hl-grid">
<section class="hl-sec hl-half" aria-labelledby="h-hl-s"><h3 id="h-hl-s">{{template "i" "i-key-round"}}Secrets <span class="n">{{template "quantity" (quantity "run.secrets" (len .Secrets) $numbers)}}</span></h3>
{{if .Secrets}}<ul class="hl-list">{{range .Secrets}}<li><a class="hl-what" href="{{logsURL $id .Path}}">{{template "spv" (spIn .Path $home $r.Cwd)}}</a><span class="hl-v">{{range secretChips . $r}}<span class="b {{.Class}}">{{template "i" .Icon}}{{.Text}} {{template "quantity" (quantity "run.secret-actions" .N $numbers)}}</span>{{end}}</span>{{if and $.CanAct $r.Contract .FirstSeq (or .Allowed .Asked .Observed)}}<a class="hl-act" href="/runs/{{pathEsc $id}}/lines/{{.FirstSeq}}?a=block#act-check" title="Open the line that touched it, to make a rule that refuses it next time">Never allow</a>{{end}}{{if .NearSend}}<span data-number-title="shared.policy" class="hl-tag hl-tag-near" title="Touched within 16 ledger lines and 5 s of a connection outside the contract" data-number-exclude="highlights.explicit-2">{{template "i" "i-activity"}}Followed by a connection</span>{{end}}<span class="hl-why"{{if .Rule}} title="{{.Rule}}"{{end}} data-number-exclude="highlights.fact-3">{{secretWhy .}}</span></li>{{end}}</ul>
{{else if readGap $r}}<p class="hl-none">{{readGap $r}}</p><p class="hl-bg">{{template "readfix"}}</p>
{{else}}<p class="hl-none" title="Allowed reads are recorded only under record: full" data-number="run.secrets">{{if $unknown := unknownCount $numbers.Window "Secret touches"}}{{$unknown}}{{else}}{{template "quantity" (quantityZero "run.secrets" "No secrets touched" $numbers)}}{{end}}</p>{{end}}
</section>
<section class="hl-sec hl-half" aria-labelledby="h-hl-o"><h3 id="h-hl-o">{{template "i" "i-activity"}}Outbound <span class="n">{{template "quantity" (quantity "run.outbound" (len .Outbound) $numbers)}}</span></h3>
{{$head := .OutHead 6}}{{$tail := .OutTail 6}}{{$ref := .AllowedFrom}}{{$lead := $.Story.Dest}}
{{if $head}}<ul class="hl-list">{{range $head}}{{template "hl-dest" (withNumbers (hl $id . $obs $ref $lead) $numbers)}}{{end}}</ul>
{{if $tail}}<details class="hl-more"><summary>{{template "quantity" (quantity "run.more-destinations" (len $tail) $numbers)}} more {{plural (len $tail) "destination" "destinations"}}</summary><ul class="hl-list">{{range $tail}}{{template "hl-dest" (withNumbers (hl $id . $obs $ref $lead) $numbers)}}{{end}}</ul></details>{{end}}{{end}}
{{if .BackgroundDests}}<p data-number-title="shared.policy" class="hl-bg" title="System lookups, DNS and the agent's own probes: never next to a secret, never counted as a send">{{if .BackgroundDestLines}}<a class="link" href="/runs/{{pathEsc $id}}/refusals?bg=open#bg">Routine · {{template "quantity" (quantity "run.routine-hosts" .BackgroundDests $numbers)}} {{plural .BackgroundDests "host" "hosts"}}</a>{{else}}Routine · {{template "quantity" (quantity "run.routine-hosts" .BackgroundDests $numbers)}} {{plural .BackgroundDests "host" "hosts"}}{{end}}</p>{{end}}
{{if not .Outbound}}<p class="hl-none" data-number="run.outbound">{{if $unknown := unknownCount $numbers.Window "Connections"}}{{$unknown}}{{else}}No connections{{end}}</p>{{else if and $obs $ref}}<p class="hl-bg">Checked against <a class="link mono" href="/runs/{{pathEsc $ref}}" title="The enforced run's contract">{{rid $ref}}</a></p>{{else if $obs}}<p class="hl-bg" title="Only the host nearest the secrets is marked red" data-number="run.contract-copy" data-number-exclude-title="highlights.detail-1">No contract to check against</p>{{end}}
</section>
<section class="hl-sec hl-third" aria-labelledby="h-hl-a"><h3 id="h-hl-a">{{template "i" "i-hand"}}Approvals <span class="n">{{template "quantity" (quantity "run.approvals" (len .Approvals) $numbers)}}</span></h3>
{{if .Approvals}}<p class="hl-sum">{{if .PendingN}}<a class="b b-waiting" href="{{approvalURL $r.ID (index $r.Pending 0).AskID}}">{{template "i" "i-hand"}}{{template "quantity" (quantity "run.waiting" .PendingN $numbers)}} waiting on you</a> {{end}}{{if .Approved}}{{template "quantity" (quantity "run.approved" .Approved $numbers)}} {{if $r.LocalApprovalAuthority}}approvals recorded{{else}}allowed{{end}}{{end}}{{if and .Approved .Denied}} · {{end}}{{if .Denied}}{{template "quantity" (quantity "run.denied" .Denied $numbers)}} denied{{end}}{{if and (or .Approved .Denied) .Unanswered}} · {{end}}{{if .Unanswered}}{{template "quantity" (quantity "run.unanswered" .Unanswered $numbers)}} not answered{{end}}</p>
{{$as := splitAsks .Approvals 6}}{{if $as.Head}}<ul class="hl-list">{{range $as.Head}}{{template "hl-ask" (withNumbers (askRow $r $home .) $numbers)}}{{end}}</ul>{{end}}
{{if $as.More}}<details class="hl-more"><summary>{{template "quantity" (quantity "run.more-asks" (len $as.More) $numbers)}} more {{plural (len $as.More) "request" "requests"}}</summary><ul class="hl-list">{{range $as.More}}{{template "hl-ask" (withNumbers (askRow $r $home .) $numbers)}}{{end}}</ul></details>{{end}}
{{if $as.Repeats}}<details class="hl-more"><summary>{{template "quantity" (quantity "run.earlier-asks" (len $as.Repeats) $numbers)}} answered earlier</summary><ul class="hl-list">{{range $as.Repeats}}{{template "hl-ask" (withNumbers (askRow $r $home .) $numbers)}}{{end}}</ul></details>{{end}}
{{else}}<p class="hl-none" data-number="run.approvals">{{if $unknown := unknownCount $numbers.Window "Approvals"}}{{$unknown}}{{else}}{{template "quantity" (quantityZero "run.approvals" "None" $numbers)}}{{end}}</p>{{end}}
</section>
<section class="hl-sec hl-third" aria-labelledby="h-hl-b"><h3 id="h-hl-b">{{template "i" "i-ban"}}Live blocks <span class="n">{{template "quantity" (quantity "run.recorded-blocks" (len .Blocks) $numbers)}}</span></h3>
{{if .Blocks}}<ul class="hl-list">{{range .Blocks}}{{$kv := blockKV .Value}}<li><a class="hl-what" href="{{logsURL $id .Rule}}" title="{{.Rule}}" data-number-exclude-title="highlights.fact-4">{{if $kv.Kind}}<span class="op" data-number-exclude="highlights.block-kind">{{$kv.Kind}}</span> {{end}}{{if $kv.Path}}{{template "spv" (spIn $kv.Path $home $r.Cwd)}}{{else}}<span class="ut" data-number-exclude="highlights.block-value">{{$kv.Value}}</span>{{end}}</a><span class="b b-refused">{{template "i" "i-ban"}}Refused {{template "quantity" (quantity "run.block-refusals" .N $numbers)}}</span></li>{{end}}</ul>
{{else}}<p class="hl-none" data-number="run.recorded-blocks">{{if $unknown := unknownCount $numbers.Window "Recorded live blocks"}}{{$unknown}}{{else}}{{template "quantity" (quantityZero "run.recorded-blocks" "None" $numbers)}}{{end}}</p>{{end}}
{{$nb := activeBlocks $.Blocks $.Now $.Live.Facts}}{{if and $nb (eq $r.State "running")}}<p class="hl-sum"><a class="link" href="#block">{{template "quantity" (quantity "run.active-blocks" $nb $numbers)}} {{plural $nb "block" "blocks"}} active now</a></p>{{end}}
</section>
<section class="hl-sec hl-third" aria-labelledby="h-hl-p"><h3 id="h-hl-p">{{template "i" "i-terminal"}}Programs refused <span class="n">{{template "quantity" (quantity "run.programs" (len .Programs) $numbers)}}</span></h3>
{{if .Programs}}{{$ph := .ProgHead 6}}{{$pt := .ProgTail 6}}<ul class="hl-list">{{range $ph}}{{template "hl-prog" (withNumbers (bind $id .) $numbers)}}{{end}}</ul>
{{if $pt}}<details class="hl-more"><summary>{{template "quantity" (quantity "run.more-programs" (len $pt) $numbers)}} more</summary><ul class="hl-list">{{range $pt}}{{template "hl-prog" (withNumbers (bind $id .) $numbers)}}{{end}}</ul></details>{{end}}
{{else}}<p class="hl-none" data-number="run.programs">{{if $unknown := unknownCount $numbers.Window "Refused programs"}}{{$unknown}}{{else}}{{template "quantity" (quantityZero "run.programs" "None" $numbers)}}{{end}}</p>{{end}}
</section>
</div>
</section>{{end}}{{end}}{{end}}
{{define "rgroup"}}{{$numbers := numbersOf .}}{{$ := numberValue .}}{{with $}}<li class="{{if .Background}}bg-row{{end}}{{if .SystemLookup}} sys{{end}}"><a class="phone-row run-refusal-row" href="/runs/{{pathEsc .Run}}/lines/{{.FirstSeq}}"><span class="phone-who">{{.Op}}</span><span class="b b-refused">{{template "i" "i-ban"}}Refused</span><time class="phone-when" datetime="{{iso .First}}" data-number-exclude="highlights.clock-1">{{clock .First}} · #{{.FirstSeq}}</time></a><div class="run-refusal-facts">{{if not .Background}}<span class="sev sev-{{.Severity}}">{{.Severity}}</span>{{end}}{{template "i" (kindIcon .Class)}}<div class="grow stack-sm"><span class="title"><span class="op">{{.Op}}</span> {{template "sptv" (spt (mask .Subject) "" 96)}}<span class="xn" title="{{quantityText "run.group-times" .Count $numbers}} refused {{plural .Count "line" "lines"}}, {{clock .First}} to {{clock .Last}}" data-number-title="run.group-times">×{{template "quantity" (quantity "run.group-times" .Count $numbers)}}</span>{{if .Secret}}<span class="hl-tag hl-tag-near">{{template "i" "i-key-round"}}Secret</span>{{end}}{{if and .NearSecret (not .SystemLookup)}}<span data-number-title="shared.policy" class="hl-tag hl-tag-near" title="First refused within 16 ledger lines and 5 s of a secret touch">{{template "i" "i-key-round"}}After a secret read</span>{{end}}{{if .SystemLookup}}<span class="tag-sys">system lookup</span>{{end}}{{with .NameUnknown}}<span class="rg-ports" title="{{.}}">name unknown</span>{{end}}{{with .BlockName}}<span class="rg-ports" title="{{$.BlockWords}}">{{.}}</span>{{end}}{{if .Hosts}}<span class="rg-ports" title="{{mask (someOf .Targets 24)}}">{{template "quantity" (quantity "run.group-hosts" .Hosts $numbers)}} addresses</span>{{end}}{{if .Ports}}<span class="rg-ports">{{if gt (len .Ports) 1}}{{template "quantity" (quantity "run.group-ports" (len .Ports) $numbers)}} ports{{else}}port{{end}} <span class="mono" data-number-exclude="highlights.fact-5">{{portSpans .Ports 12}}</span></span>{{else if gt (len .Targets) 1}}<span class="rg-ports" title="{{mask (someOf .Targets 24)}}">{{template "quantity" (quantity "run.group-targets" (len .Targets) $numbers)}} targets</span>{{end}}</span>
<span class="meta"><span class="mono" title="{{if .Label}}{{.Label}}{{else}}{{.Rule}}{{end}}" data-number-exclude="highlights.fact-6">{{if .Label}}{{firstPart .Label}}{{else if .Rule}}{{ruleName .Rule}}{{else}}—{{end}}</span>{{if .Why}} · <span title="Routine: {{.Why}}" data-number-exclude="highlights.fact-7">Routine</span>{{end}}</span>
<span class="meta" data-number-exclude="highlights.literal-1"><time datetime="{{iso .First}}" title="{{stamp .First}}" data-number-exclude="highlights.clock-2">{{clock .First}}</time>{{if gt .Count 1}} to <time datetime="{{iso .Last}}" title="{{stamp .Last}}" data-number-exclude="highlights.clock-3">{{clock .Last}}</time>{{end}} {{tz}} · first line #{{.FirstSeq}} · <a class="link" href="{{logsURL .Run .LogsText "refused"}}" title="Every refused line for this">Logs</a></span></div></div></li>{{end}}{{end}}
{{/* porttag says a row holds many ports: Detections' Times column counts the attempts, and its title says both. */}}
{{define "porttag"}}{{$numbers := numbersOf .}}{{$ := numberValue .}}{{with $}}{{if gt (len .Ports) 1}}<span class="dt-tag" title="{{quantityText "detections.ports" (len .Ports) $numbers}} ports, {{quantityText "detections.times" .Count $numbers}} {{plural .Count "attempt" "attempts"}}: {{portSpans .Ports 12}}" data-number-title="detections.ports">{{template "quantity" (quantity "detections.ports" (len .Ports) $numbers)}} ports</span>{{end}}{{end}}{{end}}
{{/* hl-ask is one approval (askRow: the run, its home, the approval): what it asked in the ask card's words (askVerb,
the recorded op in the title), people named as the run recorded them, the target through the path shortener, masked. */}}
{{define "hl-ask"}}{{$numbers := numbersOf .}}{{$ := numberValue .}}{{with $}}{{$id := .Run}}{{$r := .R}}{{$home := .Home}}{{with .V}}<li><a class="hl-what" href="{{if eq .State "pending"}}{{approvalURL $id .AskID}}{{else}}{{logsURL $id .AskID}}{{end}}"><span class="op"{{with .Op}} title="{{.}}"{{end}} data-number-exclude="highlights.identity-7">{{if .Op}}{{askVerb .Op .Rule ""}}{{else}}ask{{end}}</span> {{if .Target}}{{template "sptv" (sptIn (mask .Target) $home $r.Cwd 48)}}{{end}}</a>{{if eq .State "pending"}}<span class="b b-waiting">{{template "i" "i-hand"}}Waiting</span>{{else if and (eq .State "approved") .Managed}}<span class="b b-neutral">Approval recorded</span>{{else if eq .State "approved"}}<span class="b b-allowed">{{template "i" "i-check"}}Allowed</span>{{else if and (eq .State "denied") (eq .By "cancelled")}}<span class="b b-neutral" title="Withdrawn: a live block now refuses this">{{template "i" "i-ban"}}Withdrawn</span>{{else if eq .State "denied"}}<span class="b b-refused">{{template "i" "i-ban"}}Denied</span>{{else if eq .State "lost"}}<span class="b b-neutral" title="The run was lost; review its recorded answer in Logs.">{{template "quantity" (quantityZero "run.request-answers" "Never answered (run lost)" $numbers)}}</span>{{else}}<span class="b b-neutral">{{template "quantity" (quantityZero "run.request-answers" "No answer" $numbers)}}</span>{{end}}<span class="hl-why" data-number-exclude="highlights.fact-8">{{if and (eq .State "denied") (eq .By "cancelled")}}a live block now refuses this{{else if .By}}by {{whoIn .By $r}}{{end}}{{if .After}} after {{dur .After}}{{end}}{{if and (not .By) (not .After)}}asked at {{clock .TS}}{{end}}</span></li>{{end}}{{end}}{{end}}
{{/* sevcounts is a run's High, Medium and Low counts as pills (RunSignal.High, Medium, Low). */}}
{{define "sevcounts"}}{{$numbers := numbersOf .}}{{$ := numberValue .}}{{with $}}<span class="sev sev-High">{{template "quantity" (quantity "run.severity" .High $numbers)}} High</span> <span class="sev sev-Medium">{{template "quantity" (quantity "run.severity" .Medium $numbers)}} Medium</span> <span class="sev sev-Low">{{template "quantity" (quantity "run.severity" .Low $numbers)}} Low</span>{{end}}{{end}}
