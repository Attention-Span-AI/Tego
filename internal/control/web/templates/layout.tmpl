{{define "r-guide"}}{{end}}
{{/* SPDX-License-Identifier: Apache-2.0 */}}
{{define "i"}}<svg class="i" aria-hidden="true" focusable="false"><use href="/static/sprite.svg#{{.}}"/></svg>{{end}}
{{define "state"}}{{if eq .State "running"}}{{if paused .}}<span class="b b-neutral b-paused" title="Frozen where it stood until someone resumes it">{{template "i" "i-pause"}}Paused</span>{{else}}<span class="b b-running"><span class="dot" aria-hidden="true"></span>Running</span>{{end}}{{else if eq .State "unknown"}}<span class="b b-neutral" title="The live index could not be read">State unknown</span>{{else if eq .State "lost"}}{{if lostPaused .}}<span class="b b-lost" title="Its launcher died, and the last state it recorded was paused. Tego never thaws a run with no launcher; tego status says whether its processes are still frozen, and tego session stop ends them and closes the record.">{{template "i" "i-triangle-alert"}}Lost, last recorded paused</span>{{else}}<span class="b b-lost" title="The run stopped without closing its record; check the record details.">{{template "i" "i-triangle-alert"}}Lost</span>{{end}}{{else if and (eq .EndReason "exit") (eq .ExitCode 0)}}<span class="b b-done" title="{{endWhy .}}" data-number-exclude-title="layout.explicit-2">{{template "i" "i-check"}}Exit <span data-number="shared.exit-code">0</span></span>{{else if eq .EndReason "exit"}}<span class="b b-halted" title="{{endWhy .}}" data-number-exclude-title="layout.explicit-3">{{template "i" "i-square"}}Exit {{template "quantity" (quantity "shared.exit-code" .ExitCode exactNumbers)}}</span>{{else}}<span class="b b-stopped" title="{{endWhy .}}">{{template "i" "i-square"}}{{endWord .}}</span>{{end}}{{end}}
{{define "origin"}}<span class="b b-origin b-origin-{{.Origin}}" title="{{if eq .Origin "interactive"}}Started in a terminal a person types to (run_start recorded stdin as a terminal).{{else if eq .Origin "deployed"}}A supervised instance of {{.Deployment}}.{{else if eq .Origin "background"}}Started with no terminal on its input (run_start recorded stdin as {{.Stdin}}).{{else}}The record does not say how this run was started (an older ledger, or its input could not be examined).{{end}}">{{.OriginWord}}</span>{{end}}
{{define "chainpill"}}{{if and .Verified .Anchored}}<span class="b b-verified" title="Hash chain checked line by line, anchored in chain.log">{{template "i" "i-link"}}Verified · {{template "quantity" (quantity "shared.verified-lines" .Lines exactNumbers)}} {{if eq .Lines 1}}line{{else}}lines{{end}}</span>{{else if .Verified}}<span data-number-title="shared.record-fields" class="b b-neutral" title="Hash chain checked line by line, but with no anchor: the run did not end, so lines cut from its end would not show">{{template "i" "i-link"}}Not anchored · {{template "quantity" (quantity "shared.verified-lines" .Lines exactNumbers)}} {{if eq .Lines 1}}line{{else}}lines{{end}}</span>{{else if .Broken}}<span class="b b-broken">{{template "i" "i-triangle-alert"}}{{if .AtLine}}Broken at #{{.Line}}{{else if .Lines}}Broken after #{{.Line}}{{else}}Broken{{end}}</span>{{else if .Live}}<span class="b b-neutral" title="Checked when the run ends">{{template "i" "i-link"}}Verify at end</span>{{else}}<span class="b b-neutral" title="{{.Reason}}" data-number-exclude-title="layout.explicit-4">{{template "i" "i-link"}}Not verified</span>{{end}}{{end}}
{{/* runtable is a table of runs (runTable); runthead is its head and runrows its rows, which the Runs page splits into two live <tbody> regions. */}}
{{define "runtable"}}<div class="tw"><table class="t t-rows" role="table"><caption class="sr">Runs, newest first</caption>{{template "runthead"}}<tbody role="rowgroup">{{template "runrows" .}}</tbody></table></div>{{end}}
{{define "runthead"}}<thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader">Agent</th><th scope="col" role="columnheader">Status</th><th scope="col" role="columnheader">Secrets</th><th scope="col" role="columnheader" class="c-run">Run</th><th scope="col" role="columnheader">Started ({{tz}})</th><th scope="col" role="columnheader">Duration</th><th scope="col" role="columnheader" class="num c-lines">Lines</th><th scope="col" role="columnheader" class="num">Refused</th><th scope="col" role="columnheader" class="num c-asks">Asks</th><th scope="col" role="columnheader">Protection</th></tr></thead>{{end}}
{{/* ck is a duration (ckOf): a running run has its time so far, which live.js ticks from data-since every second; data-ck keeps its text out of the region's hash (regions.go). An ended or lost run's is plain text. */}}
{{define "ck"}}{{if .Ticks}}<span class="ck" data-since="{{iso .Start}}" data-number-exclude="layout.explicit-1" data-ck>{{dur .D}}</span>{{else}}<span data-number-exclude="layout.duration-ended">{{dur .D}}</span>{{end}}{{end}}
{{define "runrows"}}{{$now := .Now}}{{range .Runs}}{{$numbers := runNumbers .}}<tr role="row" data-k="{{.ID}}"><td role="cell" class="lead"><a class="primary" href="/runs/{{pathEsc .ID}}" data-number-exclude="layout.agent-field-1">{{if .Agent}}{{.Agent}}{{else}}(no agent){{end}}</a><span class="sub ellip" title="{{.Command}}" data-number-exclude-title="layout.identity-1" data-number-exclude="layout.identity-8">{{if .Cwd}}{{baseName .Cwd}}{{else}}{{cut .Command 40}}{{end}}</span></td><td role="cell" data-label="Status" class="state"><span class="st-wrap"{{if eq .Origin "background"}} title="Started without a terminal"{{end}}>{{template "state" .}}{{if or (eq .Origin "interactive") (eq .Origin "deployed")}}{{template "origin" .}}{{end}}</span></td><td role="cell" data-label="Secrets">{{template "secchip" (scopedChip (chip (index $.V .ID)) (runNumbers .))}}</td><td role="cell" data-label="Run" class="desk-only c-run"><a class="mono link" href="/runs/{{pathEsc .ID}}" title="{{.ID}}" data-number-exclude-title="layout.identity-2" data-number-exclude="layout.identity-10">{{rid .ID}}</a></td><td role="cell" data-label="Started" class="desk-only"><time datetime="{{iso .Start}}" title="{{stamp .Start}}" data-number-exclude="layout.clock-1">{{when .Start $now}}</time></td><td role="cell" data-label="Duration" class="desk-only">{{template "ck" (ckOf . $now)}}</td><td role="cell" data-label="Lines" class="num desk-only c-lines">{{template "quantity" (quantity "shared.run-events" .Lines $numbers)}}</td><td role="cell" data-label="Refused" class="num desk-only">{{if .Refusals}}<a class="n-link" href="/runs/{{pathEsc .ID}}/refusals" aria-label="{{quantityText "shared.run-refused" .Refusals $numbers}} refused in run {{rid .ID}}" data-number-aria-label="shared.run-refused">{{template "quantity" (quantity "shared.run-refused" .Refusals $numbers)}}</a>{{else}}<span class="zero">{{template "quantity" (quantity "shared.run-refused" 0 $numbers)}}</span>{{end}}</td><td role="cell" data-label="Asks" class="num desk-only c-asks">{{if .Asks}}{{template "quantity" (quantity "shared.run-asks" .Asks $numbers)}}{{else}}<span class="zero">{{template "quantity" (quantity "shared.run-asks" 0 $numbers)}}</span>{{end}}</td><td role="cell" data-label="Protection" class="desk-only" title="{{.Tier}}" data-number-exclude="layout.fact-2">{{tier .Tier}}</td><td role="cell" class="mobile-sum">{{rid .ID}} · {{template "ck" (ckOf . $now)}} · {{template "quantity" (quantity "shared.run-refused" .Refusals $numbers)}} refused · {{tier .Tier}}</td><td role="cell" class="phone-run-cell phone-cell"><a class="phone-row" href="/runs/{{pathEsc .ID}}"><span class="phone-who" data-number-exclude="layout.agent-field-2">{{if .Agent}}{{.Agent}}{{else}}(no agent){{end}}</span>{{template "state" .}}<time class="phone-when" datetime="{{iso .Start}}" data-started="{{iso .Start}}" data-number-exclude="layout.clock-2" data-ck>{{rowAgo .Start $now}}</time></a></td></tr>{{end}}{{end}}
{{/* spv is a shortened path (sp, story.go): the folder muted, the file name in bold, the full path in the title; sptv is a row's target (spt): a path, or text cut in the middle. Both wrap only between names (pwp). */}}
{{define "spv"}}{{range $i, $p := .}}{{if $i}} → {{end}}<span class="ut sp" title="{{$p.Full}}" data-number-exclude-title="layout.explicit-5"><span class="sp-d">{{template "pwp" (pieces $p.Dir)}}</span>{{if $p.Dir}}<wbr>{{end}}<b class="sp-b">{{template "pwp" (pieces $p.Base)}}</b></span>{{end}}{{end}}
{{define "sptv"}}{{if .Parts}}{{template "spv" .Parts}}{{else}}<span class="ut" title="{{.Full}}" data-number-exclude-title="layout.fact-3">{{template "pwp" (pieces .Text)}}</span>{{end}}{{end}}
{{/* pwp is text in pieces (breakPieces, shown.go): a <wbr> after each / and :, each short hyphenated word in a no-wrap span, so a browser breaks it between names, never inside one. */}}
{{define "pwp"}}{{range .}}{{if .Br}}<wbr>{{end}}{{if .Keep}}<span class="nb" data-number-exclude="layout.fact-4">{{.Text}}</span>{{else}}<span class="path-token" data-number-exclude="layout.path-token">{{.Text}}</span>{{end}}{{end}}{{end}}
{{/* secchip is a run's Secrets cell (chip, story.go): exposed in red, protected neutral, read on a watched run. */}}
{{define "secchip"}}{{if .Text}}<span class="b {{.Class}}" title="{{.Title}}" data-number="shared.secret-chip">{{template "i" .Icon}}{{.Text}}</span>{{else}}<span class="zero" data-number="shared.secret-chip" title="No secret read or protected was recorded">—</span>{{end}}{{end}}
{{/* firstrun is the empty Overview's and the empty Runs page's one next step, for any agent: tego watch, which the
     installer puts on the machine, records the command the person gives and blocks nothing; its run then shows here,
     and New rules file's From a run turns it into a contract (rules_new.go). No file the installer does not install is
     named. overview_test.go holds both pages to it. */}}
{{define "firstrun"}}<p>Next: start your agent under Tego, in a terminal, from your project:</p>
{{template "firstrun-step"}}{{end}}
{{/* firstrun-step is that step without its lead: the empty Overview with a guide shows it under the guide's own next
     step (overview.tmpl), so it does not call itself "Next". */}}
{{define "firstrun-step"}}<div class="cli cli-wrap"><code>tego watch -- &lt;the command that starts your agent&gt;</code></div>
<p class="soft" data-number="shared.watch-refusals">It records what the agent does and refuses nothing. When it ends, its run shows here, and <a class="link" href="/rules/new?mode=run">New rules file · From a run</a> turns it into a contract.</p>{{end}}
{{/* askform is a waiting request's answers. Allow once and Deny are the same button, equal in weight: Tego
does not pick the answer for the person, and the card's question says what each does. */}}
{{define "askform"}}<div class="ask-d">{{if .OwnerOnly}}<p class="soft">Only root may answer once. Run the approval as root from a terminal outside any governed run.</p>{{else}}<form class="stack-sm" method="post" action="/approvals/answer"><input type="hidden" name="csrf" value="{{.CSRF}}"><input type="hidden" name="run" value="{{.Run}}"><input type="hidden" name="ask" value="{{.AskID}}">
      <button class="btn btn-block ask-btn" type="submit" name="decision" value="approve">{{template "i" "i-check"}}<span data-number="shared.policy">Allow once</span></button>
      <button class="btn btn-block ask-btn" type="submit" name="decision" value="deny">{{template "i" "i-ban"}}Deny</button></form>
      <details class="ask-more"><summary>More choices</summary><div class="stack-lg ask-more-in">
      <form class="stack-sm" method="post" action="/approvals/answer"><input type="hidden" name="csrf" value="{{.CSRF}}"><input type="hidden" name="run" value="{{.Run}}"><input type="hidden" name="ask" value="{{.AskID}}"><input type="hidden" name="always" value="yes">
      <button class="btn btn-block" type="submit" name="decision" value="approve">{{template "i" "i-check"}}Allow for this run</button>
      <button class="btn btn-block" type="submit" name="decision" value="deny">{{template "i" "i-ban"}}Deny for this run</button>
      <p class="soft ask-note"><span data-number="shared.policy">For this run: the same answer also goes to every later request to </span>{{.Verb}} the same target, until this run ends. It does not change the contract.</p></form>
      {{if .Alternate}}<form class="stack-sm" method="post" action="/approvals/answer"><input type="hidden" name="csrf" value="{{.CSRF}}"><input type="hidden" name="run" value="{{.Run}}"><input type="hidden" name="ask" value="{{.AskID}}">
      <label class="lbl" for="alt-{{.AskID}}">Give a stand-in file instead (an absolute path on this computer)</label><input class="input" id="alt-{{.AskID}}" type="text" name="file" required placeholder="/home/you/stand-in.txt" autocomplete="off" spellcheck="false">
      <label class="check-inline"><input type="checkbox" name="always" value="yes"> also for later requests for the same file in this run</label>
      <button class="btn btn-block" type="submit" name="decision" value="alternate">{{template "i" "i-eye"}}Give this file instead</button></form>{{end}}
      <div class="cli-pair"><span class="lbl">Same in a terminal</span>
      <span class="cli-k"><span data-number="shared.policy">Allow once</span></span><div class="cli cli-wrap"><code data-number-exclude="layout.fact-6">{{cmd (askline "approve" .Run .AskID "")}}</code></div>
      <span class="cli-k">Deny</span><div class="cli cli-wrap"><code data-number-exclude="layout.fact-7">{{cmd (askline "deny" .Run .AskID "")}}</code></div>
      <span class="cli-k">Allow for this run</span><div class="cli cli-wrap"><code data-number-exclude="layout.fact-8">{{cmd (askline "approve" .Run .AskID " --always")}}</code></div>
      <span class="cli-k">Deny for this run</span><div class="cli cli-wrap"><code data-number-exclude="layout.fact-9">{{cmd (askline "deny" .Run .AskID " --always")}}</code></div>{{if .Alternate}}
      <span class="cli-k">Stand-in file</span><div class="cli cli-wrap"><code>{{cmd (askline "alternate" .Run .AskID " --file <path>")}}</code></div>{{end}}</div>
      </div></details>{{end}}</div>{{end}}
{{define "askbanner"}}{{if ne .Nav "overview"}}{{with index .Asks 0}}{{$m := index $.AskMeta .Run}}{{$r := request . $m}}<section class="banner banner-ask ab-line" id="ask-banner" role="region" aria-labelledby="ask-banner-h">{{template "i" "i-hand"}}<div class="grow ab-row" data-k="{{.Run}}-{{.AskID}}">{{template "compact-request-sentence" $r}}<p class="ab-h" id="ask-banner-h"><span class="sr" data-number-exclude="layout.agent-field-3">{{if .Agent}}{{.Agent}}{{else}}An agent{{end}} is waiting for you. </span>{{if $r.Wide.Long}}{{template "request-long" ($r.Named true)}}{{else}}<b data-number-exclude="layout.agent-field-4">{{if .Agent}}{{.Agent}}{{else}}An agent{{end}}</b> wants to <span class="op"{{with .Op}} title="{{.}}"{{end}} data-number-exclude="layout.identity-12">{{askVerb .Op .Rule .Hold}}</span> {{if .Target}}<span class="request-exact">{{template "request-target" (requestTarget .Target $m.Home $m.Cwd)}}</span>{{else}}<span class="ut">(no target named)</span>{{end}}{{end}} {{template "bandwait" (card . $.CSRF false $m $.Now)}}</p>
{{if .OwnerOnly}}<p class="soft">Only root may answer once. Run the approval as root from a terminal outside any governed run.</p>{{else if $r.Quick}}<form class="ab-act{{$r.QuickClass}}" method="post" action="/approvals/answer"><input type="hidden" name="csrf" value="{{$.CSRF}}"><input type="hidden" name="run" value="{{.Run}}"><input type="hidden" name="ask" value="{{.AskID}}"><button class="btn ask-btn" type="submit" name="decision" value="approve">{{template "i" "i-check"}}<span data-number="shared.policy">Allow once</span></button><button class="btn ask-btn" type="submit" name="decision" value="deny">{{template "i" "i-ban"}}Deny</button><a class="btn btn-ghost" href="{{approvalURL .Run .AskID}}#{{.AskID}}" aria-label="Details: {{if .Agent}}{{.Agent}}{{else}}An agent{{end}} wants to {{askVerb .Op .Rule .Hold}} {{.Target}}{{if gt $.Pending 1}}, {{quantityText "shared.waiting" $.Pending $.GlobalNumbers}} waiting{{end}}" {{if gt $.Pending 1}}data-number-aria-label="shared.waiting"{{else}}data-number-exclude-aria-label="layout.request-target"{{end}}>Details{{if gt $.Pending 1}}<span class="ab-count"> ({{template "quantity" (quantity "shared.waiting" $.Pending $.GlobalNumbers)}})</span>{{end}}</a></form>{{end}}{{template "ask-review" $r}}</div></section>{{end}}{{else}}{{template "askbanner-full" .}}{{end}}{{end}}
{{define "askbanner-full"}}<section class="banner banner-ask" id="ask-banner" role="region" aria-labelledby="ask-banner-h">{{template "i" "i-hand"}}<div class="grow ab">
{{$one := eq .Pending 1}}<p class="ab-h" id="ask-banner-h">{{if $one}}{{with index .Asks 0}}{{if .Agent}}{{.Agent}}{{else}}An agent{{end}}{{end}} is waiting for you{{else}}{{template "quantity" (quantity "shared.waiting" .Pending .GlobalNumbers)}} requests are waiting for you{{end}}</p>
{{$quick := false}}{{range .Asks}}{{$m := index $.AskMeta .Run}}{{$r := request . $m}}{{if $r.Quick}}{{$quick = true}}{{end}}<div class="ab-row" data-k="{{.Run}}-{{.AskID}}">{{template "compact-request-sentence" $r}}<p class="ab-what">{{if $r.Wide.Long}}{{template "request-long" ($r.Named (not $one))}}{{else}}{{if not $one}}<b data-number-exclude="layout.agent-field-5">{{if .Agent}}{{.Agent}}{{else}}An agent{{end}}</b> wants to {{else}}Wants to {{end}}<span class="op"{{with .Op}} title="{{.}}"{{end}} data-number-exclude="layout.identity-13">{{askVerb .Op .Rule .Hold}}</span> {{if .Target}}<span class="ab-tgt"><span class="request-exact">{{template "request-target" (requestTarget .Target $m.Home $m.Cwd)}}</span></span>{{else}}<span class="ut">(no target named)</span>{{end}}{{end}} {{template "bandwait" (card . $.CSRF false $m $.Now)}}</p>
{{if .OwnerOnly}}<p class="soft">Only root may answer once. Run the approval as root from a terminal outside any governed run.</p>{{else if $r.Quick}}<form class="ab-act{{$r.QuickClass}}" method="post" action="/approvals/answer"><input type="hidden" name="csrf" value="{{$.CSRF}}"><input type="hidden" name="run" value="{{.Run}}"><input type="hidden" name="ask" value="{{.AskID}}"><button class="btn ask-btn" type="submit" name="decision" value="approve">{{template "i" "i-check"}}<span data-number="shared.policy">Allow once</span></button><button class="btn ask-btn" type="submit" name="decision" value="deny">{{template "i" "i-ban"}}Deny</button><a class="btn btn-ghost" href="{{approvalURL .Run .AskID}}#{{.AskID}}" aria-label="Details: {{if .Agent}}{{.Agent}}{{else}}An agent{{end}} wants to {{askVerb .Op .Rule .Hold}} {{.Target}}{{if gt $.Pending 1}}, {{quantityText "shared.waiting" $.Pending $.GlobalNumbers}} waiting{{end}}" {{if gt $.Pending 1}}data-number-aria-label="shared.waiting"{{else}}data-number-exclude-aria-label="layout.full-request-target"{{end}}>Details{{if gt $.Pending 1}}<span class="ab-count"> ({{template "quantity" (quantity "shared.waiting" $.Pending $.GlobalNumbers)}})</span>{{end}}</a></form>{{end}}{{template "ask-review" $r}}</div>{{end}}
{{if or $quick (gt .Pending (len .Asks))}}<p class="soft ab-note">{{if $quick}}<span data-number="shared.policy">Allow once lets this one request through; Deny refuses it.</span>{{end}}{{if gt .Pending (len .Asks)}} <a class="link" href="/approvals">See all {{template "quantity" (quantity "shared.waiting" .Pending .GlobalNumbers)}} on Approvals</a>.{{end}}</p>{{end}}</div></section>{{end}}
{{/* The later wait note reserves its own wrapped height from first paint. Held age is a page-read snapshot;
     data-ck leaves it out of the region hash, and the band is excluded from live age rewrites. */}}
{{define "bandwait"}}<span class="ab-timing" data-ck><span title="Held duration when this request was last refreshed" data-number-exclude="layout.fact-11" data-ck>Held for {{ago .V.TS .Now}}</span> · <time class="ask-ago" datetime="{{iso .V.TS}}" data-ago="{{iso .V.TS}}" title="{{stamp .V.TS}}" data-number-exclude="layout.clock-3">asked at {{clock .V.TS}}</time><span class="ab-wait"><span class="ab-wait-room" aria-hidden="true" data-number-exclude="layout.fact-12">{{if .Wait.Late}}{{.Wait.Late}}{{else}}{{.Wait.Text}}{{end}}</span>{{template "waitnote" .Wait}}</span></span>{{end}}
{{/* waitnote is how long a waiting request is held (askWait): giveUp's words until the agent has likely stopped waiting, then live.js puts data-late in their place at data-late-at (the page renders those words itself once that time has passed). */}}
{{define "waitnote"}}<span class="ask-wait"{{if .Late}} data-late-at="{{iso .LateAt}}" data-late="{{.Late}}"{{end}} data-number-exclude="layout.fact-13">{{.Text}}</span>{{end}}
{{/* askcard is one waiting request in full (Approvals and its run's page): the question, how long ago it came and how long the agent waits (live.js ticks it), the agent's exact text, the answers, and the request's id (the one `tego approve <run> <ask_id>` takes and the record holds), in view with scripts off. With Show set it names the run. */}}
{{define "askcard"}}{{$a := .V}}<section class="ask" id="{{$a.AskID}}" aria-labelledby="q-{{$a.AskID}}">
  <div class="ask-bar"><span class="who">{{template "i" "i-shield"}}Tego asks you</span><span><time class="ask-ago" datetime="{{iso $a.TS}}" data-ago="{{iso $a.TS}}" title="Asked at {{stamp $a.TS}}" data-ck>asked {{ago $a.TS .Now}} ago</time> · {{template "waitnote" .Wait}}</span></div>
  <div class="ask-grid">
    <h2 class="ask-q" id="q-{{$a.AskID}}">Let {{if $a.Agent}}{{$a.Agent}}{{else}}the agent{{end}} <span{{with $a.Op}} title="{{.}}"{{end}}>{{askVerb $a.Op $a.Rule $a.Hold}}</span> {{askObject $a.Op $a.Rule $a.Hold}}?</h2>
    <div class="ask-t">{{if $a.Target}}<p class="ask-path">{{template "sptv" (sptIn $a.Target .Home .Cwd 72)}}</p>{{end}}<div><div class="ut-label">{{template "i" "i-eye"}}What the agent asked for · agent's text, shown exactly</div><span class="ut ut-box" tabindex="0">{{if $a.Target}}{{$a.Target}}{{else}}(the ask line names no target; held {{$a.Hold}}){{end}}</span></div></div>
    {{template "askform" (askForm $a .CSRF)}}
    <div class="ask-f"><dl class="kv">
      {{if .Show}}<dt>Run</dt><dd><a class="link" href="/runs/{{pathEsc $a.Run}}">{{$a.Agent}}</a> <span class="mono muted" title="{{$a.Run}}">{{rid $a.Run}}</span></dd>{{end}}
      <dt>Why it asked</dt><dd><span title="{{$a.Rule}}">{{askWhy $a.Rule}}</span></dd>
      <dt>Request</dt><dd><span class="mono" title="The id the terminal and the record show for this request">{{$a.AskID}}</span> <span class="soft">· line #{{$a.Seq}}</span></dd></dl></div>
  </div>
</section>{{end}}
{{/* lr opens a live region's wrapper (regions.go), named and hashed so static/live.js can swap the region in place:
     {{template "lr" (index $.L "<region>")}}{{template "<region>" $}}</div> */}}
{{define "lr"}}<div class="lr" data-live="{{.Name}}" data-h="{{.Hash}}"{{if .Top}} data-top{{end}}>{{end}}
{{/* lrb is lr for a table's rows: the region is a <tbody> of table rows. {{template "lrb" (index $.L "<region>")}}{{template "<region>" $}}</tbody> */}}
{{define "lrb"}}<tbody role="rowgroup" data-live="{{.Name}}" data-h="{{.Hash}}"{{if .Top}} data-top{{end}}>{{end}}
{{define "r-top"}}{{if and .Live (not .GlobalNumbers.Live.Error) (not .GlobalNumbers.Live.Lower)}}<span class="live"><span class="dot" aria-hidden="true"></span>Live</span>{{else}}<span class="live paused" data-number="shared.running-zero" title="{{if .GlobalNumbers.Live.Error}}{{.GlobalNumbers.Live.Error}}{{else}}{{.GlobalNumbers.Live.Reason}}{{end}}"><span class="dot" aria-hidden="true"></span>{{if .GlobalNumbers.Live.Error}}Could not read running state{{else if .GlobalNumbers.Live.Lower}}Running state not fully known{{else}}Nothing running{{end}}</span>{{end}}{{end}}
{{define "r-nav"}}<ul class="nav" data-ask-keys="{{range .AskKeys}}{{.}} {{end}}">
      {{if .AgentsNav}}<li><a href="/agents"{{if eq .Nav "agents"}} aria-current="page"{{end}}>{{template "i" "i-bot"}}<span class="lbl">Agents</span></a></li>{{end}}<li{{if .AgentsNav}} class="more-item"{{end}}><a href="{{if .AgentsNav}}/overview{{else}}/{{end}}"{{if eq .Nav "overview"}} aria-current="page"{{end}}>{{template "i" "i-layout-dashboard"}}<span class="lbl">Overview</span></a></li>
      <li><a href="/runs"{{if eq .Nav "runs"}} aria-current="page"{{end}}>{{template "i" "i-activity"}}<span class="lbl">Runs</span></a></li>
      <li><a href="/approvals"{{if eq .Nav "approvals"}} aria-current="page"{{end}}>{{template "i" "i-inbox"}}<span class="lbl">Approvals</span>{{with .Waiting}}{{if .Show}}<span class="count" data-number="shared.waiting" title="{{.Sentence}}" aria-label="{{.Sentence}}" data-number-aria-label="shared.waiting" data-number-title="shared.waiting">{{.Short}}<span class="sr" data-number="shared.waiting">{{.Sentence}}</span></span>{{end}}{{end}}</a></li>
      <li><a href="/logs"{{if eq .Nav "logs"}} aria-current="page"{{end}}>{{template "i" "i-scroll-text"}}<span class="lbl">Logs</span></a></li>
      <li class="more-item nav-rules"><a href="/rules"{{if eq .Nav "rules"}} aria-current="page"{{end}}>{{template "i" "i-shield"}}<span class="lbl">Rules files</span></a></li>
      <li class="sep" role="separator"></li>
      <li class="more-item"><a href="/detections"{{if eq .Nav "detections"}} aria-current="page"{{end}}>{{template "i" "i-triangle-alert"}}<span class="lbl">Detections</span></a></li>
      <li class="more-item"><a href="/machine"{{if eq .Nav "machine"}} aria-current="page"{{end}}>{{template "i" "i-terminal"}}<span class="lbl">This machine</span></a></li>
      {{if .Preview}}
      {{range layerNav}}{{if .Soon}}<li class="more-item"><span class="nav-soon" title="{{.Title}}">{{template "i" .Icon}}<span class="lbl">{{.Label}}</span><span class="soon-tag">Soon</span></span></li>{{else}}<li class="more-item"><a href="{{.Href}}"{{if eq $.Nav .Key}} aria-current="page"{{end}}>{{template "i" .Icon}}<span class="lbl">{{.Label}}</span></a></li>{{end}}
      {{end}}{{end}}
      <li class="nav-more"><a class="phone-more" href="/more" aria-label="More destinations and settings"{{if and (ne .Nav "overview") (ne .Nav "agents") (ne .Nav "runs") (ne .Nav "approvals") (ne .Nav "logs")}} aria-current="page"{{end}}>{{template "i" "i-compass"}}<span class="lbl">More</span></a><button type="button" popovertarget="more-menu"><span class="dots" aria-hidden="true">···</span><span class="lbl">More</span></button><ul class="more-menu" id="more-menu" popover><li><a href="/rules"{{if eq .Nav "rules"}} aria-current="page"{{end}}>{{template "i" "i-shield"}}Rules files</a></li><li><a href="/detections"{{if eq .Nav "detections"}} aria-current="page"{{end}}>{{template "i" "i-triangle-alert"}}Detections</a></li><li><a href="/machine"{{if eq .Nav "machine"}} aria-current="page"{{end}}>{{template "i" "i-terminal"}}This machine</a></li>{{if .Preview}}{{range layerNav}}{{if .Soon}}<li class="soon-li"><span class="nav-soon">{{template "i" .Icon}}{{.Label}}<span class="soon-tag">Coming soon</span></span></li>{{else}}<li><a href="{{.Href}}"{{if eq $.Nav .Key}} aria-current="page"{{end}}>{{template "i" .Icon}}{{.Label}}</a></li>{{end}}{{end}}{{end}}</ul></li>
    </ul>{{end}}
{{define "r-banner"}}{{with .BaselineNotice}}<section class="banner banner-warn" role="status">{{template "i" "i-triangle-alert"}}<div class="grow">{{.}}</div></section>{{end}}{{if and .WaitingIncomplete (ne .Nav "overview") (ne .Nav "approvals")}}<p class="soft desktop-only" data-number="shared.waiting">{{.Waiting.Sentence}}</p>{{if not .PhoneWaitingInContent}}<p class="soft phone-only" data-number="shared.waiting">{{.Waiting.PhoneSentence}}</p>{{end}}{{end}}{{if and .Asks (ne .Nav "approvals")}}{{template "askbanner" .}}{{end}}
{{with .Flash}}<section class="banner flash {{if .OK}}banner-ok{{else}}banner-danger{{end}}" id="flash" role="status" aria-live="polite">{{if .OK}}{{template "i" "i-check"}}{{else}}{{template "i" "i-triangle-alert"}}{{end}}<div class="grow"><strong>{{.Text}}</strong>{{with .Link}} <span class="soft" aria-hidden="true">·</span> <a class="link" href="{{.}}">{{$.Flash.LinkText}}</a>{{end}}</div></section>{{end}}
{{if .Numbers.Notes}}<div class="count-coverage soft desktop-only">{{range .CountNotes}}<p data-number-exclude="layout.count-diagnostic">{{.}}</p>{{end}}{{with $.Numbers.Links}}<p>{{range $i, $l := .}}{{if $i}} · {{end}}<a class="btn" href="{{$l.URL}}" data-number-exclude="shared.record-link-identity">{{$l.Label}}</a>{{end}}</p>{{end}}</div><details class="count-coverage soft phone-only"><summary>Details and recovery</summary><div>{{if .WaitingIncomplete}}<p data-number="shared.waiting">{{.Waiting.Sentence}}</p>{{end}}{{range .CountNotes}}<p data-number-exclude="layout.phone-count-diagnostic">{{.}}</p>{{end}}{{with $.Numbers.Links}}<p>{{range $i, $l := .}}{{if $i}} · {{end}}<a class="btn" href="{{$l.URL}}" data-number-exclude="shared.phone-record-link-identity">{{$l.Label}}</a>{{end}}</p>{{end}}</div></details>{{end}}{{if .RunLimit}}<section class="banner banner-warn" role="status"><div class="grow">Showing up to {{template "quantity" (quantity "shared.run-limit" .RunLimit exactNumbers)}} of {{template "quantity" (quantity "shared.run-candidates" .CandidateRuns .GlobalNumbers)}} runs.</div></section>{{end}}{{range .Notes}}<section class="banner banner-warn" role="status">{{template "i" "i-triangle-alert"}}<div class="grow">{{.}}</div></section>{{end}}{{end}}
{{define "layout"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#FBFAF8" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0F121F" media="(prefers-color-scheme: dark)">

<title data-number="shared.waiting">{{with .Waiting}}{{if .Show}}({{.Short}}) {{end}}{{end}}{{.Title}} · Tego</title>
<script src="/static/theme.js"></script>
<script src="/static/live.js" defer{{if .HeadStyles}} blocking="render"{{end}}></script>
<link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
<link rel="preload" href="/static/fonts/anton.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/static/tokens.css">
<link rel="stylesheet" href="/static/app.css">
<link rel="stylesheet" href="/static/mvp.css">
<link rel="stylesheet" href="/static/signal.css">
<link rel="stylesheet" href="/static/phone.css">
<link rel="stylesheet" href="/static/guide.css">
{{range .HeadStyles}}<link rel="stylesheet" href="{{.}}">{{end}}</head>
<body{{if .Sig}} data-sig="{{.Sig}}" data-rev="{{.Rev}}" data-title="{{.Title}} · Tego"{{end}}>
<header class="topbar"><a class="skip" href="#main">Skip to content</a>
  <a class="brand" href="/" aria-label="Tego overview"><svg class="logo" aria-hidden="true" focusable="false" viewBox="0 0 142 101"><use href="/static/sprite.svg#logo"/></svg><span class="word">Tego</span></a>
  <span class="page-name">{{if .Tour}}Guide{{else}}{{template "page-name" .}}{{end}}</span>
  {{if .Host}}{{$hs := cut .Host 20}}<span class="host" title="This computer: {{.Host}}" data-number-exclude-title="layout.identity-7" data-number-exclude="layout.identity-22">{{$hs}}</span>{{if ne $hs .Host}}<details class="host-more"><summary>Whole name</summary><div class="host-full"><span class="soft">This computer. Click the name to select it, then copy.</span><code class="host-name" translate="no" tabindex="0" data-number-exclude="layout.identity-33">{{.Host}}</code></div></details>{{end}}{{end}}
  <form class="gsearch" role="search" action="/logs" method="get">
    <label class="sr" for="gq">Search</label>{{template "i" "i-search"}}
    <input class="input" id="gq" type="search" name="q" value="{{.Query}}" placeholder="Path, host, command or rule" autocomplete="off" spellcheck="false" data-number-exclude-value="shared.search-query">
  </form>
  <div class="top-right">
    {{template "lr" (index .L "r-top")}}{{template "r-top" $}}</div>
    <a class="toplink" href="/guide">Guide</a>
    <a class="toplink icon" href="/glossary" title="What the dashboard's words mean" aria-label="Glossary">?</a>
    <span class="theme" id="theme-w" hidden><label class="sr" for="theme">Colour theme</label><select class="select" id="theme" title="Colour theme"><option value="auto">Auto</option><option value="light">Light</option><option value="dark">Dark</option></select></span>
  </div>
</header>
<div class="app">
  <nav class="side phone-nav" aria-label="Main">
    {{template "lr" (index .L "r-nav")}}{{template "r-nav" $}}</div>
  </nav>
  <main id="main" tabindex="-1">
    <div class="page">
{{template "lr" (index .L "r-banner")}}{{template "r-banner" $}}</div>
{{template "lr" (index .L "r-guide")}}{{template "r-guide" $}}</div>

{{if .Tour}}<details class="gf-product" id="guide-product"{{if .Tour.Builder}} open{{end}}><summary>{{.Tour.Page}}</summary><div class="gf-product-body">{{end}}
{{if .ManualRefresh}}<noscript class="manual-refresh"><p class="row"><span>Live updates are off.</span><a class="btn btn-ghost" href="">Refresh now</a></p></noscript>
{{end}}{{with index .L "content"}}{{template "lr" .}}{{template "content" $}}</div>{{else}}{{template "content" $}}{{end}}
{{if .Tour}}</div></details>{{end}}
    </div>
    <footer class="foot">
      <span data-number-title="shared.policy" title="Every run's record, hash-chained and verified">Record <span class="mono" data-number-exclude="layout.identity-23">{{.Ledger}}</span></span>
    </footer>
    <div class="sr" id="ask-say" role="status" aria-live="polite" aria-atomic="true"></div>
  </main>
</div>
</body>
</html>{{end}}

{{define "page-name"}}{{if .PhoneName}}{{.PhoneName}}{{else if eq .Nav "overview"}}Overview{{else if eq .Nav "runs"}}{{if eq .Title "Runs"}}Runs{{else}}Run{{end}}{{else if eq .Nav "approvals"}}Approvals{{else if eq .Nav "logs"}}Logs{{else}}{{pageLabel .Title}}{{end}}{{end}}

{{/* compact-request-sentence is a request's phone sentence (a requestView, request_forms.go): FULL, or LONG with the
     target cut in the middle; the accessible name carries the whole sentence in both forms. */}}
{{define "compact-request-sentence"}}<p class="ab-summary"{{if .Phone.Long}} hidden{{end}} role="group" aria-label="{{.Full}}" data-number-exclude-aria-label="layout.fact-16"><span class="ab-name" data-number-exclude="layout.agent-field-7">{{.Phone.Agent}}</span><span class="ab-intent"> wants to {{bandVerb .Op .Rule .Hold}} <span class="ab-short-target" data-number-exclude="layout.identity-24">{{if .Target}}{{range requestParts .Phone.Target}}{{.}}<wbr>{{end}}{{else}}(no target){{end}}</span></span></p>{{end}}
{{/* request-long is the wide LONG sentence (a requestNamed): the whole sentence for assistive technology, the cut one
     on screen, with the agent's name in front unless Overview's heading already names the only request's agent. */}}
{{define "request-long"}}<span class="sr" data-number-exclude="layout.request-full">{{.Full}}</span><span aria-hidden="true" data-number-exclude="layout.request-long">{{if .Named}}<b>{{.Wide.Agent}}</b> wants to {{else}}Wants to {{end}}<span class="op">{{askVerb .Op .Rule .Hold}}</span> <span class="request-exact"><span class="ut">{{range requestParts .Wide.Target}}{{.}}<wbr>{{end}}</span></span></span>{{end}}
{{/* ask-review takes the quick answers' place where the sentence is LONG: one link to the request's own card, which
     shows the FULL form with Allow once and Deny. phone-only when only the phone form is LONG. */}}
{{define "ask-review"}}{{if .Phone.Long}}<p class="ab-review{{if .Quick}} phone-only{{end}}"><a class="btn" href="{{approvalURL .Run .AskID}}#{{.AskID}}" aria-label="Review request: {{.Full}}" data-number-exclude-aria-label="layout.review-request">Review request</a></p>{{end}}{{end}}

{{define "quantity"}}<span data-number="{{.ID}}"{{with .Reason}} title="{{.}}"{{end}}>{{.Text}}</span>{{end}}

{{define "request-target"}}{{if .Paths}}{{range $i,$p:=.Paths}}{{if $i}} → {{end}}<span class="ut sp" title="{{.Full}}" data-number-exclude-title="layout.request-file-title"><span class="sp-d">{{template "pwp" .Dir}}</span>{{if .Dir}}<wbr>{{end}}<b class="sp-b">{{template "pwp" .Base}}</b></span>{{end}}{{else}}<span class="ut" title="{{.Full}}" data-number-exclude="layout.request-verbatim-target">{{range requestParts .Full}}{{.}}<wbr>{{end}}</span>{{end}}{{end}}
