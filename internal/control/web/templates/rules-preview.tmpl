{{/* rules-preview shows the redacted structured change. Save posts the retained review. A governed or uncertain peer sees the same change without a Save form or retained review. */}}
{{define "content"}}<link rel="stylesheet" href="/static/rules.css"><link rel="stylesheet" href="/static/rules-change.css">{{$csrf := $.CSRF}}{{with .Data}}<div class="page-interior contracts-page">{{$d := .}}{{$p := .P}}
<div class="head"><div><nav class="crumbs" aria-label="Breadcrumb"><a class="link" href="/rules">Contracts</a><span aria-hidden="true">/</span><a class="link" href="/rules/change?c={{queryEsc $p.Ref}}">Change rules</a><span aria-hidden="true">/</span><span>Check</span></nav>
{{if $.Tour}}<h2>{{else}}<h1 class="h1-obj">{{end}}Check the change{{if $.Tour}}</h2>{{else}}</h1>{{end}}
<p class="lede rules-ctx">For {{$p.Agent}}, in <span class="detail-value mono" title="{{$p.Contract}}" data-number-exclude="editor.preview-path">{{$p.Contract}}</span>{{template "quantity" (quantityZero "editor.preview-written" " · nothing written yet" exactNumbers)}}</p></div></div>

<p class="page-intro phone-only">For <strong class="detail-value" data-number-exclude="rules-preview.agent-1">{{$p.Agent}}</strong>. {{template "quantity" (quantityZero "editor.preview-saved" "Nothing is saved yet." exactNumbers)}}</p>
{{if $p.Stale}}<section class="banner banner-warn" role="status">{{template "i" "i-triangle-alert"}}<div class="grow">Changed since you opened it · checked as it is now</div></section>{{end}}

{{if $p.Err}}<section class="panel"><div class="panel-body stack-sm">
{{if $p.Nothing}}<p>{{template "i" "i-check"}} {{template "quantity" (quantityZero "editor.changes-zero" "The rules file already says so: nothing to change." exactNumbers)}}</p>{{else}}<p><strong>This change cannot be made.</strong> {{$p.Err}}</p>{{end}}
<p><a class="btn" href="/rules/change?c={{queryEsc $p.Ref}}">Back to Change rules</a></p></div></section>
{{else}}
{{template "hostwarn" $p.Unresolved}}{{template "newlyallows" $p.NewlyAllows}}{{template "comparisonreview" $p.ComparisonReview}}
<section class="panel rc-preview" aria-labelledby="h-what"><div class="panel-head"><h2 id="h-what">What changes</h2>{{template "dir" $p.Direction}}</div>
<div class="panel-body stack-sm">{{$mixed := eq $p.Direction "mixed"}}
<div class="tw"><table class="t rc-sent" role="table"><caption class="sr">Before and after</caption><thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader">Before</th><th scope="col" role="columnheader">After</th>{{if $mixed}}<th scope="col" role="columnheader" class="c-effect"><span class="sr">Direction</span></th>{{end}}</tr></thead><tbody role="rowgroup">{{range $p.Sentences}}
<tr role="row"><td role="cell" data-label="Before">{{if .Before}}{{.Before}}{{else}}<span class="soft" data-number="editor.entries-zero">(nothing)</span>{{end}}</td><td role="cell" data-label="After">{{.After}}</td>{{if $mixed}}<td role="cell" class="c-effect">{{template "dir" .Direction}}</td>{{end}}</tr>{{end}}
</tbody></table></div>
{{template "families" $p.Families}}
<p class="rc-next">{{template "i" "i-scroll-text"}}<span><strong>From the next run</strong>{{if $d.NowOn}}<span class="rc-next-on"> With “Apply now” ticked below, it is {{if $d.NowRecorded}}recorded (not enforced){{else}}in force{{end}} on <span class="nb">{{$d.NowOn}}</span> within about a second.</span><span class="rc-next-off"> · running runs keep theirs</span>{{else}} Runs going on now keep the rules they started with.{{end}}</span></p>
{{$fence := false}}{{range $p.Now}}{{if .FenceLift}}{{$fence = true}}{{end}}{{end}}{{if $fence}}<p class="rc-next rc-fence">{{template "i" "i-scroll-text"}}<span><strong>Live now (fence)</strong><span title="A running run lists this in its fence: lift it there now, for a while or the rest of the run. Tego's live layer enforces it, not the kernel.">Liftable now</span></span></p>{{end}}
</div></section>

{{if $d.ReadOnly}}<section class="panel"><div class="panel-body"><p>Saving is not available from this connection. Open the dashboard from a terminal outside any governed run to save a change.</p></div></section>
{{else}}<form class="panel rc-confirm" method="post" action="/rules/change" aria-labelledby="h-save"><div class="panel-head"><h2 id="h-save">Save</h2></div><div class="panel-body stack-sm">
<input type="hidden" name="csrf" value="{{$csrf}}"><input type="hidden" name="c" value="{{$p.Ref}}"><input type="hidden" name="base" value="{{$p.Base}}">{{range $d.Edits}}<input type="hidden" name="op" value="{{.Op}}"><input type="hidden" name="key" value="{{.Key}}"><input type="hidden" name="v" value="{{.Entry}}">{{end}}
{{template "nowrows" $d.Now}}
{{if $p.NeedsAck}}<section class="banner banner-warn rc-widen" role="alert" aria-labelledby="h-widen">{{template "i" "i-triangle-alert"}}<div class="grow stack-sm"><h3 class="rp-h" id="h-widen">{{if eq $p.Direction "widens"}}This lets the agent do more{{else}}This change cannot be read as only narrowing{{end}}</h3>
<p>Next run can: <strong>{{$d.After}}</strong>.</p>
<label class="rc-ack"><input type="checkbox" name="ack" value="{{$p.Ack}}" required> I understand: from its next run it {{if eq $p.Direction "widens"}}can do this{{else}}gets these rules{{end}} ({{$d.After}}).</label></div></section>
<div class="frow"><button class="btn" type="submit" data-page>Save the wider rules</button><a class="btn btn-ghost" href="/rules/change?c={{queryEsc $p.Ref}}">Cancel</a></div>
{{else}}<input type="hidden" name="ack" value="{{$p.Ack}}"><div class="frow"><button class="btn btn-primary" type="submit" data-page>{{template "i" "i-check"}}Save</button><a class="btn btn-ghost" href="/rules/change?c={{queryEsc $p.Ref}}">Cancel</a></div>{{end}}
<p class="soft"><span title="Compiled before it is written; the old file is kept as .bak">Undo from History</span></p>
</div></form>{{end}}

<details class="panel rules-raw"><summary class="panel-head"><h2>The change in the YAML</h2><span class="soft">{{$p.Summary}}</span></summary><div class="panel-body stack-sm">{{with $p.Why}}<p class="soft rc-why">Why it {{if eq $p.Direction "narrows"}}narrows{{else if eq $p.Direction "widens"}}widens{{else}}is mixed{{end}}: <span class="mono">{{.}}</span></p>{{end}}<pre class="raw rc-diff detail-value" tabindex="0" aria-label="The file's change" data-number-exclude="editor.preview-diff">{{$p.Diff}}</pre></div></details>
<div class="cli-pair"><span class="lbl">{{template "i" "i-terminal"}}The same in a terminal</span>{{with .CLINote}}<span class="soft" data-number-exclude="editor.preview-hint">{{.}}:</span>{{end}}{{range .CLI}}<div class="cli"><code data-number-exclude="editor.preview-command">{{cmd .}}</code></div>{{end}}</div>
{{end}}
</div>{{end}}{{end}}
