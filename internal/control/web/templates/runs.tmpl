{{/* Runs: the counts, then one table whose rows are two live <tbody> regions (regions.go): the running runs, whose rows move with each line they write, and a page of the other runs, newest first, which stay put; then the paging links. */}}
{{define "content"}}{{template "lr" (index $.L "r-runs-head")}}{{template "r-runs-head" $}}</div>
{{with .Data}}{{if gt (index .Count "all") 1}}<section class="panel cmp-pick runs-compare" aria-label="Compare two runs"><div class="panel-body row"><strong>Compare two runs</strong><span class="soft">what each touched, side by side</span>{{template "cmpform" (cmpForm .All "" "")}}</div></section>{{end}}{{end}}
{{with .Data}}
{{if .FilterPage}}<section class="filter-fallback panel panel-body" id="runs-filters" aria-labelledby="runs-filter-title"><h2 id="runs-filter-title">Filter runs</h2>{{template "runs-filters" .}}</section>{{else}}<dialog class="filter-sheet" id="runs-filters" aria-labelledby="runs-filter-title"><div class="filter-title"><h2 id="runs-filter-title">Filter runs</h2><button class="btn" type="button" data-filter-close>Close</button></div>{{template "runs-filters" .}}</dialog>{{end}}{{end}}
<section class="panel runs-panel" aria-label="Runs" id="runs-table">
<div class="tw phone-list"><table class="t t-rows summary-table" role="table"><caption class="sr">Runs: the running ones first, then the others, newest first</caption>{{template "runthead"}}
{{template "lrb" (index $.L "r-runs-live")}}{{template "r-runs-live" $}}</tbody>
{{template "lrb" (index $.L "r-runs-table")}}{{template "r-runs-table" $}}</tbody>
</table></div>
{{template "lr" (index $.L "r-runs-foot")}}{{template "r-runs-foot" $}}</div>
</section>
{{end}}
{{define "r-runs-head"}}{{with .Data}}<div class="head runs-head"><div>{{if $.Tour}}<h2>{{else}}<h1>{{end}}What is running?{{if $.Tour}}</h2>{{else}}</h1>{{end}}<p class="lede">{{template "quantity" (quantity "runs.running" (index .Count "running") $.Numbers)}} running<span class="phone-today"> · {{template "quantity" (quantity "runs.today" .Today $.Numbers)}} started today</span></p></div><div class="head-actions"><a class="btn" href="/logs">{{template "i" "i-scroll-text"}}Search logs</a></div></div>
<nav class="chips runs-head-chips" aria-label="Status"><a class="chip" href="/runs"{{if eq .State ""}} aria-current="true"{{end}}>All {{template "quantity" (quantity "runs.all" (index .Count "all") $.Numbers)}}</a><a class="chip" href="/runs?state=running"{{if eq .State "running"}} aria-current="true"{{end}}>Running {{template "quantity" (quantity "runs.running" (index .Count "running") $.Numbers)}}</a><a class="chip" href="/runs?state=ended"{{if eq .State "ended"}} aria-current="true"{{end}}>Ended {{template "quantity" (quantity "runs.ended" (index .Count "ended") $.Numbers)}}</a>{{if or (index .Count "lost") (eq .State "lost")}}<a class="chip" href="/runs?state=lost"{{if eq .State "lost"}} aria-current="true"{{end}}>Lost {{template "quantity" (quantity "runs.lost" (index .Count "lost") $.Numbers)}}</a>{{end}}</nav><div class="runs-filter-control summary-controls"><span class="soft" data-say>{{template "quantity" (quantity "runs.matches" .Matches $.Numbers)}} {{plural .Matches "run" "runs"}} · {{.PeriodLabel}}</span><a class="btn" data-filter-open href="{{.FilterURL}}">Filter</a></div>{{end}}{{end}}
{{define "r-runs-live"}}{{with .Data}}{{template "runrows" (runtab .Live .Now .V)}}{{end}}{{end}}
{{define "r-runs-table"}}{{with .Data}}{{template "runrows" (runtab .Runs .Now .V)}}{{end}}{{end}}
{{/* r-runs-foot: where this page sits among the runs that are not running, and the links to the next and the newest page; or, with no row at all, the empty state. */}}
{{define "r-runs-foot"}}{{with .Data}}{{if or .Live .Runs}}{{if or .Older .Before}}<nav class="panel-foot runs-pager" aria-label="Pages of runs"><span class="soft">{{if .Live}}{{template "quantity" (quantity "runs.page-running" (len .Live) $.Numbers)}} running, then {{end}}{{if .Runs}}runs {{template "quantity" (quantity "runs.page-from" .From $.Numbers)}}–{{template "quantity" (quantity "runs.page-to" .To $.Numbers)}} of the {{template "quantity" (quantity "runs.remaining" .Rest $.Numbers)}} {{if eq .State "ended"}}ended{{else if eq .State "lost"}}lost{{else}}not running{{end}}, newest first{{else}}{{template "quantity" (quantityZero "runs.remaining" "no other runs" $.Numbers)}}{{end}}</span><span class="row">{{if .Before}}<a class="link" href="{{runsQuery .State "" .Query .Period}}">Newest runs</a>{{end}}{{if .Older}}<a class="btn" href="{{runsQuery .State .Older .Query .Period}}">Older runs</a>{{end}}</span></nav>{{end}}
{{else}}<div class="empty">{{if .Filtered}}<h2>{{template "quantity" (quantityZero "runs.matches" "No runs match these filters" $.Numbers)}}</h2><a class="btn" href="/runs">Clear filters</a>{{else}}
  <div class="glyph">{{template "i" "i-activity"}}</div>
  <h3>{{template "quantity" (quantityZero "runs.all" "No runs here" $.Numbers)}}</h3>
  <p>Runs show up here</p>
  {{template "firstrun"}}{{end}}
</div>{{end}}{{end}}{{end}}

{{define "runs-filters"}}<form action="/runs" method="get" class="filter-fields">
<label class="field">Agent or run<input class="input" type="search" name="q" value="{{.Query}}" autocomplete="off" spellcheck="false" placeholder="Agent name…"></label>
<label class="field">State<select class="select" name="state"><option value="">All states</option><option value="running"{{if eq .State "running"}} selected{{end}}>Running</option><option value="ended"{{if eq .State "ended"}} selected{{end}}>Ended</option><option value="lost"{{if eq .State "lost"}} selected{{end}}>Lost</option></select></label>
<label class="field">Time frame<select class="select" name="period"><option value="">All time</option><option value="today"{{if eq .Period "today"}} selected{{end}}>Today</option><option value="24h"{{if eq .Period "24h"}} selected{{end}} data-number="shared.configuration">Last 24 hours</option><option value="7d"{{if eq .Period "7d"}} selected{{end}} data-number="shared.configuration">Last 7 days</option></select></label>
<button class="btn btn-primary" type="submit">Show runs</button><a class="btn btn-ghost" href="/runs">Clear filters</a>
<details><summary>More options</summary><div class="stack"><a class="btn" href="/compare">Compare two runs</a><a class="btn" href="/logs">Search and export logs</a></div></details>
</form>{{end}}
