{{/* SPDX-License-Identifier: Apache-2.0 */}}
{{/* rules-change: the Change rules form (rules_change.go). Every form names the contract by its ref and carries the base it was read at. */}}
{{define "content"}}<link rel="stylesheet" href="/static/rules.css"><link rel="stylesheet" href="/static/rules-change.css"><link rel="stylesheet" href="/static/builder.css"><script src="/static/builder.js" defer></script><script src="/static/lines.js" defer></script><div class="builder-page">{{$csrf := $.CSRF}}{{with .Data}}{{$d := .}}{{template "builderproblems" .Errors}}
{{if not .C}}
<div class="head"><div><nav class="crumbs" aria-label="Breadcrumb"><a class="link" href="/rules">Rules files</a><span aria-hidden="true">/</span><span>Change rules</span></nav>{{if $.Tour}}<h2>{{else}}<h1>{{end}}Change rules{{if $.Tour}}</h2>{{else}}</h1>{{end}}<p class="lede">Pick a contract file</p></div></div>
{{with .SelectionErr}}<section class="banner banner-warn" role="status">{{template "i" "i-triangle-alert"}}<div class="grow"><strong>Contract location unavailable</strong> {{.}}</div></section>{{end}}
{{if .Contracts}}<section class="panel phone-list">{{range .Contracts}}<a class="phone-row" href="/rules/change?c={{queryEsc .Ref}}"><span class="phone-who" data-number-exclude="editor.chooser-agent">{{.Agent}}</span><span class="phone-detail mono" title="{{.Path}}" data-number-exclude="editor.chooser-path">{{template "pwp" (pieces .Path)}}</span><span class="b b-neutral">{{if .Writable}}Editable{{else}}Read only{{end}}</span>{{if .Why}}<span class="phone-detail">{{.Why}}</span>{{end}}<span class="phone-when">{{if .LastAt.IsZero}}Not run yet{{else}}<time datetime="{{iso .LastAt}}" data-started="{{iso .LastAt}}" data-ck>{{ago .LastAt $d.Now}} ago</time>{{end}}</span></a>{{end}}</section>
{{else}}<section class="panel"><div class="empty"><div class="glyph">{{template "i" "i-shield"}}</div><h3>{{template "quantity" (quantityZero "contracts.contracts" "No contract to edit yet" $.Numbers)}}</h3><p>Make one with <a class="link" href="/rules/new">New rules file</a>; once it is written, its rules can be changed here.</p></div></section>{{end}}
{{else}}{{$c := .C}}
<div class="head"><div><nav class="crumbs" aria-label="Breadcrumb"><a class="link" href="/rules?c={{queryEsc $c.Ref}}">Rules</a><span aria-hidden="true">/</span><span>Change rules</span></nav>
{{if $.Tour}}<h2>{{else}}<h1>{{end}}Change rules{{if $.Tour}}</h2>{{else}}</h1>{{end}}<p class="object-name">{{$c.Agent}}</p>
<p class="lede rules-ctx">One change at a time, or several together · from the next run of <span class="code-i" data-number-exclude="editor.file">{{template "spv" (sp $c.Path "")}}</span>{{if $c.Live}}; a narrowing can also apply now to the {{template "quantity" (quantity "editor.running" (len $c.Live) $.Numbers)}} running {{plural (len $c.Live) "run" "runs"}}{{end}}.</p></div>
<div class="builder-head-actions"><a class="btn btn-primary" href="#builder-change-save">Check and save</a><details class="head-more"><summary>Actions</summary><div class="head-actions"><a class="btn" href="/rules?c={{queryEsc $c.Ref}}">{{template "i" "i-eye"}}Rules in force</a></div></details></div></div>

<details class="panel builder-context"><summary class="panel-head">Contract details</summary><div class="panel-body"><p>{{template "pwp" (pieces $c.Path)}}</p><p>{{template "quantity" (quantity "contracts.runs" $c.Runs $.Numbers)}} recorded {{plural $c.Runs "run" "runs"}}. {{template "quantity" (quantity "editor.running" (len $c.Live) $.Numbers)}} running now.</p><p>Changes apply from the next run. Narrowings can also apply now where offered.</p>{{if gt (len .Contracts) 1}}<details class="panel builder-picker"><summary class="panel-head">Choose another contract</summary><form class="frow rules-pick" action="/rules/change" method="get" aria-label="Choose the rules file"><label class="field rp-file">Rules file<select class="select" name="c">{{range .Contracts}}<option value="{{.Ref}}"{{if eq .Ref $c.Ref}} selected{{end}} data-number-exclude="editor.choice">{{.Agent}} · {{tail .Path 48}}{{if .Live}} · running{{end}}</option>{{end}}</select></label><button class="btn" type="submit">Open</button></form></details>{{end}}</div></details>


{{if .NotWritable}}<section class="banner banner-warn" role="status">{{template "i" "i-triangle-alert"}}<div class="grow"><strong>Not editable here</strong> {{.NotWritable}}<br>In a terminal: <span class="mono">{{cmd .Hint}}</span>.</div></section>
{{else}}


<details class="panel rules-raw rc-raw builder-edit" id="yaml"{{if and .Raw .Raw.Open}} open{{end}}><summary class="panel-head"><h2>Simple and Full editor</h2><span class="soft">edit the whole file</span></summary>
<div class="panel-body stack-sm">{{if not .CanRaw}}<p class="soft">{{.RawWhy}}</p>{{else}}{{$raw := .Raw}}

{{if .EnvHidden}}<details class="builder-env"><summary>Environment values stay hidden</summary><p class="soft rc-envnote">{{template "i" "i-key-round"}}Environment values (env.set) show as <span class="mono">(value hidden)</span>: saving puts each back · set values in a terminal</p></details>{{end}}
{{with $raw}}{{with .Err}}<section class="banner banner-danger" role="alert">{{template "i" "i-triangle-alert"}}<div class="grow">{{.}}</div></section>{{end}}
{{with .Plan}}{{if .Stale}}<section class="banner banner-warn" role="status">{{template "i" "i-triangle-alert"}}<div class="grow">Changed since you opened it. Saving is refused until you review this version.</div></section>{{end}}
{{if .Err}}<section class="banner banner-danger rc-diag" role="alert" aria-labelledby="h-diag">{{template "i" "i-triangle-alert"}}<div class="grow stack-sm"><h3 class="rp-h" id="h-diag">{{if .Nothing}}{{template "quantity" (quantityZero "editor.changes-zero" "Nothing to save" exactNumbers)}}{{else}}This text cannot be saved{{end}}</h3>
<ul class="rc-diags">{{range $raw.Diags}}<li>{{if .Profile}}<span class="rc-where"><strong>Profile {{.Profile}}</strong> · <span class="mono" title="The profile's file">{{.File}}</span> · line {{.FileLine}}</span>{{if ne .Text (printf "profile %s · %s · line %d" .Profile .File .FileLine)}} <span class="mono">{{.Text}}</span>{{end}}{{else}}{{if .Line}}<a class="link mono" href="#yl-{{.Line}}" data-goto-line="{{.Line}}" data-goto-for="yaml-text">line {{.Line}}</a> {{end}}{{if ne .Text (printf "the draft · line %d" .Line)}}<span class="mono">{{.Text}}</span>{{end}}{{end}}</li>{{end}}</ul>
{{if $raw.Lines}}<ol class="rc-lines" aria-label="The lines named above">{{range $raw.Lines}}{{if .Gap}}<li class="rc-gap" aria-hidden="true">…</li>{{else}}<li class="mono{{if .Bad}} rc-bad{{end}}" id="yl-{{.N}}"><span class="rc-n">{{.N}}</span><span class="rc-t">{{.Text}}</span></li>{{end}}{{end}}</ol>{{end}}</div></section>
{{else}}<section class="banner banner-ok" role="status">{{template "i" "i-check"}}<div class="grow stack-sm"><strong>It compiles.</strong> Changes below · save to write{{template "families" .Families}}<pre class="raw rc-diff" tabindex="0" aria-label="The file's change">{{.Diff}}</pre></div></section>{{template "hostwarn" .Unresolved}}{{end}}{{end}}{{end}}
<form class="stack-sm" id="builder-edit" data-page method="post" action="/rules/change?c={{queryEsc $c.Ref}}#yaml"><input type="hidden" name="csrf" value="{{$csrf}}"><input type="hidden" name="mode" value="raw"><input type="hidden" name="builder" value="1"><input type="hidden" name="current-view" value="{{$d.View}}">
<nav class="seg" aria-label="Contract view"><button class="btn" data-page formnovalidate name="view" value="simple"{{if eq $d.View "simple"}} aria-current="true"{{end}}>Simple</button><button class="btn" data-page formnovalidate name="view" value="full"{{if eq $d.View "full"}} aria-current="true"{{end}}>Full</button></nav><input type="hidden" name="c" value="{{$c.Ref}}"><input type="hidden" name="base" value="{{if and $raw $raw.Plan}}{{$raw.Plan.Base}}{{else}}{{$c.Base}}{{end}}">
{{if eq .View "simple"}}<textarea name="text" hidden data-number-exclude="editor.hidden-yaml">{{if $raw}}{{template "buildertextarea" $raw.Text}}{{else}}{{template "buildertextarea" $d.Text}}{{end}}</textarea><div class="phone-list builder-decisions">{{range .Decisions}}<div class="builder-decision"><p>{{.Sentence}}</p><fieldset class="kd"><legend class="sr">{{.Sentence}}</legend><label><input type="radio" name="choice-{{.ID}}" value="keep" checked>Keep</label><label><input type="radio" name="choice-{{.ID}}" value="drop">Drop</label></fieldset></div>{{end}}</div><details class="panel"><summary class="panel-head">YAML</summary><pre class="term" data-number-exclude="editor.yaml-preview">{{if $raw}}{{$raw.Text}}{{else}}{{$d.Text}}{{end}}</pre></details>{{else}}
<p class="builder-phone-note">This editor works best on a larger screen. Hidden environment values stay unchanged.</p><label class="lbl" for="yaml-text" data-number-exclude="editor.yaml-file">{{template "spv" (sp $c.Path "")}}</label>
<textarea class="input mono rc-text" id="yaml-text" name="text" aria-invalid="{{if and $raw $raw.Plan $raw.Plan.Err}}true{{else}}false{{end}}" aria-describedby="h-diag" rows="22" spellcheck="false" autocomplete="off" wrap="off" data-lines data-number-exclude="editor.yaml">
{{if $raw}}{{$raw.Text}}{{else}}{{$d.Text}}{{end}}</textarea>{{end}}
{{if and $raw $raw.Plan}}{{template "newlyallows" $raw.Plan.NewlyAllows}}{{template "comparisonreview" $raw.Plan.ComparisonReview}}{{end}}
{{$ok := and $raw $raw.Plan $raw.Plan.Ack (not $raw.Plan.Err)}}{{if $ok}}{{template "nowrows" $raw.Now}}<div class="rc-free"><label class="rc-ack"><input type="checkbox" name="ack" value="{{$raw.Plan.Ack}}" required> I checked this text · it applies from the next run</label></div>{{end}}
<div class="frow" id="builder-change-save"><button class="btn" type="submit" name="step" value="check" formnovalidate data-page>{{template "i" "i-check"}}Check</button>{{if $ok}}<button class="btn btn-primary" type="submit" name="step" value="save" data-page>Save the free edit</button>{{else}}<span class="soft">Check first</span>{{end}}</div>
</form>
{{template "builderglossary" .Fields}}{{end}}</div></details>
{{end}}
<details class="panel"><summary class="panel-head">Change individual rules</summary>{{template "lr" (index $.L "r-change")}}{{template "r-change" $}}</div></details>

<div class="cli-pair"><span class="lbl">{{template "i" "i-terminal"}}Check the file in a terminal</span><div class="cli"><code data-number-exclude="editor.compile-command">{{cmd .Hint}}</code></div></div>
{{end}}{{end}}</div>{{end}}
{{/* r-change is the lists and the history, a live region (the YAML editor is outside it, so a live update never touches its text). */}}
{{define "r-change"}}{{with .Data}}{{if and .C (not .NotWritable)}}{{$d := .}}{{$c := .C}}
{{with .ListsErr}}<section class="banner banner-warn" role="status">{{template "i" "i-triangle-alert"}}<div class="grow">The rules file's lists could not be read ({{.}}); fix it {{if $d.CanRaw}}in the YAML editor below or {{end}}in a terminal.</div></section>{{end}}
<div class="rc-grid">{{range .Groups}}{{$g := .}}<section class="panel rc-g" aria-labelledby="rc-{{.Key}}"><div class="panel-head"><h2 id="rc-{{.Key}}">{{template "i" .Icon}}{{.Title}} <span class="soft">{{.Lede}}</span></h2></div>
<div class="panel-body stack-sm">{{if .Entries}}<ul class="rc-entries">{{range .Entries}}<li><span class="mono rc-entry" title="{{.}}">{{template "pwp" (pieces (tilde .))}}</span><span class="rc-acts">{{if $g.Ask}}<form method="get" action="/rules/change/preview"><input type="hidden" name="c" value="{{$c.Ref}}"><input type="hidden" name="base" value="{{$c.Base}}"><input type="hidden" name="op" value="never"><input type="hidden" name="key" value="{{$g.Key}}"><input type="hidden" name="v" value="{{.}}"><button class="btn" type="submit" aria-label="Never allow {{.}}">{{template "i" "i-ban"}}Never allow</button></form>{{end}}<form method="get" action="/rules/change/preview"><input type="hidden" name="c" value="{{$c.Ref}}"><input type="hidden" name="base" value="{{$c.Base}}"><input type="hidden" name="op" value="remove"><input type="hidden" name="key" value="{{$g.Key}}"><input type="hidden" name="v" value="{{.}}"><button class="btn" type="submit" aria-label="Remove {{.}} from {{$g.Title}}">Remove</button></form></span></li>{{end}}</ul>{{else}}<p class="soft">{{if .Absent}}Not in this rules file.{{else}}{{template "quantity" (quantityZero "editor.entries-zero" "No entries." exactNumbers)}}{{end}}</p>{{end}}
<form class="rc-add" method="get" action="/rules/change/preview"><input type="hidden" name="c" value="{{$c.Ref}}"><input type="hidden" name="base" value="{{$c.Base}}"><input type="hidden" name="op" value="add"><input type="hidden" name="key" value="{{.Key}}">
<label class="sr" for="add-{{.Key}}">Add to {{.Title}}</label><input class="input mono" id="add-{{.Key}}" name="v" value="{{.Input}}" aria-invalid="{{if .Err}}true{{else}}false{{end}}" required maxlength="4096" autocomplete="off" spellcheck="false" placeholder="e.g. {{.Example}}" aria-describedby="hint-{{.Key}}" data-number-exclude-placeholder="editor.entry-example"><button class="btn" type="submit">Add</button>
<p class="rc-hint" id="hint-{{.Key}}" data-number-exclude="editor.entry-hint">{{.Hint}}{{with .Err}}<span class="err">{{.}}</span>{{end}}</p></form></div>
<div class="panel-foot"><span class="mono soft">{{.Key}}</span></div></section>{{end}}</div>

{{if .Several}}<details class="panel rc-several" id="several"{{if .SeveralOpen}} open{{end}}><summary class="panel-head"><h2 id="h-several">{{template "i" "i-scroll-text"}}Several changes at once <span class="soft">checked and saved together</span></h2></summary>
<form class="panel-body stack-sm" method="post" action="/rules/change/preview" aria-labelledby="h-several"><input type="hidden" name="csrf" value="{{$.CSRF}}"><input type="hidden" name="c" value="{{$c.Ref}}"><input type="hidden" name="base" value="{{$c.Base}}"><input type="hidden" name="batch" value="1">
<p class="soft rc-hint">Fill the rows you need and leave the others blank. The changes are checked together and saved together. If a change cannot be made, the file stays as it was, and Undo takes them back together.</p>
{{range .Several}}{{if eq .N 5}}<details class="rc-more"{{if $d.SeveralMore}} open{{end}}><summary>More rows</summary>{{end}}<div class="rc-sev-row"><span class="rc-sev-n" aria-hidden="true" data-number-exclude="editor.several-row-1">{{.N}}</span><label class="sr" for="sev-op-{{.N}}" data-number-exclude="editor.several-row-2">Change {{.N}}: action</label><select class="select" id="sev-op-{{.N}}" name="op"><option value="add"{{if eq .Op "add"}} selected{{end}}>Add</option><option value="remove"{{if eq .Op "remove"}} selected{{end}}>Remove</option><option value="never"{{if eq .Op "never"}} selected{{end}}>Never allow</option></select>
<label class="sr" for="sev-key-{{.N}}" data-number-exclude="editor.several-row-3">Change {{.N}}: list</label><select class="select" id="sev-key-{{.N}}" name="key">{{$k := .Key}}{{range $d.Groups}}<option value="{{.Key}}"{{if eq .Key $k}} selected{{end}}>{{.Title}}</option>{{end}}</select>
<label class="sr" for="sev-v-{{.N}}" data-number-exclude="editor.several-row-4">Change {{.N}}: entry</label><input class="input mono" id="sev-v-{{.N}}" name="v" value="{{.Entry}}" maxlength="4096" autocomplete="off" spellcheck="false" placeholder="entry, such as ./docs/"></div>{{if eq .N 16}}</details>{{end}}{{end}}
<div class="frow"><button class="btn btn-primary" type="submit">{{template "i" "i-check"}}Check the changes</button></div></form></details>
{{end}}
<section class="panel rc-history" aria-labelledby="h-hist"><div class="panel-head"><h2 id="h-hist">{{template "i" "i-scroll-text"}}History <span class="soft">Newest first</span></h2></div><div class="panel-body">
{{with .HistoryErr}}<p class="soft">{{.}}</p>{{else}}{{template "history" .Hist}}{{end}}</div></section>
{{end}}{{end}}{{end}}
