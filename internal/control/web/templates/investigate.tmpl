{{/* SPDX-License-Identifier: Apache-2.0 */}}
{{/* Investigate: one detection in four parts, always in this order: What, How it got there, What else, What now
     (investigate.go). Labels, not sentences; the next detection at the same severity is one click away. */}}
{{define "content"}}<link rel="stylesheet" href="/static/evidence.css">{{with .Data}}{{$numbers:=.Numbers}}{{$lists:=.ListNumbers}}{{$d := .D}}
<nav class="crumbs" aria-label="Breadcrumb"><a href="/detections">Detections</a> › <a href="/detections?sev={{lower $d.Severity.String}}">{{$d.Severity}}</a></nav>
<div class="head"><div>{{if $.Tour}}<h2>{{else}}<h1>{{end}}What was noticed?{{if $.Tour}}</h2>{{else}}</h1>{{end}}{{with .Kind}}<p class="lede">{{.}}</p>{{end}}</div>
<details class="head-more"><summary>Actions</summary><div class="head-actions"><span class="soft iv-pos">{{template "quantity" (quantity "investigate.position" (.Pos) $numbers)}} of {{template "quantity" (quantity "investigate.of-severity" (.OfSev) $lists)}} {{$d.Severity}}</span><a class="btn" href="/runs/{{pathEsc $d.Run}}/lines/{{$d.Seq}}?a=allow#act-check" title="Preview the contract change first">{{template "i" "i-check"}}Allow from now on</a><a class="btn btn-primary" data-review="{{$d.Run}}-{{$d.Seq}}" href="{{with .Next}}/runs/{{pathEsc .Run}}/investigate/{{.FirstSeq}}{{else}}/detections?sev={{lower $d.Severity.String}}{{end}}">{{template "i" "i-shield"}}Keep refused{{if .Next}} · Next{{end}}</a></div></details></div>
<script src="/static/review.js" defer></script>

<section class="panel" aria-labelledby="h-what"><div class="panel-head"><h2 id="h-what">What</h2></div>
<div class="panel-body iv-target"><p>{{$d.Verb}}</p><p class="ut ut-box">{{mask $d.Subject}}</p></div><div class="iv-summary"><span class="b b-refused">{{template "i" "i-ban"}}Refused</span><span class="b sev-{{$d.Severity}}">{{$d.Severity}}</span><time class="phone-when" datetime="{{iso $d.Last}}" data-number-exclude="investigate.last-clock">{{when $d.Last $.Now}}</time><p data-number-exclude="investigate.agent-1">{{$d.Agent}}</p></div><details class="iv-facts-detail"><summary>Detection details</summary><dl class="iv-facts panel-body">
<dt>Result</dt><dd><strong>Refused</strong>{{if gt $d.Count 1}} · {{template "quantity" (quantity "investigate.times" ($d.Count) $numbers)}} times{{end}}{{if $d.Hosts}} · <span title="{{mask (someOf $d.Targets 24)}}">{{template "quantity" (quantity "investigate.addresses" ($d.Hosts) $numbers)}} addresses</span>{{end}}{{if gt (len $d.Ports) 1}} · {{template "quantity" (quantity "investigate.ports" (len $d.Ports) $numbers)}} ports{{end}}</dd>
{{if gt (len $d.Ports) 1}}<dt>Ports</dt><dd><span class="mono" data-number-exclude="investigate.port-list">{{portSpans $d.Ports 200}}</span> · <a class="link" href="{{logsByTarget $d}}">Each in Logs</a></dd>{{end}}
<dt>Rule</dt><dd>{{$d.Rule}}{{with .Policy}} · <a class="link" href="/rules?run={{pathEsc $d.Run}}">{{.}}</a>{{end}}</dd>
<dt>Channel</dt><dd>{{$d.Channel}}</dd>
<dt>Severity</dt><dd><span class="sev sev-{{$d.Severity}}">{{$d.Severity}}</span> · <a class="link" href="/severity?ch={{$d.Channel}}&amp;match={{$d.Match}}">Change</a></dd>
<dt>Agent</dt><dd data-number-exclude-text="investigate.agent-project">{{$d.Agent}} · <span title="{{$d.Project}}">{{$d.Project}}</span></dd>
<dt>When</dt><dd><time datetime="{{iso $d.First}}" title="{{stamp $d.First}}" data-number-exclude="investigate.first-clock">{{stamp $d.First}}</time>{{if gt $d.Count 1}} to <time datetime="{{iso $d.Last}}" title="{{stamp $d.Last}}" data-number-exclude="investigate.last-full-clock">{{clock $d.Last}}</time>{{end}}</dd>
{{if or $d.Secret $d.NearSecret}}<dt>Flags</dt><dd>{{if $d.Secret}}<span class="dt-tag">Secret</span>{{end}}{{if $d.NearSecret}}<span data-number-title="shared.policy" class="dt-tag" title="Within 5 seconds of a secret read">After a secret read</span>{{end}}</dd>{{end}}
</dl></details></section>

<details class="panel iv-question"><summary>How did it get there?</summary><section aria-labelledby="h-how"><div class="panel-head"><h2 id="h-how">How it got there</h2></div>
<div class="panel-body">{{if .Chain}}<ol class="iv-chain">{{range .Chain}}<li title="{{if .ArgvMasked}}{{.ArgvMasked}}{{else}}{{.Words}}{{end}}">{{if .Launcher}}tego{{else if .Unrecorded}}pid {{.PID}}{{else}}{{.Name}}{{end}}</li>{{end}}<li class="iv-end"><span class="sev sev-{{$d.Severity}}">{{$d.Verb}}</span> <span class="ut">{{mask $d.Subject}}</span></li></ol>
{{with .Argv}}<p class="iv-argv mono" title="Command line">{{.}}</p>{{end}}
{{else}}<p class="soft">Not recorded</p>{{end}}</div></section>

</details><details class="panel iv-question"><summary>What else happened?</summary><section aria-labelledby="h-else"><div class="panel-head"><h2 id="h-else">What else</h2><span class="soft">same run · within <span data-number="investigate.link-window">10</span> s</span></div>
{{if .Linked}}<ul class="iv-linked phone-list">{{range .Linked}}<li data-k="{{.Run}}-{{.FirstSeq}}"><a class="phone-row" href="/runs/{{pathEsc .Run}}/investigate/{{.FirstSeq}}"><span class="phone-who" data-number-exclude="investigate.linked-target">{{.Verb}} {{mask .Subject}}</span><span class="b sev-{{.Severity}}">{{.Severity}}</span><time class="phone-when" datetime="{{iso .First}}" data-number-exclude="investigate.linked-clock">{{clock .First}}</time></a></li>{{end}}</ul>{{else}}<p class="panel-body soft">{{template "quantity" (quantityZero "investigate.linked-zero" "Nothing else" $numbers)}}</p>{{end}}</section>

</details><section class="panel" aria-labelledby="h-now"><div class="panel-head"><h2 id="h-now">What now</h2></div>
<div class="panel-body row iv-now">
<a class="btn" href="/runs/{{pathEsc $d.Run}}/lines/{{$d.Seq}}#act">{{template "i" "i-shield"}}All contract options</a>
<a class="btn" href="{{logsFor $d}}">{{template "i" "i-scroll-text"}}Logs</a>
<a class="btn" href="/runs/{{pathEsc $d.Run}}">{{template "i" "i-activity"}}Run</a>
</div></section>
{{end}}{{end}}
