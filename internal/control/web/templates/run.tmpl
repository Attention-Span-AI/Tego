{{/* SPDX-License-Identifier: Apache-2.0 */}}
{{/* The run page is six live regions (regions.go) around the timeline's rows, which add themselves while the run is live (live.js, /runs/<id>/rows). */}}
{{define "content"}}{{template "lr" (index $.L "r-run-top")}}{{template "r-run-top" $}}</div>{{template "lr" (index $.L "r-run-live")}}{{template "r-run-live" $}}</div>{{template "lr" (index $.L "r-run-hl")}}{{template "r-run-hl" $}}</div>
{{with .Data}}{{$r := .Run}}{{$live := eq $r.State "running"}}{{if eq .Tab "timeline"}}{{$follow := and $live (eq .Before 0)}}
<section class="panel" aria-labelledby="h-tl">{{template "lr" (index $.L "r-tl-head")}}{{template "r-tl-head" $}}</div>
<div id="tl-rows"{{if $follow}} data-rows="/runs/{{pathEsc $r.ID}}/rows?{{if .Verdict}}verdict={{queryEsc .Verdict}}&amp;{{end}}after=" data-after="{{.After}}"{{end}}>{{template "tlrows" (tlv (tl .Lines $live (ne $r.Contract "") .Changes) .Story (eq $r.Tier "observe") .Home)}}{{if not .Lines}}<div class="panel-body tl-empty"><p class="soft">No lines.</p></div>{{end}}</div>
{{template "lr" (index $.L "r-tl-foot")}}{{template "r-tl-foot" $}}</div>
</section>
{{else}}{{template "lr" (index $.L "r-run-tab")}}{{template "r-run-tab" $}}</div>{{end}}{{end}}{{end}}
{{define "r-run-top"}}{{with .Data}}{{$r := .Run}}{{$live := eq $r.State "running"}}
<div class="head"><div><nav class="crumbs" aria-label="Breadcrumb"><a href="/runs">Runs</a></nav><h1>{{if $r.Agent}}{{$r.Agent}}{{else}}Run{{end}}</h1><div class="sub-h1">{{template "state" $r}}{{if .Adjustable}}<a class="b b-asked b-mode" href="/rules?run={{queryEsc $r.ID}}#live-fence" title="Adjustable (live both ways): its fence entries can be lifted and restored while it runs; Tego's live layer, not the kernel, enforces them">Adjustable</a>{{end}}{{template "origin" $r}}<span class="mono">{{$r.ID}}</span>{{template "chainpill" .Chain}}</div>
<p class="run-who"><b title="Started by">{{if $r.User}}{{$r.User}}{{else}}Unknown user{{end}}</b> · <time datetime="{{iso $r.Start}}" title="{{stamp $r.Start}}">{{clock $r.Start}} {{tz}}</time> · {{if $r.Contract}}<a class="link" href="/rules?run={{queryEsc $r.ID}}" title="{{$r.Contract}}{{if $r.ContractHash}} · sha256 {{$r.ContractHash}}{{end}}">Contract <span class="mono">{{template "pwp" (pieces (tail $r.Contract 36))}}</span></a>{{else}}<span class="watch-only">Watched only</span> · <a class="link" href="{{if .CanSetUp}}/rules/new?mode=run&amp;from={{queryEsc $r.ID}}{{else}}/runs/{{pathEsc $r.ID}}/least-privilege{{end}}">Make a contract</a>{{end}}</p></div><div class="head-actions"><a class="btn" href="/compare?a={{queryEsc $r.ID}}">{{template "i" "i-activity"}}Compare</a>{{if .Stopping}}<span class="b b-stopping" role="status">{{template "i" "i-square"}}Stopping…</span>{{else if eq $r.State "running"}}{{if .Live.Observe}}<a class="btn" href="#block" title="This run is only watched: a mark is recorded on each matching line, and nothing is refused">{{template "i" "i-ban"}}Mark (recorded only)</a>{{else}}<a class="btn" href="#block">{{template "i" "i-ban"}}Block now</a>{{end}}{{$ask := .Live.Pause}}{{with .Live.Facts}}{{if $ask.Takes}}{{if and $ask.Waiting $ask.Paused}}<form class="head-form" method="post" action="/runs/{{pathEsc $r.ID}}/resume"><input type="hidden" name="csrf" value="{{$.CSRF}}"><button class="btn" type="submit" title="Withdraw the pause the run has not confirmed yet">{{template "i" "i-play"}}Cancel pause</button></form>{{else if .Paused}}<form class="head-form" method="post" action="/runs/{{pathEsc $r.ID}}/resume"><input type="hidden" name="csrf" value="{{$.CSRF}}"><button class="btn btn-primary" type="submit" title="Let the agent carry on from where it stood">{{template "i" "i-play"}}Resume</button></form>{{else if eq .Pause "pause-failed"}}<form class="head-form" method="post" action="/runs/{{pathEsc $r.ID}}/resume"><input type="hidden" name="csrf" value="{{$.CSRF}}"><button class="btn" type="submit" title="The agent is still running; this withdraws the pause">{{template "i" "i-play"}}Withdraw pause</button></form>{{else if $r.Pending}}<span class="head-form pause-off" title="Answer its waiting request first; then Pause freezes it. A request that waits cannot be frozen."><button class="btn" type="button" disabled aria-describedby="pause-why">{{template "i" "i-pause"}}Pause</button><span class="soft pause-why" id="pause-why">Answer the waiting request first</span></span>{{else}}<form class="head-form" method="post" action="/runs/{{pathEsc $r.ID}}/pause"><input type="hidden" name="csrf" value="{{$.CSRF}}"><button class="btn" type="submit" title="Freeze the agent where it stands, within a second; Resume lets it carry on">{{template "i" "i-pause"}}Pause</button></form>{{end}}{{end}}{{end}}<span class="act-sep" aria-hidden="true"></span><a class="btn btn-danger" href="/runs/{{pathEsc $r.ID}}/stop">{{template "i" "i-square"}}Stop run</a>{{end}}</div></div>
{{template "verdict" .}}

{{if $live}}{{$ask := .Live.Pause}}{{with .Live.Facts}}{{if $ask.Takes}}{{if .Paused}}<section class="banner banner-paused" role="status">{{template "i" "i-pause"}}<div class="grow"><strong>Paused by {{pausedBy .PausedBy}} at <time datetime="{{iso .PausedAt}}" title="{{stamp .PausedAt}}">{{clock .PausedAt}} {{tz}}</time>.</strong> {{if eq .Pause "resume-failed"}}The resume did not take, so the agent stays frozen; Tego keeps trying, and Stop run still ends it (within the stop grace, 10 s by default).{{else}}The agent is frozen where it stood and does nothing until you resume it (line #{{.PauseSeq}}). Stop run still ends it (within the stop grace, 10 s by default).{{end}}{{if and $ask.Waiting (not $ask.Paused)}} Resume asked at <time datetime="{{iso $ask.At}}" title="{{stamp $ask.At}}">{{clock $ask.At}}</time>; waiting for the run to confirm it.{{end}}</div></section>{{else if and $ask.Waiting $ask.Paused}}<section class="banner banner-paused" role="status">{{template "i" "i-pause"}}<div class="grow"><strong>Pause asked at <time datetime="{{iso $ask.At}}" title="{{stamp $ask.At}}">{{clock $ask.At}} {{tz}}</time>; waiting for the run to confirm it.</strong> This usually takes about a second. If it does not come, this run's launcher does not read pauses, and Cancel pause withdraws the request.</div></section>{{else if eq .Pause "pause-failed"}}<section class="banner banner-warn" role="status">{{template "i" "i-triangle-alert"}}<div class="grow"><strong>The pause did not take{{if $r.Pending}} yet{{end}}.</strong> {{if $r.Pending}}The agent waits on a request, and a request that waits cannot be frozen, so it keeps running (line #{{.PauseSeq}}). Answer the request and Tego freezes the run then; Withdraw pause takes the request back.{{else}}Tego could not freeze this run, so it keeps running (line #{{.PauseSeq}}). Tego keeps trying, at most 30 s apart, until it takes or you stop the run; Withdraw pause takes the request back.{{end}}</div></section>{{end}}{{end}}{{end}}{{end}}
{{with .Live.LauncherUnknown}}<section class="banner banner-warn" role="status">{{template "i" "i-triangle-alert"}}<div class="grow"><strong>Launcher not confirmed.</strong> This run's lock is held, but the launcher its lock line names could not be confirmed ({{.}}). It is shown as running, and Tego never ends it on that. To fix: {{unknownRecovery}}.</div></section>
{{end}}{{if lostPaused $r}}<section class="banner banner-warn" role="status">{{template "i" "i-triangle-alert"}}<div class="grow"><strong>Lost, last recorded paused.</strong> This run's launcher died, and the last state it recorded was paused, with no resume after it. Nothing decides or records what it does any more, and Tego never thaws such a run. Whether its processes are still frozen is not known here (a stop thaws a run before it signals, and lines the launcher had not written are lost): <span class="mono">tego status {{$r.ID}}</span> reads its scope, and <span class="mono">tego stop {{$r.ID}}</span> ends what is left and closes the record.</div></section>
{{end}}{{if and $r.Pending $live}}<div class="stack-lg run-asks">{{range $r.Pending}}
{{template "askcard" (card . $.CSRF false (index $.AskMeta $r.ID) $.Data.Now)}}{{end}}</div>{{else if and $r.Pending (eq $r.State "lost")}}<section class="banner banner-warn" role="status">{{template "i" "i-triangle-alert"}}<div class="grow">This run was lost with {{len $r.Pending}} {{plural (len $r.Pending) "request" "requests"}} nobody answered. Nothing holds {{if eq (len $r.Pending) 1}}it{{else}}them{{end}} any more, so there is nothing to answer.</div></section>{{end}}
{{with .Chain}}{{if .Broken}}<div class="banner banner-danger chain-alert" role="alert">{{template "i" "i-triangle-alert"}}<div class="grow"><strong>{{if .AtLine}}Record broken at #{{.Line}}{{else if .Lines}}Record broken after #{{.Line}}{{else}}Record broken{{end}}</strong> · {{.Reason}} · {{if .AtLine}}not trusted from #{{.Line}}{{else}}edited{{end}} · <span class="mono">tego events {{.Run}} --verify</span></div></div>{{end}}{{end}}
{{end}}{{end}}
{{/* r-run-live: the Block now panel, its own live region so each block's chip (livechip.go) moves from "Waiting for the run…" to "In force since line #N" as the launcher's gap line arrives. With no block (and nothing prefilled) it is one folded line, "Block now ▸": a <details> whose body holds the fragment #block, so the header's Block now link opens it in one click; with a block it is the full panel, another element, so a live update that adds or removes the last block swaps one for the other (live.js keeps a <details>'s open state only on the same element). static/twin.js writes the form's kind, value and time limit into its terminal twin. */}}
{{define "r-run-live"}}{{with .Data}}{{$r := .Run}}{{if eq $r.State "running"}}{{$obs := .Live.Observe}}<link rel="stylesheet" href="/static/live.css"><script src="/static/twin.js" defer></script>
{{if or .Blocks .BlockKind .BlockErr}}<section class="panel live-panel" id="block" aria-labelledby="h-block"><div class="panel-head"><h2 id="h-block">{{if $obs}}Mark now (recorded only){{else}}Block now{{end}}</h2><span class="soft">{{template "blockwhy" $obs}}</span></div>
{{template "blockbody" $}}</section>{{else}}<details class="panel live-panel live-fold" id="block-fold"><summary class="live-fold-s"><h2 class="live-fold-h" id="h-block">{{template "i" "i-ban"}}{{if $obs}}Mark now (recorded only){{else}}Block now{{end}}<span class="live-fold-c" aria-hidden="true"></span></h2><span class="soft live-fold-n">{{if $obs}}No marks on this run{{else}}No live blocks on this run{{end}}</span></summary>
<div class="live-fold-b" id="block"><p class="soft">{{template "blockwhy" $obs}}</p>{{template "blockbody" $}}</div></details>{{end}}{{end}}{{end}}{{end}}
{{/* blockwhy is what a block (a mark, on a watched run) does, under the panel's name. */}}
{{define "blockwhy"}}{{if .}}This run is only watched, so a mark refuses nothing: each matching action is recorded, and the agent goes on. To refuse, run the agent with <span class="mono">tego run</span>.{{else}}Applies to the next action; the contract file is unchanged. Remove allows again only what the contract allows.{{end}}{{end}}
{{/* blockbody is the Block now form, the run's live blocks with their state and Remove (each value shortened as the page writes paths, ~/ for the run's home, the full value in its title), and the terminal twins: the first names the form (data-twin) and its command's fixed words (data-cmd), and static/twin.js writes what the form holds in place of its placeholders. */}}
{{define "blockbody"}}{{with .Data}}{{$r := .Run}}{{$obs := .Live.Observe}}<div class="panel-body stack-lg"><form class="row" id="block-form" method="post" action="/runs/{{pathEsc $r.ID}}/block"><input type="hidden" name="csrf" value="{{$.CSRF}}">
<label class="field">Kind<select class="select" name="kind">{{$bk := .BlockKind}}{{range .BlockKinds}}<option value="{{.}}"{{if eq (print .) $bk}} selected{{end}}>{{kindWord .}}</option>{{end}}</select></label>
<label class="field grow">Program, destination, or file or folder<input class="input" type="text" name="value" required maxlength="4096" value="{{.BlockValue}}" placeholder="curl, example.com:443, 127.0.0.1:8080, /home/you/.aws/"></label><div class="lfor">{{template "forselect" "run"}}</div>
{{if $obs}}<button class="btn" type="submit">{{template "i" "i-ban"}}Mark (recorded only)</button>{{else}}<button class="btn btn-danger" type="submit">{{template "i" "i-ban"}}Block now</button>{{end}}</form>
{{if .BlockErr}}<p class="soft">The run's live blocks could not be read: {{.BlockErr}}.</p>{{end}}
{{if .Blocks}}<ul class="list live-list">{{range .Blocks}}{{$c := blockChip . $.Data.Live $.Data.Now}}<li data-k="{{.Kind}}:{{.Value}}">{{template "i" "i-ban"}}<div class="grow stack-sm"><span title="{{.Rule}}">{{$w := blockLine . $r $.Data.Home}}{{if $obs}}{{$w = markLine . $r $.Data.Home}}{{end}}{{$w.Kind}} {{if eq $w.Value $w.Full}}{{$w.Value}}{{else}}<span title="{{$w.Full}}">{{$w.Value}}</span>{{end}}{{$w.Rest}}{{with $c.Ends}} <span class="soft lf-ends">{{.}}</span>{{end}}</span>
<span class="live-st"><span class="b {{$c.Class}} lchip" data-state="{{$c.State}}" title="{{$c.Sentence}}">{{$c.Label}}</span><span class="soft live-note">{{$c.Note}}</span></span></div>
{{if not $c.Ended}}<form method="post" action="/runs/{{pathEsc $r.ID}}/unblock"><input type="hidden" name="csrf" value="{{$.CSRF}}"><input type="hidden" name="kind" value="{{.Kind}}"><input type="hidden" name="value" value="{{.Value}}"><button class="btn" type="submit">Remove</button></form>{{end}}</li>{{end}}</ul>
{{end}}
<div class="cli-pair"><span class="lbl">Same in a terminal</span><div class="cli cli-wrap"><code data-twin="block-form" data-cmd="tego block {{$r.ID}}">tego block {{$r.ID}} &lt;exec|net|path&gt; &lt;value&gt;</code></div><div class="cli cli-wrap"><code>tego block --list {{$r.ID}}</code></div></div></div>{{end}}{{end}}
{{define "r-run-hl"}}{{with .Data}}{{$r := .Run}}{{$live := eq $r.State "running"}}
{{template "highlights" .}}
<details class="panel run-facts"><summary><span class="title">Run details</span><span class="soft">{{tier $r.Tier}}{{if $r.Contract}} · <span class="mono">{{template "pwp" (pieces (tail $r.Contract 40))}}</span>{{end}} · started <time datetime="{{iso $r.Start}}">{{clock $r.Start}} {{tz}}</time> · {{template "ck" (ckOf $r .Now)}}</span></summary>
<dl class="kv-cols">
  <div><dt>Contract</dt><dd>{{if $r.Contract}}<span class="mono">{{template "pwp" (pieces $r.Contract)}}</span>{{else}}<span class="muted">not recorded</span>{{end}}</dd></div>
  <div><dt>Protection</dt><dd>{{tier $r.Tier}}</dd></div>
  <div><dt>Started as</dt><dd>{{$r.OriginWord}} <span class="muted">· {{if eq $r.Origin "interactive"}}in a terminal a person types to{{else if eq $r.Origin "deployed"}}a supervised instance of {{$r.Deployment}}{{else if eq $r.Origin "background"}}with no terminal on its input{{else}}the record does not say{{end}}</span></dd></div>
  <div><dt>Started by</dt><dd>{{if $r.User}}{{$r.User}} <span class="muted">(uid {{$r.UID}})</span>{{else}}<span class="muted">not recorded</span>{{end}}</dd></div>
  <div><dt>Machine</dt><dd>{{if $r.Host}}{{$r.Host}}{{if $r.Kernel}} <span class="muted">· Linux {{$r.Kernel}}</span>{{end}}{{else}}<span class="muted">not recorded</span>{{end}}</dd></div>
  <div><dt>Rules version</dt><dd>{{if $r.ContractHash}}<span class="mono" title="sha256 of the contract this run enforced: {{$r.ContractHash}}">{{cut $r.ContractHash 12}}</span> <a class="link" href="/rules?run={{queryEsc $r.ID}}">see the rules</a>{{else}}<span class="muted">not recorded</span>{{end}}</dd></div>
  <div><dt>Agent and recording</dt><dd>{{if $r.Harness}}{{$r.Harness}}{{else}}any program{{end}} <span class="muted">· model traffic capture {{if $r.Capture}}{{$r.Capture}}{{else}}off{{end}}</span></dd></div>
  <div><dt>Tego build</dt><dd class="mono">{{if $r.TegoVersion}}{{$r.TegoVersion}}{{else}}—{{end}}</dd></div>
  <div><dt>Command</dt><dd class="mono">{{cut $r.Command 80}}</dd></div>
  <div><dt>Started</dt><dd><time datetime="{{iso $r.Start}}" title="{{stamp $r.Start}}">{{clock $r.Start}} {{tz}}</time> · {{template "ck" (ckOf $r .Now)}}{{if eq $r.State "running"}} so far{{end}}</dd></div>
  <div><dt>Ended</dt><dd>{{if $r.Ended}}<time datetime="{{iso $r.End}}" title="{{stamp $r.End}}">{{clock $r.End}} {{tz}}</time> · {{endWord $r}}{{with endWhy $r}} <span class="muted">· {{.}}</span>{{end}}{{else if eq $r.State "running"}}Still running{{else}}No run_end line: the run was lost{{end}}</dd></div>
  <div><dt>Refused</dt><dd>{{if $r.Refusals}}<a class="n-link" href="/runs/{{pathEsc $r.ID}}/refusals">{{$r.Refusals}} {{plural $r.Refusals "action" "actions"}}</a>{{else}}None{{end}}</dd></div>
  <div><dt>Asks</dt><dd>{{$r.Asks}}{{if and $r.Pending $live}} · <a class="link" href="/approvals">{{len $r.Pending}} waiting</a>{{else if $r.Pending}} · {{len $r.Pending}} never answered (the run was lost){{end}}</dd></div>
  <div><dt>In the terminal</dt><dd class="mono">tego events {{$r.ID}} --verify</dd></div>
</dl></details>
<nav class="tabs" aria-label="Run sections"><a href="/runs/{{pathEsc $r.ID}}"{{if eq .Tab "timeline"}} aria-current="page"{{end}}>Timeline <span class="n">{{.Rows}}</span></a><a href="/runs/{{pathEsc $r.ID}}/refusals"{{if eq .Tab "refusals"}} aria-current="page"{{end}}>Refused <span class="n">{{$r.Refusals}}</span></a><a href="/runs/{{pathEsc $r.ID}}/processes"{{if eq .Tab "processes"}} aria-current="page"{{end}}>Processes</a><a href="/runs/{{pathEsc $r.ID}}/receipt"{{if eq .Tab "receipt"}} aria-current="page"{{end}}>Receipt</a><a href="/runs/{{pathEsc $r.ID}}/least-privilege"{{if eq .Tab "least-privilege"}} aria-current="page"{{end}} title="The smallest contract change this run suggests">Tighten</a><a href="/runs/{{pathEsc $r.ID}}/unused"{{if eq .Tab "unused"}} aria-current="page"{{end}} title="Rules this run never used">Unused</a></nav>
{{end}}{{end}}
{{define "r-tl-head"}}{{with .Data}}{{if eq .Tab "timeline"}}{{$r := .Run}}{{$live := eq $r.State "running"}}{{$follow := and $live (eq .Before 0)}}<div class="panel-head"><h2 id="h-tl">Timeline</h2>{{if eq $r.Tier "observe"}}<span class="soft tl-watch" title="tego watch records and refuses nothing">Watched only, not enforced</span>{{end}}<div class="row">{{if $follow}}<span class="live"><span class="dot" aria-hidden="true"></span>Live</span>{{else if .Before}}<a class="btn" href="/runs/{{pathEsc $r.ID}}{{if .Verdict}}?verdict={{queryEsc .Verdict}}{{end}}">Newest rows</a>{{end}}</div></div>
<div class="panel-body row chips-row"><nav class="chips" aria-label="Show"><a class="chip" href="/runs/{{pathEsc $r.ID}}"{{if eq .Verdict ""}} aria-current="true"{{end}}>All {{.Rows}}</a>{{if eq $r.Tier "observe"}}<a class="chip" href="/runs/{{pathEsc $r.ID}}?verdict=leak"{{if eq .Verdict "leak"}} aria-current="true"{{end}} title="The secret reads and the sends the verdict above names">Secrets and sends</a>{{else}}<a class="chip" href="/runs/{{pathEsc $r.ID}}?verdict=refused"{{if eq .Verdict "refused"}} aria-current="true"{{end}}>Refused only</a>{{end}}<a class="chip" href="/logs?run={{queryEsc $r.ID}}">Open in logs</a></nav></div>{{end}}{{end}}{{end}}
{{define "r-tl-foot"}}{{with .Data}}{{if eq .Tab "timeline"}}{{$r := .Run}}{{$live := eq $r.State "running"}}{{$follow := and $live (eq .Before 0)}}<div class="panel-foot"><span>{{if .Before}}{{.Shown}} older {{plural .Shown "row" "rows"}}{{else if gt .Total .Shown}}The newest {{.Shown}} of {{.Total}} rows{{else}}{{.Shown}} {{plural .Shown "row" "rows"}}{{end}} (identical refusals folded), newest first</span>{{if or .Older $follow}}<a class="btn" id="tl-older" href="/runs/{{pathEsc $r.ID}}?{{if .Verdict}}verdict={{queryEsc .Verdict}}&amp;{{end}}before={{.Older}}"{{if not .Older}} hidden{{end}}>Older rows</a>{{end}}</div>{{end}}{{end}}{{end}}
{{/* rfnone is the Refusals tab's empty state, in the receipt's own sentence for the run (receipt.RefusedSentence, through
     ledgerview.ReceiptRefusedWords): "Nothing was refused." only when a refused read would have left a line. */}}
{{define "rfnone"}}<div class="empty"><div class="glyph">{{if .ReceiptReadsUnrecorded}}{{template "i" "i-search"}}{{else}}{{template "i" "i-check"}}{{end}}</div><h3>{{noneRefused .}}</h3></div>{{end}}
{{define "r-run-tab"}}{{with .Data}}{{$r := .Run}}{{$live := eq $r.State "running"}}{{if eq .Tab "timeline"}}{{else if eq .Tab "processes"}}{{template "procs" .Procs}}{{else if eq .Tab "refusals"}}
<section class="panel" aria-labelledby="h-rf"><div class="panel-head"><h2 id="h-rf">Refusals</h2><nav class="chips" aria-label="Refusals view"><a class="chip" href="/runs/{{pathEsc $r.ID}}/refusals"{{if ne .View "lines"}} aria-current="true"{{end}}>Grouped</a><a class="chip" href="/runs/{{pathEsc $r.ID}}/refusals?view=lines"{{if eq .View "lines"}} aria-current="true"{{end}}>Every line</a></nav></div>
{{if ne .View "lines"}}{{with .Signal}}{{if .Groups}}
<p class="panel-body rf-sum">{{template "sevcounts" .}}</p>
{{$sig := .}}{{range $sev := sevLevels}}{{$n := sevGroups $sig.Groups $sev}}{{if $n}}{{if eq $sev.String "Low"}}<details class="rf-sev"><summary>Low ({{len $n}})</summary>{{else}}<h3 class="rf-sev-h">{{$sev}} ({{len $n}})</h3>{{end}}<ul class="list refusals">{{range $n}}{{template "rgroup" .}}{{end}}</ul>{{if eq $sev.String "Low"}}</details>{{end}}{{end}}{{end}}
{{if .Background}}<details class="rf-bg" id="bg"{{if or $.Data.BgOpen (not .Real)}} open{{end}}><summary>Routine ({{.BackgroundLines}} {{plural .BackgroundLines "refusal" "refusals"}} in {{.Background}} {{plural .Background "group" "groups"}}: system lookups, probes)</summary>
<p class="rf-rule">Routine means the contract's default refused it (no entry names it), it touches no secret, its first refusal is not within 16 lines and 5 s of a secret touch, and it is a system lookup, a connect to a remote host this run also reached, a route probe to port 65535 of a remote host, or a terminal or standard device. How often it repeats never makes it routine. Every refusal is still counted here and in Logs.</p>
<ul class="list refusals">{{range .Groups}}{{if .Background}}{{template "rgroup" .}}{{end}}{{end}}</ul></details>{{end}}
{{else}}{{template "rfnone" $r}}{{end}}{{end}}
{{else}}<p class="panel-body soft rf-sum" title="Identical lines fold into one row">Newest first</p>
{{if .Refusals}}<ul class="list refusals">{{range .Refusals}}<li class="{{if .SystemLookup}}sys{{end}}">{{template "i" "i-ban"}}<div class="grow stack-sm"><span class="title"><span class="op">{{.Op}}</span> <span class="ut">{{shown .Event}}</span>{{if gt .Count 1}}<span class="xn" title="{{.Count}} identical refusals, {{clock .First}} to {{clock .TS}}">×{{.Count}}</span>{{end}}{{if .SystemLookup}}<span class="tag-sys">system lookup</span>{{end}}</span>
<dl class="kv"><dt>Rule</dt><dd class="mono">{{if .Label}}<span title="{{.Rule}}">{{.Label}}</span>{{else if .Rule}}<span title="{{.Rule}}">{{ruleName .Rule}}</span>{{else}}—{{end}}</dd><dt>Reason the agent got</dt><dd>{{reasonText (print .Reason)}} <span class="mono muted">{{.Reason}}</span></dd><dt>When</dt><dd><time datetime="{{iso .TS}}" title="{{stamp .TS}}">{{clockms .TS}} {{tz}}</time> · line #{{.Seq}}</dd></dl></div></li>{{end}}</ul>
{{else}}{{template "rfnone" $r}}{{end}}{{end}}
</section>
{{else if eq .Tab "least-privilege"}}{{if and (eq .Story.Kind "leak") .Learn (not .Learn.Err)}}<div class="banner banner-danger lp-leak" role="alert">{{template "i" "i-triangle-alert"}}<div class="grow">This run leaked secrets: {{baseNames .Story.Exposed}} sent to {{join .Story.Dests ", "}}. {{if .Withheld}}The proposal below leaves <span class="mono">{{join .Withheld ", "}}</span> out: a contract made from this run must never allow where its secrets went. Review every other entry before you use it.{{else}}The proposal may still allow it: remove it before you use it.{{end}}</div></div>
{{end}}{{if and .Drift (not .Drift.Err) (not .Drift.NoContract)}}{{with .Drift}}
<section class="panel" aria-labelledby="h-lpe"><div class="panel-head"><h2 id="h-lpe">Least privilege</h2><span class="soft">Smallest contract change</span></div>
{{$cut := $.Data.Cut}}<div class="panel-body stack-lg"><p>{{if $cut}}Remove the {{len $cut}} {{plural (len $cut) "entry" "entries"}} this run was granted but never used. Every protection the contract has stays as it is.{{else}}This run used every entry its contract grants: nothing to remove. Every protection stays as it is.{{end}}{{if .Unknown}} The contract was not recompiled here, so its unused entries are not known.{{end}}</p>
{{if $cut}}<div><h3 class="lbl">Remove: granted but never used</h3><ul class="lp-keep">{{range $cut}}<li><span class="mono" title="{{.}}">{{ruleName .}}</span></li>{{end}}</ul></div>{{end}}
{{if $.Data.Keep}}<div><h3 class="lbl">Keep: your protections</h3><ul class="lp-keep">{{range $.Data.Keep}}<li><span class="mono">{{.}}</span></li>{{end}}</ul></div>{{end}}
<div class="cli"><code>tego drift {{$r.ID}}</code></div></div></section>{{end}}{{end}}
{{with .Learn}}{{if $.Data.Keep}}<details class="lp-learn"><summary>Contract from scratch <span class="mono" title="tego learn">learn</span> <span class="soft">(only what this run did: it drops your deny and ask entries)</span></summary>{{end}}
<section class="panel" aria-labelledby="h-lp"><div class="panel-head"><h2 id="h-lp">Least privilege</h2><div class="row">{{if not .Err}}{{if $.Data.CanSetUp}}<a class="btn btn-primary" href="/rules/new?mode=run&amp;from={{queryEsc $r.ID}}">{{template "i" "i-shield"}}Make a contract from this run</a>{{end}}<a class="btn" href="/runs/{{pathEsc $r.ID}}/least-privilege.yaml" download>{{template "i" "i-download"}}Download contract</a>{{end}}</div></div>
<div class="panel-body stack-sm">{{if .Err}}<p class="soft">No proposal could be made from this run: {{.Err}}</p>{{else}}
<p>The contract <span class="mono">tego learn</span> proposes from what this run did: only the directories it wrote, the programs it started and the addresses it connected to. It is a proposal: review it before you use it.{{if not .Ended}} <strong>The run has not ended</strong>: this is the run so far, and no limits are suggested until it ends.{{end}}{{if .Left}} {{.Left}} {{plural .Left "kind" "kinds"}} of action the run took {{if eq .Left 1}}is{{else}}are{{end}} left out; the header and the "observed, not allowed" comments say which and why.{{end}}</p>
<pre class="mono lp-contract">{{.Text}}</pre>{{end}}
<div class="cli"><code>tego learn {{$r.ID}} --save &lt;name&gt;</code></div></div>
</section>{{if $.Data.Keep}}</details>{{end}}{{end}}
{{else if eq .Tab "unused"}}{{with .Drift}}{{$unk := .Unknown}}
<section class="panel" aria-labelledby="h-un"><div class="panel-head"><h2 id="h-un">Unused permissions</h2><span class="soft">{{if .Declared}}{{.Unused}} of {{.Declared}} contract {{plural .Declared "entry" "entries"}} granted but never used{{end}}</span></div>
<div class="panel-body stack-sm">{{if .Err}}<p class="soft">The run could not be read: {{.Err}}</p>{{else}}
{{if .NoContract}}<p class="soft">No contract copy · rules named by the run only</p>{{end}}
{{if .FromText}}<p class="soft" title="{{.Contract}}">The contract no longer compiles here, so its entries are counted from its text; a rule it does not list may be granted without an entry and shows as unknown.</p>
{{else if .Unknown}}<p class="soft">The contract was not recompiled here ({{.Contract}}), so its declared entries are unknown: only the rules the run named are shown.</p>{{end}}
{{if .HashChanged}}<p class="soft">Copy differs from the recorded contract</p>{{end}}
{{if .Rows}}<div class="tw"><table class="t" role="table"><caption class="sr">Contract entries and how often each was used</caption><thead><tr><th scope="col">Entry</th><th scope="col">Section</th><th scope="col" class="num">Allowed</th><th scope="col" class="num">Asked</th><th scope="col" class="num">Refused</th><th scope="col">Use</th></tr></thead><tbody>
{{range .Rows}}<tr class="{{if .Unused}}unused-row{{end}}"><td class="mono lead" title="{{.Rule}}">{{ruleName .Rule}}</td><td data-label="Section">{{.Section}}</td><td class="num" data-label="Allowed">{{.Allow}}</td><td class="num" data-label="Asked">{{.Ask}}</td><td class="num" data-label="Refused">{{.Refused}}</td><td data-label="Use">{{if .Unused}}<span class="b b-asked">Granted but never used</span>{{else if .Guard}}<span class="muted">A guard: not fired</span>{{else if .Unobservable}}<span class="muted">The record could not show it used</span>{{else if not .Declared}}<span class="muted">{{if $unk}}<span title="The contract was not recompiled here">Contract unknown here</span>{{else}}Not in contract{{end}}</span>{{else}}Used{{end}}</td></tr>{{end}}
</tbody></table></div>{{else}}<p class="soft">The run named no rule and its contract declares no entry.</p>{{end}}
<p class="soft">A grant never used is one a least-privilege contract would drop: see the Least privilege tab.</p>{{end}}
<div class="cli"><code>tego drift {{$r.ID}}</code></div></div>
</section>{{end}}
{{else}}
{{template "receipt" .Receipt}}
{{end}}
{{end}}{{end}}
{{/* tlrows is timeline rows (tl: the rows and whether the run is live, which offers Block); the run page and GET /runs/<id>/rows both render it. */}}
{{define "tlrows"}}{{$live := .Live}}{{$contract := .Contract}}{{$ch := .Changes}}{{range .Rows}}{{range index $ch.Before .Cursor}}{{template "rctl" .}}{{end}}{{$mk := leakMark $.V .Event}}<div class="tl v-{{verdictClass .Event}}{{if .SystemLookup}} sys{{end}}{{with $mk.Class}} {{.}}{{end}}" id="l{{.Seq}}"{{with foldKey .Event}} data-k="{{.}}"{{end}}><span class="time">{{clock .TS}}<a class="seq link" href="/runs/{{pathEsc .Run}}/lines/{{.Seq}}" title="Details of line {{.Seq}}">#{{.Seq}}</a></span><span class="kind">{{template "i" (kindIcon .Kind)}}</span>{{$rn := renameOf (shown .Event) $.Home}}<span class="what"><span><span class="op">{{shownOp .Event}}</span>{{if $rn}}<span class="ut rn" title="{{$rn.Full}}"><b>{{$rn.From}}</b> → <b>{{$rn.To}}</b></span>{{else}}{{template "sptv" (spt (shown .Event) $.Home 120)}}{{end}}{{if gt .Count 1}}<span class="xn" title="{{.Count}} identical lines folded">×{{.Count}}</span>{{end}}{{if .SystemLookup}}<span class="tag-sys">system lookup</span>{{end}}</span>{{with $rn}}<span class="rule rn-where" title="{{.Full}}">{{.Where}}</span>{{end}}{{if $mk.Why}}<span class="rule"><span class="clamp mk-why">{{$mk.Why}}</span></span>{{else}}{{$named := or .Label .Rule}}{{$why := or $named (reasonOf .Event) (codeOf .Event)}}{{if and $why (not (and $.Watched (eq .Verdict "observed")))}}<span class="rule"><span class="clamp" title="A {{.Kind}} line{{with .Source}}, seen by {{.}}{{end}}{{with codeOf .Event}}; reason code {{.}}{{end}}">{{if or .Label .Rule}}<span title="{{.Rule}}">{{if .Label}}{{homeIn .Label $.Home}}{{else}}{{homeIn (ruleName .Rule) $.Home}}{{end}}</span>{{end}}{{with reasonOf .Event}}{{if $named}} · {{end}}{{.}}{{end}}</span></span>{{end}}{{end}}</span><span class="tl-end"><span class="row-acts">{{template "rulelink" (acts .Event $live $contract)}}</span>{{if $mk.Word}}<span class="b b-bad" title="{{verdictWord .Event}}: tego {{if $.Watched}}watch recorded it and stopped nothing{{else}}let it through{{end}}">{{template "i" "i-triangle-alert"}}{{$mk.Word}}</span>{{else}}<span class="b b-{{verdictClass .Event}}">{{template "i" (verdictIcon .Event)}}{{verdictWord .Event}}</span>{{end}}</span></div>{{end}}{{range $ch.Tail}}{{template "rctl" .}}{{end}}{{end}}
{{/* receipt is the Receipt tab (receipt.go): one screen of what the run did, from internal/check/receipt, the builder `tego receipt` prints from, so the page and the terminal show the same numbers. */}}
{{define "receipt"}}<link rel="stylesheet" href="/static/receipt.css">
<section class="panel rc" aria-labelledby="h-rc"><div class="panel-head"><h2 id="h-rc">Receipt</h2><span class="soft" title="Same as tego receipt">From the record</span></div>
{{if not .}}<div class="panel-body"><p class="soft">No receipt</p></div>
{{else if .Err}}<div class="panel-body"><p class="soft">No receipt for this run: {{.Err}}</p></div>
{{else}}{{$v := .}}{{with .R}}
<div class="panel-body rc-hero"><div class="rc-line"><span class="b {{$v.OutcomeClass}}">{{$v.OutcomeWord}}</span><span class="rc-out">{{.Outcome}}</span><span class="soft">· took {{with $v.LiveSince}}<span class="ck" data-since="{{.}}" data-ck>{{$v.Took}}</span>{{else}}{{$v.Took}}{{end}}</span></div>
{{with $v.Command}}<div class="rc-cmd mono" title="{{.}}">{{cut . 140}}</div>{{end}}</div>
<ul class="rc-tiles" aria-label="The run in numbers">
<li class="rc-tile"><span class="rc-k">Time taken</span><span class="rc-v">{{with $v.LiveSince}}<span class="ck" data-since="{{.}}" data-ck>{{$v.Took}}</span>{{else}}{{$v.Took}}{{end}}</span><span class="rc-s">{{if .Time.SoFar}}so far{{else if .Stall.Windows}}{{.Stall.Minutes}} min quiet{{else}}no stall{{end}}</span></li>
<li class="rc-tile"><span class="rc-k">Files written</span>{{if .Files.Recorded}}<span class="rc-v">{{len .Files.Written}}</span><span class="rc-s">{{len .Files.Created}} new · {{len .Files.Deleted}} deleted{{with .Files.Renamed}} · {{len .}} renamed{{end}}</span>{{else}}<span class="rc-v rc-na">–</span><span class="rc-s">not recorded at this protection level</span>{{end}}</li>
<li class="rc-tile{{if .Refusals.Total}} rc-bad{{end}}"><span class="rc-k">Refused</span><span class="rc-v">{{.Refusals.Total}}</span><span class="rc-s">{{if .Refusals.Total}}by {{len .Refusals.ByRule}} {{plural (len .Refusals.ByRule) "rule" "rules"}}{{else if .RefusedReadsUnrecorded}}refused reads not recorded{{else}}nothing refused{{end}}</span></li>
<li class="rc-tile{{if .Asks.Unanswered}} rc-warn{{end}}"><span class="rc-k">Asked you</span><span class="rc-v">{{.Asks.Asked}}</span><span class="rc-s">{{if .Asks.Asked}}{{.Asks.Approved}} approved · {{.Asks.Denied}} denied{{if .Asks.TimedOut}} · {{.Asks.TimedOut}} timed out{{end}}{{if .Asks.Unanswered}} · {{.Asks.Unanswered}} open{{end}}{{else}}never asked{{end}}</span></li>
<li class="rc-tile"><span class="rc-k">Model tokens</span>{{if .Tokens.Recorded}}<span class="rc-v">{{$v.TokensText}}</span><span class="rc-s">{{.Tokens.ModelCalls}} {{plural .Tokens.ModelCalls "call" "calls"}}{{if lt .Tokens.Unpriced .Tokens.Metered}} · {{.Tokens.CostText}}{{end}}</span>{{else}}<span class="rc-v rc-na">–</span><span class="rc-s">model traffic not captured</span>{{end}}</li>
</ul>
{{/* What the run did (receipt.Receipt's activity lists): the secret-looking files it read, where it connected and the programs it ran. */}}
<div class="panel-body rc-block rc-sens"><h3>Sensitive files read{{with .SensitiveReads}} <span class="soft">· {{len .}} {{plural (len .) "file" "files"}}</span>{{end}}</h3>
{{if .SensitiveReads}}<ul class="list rc-list rc-act">{{range $i, $s := .SensitiveReads}}{{if lt $i $v.SensShown}}<li>{{template "i" "i-key-round"}}<span class="ut rc-path" title="{{.Path}}">{{template "pwp" (pieces (tilde .Path))}}</span>{{with fileKind .Path}}<span class="soft rc-kind">{{.}}</span>{{end}}<span class="rc-chips">{{range $v.SensChips .Path .Verdicts.Observed .Verdicts.Allowed .Verdicts.Refused}}<span class="b {{.Class}}">{{.Text}} {{.N}}</span>{{end}}</span></li>{{end}}{{end}}</ul>
{{if $v.MoreSensitive}}<p class="soft">and {{$v.MoreSensitive}} more: <span class="mono">tego receipt {{.Run}}</span> lists them.</p>{{end}}{{if .SensitiveReadsTruncated}}<p class="soft">The receipt keeps a bounded list of files; Logs has every read.</p>{{end}}
{{else if $v.Gap}}
{{else if .SensitiveReadsUnknown}}<p class="soft">Not known: this run did not record every read, so a sensitive file may have been read.</p>
{{else}}<p class="rc-ok">{{template "i" "i-check"}}None: no file that looks like a secret, and none a read rule guards.</p>{{end}}
{{with $v.Gap}}<p class="soft">{{.}}</p><p class="soft">{{template "readfix"}}</p>{{else with $v.SensNote}}<p class="soft">{{.}}</p>{{end}}</div>
<div class="rc-grid rc-act-grid">
<div class="panel-body rc-block"><h3>Connections{{if .Connections}} <span class="soft">· {{.ConnectionTries}} {{plural .ConnectionTries "connection" "connections"}} to {{$v.Places}} {{plural $v.Places "place" "places"}}</span>{{end}}</h3>
{{if .Connections}}<ul class="list rc-list rc-act">{{range .Connections}}<li>{{template "i" "i-activity"}}<span class="ut rc-path" title="{{.Destination}}">{{template "pwp" (pieces .Destination)}}</span><span class="rc-chips">{{range $v.Chips .Verdicts.Observed .Verdicts.Allowed .Verdicts.Refused}}<span class="b {{.Class}}">{{.Text}} {{.N}}</span>{{end}}</span></li>{{end}}</ul>
{{if .ConnectionsMore}}<p class="soft">and {{.ConnectionsMore}} more in <a class="link" href="/logs?run={{queryEsc .Run}}">Logs</a>.</p>{{end}}
{{else}}<p class="soft">{{.NoConnectionWords}}</p>{{end}}
{{range .RoutineAlsoWords}}<p class="soft">{{.}}</p>{{end}}
{{with $v.ConnNote}}<p class="soft">{{.}}</p>{{end}}</div>
<div class="panel-body rc-block"><h3>Programs run{{if .Programs}} <span class="soft">· {{$v.ProgramStarts}} {{plural $v.ProgramStarts "start" "starts"}}</span>{{end}}</h3>
{{if .Programs}}<ul class="list rc-list rc-act">{{range .Programs}}<li>{{template "i" "i-terminal"}}<span class="ut rc-path" title="{{.Path}}">{{template "pwp" (pieces (tilde .Path))}}</span><span class="soft rc-cnt">×{{.Count}}</span></li>{{end}}</ul>
{{if .ProgramsMore}}<p class="soft">and {{.ProgramsMore}} more in <a class="link" href="/logs?run={{queryEsc .Run}}">Logs</a>.</p>{{end}}
{{else}}<p class="soft">None recorded.</p>{{end}}</div>
</div>
<div class="rc-grid">
<div class="panel-body rc-block"><h3>Refused, by rule</h3>
{{if .Refusals.ByRule}}<ul class="rc-bars">{{range $v.Rules}}<li><div class="rc-bar-h"><span class="mono rc-rule" title="{{.Rule}}">{{if .Label}}{{.Label}}{{else}}{{ruleName .Rule}}{{end}}</span><span class="rc-n">{{.Count}}</span></div><svg class="rc-bar" viewBox="0 0 100 6" preserveAspectRatio="none" aria-hidden="true" focusable="false"><rect class="rc-track" x="0" y="0" width="100" height="6" rx="3"/><rect class="rc-fill" x="0" y="0" width="{{.Pct}}" height="6" rx="3"/></svg><span class="soft rc-why" title="Reason code {{.Reason}}">{{reasonText .Reason}}</span></li>{{end}}</ul>
{{with .RefusedWords}}<p class="soft">{{.}}</p>{{end}}{{else if .RefusedReadsUnrecorded}}<p class="soft">{{.RefusedWords}}</p>{{else}}<p class="rc-ok">{{template "i" "i-check"}}{{.RefusedWords}}</p>{{end}}</div>
<div class="panel-body rc-block"><h3>Refusals over time</h3>
{{if .Refusals.Total}}<p class="sr">Refusals per minute from the start: {{.OverTimeText}}</p><svg class="rc-spark" viewBox="{{$v.SparkBox}}" preserveAspectRatio="none" aria-hidden="true" focusable="false">{{range $v.Spark}}<rect class="{{if .N}}on{{else}}off{{end}}" x="{{.X}}" y="{{.Y}}" width="{{.W}}" height="{{.H}}"><title>{{.Label}}: {{.N}} refused</title></rect>{{end}}</svg>
<div class="rc-axis soft"><span>start</span><span>{{with $v.LiveSince}}<span class="ck" data-since="{{.}}" data-ck>{{$v.Took}}</span>{{else}}{{$v.Took}}{{end}}</span></div>
{{else}}<p class="soft">{{$v.NoneOverTime}}</p>{{end}}
{{if $v.ShowStall}}<h3>Stall minutes</h3><p>{{.StallText}}{{if .Stall.EndedByStall}}; the stall limit ended the run{{end}}.</p>{{end}}</div>
</div>
{{if .Refusals.List}}<div class="panel-body rc-block"><h3>Refused actions <span class="soft">· oldest first</span></h3><ul class="list rc-list">{{range $v.Refused}}<li>{{template "i" "i-ban"}}<span class="mono soft rc-t">{{clock .TS}}</span><span class="op">{{.Op}}</span> <span class="ut" title="{{.Target}}">{{cut .Target 90}}</span><span class="soft rc-rr" title="{{.Rule}}">{{with $v.BuiltIn .}}{{.}}{{else}}{{ruleName .Rule}}{{end}}</span></li>{{end}}</ul>
{{if $v.MoreRefused}}<p class="soft">and {{$v.MoreRefused}} more on the <a class="link" href="/runs/{{pathEsc .Run}}/refusals">Refusals tab</a>.</p>{{end}}</div>{{end}}
<div class="panel-body rc-block"><h3>Files written</h3>
{{if not .Files.Recorded}}<p class="soft">{{.Files.Note}}.</p>
{{else if $v.Files}}<ul class="list rc-list">{{range $v.Files}}<li><span class="rc-verb rc-{{.Verb}}">{{.Verb}}</span><span class="ut" title="{{.Path}}">{{cut .Path 100}}</span>{{if .To}} <span class="soft">to</span> <span class="ut" title="{{.To}}">{{cut .To 100}}</span>{{end}}</li>{{end}}</ul>
{{if $v.MoreFiles}}<p class="soft">and {{$v.MoreFiles}} more: <span class="mono">tego receipt {{.Run}}</span> lists them.</p>{{end}}
{{else}}<p class="soft">It wrote no file.</p>{{end}}</div>
{{if .Asks.List}}<div class="panel-body rc-block"><h3>Times it asked you</h3><ul class="list rc-list">{{range .Asks.List}}<li><span class="b {{if eq .Answer "approved"}}b-allowed{{else if .Answer}}b-refused{{else}}b-waiting{{end}}">{{if .Answer}}{{.Answer}}{{else}}open{{end}}</span><span class="op">{{.Op}}</span> <span class="ut" title="{{.Target}}">{{cut .Target 90}}</span>{{if .By}}<span class="soft rc-rr" title="{{.By}}">by {{who .By}}{{if .AfterS}} after {{secs .AfterS}}{{end}}</span>{{end}}</li>{{end}}</ul></div>{{end}}
<div class="panel-body rc-block rc-cov"><h3>What this receipt can vouch for</h3>
{{if .Coverage.Complete}}<p class="rc-ok">{{template "i" "i-check"}}Complete: every field above was read off a ledger that records it.</p>
{{else}}{{$run := .Run}}<ul class="rc-gaps">{{range .Coverage.Gaps}}{{$g := .}}<li>{{with $v.GapWords .Field .Why}}<a class="link" href="/logs?run={{queryEsc $run}}&amp;kind=gap" title="{{$g.Why}}">{{.}}</a>{{else}}<span class="mono">{{.Field}}</span> {{.Why}}{{end}}</li>{{end}}</ul>{{end}}
{{with .Coverage.FrozenText}}<p class="soft">{{.}}</p>{{end}}
{{range .Notes}}<p class="soft">Note: {{.}}.</p>{{end}}
<p class="soft">Tests result: {{.Tests.Note}}.</p></div>
<div class="panel-body rc-cli"><div class="cli"><code>tego receipt {{.Run}}</code></div><div class="cli"><code>tego receipt {{.Run}} --verify</code></div></div>
{{end}}{{end}}
</section>{{end}}
