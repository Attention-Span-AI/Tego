{
  "hooks": {
    "PostToolBatch": [
      {
        "hooks": [
          {
            "args": [
              "__hook__",
              "context"
            ],
            "command": "@HOOK@",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "args": [
              "__hook__",
              "exit2"
            ],
            "command": "@HOOK@",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "args": [
              "__hook__",
              "exit2"
            ],
            "command": "@HOOK@",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "args": [
              "__hook__",
              "context"
            ],
            "command": "@HOOK@",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "args": [
              "__hook__",
              "exit2-once"
            ],
            "command": "@HOOK@",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  }
}
